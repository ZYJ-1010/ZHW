.participant-card {
  display: flex;
  width: 100%;
  min-height: 190rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.05);
}

.participant-card.player {
  background: #f6ebdc;
}

.participant-card.expert {
  background: #e2eff6;
}

.participant-card.guide {
  background: #ffffff;
}

.participant-avatar-wrap {
  position: relative;
  flex: none;
  width: 92rpx;
  height: 126rpx;
  margin-right: 20rpx;
}

.participant-avatar-image {
  display: block;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #e5e7eb;
}

.participant-avatar-fallback {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 86rpx;
	height: 86rpx;
	border-radius: 50%;
	color: #ffffff;
	background: #64748b;
	font-size: 28rpx;
	font-weight: 700;
}

.participant-role-badge {
  position: absolute;
  left: 50%;
  top: 82rpx;
  min-width: 64rpx;
  height: 38rpx;
  padding: 0 10rpx;
  border: 2rpx solid #ffffff;
  border-radius: 19rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  transform: translateX(-50%);
  white-space: nowrap;
}

.participant-role-badge.player {
  background: #b97d09;
}

.participant-role-badge.expert {
  background: #1890ff;
}

.participant-role-badge.guide {
  background: #f59e0b;
}

.participant-main {
  flex: 1;
  min-width: 0;
}

.participant-title-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 12rpx;
  row-gap: 2rpx;
  min-width: 0;
}

.participant-name {
  flex: 0 1 auto;
  max-width: 100%;
  overflow: visible;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
  overflow-wrap: anywhere;
  white-space: normal;
}

.participant-blue-badge {
  flex: none;
  margin: 0 8rpx;
  padding: 1rpx 8rpx;
  border-radius: 7rpx;
  background: #168bff;
  color: #ffffff;
  font-size: 17rpx;
  line-height: 26rpx;
}

.participant-role-text {
  flex: none;
  min-width: 0;
  margin-left: 0;
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-topic {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-primary-tag {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #a16222;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-location {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
}

.participant-location-icon {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
  opacity: 0.58;
}

.participant-location-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-card.compact {
  min-height: 142rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  box-shadow: none;
}

.participant-card.compact .participant-avatar-wrap {
  width: 66rpx;
  height: 96rpx;
  margin-right: 14rpx;
}

.participant-card.compact .participant-avatar-image {
  width: 58rpx;
  height: 58rpx;
}

.participant-card.compact .participant-role-badge {
  top: 54rpx;
  min-width: 48rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  font-size: 16rpx;
  line-height: 26rpx;
}

.participant-card.compact .participant-name {
  max-width: 100%;
  font-size: 22rpx;
  line-height: 30rpx;
}

.participant-card.compact .participant-role-text,
.participant-card.compact .participant-primary-tag,
.participant-card.compact .participant-location {
  font-size: 18rpx;
  line-height: 24rpx;
}

.participant-card.compact .participant-topic {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.participant-card.compact .participant-primary-tag,
.participant-card.compact .participant-location {
  margin-top: 4rpx;
}
