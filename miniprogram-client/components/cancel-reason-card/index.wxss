.cancel-reason-card {
  width: 684rpx;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.cancel-reason-card.expert {
  width: 682rpx;
  height: 750rpx;
  margin-top: 34rpx;
}

.cancel-reason-card.player {
  width: 684rpx;
  min-height: 692rpx;
  margin-top: 34rpx;
  padding: 30rpx 30rpx 30rpx 40rpx;
}

.cancel-reason-heading {
  display: flex;
  align-items: baseline;
}

.cancel-reason-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.cancel-reason-required {
  margin-left: 6rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.cancel-reason-list {
  margin-top: 24rpx;
}

.cancel-reason-list.check {
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
}

.cancel-reason-option {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.cancel-reason-option text {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.cancel-reason-option.center {
  justify-content: flex-start;
  width: 100%;
  height: 82rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  color: #4b5563;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
}

.cancel-reason-option.center + .cancel-reason-option.center {
  margin-top: 18rpx;
}

.cancel-reason-option.center.active {
  border-color: #3b82f6;
  color: #2563eb;
  background: #eff6ff;
  font-weight: 700;
}

.cancel-reason-card.player .cancel-reason-option.center.active {
  border-color: #1890ff;
  color: #1890ff;
  background: #eff6ff;
}

.cancel-reason-option.check {
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  color: #333333;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 38rpx;
}

.cancel-reason-option.check:first-child {
  margin-top: 0;
}

.cancel-reason-option.check.active {
  border-color: #1890ff;
  color: #1890ff;
  background: #eff6ff;
  font-weight: 500;
}

.cancel-reason-check {
  position: relative;
  flex: none;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #1890ff;
}

.cancel-reason-check::after {
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 10rpx;
  height: 16rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(42deg);
  content: '';
}

.cancel-reason-textarea {
  width: 100%;
  border-radius: 16rpx;
  color: #1f2937;
  background: #f9fafb;
  box-sizing: border-box;
}

.cancel-reason-textarea.center {
  height: 164rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  line-height: 38rpx;
}

.cancel-reason-textarea.check {
  height: 150rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  color: #333333;
  background: #f7f8fa;
  font-size: 28rpx;
  line-height: 40rpx;
}

.cancel-reason-placeholder {
  color: #9ca3af;
}
