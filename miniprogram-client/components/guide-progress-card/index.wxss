.progress-card {
  position: relative;
  width: 100%;
  margin-top: 20rpx;
  padding: 32rpx 34rpx 32rpx;
  border: 2rpx solid #fed7aa;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.progress-card.blue {
  border-color: #bfdbfe;
}

.progress-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
}

.progress-card-meta {
  display: flex;
  align-items: center;
  min-width: 0;
}

.progress-status {
  flex: none;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #c2410c;
  background: #ffedd5;
  font-size: 24rpx;
  line-height: 44rpx;
}

.progress-card.blue .progress-status {
  color: #1d4ed8;
  background: #dbeafe;
}

.progress-time {
  margin-left: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
}

.progress-chevron {
  flex: none;
  width: 18rpx;
  height: 26rpx;
}

.member-flow {
  position: relative;
  min-height: 158rpx;
  margin-top: 24rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.member-node {
  position: absolute;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 108rpx;
}

.member-node.first {
  left: 0;
}

.member-node.last {
  right: 0;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 72rpx;
  overflow: hidden;
  border: 2rpx solid #fbcfe8;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 44rpx;
}

.member-avatar-img {
  width: 100%;
  height: 100%;
}

.member-avatar.pink {
  background: #ec4899;
}

.member-avatar.orange {
  background: #f97316;
}

.member-avatar.blue {
  background: #3b82f6;
}

.member-avatar.green {
  background: #10b981;
}

.member-avatar.teal {
  background: #14b8a6;
}

.member-avatar.purple {
  background: #8b5cf6;
}

.member-avatar.muted {
  opacity: 0.5;
  border-color: #e5e7eb;
}

.member-name {
  max-width: 132rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-node.last .member-name {
  color: #9ca3af;
}

.member-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 102rpx;
  height: 38rpx;
  margin-top: 8rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #6b7280;
  background: #f3f4f6;
  font-size: 22rpx;
  line-height: 34rpx;
}

.member-state.confirmed {
  min-width: 134rpx;
  color: #15803d;
  background: #dcfce7;
}

.member-state.waiting {
  color: #c2410c;
  background: #ffedd5;
}

.member-state.canceled {
  color: #6b7280;
  background: #e5e7eb;
}

.member-state-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.progress-line-wrap {
  position: absolute;
  left: 136rpx;
  right: 136rpx;
  top: 56rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.progress-line {
  width: 100%;
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-line-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #fb923c;
}

.progress-card.blue .progress-line-fill {
  background: #3b82f6;
}

.progress-line-text {
  margin-top: 8rpx;
  color: #ea580c;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.progress-card.blue .progress-line-text {
  color: #2563eb;
}

.progress-notice {
  display: flex;
  align-items: center;
  height: 70rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  color: #c2410c;
  background: #fff7ed;
  font-size: 24rpx;
  line-height: 32rpx;
}

.progress-notice-icon {
  flex: none;
  width: 30rpx;
  height: 26rpx;
  margin-right: 16rpx;
}
