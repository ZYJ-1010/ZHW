<view class="game-card {{variant ? 'game-card--' + variant : ''}}" bindtap="handleTap">
  <image class="game-card-cover" src="{{item.coverSrc || defaultCover}}" mode="aspectFill" />
  <view class="game-card-tag {{tagTone}}">
    <text class="game-card-tag-text">{{item.tag}}</text>
  </view>
  <text class="game-card-price">{{item.price}}</text>
  <text class="game-card-title">{{item.title}}</text>
  <text class="game-card-meta location">{{item.location}}</text>
  <text class="game-card-meta time">{{item.time}}</text>
  <text wx:if="{{item.action}}" class="game-card-join" catchtap="handlePrimaryTap">{{item.action}}</text>
  <view wx:if="{{item.playerAvatars && item.playerAvatars.length}}" class="game-card-avatars">
    <view
      wx:for="{{item.playerAvatars}}"
      wx:for-item="avatar"
      wx:key="userId"
      class="game-card-avatar"
    >
      <image src="{{avatar.imageUrl || avatar.avatarUrl}}" mode="aspectFill" />
    </view>
  </view>
  <text class="game-card-joined {{item.playerAvatars && item.playerAvatars.length ? '' : 'no-avatars'}}">{{joinedText}}</text>
  <view class="game-card-actions">
    <view
      wx:for="{{item.actions}}"
      wx:for-item="action"
      wx:key="*this"
      class="game-card-action {{action === item.shareActionLabel && item.shareComponentVariant === 'icon_button' ? 'game-card-action--icon-only' : ''}}"
      data-action="{{action === item.shareActionLabel ? 'share' : action}}"
      catchtap="handleActionTap"
    >
      <image wx:if="{{action === item.shareActionLabel || action === '分享'}}" class="game-card-action-icon" src="https://static.haowan.net.cn/miniprogram/components/game-card/assets/action-share.png" mode="aspectFit" />
      <image wx:elif="{{action === '关注'}}" class="game-card-action-icon" src="https://static.haowan.net.cn/miniprogram/components/game-card/assets/action-follow.png" mode="aspectFit" />
      <image wx:elif="{{action === '引荐'}}" class="game-card-action-icon" src="https://static.haowan.net.cn/miniprogram/components/game-card/assets/action-refer.png" mode="aspectFit" />
      <image wx:elif="{{action === '打招呼'}}" class="game-card-action-icon" src="https://static.haowan.net.cn/miniprogram/components/game-card/assets/action-greet.png" mode="aspectFit" />
      <text wx:if="{{!(action === item.shareActionLabel && item.shareComponentVariant === 'icon_button')}}" class="game-card-action-text">{{action}}</text>
    </view>
  </view>
</view>
