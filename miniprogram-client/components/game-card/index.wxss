.game-card {
  position: relative;
  width: 662rpx;
  height: 258rpx;
  margin: 18rpx auto 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #007bd3 0%, #034373 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.game-card-cover {
  position: absolute;
  left: 24rpx;
  top: 46rpx;
  width: 178rpx;
  height: 180rpx;
  border: 2rpx solid rgba(55, 127, 127, 0.67);
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #0b4f71;
}

.game-card-tag {
  position: absolute;
  left: 218rpx;
  top: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 30rpx;
  overflow: hidden;
  color: #ffffff;
  background: rgb(243, 158, 30);
  text-align: center;
}

.game-card-tag-text {
  display: block;
  width: 100%;
  height: 30rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  white-space: nowrap;
}

.game-card-tag.explore {
  color: #ffffff;
  background: rgb(59, 189, 26);
}

.game-card-tag.task {
  color: #ffffff;
  background: rgb(243, 158, 30);
}

.game-card-tag.story {
  color: #ffffff;
  background: rgb(59, 189, 26);
}

.game-card-tag.nearby {
  color: #ff006e;
  background: rgba(255, 0, 110, 0.18);
}

.game-card-price {
  position: absolute;
  left: 546rpx;
  top: 50rpx;
  color: rgb(34, 226, 238);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

.game-card-title {
  position: absolute;
  left: 216rpx;
  right: 142rpx;
  top: 84rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-meta {
  position: absolute;
  left: 218rpx;
  right: 198rpx;
  overflow: hidden;
  color: rgb(190, 190, 190);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-meta.location {
  top: 132rpx;
}

.game-card-meta.time {
  top: 158rpx;
}

.game-card-join {
  position: absolute;
  right: 24rpx;
  top: 130rpx;
  z-index: 2;
  display: block;
  width: 100rpx;
  height: 38rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgb(255, 0, 110);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  white-space: nowrap;
}

.game-card-avatars {
  position: absolute;
  left: 216rpx;
  bottom: 30rpx;
  display: flex;
  width: 80rpx;
}

.game-card-avatar {
	display: flex;
	align-items: center;
	justify-content: center;
  width: 32rpx;
  height: 34rpx;
  margin-right: -8rpx;
  border: 2rpx solid rgba(17, 62, 96, 0.95);
  border-radius: 50%;
  box-sizing: border-box;
	color: #ffffff;
	background: #1686d9;
	font-size: 14rpx;
	line-height: 1;
	overflow: hidden;
}

.game-card-avatar image {
	width: 100%;
	height: 100%;
}

.game-card-joined {
  position: absolute;
  left: 306rpx;
  bottom: 30rpx;
  width: 92rpx;
  overflow: hidden;
  color: rgb(190, 190, 190);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-joined.no-avatars {
  left: 216rpx;
  width: 182rpx;
}

.game-card-actions {
  position: absolute;
  right: 28rpx;
  bottom: 31rpx;
  display: grid;
  grid-template-columns: 54rpx 58rpx 58rpx 70rpx;
  column-gap: 4rpx;
}

.game-card-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  color: rgb(162, 151, 141);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 24rpx;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-action-icon {
  width: 20rpx;
  height: 20rpx;
  margin-right: 4rpx;
  flex: 0 0 20rpx;
}

.game-card-action-text {
  display: block;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
}
