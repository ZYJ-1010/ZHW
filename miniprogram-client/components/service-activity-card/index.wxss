.service-activity-card {
  width: 684rpx;
  height: 404rpx;
  margin-top: 32rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.service-activity-title {
  display: block;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.service-person-row {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.service-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #3b82f6;
  font-size: 35rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.service-avatar.player {
  background: #ec4899;
}

.service-avatar.expert {
  background: #3b82f6;
}

.service-avatar.guide {
  background: #10b981;
}

.service-person-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 24rpx;
}

.service-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.service-person-name {
  max-width: 350rpx;
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-role {
  flex: none;
  margin-left: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  color: #2563eb;
  background: #dbeafe;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.service-role.player {
  color: #ec4899;
  background: #fce7f3;
}

.service-role.expert {
  color: #2563eb;
  background: #dbeafe;
}

.service-role.guide {
  color: #047857;
  background: #d1fae5;
}

.service-title {
  margin-top: 6rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-divider {
  height: 2rpx;
  margin: 42rpx 0 24rpx;
  background: #f3f4f6;
}

.service-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-info-row.with-divider {
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.service-info-row + .service-info-row {
  margin-top: 20rpx;
}

.service-info-label {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 36rpx;
}

.service-info-value {
  max-width: 380rpx;
  overflow: hidden;
  color: #111827;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-info-value.strong {
  color: #111827;
  font-weight: 800;
}

.service-info-value.active,
.service-info-value.blue {
  color: #3b82f6;
}
