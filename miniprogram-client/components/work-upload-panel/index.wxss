.work-upload-panel {
  box-sizing: border-box;
  width: 100%;
}

.work-upload-panel.framed {
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(15, 16, 20, 0.04);
  border-radius: 24rpx;
  background: #f6f7fb;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.16);
}

.work-upload-row {
  display: flex;
  justify-content: center;
  gap: 18rpx;
}

.work-upload-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  width: 168rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 2rpx solid rgba(187, 187, 187, 0.64);
  border-radius: 24rpx;
  color: #a7b2d4;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 34rpx;
  background: #ffffff;
}

.work-upload-panel.framed .work-upload-button {
  background: rgba(255, 255, 255, 0.05);
}

.work-upload-button::after {
  border: 0;
}

.work-upload-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 34rpx;
  color: #a7b2d4;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 34rpx;
}
