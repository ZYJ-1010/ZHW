.status-card {
  position: relative;
  overflow: hidden;
  width: 666rpx;
  min-height: 458rpx;
  margin: 0 auto;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(154.26deg, rgba(251, 146, 60, 1) 12.58%, rgba(239, 68, 68, 1) 87.42%);
  box-shadow: 0 16rpx 34rpx rgba(252, 96, 118, 0.22);
}

.status-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}

.hourglass {
  position: relative;
  width: 34rpx;
  height: 46rpx;
  border-top: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  box-sizing: border-box;
}

.hourglass::before,
.hourglass::after {
  position: absolute;
  left: 4rpx;
  width: 26rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
  content: '';
}

.hourglass::before {
  top: 2rpx;
  border-top: 18rpx solid rgba(255, 255, 255, 0.92);
}

.hourglass::after {
  bottom: 2rpx;
  border-bottom: 18rpx solid rgba(255, 255, 255, 0.92);
}

.status-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.status-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 32rpx;
}

.status-title {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.referral-quote {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.12);
  font-size: 26rpx;
  line-height: 38rpx;
}

.status-meta-box {
  margin-top: 20rpx;
  padding: 20rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
}

.referral-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 0 24rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 34rpx;
}

.referral-name {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.countdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 24rpx 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 34rpx;
}

.countdown-value {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.2);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.detail-card {
  width: 682rpx;
  margin-top: 24rpx;
  margin-right: 0;
  margin-left: 11rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: var(--game-detail-panel-background-color);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.18);
}

.expert-detail-card {
  height: 878rpx;
  margin-top: 38rpx;
}

.party-detail-card {
  height: 446rpx;
  margin-top: 40rpx;
}

.session-detail-card {
  height: 512rpx;
  margin-top: 18rpx;
}

.game-info-detail-card {
  height: 568rpx;
  margin-top: 44rpx;
}

.cost-detail-card {
  height: 340rpx;
  margin-top: 44rpx;
  color: #101010;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-align: center;
}

.card-head,
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title-row.left {
  justify-content: flex-start;
  margin-bottom: 28rpx;
}

.blue-pill,
.verify-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.blue-pill {
  color: #ffffff;
  background: #3b82f6;
}

.verify-pill {
  gap: 8rpx;
  color: #22c55e;
  background: rgba(34, 197, 94, 0.12);
}

.verify-dot {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #22c55e;
}

.verify-dot::after {
  position: absolute;
  left: 5rpx;
  top: 2rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(42deg);
  content: '';
}

.expert-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.expert-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 44rpx;
  box-shadow: inset 0 -12rpx 20rpx rgba(0, 0, 0, 0.12);
}

.expert-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.expert-name {
  color: var(--game-detail-panel-text-color);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.expert-desc {
  margin-top: 8rpx;
  color: var(--game-detail-panel-muted-color);
  font-size: 24rpx;
  line-height: 34rpx;
}

.expert-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.rating-badge,
.service-badge {
  display: flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}

.rating-badge {
  color: #facc15;
  background: rgba(250, 204, 21, 0.14);
}

.service-badge {
  color: #4b5563;
  background: var(--game-detail-panel-soft-color);
}

.field-block {
  margin-top: 34rpx;
}

.field-title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--game-detail-panel-muted-color);
  font-size: 24rpx;
  line-height: 34rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.expert-tag {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.28);
  border-radius: 999rpx;
  color: #60a5fa;
  background: rgba(59, 130, 246, 0.12);
  font-size: 22rpx;
  line-height: 30rpx;
}

.service-intro {
  display: flex;
  flex-direction: column;
  margin-top: 34rpx;
  padding: 26rpx;
  border: 1rpx solid var(--game-detail-panel-border-color);
  border-radius: 24rpx;
  background: var(--game-detail-panel-soft-color);
}

.expert-detail-card .expert-profile {
  margin-top: 34rpx;
}

.expert-detail-card .field-block {
  margin-top: 46rpx;
}

.expert-detail-card .service-intro {
  min-height: 230rpx;
  margin-top: 46rpx;
}

.service-title {
  color: #60a5fa;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.service-text {
  margin-top: 12rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 38rpx;
}

.section-title {
  color: var(--game-detail-panel-text-color);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.section-title.regular {
  font-weight: 400;
}

.section-title.block {
  display: block;
  margin-bottom: 24rpx;
}

.section-tip {
  color: var(--game-detail-panel-muted-color);
  font-size: 22rpx;
  line-height: 30rpx;
}

.party-row {
  display: grid;
  grid-template-columns: 1fr 112rpx 1fr;
  align-items: start;
  gap: 14rpx;
  margin-top: 34rpx;
}

.party-detail-card .party-row {
  margin-top: 44rpx;
}

.party-person {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
}

.party-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
  box-shadow: 0 12rpx 22rpx rgba(0, 0, 0, 0.28);
}

.party-avatar.pink {
  background: #ec4899;
}

.party-avatar.blue {
  background: #3b82f6;
}

.party-check {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--game-detail-panel-background-color);
  border-radius: 50%;
  background: #22c55e;
  box-sizing: border-box;
}

.party-check::after {
  position: absolute;
  left: 8rpx;
  top: 3rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(42deg);
  content: '';
}

.party-name {
  max-width: 170rpx;
  margin-top: 16rpx;
  overflow: hidden;
  color: var(--game-detail-panel-text-color);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.party-role {
  margin-top: 4rpx;
  color: var(--game-detail-panel-muted-color);
  font-size: 22rpx;
  line-height: 30rpx;
}

.party-state {
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #facc15;
  background: rgba(250, 204, 21, 0.14);
  font-size: 20rpx;
  line-height: 28rpx;
  white-space: nowrap;
}

.party-link {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 12rpx;
}

.link-circle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.16);
}

.link-icon-image {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.link-line {
  width: 1rpx;
  height: 34rpx;
  margin-top: -10rpx;
  border-left: 2rpx dashed rgba(34, 197, 94, 0.5);
}

.link-text {
  margin-top: 2rpx;
  padding: 0 6rpx;
  color: #22c55e;
  background: var(--game-detail-panel-background-color);
  font-size: 22rpx;
  line-height: 30rpx;
}

.section-title-icon {
  flex: none;
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.session-detail-card .info-list {
  gap: 34rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.info-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: var(--game-detail-panel-muted-color);
  background: var(--game-detail-panel-soft-color);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.info-icon.image {
  background: transparent;
}

.info-icon-image {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.info-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.info-label {
  color: var(--game-detail-panel-muted-color);
  font-size: 22rpx;
  line-height: 30rpx;
}

.info-value {
  margin-top: 6rpx;
  color: var(--game-detail-panel-text-color);
  font-size: 24rpx;
  line-height: 36rpx;
}

.map-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 70rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  color: #4b5563;
  background: var(--game-detail-panel-soft-color);
  font-size: 24rpx;
  line-height: 32rpx;
}

.map-button::after,
.detail-action::after {
  border: 0;
}

.simple-list {
  display: flex;
  flex-direction: column;
}

.simple-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 62rpx;
  border-bottom: 1rpx solid var(--game-detail-panel-border-color);
}

.game-info-detail-card .simple-row {
  min-height: 106rpx;
}

.cost-detail-card .simple-row {
  min-height: 88rpx;
}

.cost-detail-card .simple-row.total {
  min-height: 108rpx;
}

.simple-row.last {
  border-bottom: 0;
}

.simple-label {
  flex: none;
  color: var(--game-detail-panel-muted-color);
  font-size: 24rpx;
  line-height: 34rpx;
}

.simple-value {
  min-width: 0;
  color: var(--game-detail-panel-text-color);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: right;
}

.simple-value.highlight {
  color: #f97316;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.cost-list .simple-row.total {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #e5e7eb;
  border-bottom: 0;
}

.cost-detail-card .simple-row:not(.total) {
  border-bottom: 0;
}

.simple-row.total .simple-label {
  color: var(--game-detail-panel-text-color);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.protection-card,
.notice-card {
  width: 666rpx;
  margin-top: 24rpx;
  margin-right: auto;
  margin-left: auto;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.protection-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  width: 682rpx;
  height: 180rpx;
  margin-left: 11rpx;
  padding: 34rpx 32rpx;
  border: 2rpx solid rgba(220, 252, 231, 1);
  border-radius: 32rpx;
  background: rgba(240, 253, 244, 1);
}

.shield-icon {
  flex: none;
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-top: 10rpx;
}

.notice-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.protection-title {
  color: #22c55e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.protection-text {
  margin-top: 6rpx;
  color: rgba(34, 197, 94, 0.82);
  font-size: 22rpx;
  line-height: 32rpx;
}

.notice-card {
  width: 684rpx;
  height: 262rpx;
  margin-left: 10rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid rgba(254, 249, 195, 1);
  border-radius: 24rpx;
  background: rgba(254, 252, 232, 1);
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #a16207;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.info-mark {
  display: block;
  width: 28rpx;
  height: 28rpx;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #a16207;
  font-size: 22rpx;
  line-height: 34rpx;
}

.notice-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #a16207;
}

.detail-action-bar {
  position: relative;
  z-index: 1;
  display: block;
  width: 682rpx;
  margin: 28rpx 0 0 11rpx;
  padding: 0 0 88rpx;
  min-height: 214rpx;
  box-sizing: border-box;
  border-top: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.action-buttons {
  display: flex;
  width: 100%;
  height: 86rpx;
  gap: 18rpx;
}

.detail-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 86rpx;
  min-width: 0;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.detail-action.secondary {
  flex: 1;
  color: #374151;
  background: var(--game-detail-panel-soft-color);
}

.detail-action.primary {
  flex: 1;
  background: #22c55e;
  box-shadow: 0 12rpx 28rpx rgba(34, 197, 94, 0.28);
}

.detail-action.primary.loading {
  opacity: 0.78;
}

.action-icon-image {
  flex: none;
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.action-tip {
  display: block;
  margin-top: 14rpx;
  color: var(--game-detail-panel-muted-color);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}
