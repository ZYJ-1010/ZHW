<view class="detail-action-bar">
  <view class="action-buttons">
    <view wx:if="{{singleReadonly}}" class="detail-action readonly">
      <text>{{confirmText}}</text>
    </view>
    <block wx:else>
      <view class="detail-action secondary" bindtap="handleDecline">
        <image class="action-icon-image" src="/pages/game/audit-detail/assets/icon-close.svg" mode="aspectFit"></image>
        <text>{{declineText}}</text>
      </view>
      <view class="detail-action primary {{loading ? 'loading' : ''}} {{confirmDisabled ? 'disabled' : ''}}" bindtap="handleConfirm">
        <image class="action-icon-image" src="/pages/game/audit-detail/assets/icon-confirm-green.svg" mode="aspectFit"></image>
        <text>{{loading ? loadingText : confirmText}}</text>
      </view>
    </block>
  </view>
  <text class="action-tip">{{tip}}</text>
</view>
