.detail-card {
  width: 682rpx;
  margin-top: 24rpx;
  margin-right: auto;
  margin-left: auto;
  padding: 30rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.card-tip {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.relation-head {
  position: relative;
  justify-content: center;
  min-height: 42rpx;
}

.relation-title {
  font-weight: 400;
  text-align: center;
}

.relation-count {
  position: absolute;
  right: 0;
  top: 4rpx;
}

.relation-map {
  position: relative;
  height: 310rpx;
  margin-top: 30rpx;
}

.relation-node {
  position: absolute;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.relation-node-expert {
  left: 50rpx;
  top: 62rpx;
}

.relation-node-guide {
  left: 270rpx;
  top: 0;
}

.relation-node-player {
  right: 50rpx;
  top: 62rpx;
}

.relation-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  color: #ffffff;
  font-weight: 400;
  box-shadow: 0 12rpx 22rpx rgba(0, 0, 0, 0.18);
}

.relation-avatar.expert,
.relation-avatar.player {
  width: 112rpx;
  height: 112rpx;
  font-size: 32rpx;
  line-height: 40rpx;
}

.relation-avatar.expert {
  background: #3b82f6;
}

.relation-avatar.player {
  background: #ec4899;
}

.confirmed-mark {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #22c55e;
  box-sizing: border-box;
}

.confirmed-mark::after {
  position: absolute;
  left: 8rpx;
  top: 3rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(42deg);
  content: "";
}

.relation-name {
  max-width: 168rpx;
  margin-top: 14rpx;
  overflow: hidden;
  color: #111827;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.relation-guide-name {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
}

.guide-hub {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fde68a;
  box-shadow: 0 12rpx 22rpx rgba(0, 0, 0, 0.14);
}

.handshake-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.guide-online-dot {
  position: absolute;
  right: 0;
  top: 0;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #47c16b;
}

.guide-stem {
  width: 5rpx;
  height: 48rpx;
  background: #fbbf24;
}

.guide-avatar-small {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #f59e0b;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.relation-badge {
  margin-top: 8rpx;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  white-space: nowrap;
}

.relation-badge.expert {
  color: #2563eb;
  background: rgba(59, 130, 246, 0.12);
}

.relation-badge.player {
  color: #db2777;
  background: rgba(236, 72, 153, 0.12);
}

.relation-map text,
.relation-map .relation-badge,
.relation-map .guide-avatar-small {
  font-weight: 400;
}

.blue-note {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  color: #2563eb;
  background: #eff6ff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.note-info {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #3b82f6;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}
