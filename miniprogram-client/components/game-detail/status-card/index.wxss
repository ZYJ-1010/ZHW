.status-card {
  position: relative;
  overflow: hidden;
  width: 666rpx;
  min-height: 458rpx;
  margin: 0 auto;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(154.26deg, rgba(251, 146, 60, 1) 12.58%, rgba(239, 68, 68, 1) 87.42%);
  box-shadow: 0 16rpx 34rpx rgba(252, 96, 118, 0.22);
}

.status-card.hide-quote {
  min-height: 330rpx;
}

.status-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}

.hourglass {
  position: relative;
  width: 34rpx;
  height: 46rpx;
  border-top: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  box-sizing: border-box;
}

.hourglass::before,
.hourglass::after {
  position: absolute;
  left: 4rpx;
  width: 26rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
  content: '';
}

.hourglass::before {
  top: 2rpx;
  border-top: 18rpx solid rgba(255, 255, 255, 0.92);
}

.hourglass::after {
  bottom: 2rpx;
  border-bottom: 18rpx solid rgba(255, 255, 255, 0.92);
}

.status-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.status-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 32rpx;
}

.status-title {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.referral-quote {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.12);
  font-size: 26rpx;
  line-height: 38rpx;
}

.status-meta-box {
  margin-top: 20rpx;
  padding: 20rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
}

.referral-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 0 24rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 34rpx;
}

.referral-name {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.countdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 24rpx 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 34rpx;
}

.countdown-value {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.2);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.status-card.progress {
  width: 666rpx;
  min-height: 0;
  padding: 56rpx 56rpx 54rpx;
  border-radius: 32rpx;
  background: linear-gradient(154.26deg, #fb923c 12.58%, #ef4b1f 87.42%);
  box-shadow: 0 16rpx 34rpx rgba(249, 115, 22, 0.22);
}

.progress-status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.progress-status-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.progress-status-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.progress-status-title {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.progress-hourglass {
  flex: none;
  width: 110rpx;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.2);
}

.progress-hourglass .hourglass {
  width: 40rpx;
  height: 54rpx;
}

.progress-hourglass .hourglass::before,
.progress-hourglass .hourglass::after {
  left: 5rpx;
  width: 30rpx;
  height: 20rpx;
  border-left-width: 15rpx;
  border-right-width: 15rpx;
}

.progress-hourglass .hourglass::before {
  border-top-width: 20rpx;
}

.progress-hourglass .hourglass::after {
  border-bottom-width: 20rpx;
}

.progress-countdown-box {
  margin-top: 32rpx;
  padding: 22rpx 28rpx 26rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
}

.progress-countdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.progress-countdown-value {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.progress-fill {
  width: 74%;
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
}
