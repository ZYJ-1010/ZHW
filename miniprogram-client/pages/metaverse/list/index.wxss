page {
  width: 100%;
  height: 100%;
  background: #efefef;
}

.metaverse-list {
  position: relative;
  width: 100%;
  min-height: 100%;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 26%, rgba(0, 210, 255, 0.28) 0, transparent 34%),
    radial-gradient(circle at 75% 68%, rgba(236, 72, 153, 0.22) 0, transparent 36%),
    #000000;
}

.metaverse-list__grid {
  position: absolute;
  left: -90rpx;
  right: -90rpx;
  bottom: -70rpx;
  height: 520rpx;
  opacity: 0.42;
  background-image:
    linear-gradient(rgba(0, 210, 255, 0.22) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(0, 210, 255, 0.22) 2rpx, transparent 2rpx);
  background-size: 58rpx 58rpx;
  transform: perspective(460rpx) rotateX(58deg);
  transform-origin: center bottom;
}

.metaverse-list__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  pointer-events: none;
}

.metaverse-list__glow.glow-a {
  left: 72rpx;
  top: 102rpx;
  width: 86rpx;
  height: 86rpx;
  background: rgba(0, 210, 255, 0.16);
  box-shadow: 0 0 68rpx rgba(0, 210, 255, 0.46);
}

.metaverse-list__glow.glow-b {
  right: 76rpx;
  top: 328rpx;
  width: 104rpx;
  height: 104rpx;
  background: rgba(236, 72, 153, 0.16);
  box-shadow: 0 0 80rpx rgba(236, 72, 153, 0.45);
}

.metaverse-list__stage {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 100%;
  padding: 28rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.metaverse-list__scene {
  position: relative;
  height: 300rpx;
  margin-top: 24rpx;
}

.metaverse-list__street {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 500rpx;
  height: 276rpx;
  transform: translateX(-50%);
}

.metaverse-list__street::after {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 0;
  height: 98rpx;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, rgba(0, 210, 255, 0.16), rgba(0, 0, 0, 0.1));
  box-shadow: inset 0 0 26rpx rgba(255, 255, 255, 0.08);
  content: '';
}

.metaverse-list__building {
  position: absolute;
  bottom: 42rpx;
  display: grid;
  grid-template-columns: repeat(2, 22rpx);
  gap: 14rpx;
  width: 92rpx;
  padding: 18rpx 14rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 210, 255, 0.28);
  border-radius: 14rpx;
  background: rgba(4, 18, 35, 0.76);
}

.metaverse-list__building.left {
  left: 38rpx;
  height: 196rpx;
}

.metaverse-list__building.right {
  right: 22rpx;
  height: 226rpx;
}

.metaverse-list__building view {
  width: 22rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: rgba(254, 250, 131, 0.72);
  box-shadow: 0 0 14rpx rgba(254, 250, 131, 0.32);
}

.metaverse-list__tower {
  position: absolute;
  left: 50%;
  bottom: 42rpx;
  width: 154rpx;
  height: 268rpx;
  transform: translateX(-50%);
}

.metaverse-list__tower-cap {
  position: absolute;
  left: 50%;
  top: 0;
  width: 24rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fefa83, #00d2ff);
  box-shadow: 0 0 32rpx rgba(0, 210, 255, 0.6);
  transform: translateX(-50%);
}

.metaverse-list__tower-body {
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(2, 24rpx);
  justify-content: center;
  gap: 14rpx 20rpx;
  height: 214rpx;
  padding-top: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(167, 139, 250, 0.36);
  border-radius: 52rpx 52rpx 16rpx 16rpx;
  background: linear-gradient(180deg, rgba(58, 134, 255, 0.4), rgba(2, 9, 24, 0.9));
}

.metaverse-list__tower-body view {
  width: 24rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: rgba(0, 210, 255, 0.68);
  box-shadow: 0 0 16rpx rgba(0, 210, 255, 0.4);
}

.metaverse-list__space-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 210, 255, 0.34);
  border-radius: 28rpx;
  background: rgba(0, 0, 0, 0.48);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
}

.metaverse-list__space-title,
.metaverse-list__space-subtitle,
.metaverse-list__speaker,
.metaverse-list__message {
  display: block;
}

.metaverse-list__space-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.metaverse-list__space-subtitle {
  margin-top: 10rpx;
  color: #00d2ff;
  font-size: 24rpx;
  line-height: 32rpx;
}

.metaverse-list__live-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 24rpx rgba(16, 185, 129, 0.82);
}

.metaverse-list__players {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.metaverse-list__player {
  display: flex;
  align-items: center;
  width: 320rpx;
  min-height: 66rpx;
  padding: 8rpx 18rpx 8rpx 8rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.05);
}

.metaverse-list__player:nth-child(2) {
  align-self: flex-end;
}

.metaverse-list__player.active {
  color: #ffffff;
}

.metaverse-list__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 50rpx;
  height: 50rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.metaverse-list__player.pink .metaverse-list__avatar {
  background: linear-gradient(180deg, #ec4899, #8b5cf6);
}

.metaverse-list__player.cyan .metaverse-list__avatar {
  background: linear-gradient(180deg, #00d2ff, #3a86ff);
}

.metaverse-list__player.orange .metaverse-list__avatar {
  background: linear-gradient(180deg, #ffbe0b, #fb5607);
}

.metaverse-list__player text {
  font-size: 24rpx;
  line-height: 32rpx;
}

.metaverse-list__chat {
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid rgba(139, 92, 246, 0.36);
  border-radius: 28rpx;
  background: rgba(12, 10, 32, 0.72);
}

.metaverse-list__speaker {
  color: #a78bfa;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.metaverse-list__message {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 40rpx;
}

.metaverse-list__actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.metaverse-list__action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 38rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.metaverse-list__action.primary {
  background: linear-gradient(90deg, #00d2ff, #8b5cf6);
  box-shadow: 0 12rpx 28rpx rgba(0, 210, 255, 0.28);
}

.metaverse-list__action.secondary {
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  background: rgba(255, 255, 255, 0.08);
}
