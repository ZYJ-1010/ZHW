<view class="page">
  <view class="realname-mask"></view>

  <view class="realname-sheet">
    <view class="realname-head">
      <text class="realname-title">实名认证</text>
    </view>

    <view class="realname-form">
      <view class="realname-row">
        <view class="realname-label realname-label--name">
          <text>真实姓名:</text>
        </view>
        <input
          class="realname-input"
          value="{{realname}}"
          placeholder="请输入真实姓名"
          placeholder-class="realname-placeholder"
          bindinput="onRealnameInput"
        />
      </view>

      <view class="realname-row">
        <text class="realname-label">身份证号:</text>
        <input
          class="realname-input"
          value="{{idNumber}}"
          type="idcard"
          maxlength="18"
          placeholder="请输入身份证号"
          placeholder-class="realname-placeholder"
          bindinput="onIdNumberInput"
        />
      </view>
    </view>

    <view class="realname-note">
      <text class="realname-note-line">说明:1.实名认证后可获得身份可信标识，并解锁完整组局、匹配与引荐能力。</text>
      <text class="realname-note-line">2.姓名和身份证号仅用于身份核验与安全风控，我们将遵循隐私协议保护你的信息。</text>
    </view>

    <view class="realname-submit enjoy-button enjoy-button--primary enjoy-button--comfortable" bindtap="completeRealname">
      {{isCompleting ? '提交中...' : '提交审核'}}
    </view>
  </view>
</view>
