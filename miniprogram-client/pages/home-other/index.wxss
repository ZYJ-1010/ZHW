@import "../home/master/index.wxss";

page {
  width: 100%;
  height: 100%;
  background: #efefef;
}

.home-other-apply-page {
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.home-other-save {
  grid-column: 3;
  justify-self: end;
  color: #a6a6ae;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: right;
}

.home-other-toolbar {
  position: relative;
  z-index: 6;
  display: grid;
  grid-template-columns: 176rpx 1fr 176rpx;
  align-items: center;
  flex: 0 0 auto;
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #000000;
}

.home-other-back {
  grid-column: 1;
  justify-self: start;
  min-width: 64rpx;
  height: 64rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 64rpx;
}

.home-other-toolbar .home-other-save {
  grid-column: 3;
  justify-self: end;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.home-other-toolbar-title {
  grid-column: 2;
  justify-self: center;
  max-width: 100%;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-other-toolbar.with-title {
  height: 94rpx;
}

.home-other-apply-page.passed .home-other-toolbar,
.home-other-apply-page.rejected .home-other-toolbar {
  grid-template-columns: 96rpx 1fr 96rpx;
  height: 72rpx;
  padding: 0 14rpx;
}

.home-other-apply-page.passed .home-other-back,
.home-other-apply-page.rejected .home-other-back {
  min-width: 48rpx;
  height: 48rpx;
  font-size: 34rpx;
  line-height: 48rpx;
}

.home-other-apply-page.passed .home-other-toolbar-title,
.home-other-apply-page.rejected .home-other-toolbar-title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.home-other-scroll {
  position: relative;
  z-index: 1;
}

.home-other-content {
  width: 100%;
  padding: 40rpx 30rpx 0;
  box-sizing: border-box;
}

.home-other-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.home-other-status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 178rpx;
  height: 178rpx;
  margin-bottom: 62rpx;
  border: 4rpx solid var(--theme);
  border-radius: 50%;
  box-sizing: border-box;
  color: #ffffff;
  background: rgba(14, 20, 25, 0.92);
  box-shadow: 0 0 54rpx var(--glow);
}

.home-other-status-image {
  display: block;
  width: 88rpx;
  height: 88rpx;
}

.home-other-status-emoji {
  display: block;
  width: 100%;
  font-size: 88rpx;
  line-height: 1;
  text-align: center;
}

.home-other-status-title {
  display: block;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 60rpx;
  text-align: center;
}

.home-other-status-subtitle {
  display: block;
  margin-top: 26rpx;
  color: var(--theme);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.home-other-desc {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 42rpx;
  color: #adb0ba;
  font-size: 24rpx;
  line-height: 34rpx;
}

.home-other-cert {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 82rpx;
  padding: 44rpx 24rpx;
  border: 2rpx solid var(--cert-border);
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #1f1f22;
}

.home-other-cert-label {
  color: #777982;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  line-height: 30rpx;
}

.home-other-cert-no {
  margin-top: 26rpx;
  color: var(--theme);
  font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
  font-size: 36rpx;
  font-weight: normal;
  line-height: 48rpx;
  letter-spacing: 1rpx;
  text-shadow: none;
}

.home-other-cert-time {
  margin-top: 22rpx;
  color: #5d6270;
  font-size: 21rpx;
  line-height: 28rpx;
}

.home-other-panel {
  width: 100%;
  max-width: 100%;
  margin-top: 40rpx;
  padding: 42rpx 40rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  background: #191c25;
}

.home-other-panel-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.home-other-panel-title.warn {
  color: #ff6745;
}

.home-other-panel-title.cyan {
  color: var(--theme);
}

.home-other-panel-title.crown .home-other-section-symbol {
  color: #ffd166;
}

.home-other-section-symbol {
  flex: 0 0 auto;
  color: #00d4ff;
  font-size: 34rpx;
  line-height: 40rpx;
}

.home-other-panel-icon,
.home-other-panel-symbol {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
}

.home-other-panel-symbol {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  line-height: 36rpx;
}

.home-other-warning-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.home-other-gift {
  display: grid;
  grid-template-columns: 72rpx 1fr auto;
  align-items: center;
  gap: 26rpx;
  margin-top: 48rpx;
}

.home-other-gift-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  color: #aeb6c7;
  background: #263142;
  font-size: 22rpx;
  font-weight: 900;
}

.home-other-gift-icon text {
  display: block;
  font-size: 22rpx;
  line-height: 1;
}

.home-other-gift-icon.traffic text,
.home-other-gift-icon.reward text {
  font-size: 34rpx;
}

.home-other-gift-text {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.home-other-gift-tag {
  min-width: 54rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 21rpx;
  line-height: 26rpx;
  text-align: center;
}

.home-other-gift-tag.limit {
  color: #ffd529;
  background: rgba(121, 93, 12, 0.78);
}

.home-other-gift-tag.traffic {
  color: #4ca1ff;
  background: rgba(28, 77, 133, 0.78);
}

.home-other-gift-tag.reward {
  color: #19d874;
  background: rgba(11, 94, 59, 0.82);
}

.home-other-action-grid {
  position: relative;
  z-index: 6;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32rpx;
  margin-top: 44rpx;
}

.home-other-action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 146rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #1e1e20;
}

.home-other-action-icon {
  width: 60rpx;
  height: 66rpx;
}

.home-other-action-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 66rpx;
  font-size: 42rpx;
  line-height: 1;
}

.home-other-action-text {
  margin-top: 26rpx;
  color: #bbbcc4;
  font-size: 22rpx;
  line-height: 30rpx;
}

.home-other-primary,
.home-other-footer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 50rpx;
  box-sizing: border-box;
  color: var(--primary-text);
  background: var(--button-bg);
  box-shadow: 0 12rpx 38rpx var(--button-glow);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-align: center;
}

.home-other-primary {
  position: relative;
  z-index: 6;
  margin-top: 90rpx;
}

.home-other-footer-buttons {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
  margin-top: 48rpx;
}

.home-other-footer-button.ghost {
  border: 2rpx solid #596579;
  color: #ffffff;
  background: transparent;
  box-shadow: none;
}

.home-other-footer-button.green {
  color: #ffffff;
  background: #08d47b;
  box-shadow: none;
}

.reject-reasons {
  margin-top: 62rpx;
  margin-bottom: 32rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 32rpx;
  width: 100%;
  max-width: 100%;
  min-height: 262rpx;
  border: 2rpx solid var(--reject-border, rgba(255, 107, 53, 0.2));
  border-radius: 32rpx;
  box-sizing: border-box;
  background: var(--reject-bg, rgba(255, 107, 53, 0.08));
}

.reject-reasons .home-other-panel-title {
  gap: 16rpx;
  margin-bottom: 24rpx;
  color: var(--theme);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.reject-reasons .home-other-list-line {
  margin-top: 24rpx;
  color: #e5e7eb;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.reject-reasons .home-other-list-line:first-of-type {
  margin-top: 0;
}

.suggestions,
.retry,
.details {
  background: #191b23;
}

.home-other-apply-page.rejected .suggestions,
.home-other-apply-page.rejected .retry,
.home-other-apply-page.rejected .details {
  margin-left: 0;
  margin-right: 0;
  width: 100%;
  max-width: 100%;
  border-radius: 26rpx;
  box-sizing: border-box;
}

.home-other-apply-page.rejected .retry {
  background: transparent;
}

.retry {
  border-left: 8rpx solid var(--theme);
}

.home-other-list-line {
  display: block;
  margin-top: 28rpx;
  color: #f1f2f7;
  font-size: 27rpx;
  line-height: 44rpx;
}

.home-other-note,
.home-other-card-text {
  display: block;
  margin-top: 18rpx;
  color: #7e8492;
  font-size: 22rpx;
  line-height: 34rpx;
}

.home-other-estimate {
  margin-top: 62rpx;
  padding: 36rpx;
  border: 2rpx solid var(--panel-border, rgba(0, 240, 255, 0.2));
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #dce3e9;
  background: var(--panel-bg, #071e1e);
  font-size: 25rpx;
  line-height: 42rpx;
}

.home-other-apply-page.pending .home-other-content {
  padding-top: 44rpx;
}

.home-other-apply-page.pending .home-other-status-icon {
  width: 172rpx;
  height: 172rpx;
  margin-bottom: 46rpx;
  background: var(--panel-bg, rgba(0, 54, 54, 0.9));
}

.home-other-apply-page.pending .home-other-status-image {
  width: 96rpx;
  height: 96rpx;
}

.home-other-apply-page.pending .home-other-status-title {
  font-size: 46rpx;
  line-height: 58rpx;
}

.home-other-apply-page.pending .home-other-status-subtitle {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 38rpx;
}

.home-other-apply-page.pending .home-other-desc {
  margin-top: 14rpx;
  color: #666666;
}

.home-other-apply-page.pending .home-other-estimate {
  margin-top: 42rpx;
}

.home-other-timeline {
  position: relative;
  margin-top: 64rpx;
}

.home-other-timeline-item {
  position: relative;
  display: flex;
  gap: 34rpx;
  padding-bottom: 58rpx;
}

.home-other-timeline-item::before {
  position: absolute;
  top: 32rpx;
  bottom: -8rpx;
  left: 16rpx;
  width: 2rpx;
  background: #31333a;
  content: "";
}

.home-other-timeline-item:last-child::before {
  display: none;
}

.home-other-timeline-dot {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: #374151;
}

.home-other-timeline-item.done .home-other-timeline-dot {
  background: #16c994;
  box-shadow: 0 0 22rpx rgba(22, 201, 148, 0.55);
}

.home-other-timeline-item.active .home-other-timeline-dot {
  background: var(--theme);
  box-shadow: 0 0 22rpx var(--glow);
}

.home-other-timeline-body {
  flex: 1;
  min-width: 0;
}

.home-other-timeline-card {
  flex: 1;
  min-width: 0;
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #151724;
}

.home-other-timeline-item.active .home-other-timeline-card {
  border-color: var(--panel-border, rgba(0, 209, 229, 0.45));
}

.home-other-timeline.cards {
  margin-top: 58rpx;
}

.home-other-timeline.cards .home-other-timeline-item {
  gap: 40rpx;
  padding-bottom: 58rpx;
}

.home-other-timeline.cards .home-other-timeline-item::before {
  top: 38rpx;
  bottom: -10rpx;
  left: 18rpx;
  width: 2rpx;
  background: rgba(87, 96, 112, 0.55);
}

.home-other-timeline.cards .home-other-timeline-dot {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
}

.home-other-timeline.cards .home-other-timeline-item.done .home-other-timeline-dot {
  background: #35d2a1;
  box-shadow: 0 0 28rpx rgba(53, 210, 161, 0.58);
}

.home-other-timeline.cards .home-other-timeline-item.active .home-other-timeline-dot {
  background: var(--theme);
  box-shadow: 0 0 30rpx var(--glow);
}

.home-other-timeline.cards .home-other-timeline-item.todo .home-other-timeline-dot {
  background: #384252;
  box-shadow: none;
}

.home-other-timeline.cards .home-other-timeline-card {
  min-height: 170rpx;
  padding: 30rpx 34rpx;
  border-color: rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
  background: #151724;
}

.home-other-timeline.cards .home-other-timeline-item.done .home-other-timeline-card {
  border-color: rgba(255, 255, 255, 0.06);
}

.home-other-timeline.cards .home-other-timeline-item.active .home-other-timeline-card {
  border-color: var(--theme);
  background: var(--panel-bg, rgba(17, 32, 40, 0.92));
}

.home-other-timeline.cards .home-other-timeline-item.todo .home-other-timeline-card {
  border-color: rgba(255, 255, 255, 0.04);
  background: #151724;
}

.home-other-timeline.cards .home-other-timeline-item.todo .home-other-timeline-title {
  color: #ffffff;
}

.home-other-timeline.cards .home-other-timeline-item.todo .home-other-timeline-text,
.home-other-timeline.cards .home-other-timeline-item.todo .home-other-timeline-time {
  color: #6f7581;
}

.home-other-timeline-title {
  display: block;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.home-other-timeline-item.active .home-other-timeline-title {
  color: var(--theme);
}

.home-other-timeline-text {
  display: block;
  margin-top: 12rpx;
  color: #a9aeb7;
  font-size: 22rpx;
  line-height: 34rpx;
}

.home-other-timeline-time {
  display: block;
  margin-top: 10rpx;
  color: #686d78;
  font-size: 20rpx;
  line-height: 28rpx;
}

.home-other-progress {
  margin-top: 64rpx;
}

.home-other-progress-bar {
  width: 100%;
  height: 9rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #2e2f36;
}

.home-other-progress-bar view {
  width: 60%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #16c994 0%, var(--theme) 100%);
}

.home-other-progress-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: #9ca0ab;
  font-size: 21rpx;
  line-height: 30rpx;
}

.home-other-section-title {
  margin-top: 62rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.home-other-detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
  color: #b5bac3;
  font-size: 24rpx;
  line-height: 34rpx;
}

.home-other-detail-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.home-other-detail-row text:last-child {
  color: #ffffff;
  text-align: right;
}

.home-other-detail-row text.accent {
  color: var(--theme);
  font-weight: 800;
}

.home-other-detail-row text.cyan {
  color: var(--theme);
  font-weight: 800;
}

.home-other-apply-page.cards .details {
  margin-top: 56rpx;
  padding: 34rpx 36rpx 0;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #111827;
  overflow: hidden;
}

.home-other-apply-page.cards .details .home-other-panel-title {
  margin-bottom: 18rpx;
}

.home-other-apply-page.cards .details .home-other-section-symbol {
  color: #ffffff;
  font-size: 34rpx;
}

.home-other-apply-page.cards .home-other-detail-row {
  min-height: 86rpx;
  padding: 24rpx 0;
  box-sizing: border-box;
  border-bottom-color: rgba(255, 255, 255, 0.07);
}

.home-other-apply-page.cards .home-other-detail-row:last-child {
  padding-bottom: 24rpx;
}

.home-other-helper {
  display: block;
  margin-top: 48rpx;
  color: #8d919a;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.home-other-guide-form-panel {
  width: 100%;
  margin: 46rpx auto 0;
  padding: 30rpx 28rpx 32rpx;
  border: 0;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #141926;
}

.home-other-guide-form-panel.secondary {
  margin-top: 48rpx;
}

.home-other-guide-form-panel.requirements {
  margin-top: 0;
  padding: 30rpx 0 0;
  overflow: hidden;
}

.home-other-guide-form-panel.perks {
  margin-top: 48rpx;
}

.home-other-guide-panel-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 28rpx;
  margin-bottom: 22rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.home-other-guide-panel-title.crown {
  padding: 0;
}

.home-other-guide-requirement {
  display: grid;
  grid-template-columns: 44rpx 1fr;
  gap: 16rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 18rpx 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
}

.home-other-guide-plan-row {
  display: grid;
  grid-template-columns: 44rpx 1fr auto;
  gap: 16rpx;
  align-items: center;
  min-height: 96rpx;
  padding: 22rpx 28rpx 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
}

.home-other-guide-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 50%;
  box-sizing: border-box;
  color: rgba(255, 255, 255, 0.36);
  background: transparent;
  font-size: 22rpx;
  line-height: 28rpx;
}

.home-other-guide-requirement.done .home-other-guide-check {
  border-color: rgba(0, 230, 118, 0.28);
  color: #00e676;
  background: rgba(0, 230, 118, 0.16);
}

.home-other-guide-requirement.pending .home-other-guide-check {
  border-color: rgba(255, 107, 107, 0.3);
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.12);
}

.home-other-guide-plan-row.pending .home-other-guide-check {
  border-color: rgba(255, 255, 255, 0.28);
  color: transparent;
  background: transparent;
}

.home-other-guide-requirement-body {
  min-width: 0;
}

.home-other-guide-requirement-title {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.home-other-guide-requirement-text {
  display: block;
  margin-top: 8rpx;
