<view class="player-manage-page">
  <view class="manage-frame" style="{{shellLayout.frameStyle}}">
    <view class="manage-nav">
      <view class="manage-back" style="{{shellLayout.backStyle}}" bindtap="onBackTap">
        <view class="manage-back-icon"></view>
      </view>
      <text class="manage-title" style="{{shellLayout.titleStyle}}">我的组局管理</text>
    </view>

    <scroll-view
      class="manage-content"
      style="{{shellLayout.contentStyle}}"
      scroll-y
      enhanced
      show-scrollbar="false"
    >
      <view class="manage-inner">
        <game-role-switch current-role="player" />
        <view class="summary-card">
          <view class="summary-main">
            <view class="summary-copy">
              <text class="summary-label">{{summary.label}}</text>
              <text class="summary-amount">{{summary.amount}}</text>
            </view>
            <view class="summary-icon">
              <view class="summary-icon-mark"></view>
            </view>
          </view>
          <view class="summary-stats">
            <text wx:for="{{summary.stats}}" wx:key="text" class="summary-stat">{{item.text}}</text>
          </view>
        </view>

        <view class="manage-tabs">
          <view
            wx:for="{{tabs}}"
            wx:key="key"
            class="manage-tab {{item.active ? 'active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onTabTap"
          >
            <text>{{item.text}}</text>
          </view>
        </view>

        <view
          wx:for="{{displayOrders}}"
          wx:key="id"
          class="order-card {{item.cardClass}}"
        >
          <view class="order-header">
            <view class="status-pill {{item.statusClass}}">
              <image
                wx:if="{{item.statusType === 'complete'}}"
                class="status-icon"
                src="./assets/status-complete-check.svg"
                mode="aspectFit"
              ></image>
              <image
                wx:elif="{{item.statusType === 'canceled'}}"
                class="status-icon"
                src="./assets/status-cancel-x.svg"
                mode="aspectFit"
              ></image>
              <view wx:else class="status-dot {{item.statusClass}}"></view>
              <text>{{item.statusText}}</text>
            </view>
            <text class="order-ref">{{item.ref}}</text>
          </view>

          <view class="expert-row">
            <view class="expert-avatar {{item.avatarClass}}">{{item.avatar}}</view>
            <view class="expert-copy">
              <text class="expert-name {{item.muted ? 'muted' : ''}}">{{item.name}}</text>
              <view class="service-line">
                <text class="service-title">{{item.title}}</text>
                <text wx:if="{{item.amount}}" class="service-separator">·</text>
                <text wx:if="{{item.amount}}" class="service-amount">{{item.amount}}</text>
              </view>
              <text wx:if="{{item.guideText}}" class="guide-text">{{item.guideText}}</text>
            </view>
          </view>

          <block wx:if="{{item.statusType === 'active'}}">
            <view class="progress-panel">
              <view class="progress-heading">
                <text>服务进度</text>
                <text>{{item.progressText}}</text>
              </view>
              <view class="progress-track">
                <view class="progress-fill" style="{{item.progressStyle}}"></view>
              </view>
              <text class="delivery-text">{{item.deliveryText}}</text>
              <view class="progress-days">
                <text>{{item.elapsedText}}</text>
                <text>{{item.remainingText}}</text>
              </view>
            </view>

            <view class="action-row">
              <button class="order-action contact {{item.canContactExpert ? '' : 'disabled'}}" data-id="{{item.id}}" disabled="{{!item.canContactExpert}}" hover-class="none" bindtap="onContactExpert">
                <image class="action-icon" src="./assets/action-contact-chat.svg" mode="aspectFit"></image>
                <text>{{item.primaryActionText}}</text>
              </button>
              <button class="order-action cancel {{item.canCancelOrder ? '' : 'disabled'}}" data-id="{{item.id}}" disabled="{{!item.canCancelOrder}}" hover-class="none" bindtap="onCancelOrder">
                <image class="action-icon" src="./assets/action-cancel-hand.svg" mode="aspectFit"></image>
                <text>{{item.secondaryActionText}}</text>
              </button>
            </view>

            <view wx:if="{{item.noticeText}}" class="notice-row">
              <image class="notice-icon" src="./assets/notice-warning.svg" mode="aspectFit"></image>
              <text>{{item.noticeText}}</text>
            </view>
          </block>

          <block wx:elif="{{item.statusType === 'complete'}}">
            <view class="completed-panel">
              <view class="completed-top">
                <text>{{item.completeSummary}}</text>
                <text class="completed-amount">{{item.amount}}</text>
              </view>
              <view class="completed-info">
                <view wx:for="{{item.completedRows}}" wx:key="label" class="completed-info-row">
                  <text class="completed-info-label">{{item.label}}</text>
                  <text class="completed-info-value">{{item.value}}</text>
                </view>
              </view>
              <view class="completed-result">
                <image class="completed-check" src="./assets/status-complete-check.svg" mode="aspectFit"></image>
                <text>{{item.resultText}}</text>
              </view>
            </view>
            <button
              class="review-action {{item.reviewDisabled ? 'disabled' : ''}}"
              data-id="{{item.id}}"
              disabled="{{item.reviewDisabled}}"
              hover-class="none"
              bindtap="onReviewBoth"
            >
              <text>{{item.reviewActionText}}</text>
            </button>
          </block>

          <block wx:elif="{{item.statusType === 'canceled'}}">
            <view class="refund-panel">
              <view class="refund-top">
                <text>{{item.reasonSummary}}</text>
                <text class="refund-amount">{{item.amount}}</text>
              </view>
              <text class="refund-reason">{{item.reasonText}}</text>
            </view>
          </block>
        </view>

        <view wx:if="{{!hasDisplayOrders}}" class="manage-empty">
          <text>{{emptyText}}</text>
        </view>
        <view wx:if="{{total > pageSize}}" class="manage-pagination">
          <button disabled="{{!hasPrevious}}" bindtap="onPreviousPage">上一页</button>
          <text>第 {{page}} 页</text>
          <button disabled="{{!hasMore}}" bindtap="onNextPage">下一页</button>
        </view>
      </view>
    </scroll-view>

    <view class="manage-bottom-bg" style="{{shellLayout.bottomStyle}}"></view>
  </view>
</view>
