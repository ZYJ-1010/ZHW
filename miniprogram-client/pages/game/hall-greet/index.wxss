page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.hall-greet-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #1f2937;
  font-family: "PingFang SC", "Noto Sans SC", sans-serif;
}

.hall-greet-stage {
  width: 750rpx;
  height: 100vh;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  box-sizing: border-box;
}

.hall-greet-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
}

.white-top-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 0;
  height: 160rpx;
  background: #ffffff;
}

.white-nav {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 6;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.nav-button {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.nav-button::after,
.quick-action::after {
  border: 0;
}

.nav-button--active {
  background: #f3f4f6;
}

.chevron-left {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.phone-panel {
  position: absolute;
  z-index: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f3f4f6;
  color: #1f2937;
  box-sizing: border-box;
}

.chat-area {
  flex: 1;
  min-height: 0;
  width: 100%;
  background: #f3f4f6;
  box-sizing: border-box;
}

.chat-empty-space {
  width: 100%;
  min-height: 820rpx;
}

.sent-message-list {
  padding: 0 34rpx 28rpx;
  box-sizing: border-box;
}

.sent-message {
  width: fit-content;
  max-width: 500rpx;
  margin: 0 0 20rpx auto;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: #95ec69;
  box-sizing: border-box;
}

.sent-message text {
  display: block;
  color: #111827;
  font-size: 28rpx;
  line-height: 40rpx;
  word-break: break-all;
}

.quick-action-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex: none;
  justify-content: space-between;
  gap: 8rpx;
  width: 100%;
  height: 76rpx;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  background: #f3f4f6;
}

.quick-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-width: 0;
  height: 56rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: rgba(229, 231, 235, 0.86);
  color: #1f2937;
  font-size: 23rpx;
  line-height: 56rpx;
  white-space: nowrap;
}

.quick-action--active {
  background: rgba(209, 213, 219, 0.95);
}

.quick-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 7rpx;
}

.input-wrap {
  position: relative;
  z-index: 2;
  flex: none;
  width: 100%;
  padding: 0 0 12rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 38rpx 38rpx 0 0;
}

.source-chat-bar {
  position: relative;
  width: 704rpx;
  max-width: calc(100% - 52rpx);
  height: 92rpx;
  margin: 24rpx auto 0;
  padding: 0;
  border-radius: 46rpx;
  box-sizing: border-box;
  background: #e5e5e5;
}

.source-message-field {
  position: absolute;
  left: 32rpx;
  right: 220rpx;
  top: 0;
  height: 92rpx;
  overflow: hidden;
}

.source-message-field text {
  display: block;
  color: #a7a7a7;
  font-size: 30rpx;
  line-height: 92rpx;
  white-space: nowrap;
}

.source-tool-group {
  position: absolute;
  right: 20rpx;
  top: 17rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 190rpx;
  height: 58rpx;
}

.source-input-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 0 0 8rpx;
  padding: 0;
  border-radius: 50%;
  background: transparent;
}

.source-input-tool::after {
  border: 0;
}

.source-input-tool--active {
  background: rgba(209, 213, 219, 0.72);
}

.source-input-tool image {
  width: 46rpx;
  height: 46rpx;
}

.source-send-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 54rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: #22c55e;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.white-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}
