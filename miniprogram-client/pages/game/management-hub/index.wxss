page { background: #07111d; color: #fff; min-height: 100%; }
.page { min-height: 100vh; padding-bottom: 40rpx; }
.custom-nav { position:relative; width:100%; background:#fff; box-sizing:border-box; }
.nav-title { position:absolute; left:50%; width:300rpx; transform:translateX(-50%); color:#111827; font-size:32rpx; font-weight:600; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.nav-back { position:absolute; left:32rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#f1f3f5; }
.nav-back image { width:30rpx; height:30rpx; }
.tabs,.status-tabs { white-space:nowrap; box-sizing:border-box; padding:28rpx 24rpx 8rpx; }
.role-summary { padding:20rpx 24rpx 4rpx; }
.status-tabs { padding-top:12rpx; padding-bottom:18rpx; }
.tab,.status-tab { display:inline-flex; padding:14rpx 32rpx; margin-right:14rpx; border-radius:34rpx; background:#152231; color:#9fb0c2; font-size:26rpx; }
.tab.active { background:#1685f5; color:#fff; }
.status-tab { padding:11rpx 24rpx; font-size:24rpx; }
.status-tab.active { color:#19d8ff; border:1rpx solid #19d8ff; }
.list { padding:0 24rpx; }
.card { padding:26rpx; margin-bottom:18rpx; background:#111c29; border:1rpx solid #243449; border-left:6rpx solid #1685f5; border-radius:18rpx; }
.card.guide { border-left-color:#ff9d38; }.card.player { border-left-color:#9b6cff; }
.card.complete { border-left-color:#37c987; }.card.cancelled { border-left-color:#788696; opacity:.88; }
.card-head,.card-foot { display:flex; align-items:center; }
.role { padding:6rpx 18rpx; border-radius:22rpx; font-size:22rpx; }
.role.blue { background:#123f70; color:#5fc3ff; }.role.orange { background:#593619; color:#ffb35f; }.role.purple { background:#38265f; color:#c29aff; }
.status { margin-left:auto; color:#7fdcff; font-size:24rpx; }
.title { display:block; font-size:30rpx; font-weight:600; }
.meta,.card-foot { color:#8fa1b5; font-size:24rpx; }
.card-foot { margin-top:18rpx; border-top:1rpx solid #243449; padding-top:16rpx; }
.service-row { display:flex; align-items:center; margin:24rpx 0 18rpx; }.amount { margin-left:auto; color:#ff8d42; font-weight:700; }.arrow { font-size:38rpx; margin-left:auto; }
.people-row { display:flex; align-items:center; justify-content:space-between; margin-top:26rpx; padding:18rpx 12rpx; background:#0d1723; border-radius:16rpx; }
.person { width:160rpx; display:flex; flex-direction:column; align-items:center; gap:8rpx; font-size:25rpx; }.avatar { width:76rpx; height:76rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:27rpx; }.avatar.expert { background:#2388ef; }.avatar.player { background:#df468f; }.identity { padding:3rpx 14rpx; border-radius:16rpx; color:#52adff; background:#12385d; font-size:20rpx; }.identity.player { color:#ff9ac8; background:#4b2039; }
.relation { display:flex; flex-direction:column; align-items:center; color:#ffc94d; font-size:22rpx; }.relation-line { height:34rpx; width:2rpx; background:#ffc94d; margin:5rpx; }
.single-person { display:flex; align-items:center; gap:18rpx; margin-top:24rpx; padding:18rpx; background:#0d1723; border-radius:16rpx; }.single-person view:last-child { display:flex; flex-direction:column; gap:9rpx; }.person-name { font-size:28rpx; }
.actions { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }.action { padding:19rpx 10rpx; border-radius:13rpx; text-align:center; font-size:25rpx; }.action.primary { color:#1484ed; background:#e8f3ff; }.action.secondary { color:#c2cad4; background:#273341; }
.result,.notice { margin-top:14rpx; padding:18rpx; border-radius:12rpx; font-size:24rpx; }.complete-result { color:#37c987; background:#123528; }.review-result { color:#ffca52; background:#3a3016; }.cancel-result { color:#aab3bd; background:#28313a; }.notice { color:#d29b43; background:#332b19; }
.empty { padding:120rpx 30rpx; text-align:center; color:#8495a8; }.error { color:#ff7d7d; }
