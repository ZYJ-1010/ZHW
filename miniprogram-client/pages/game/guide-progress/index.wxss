page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.guide-progress-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.guide-progress-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.guide-progress-top-bg,
.guide-progress-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.guide-progress-top-bg {
  z-index: 0;
}

.guide-progress-nav {
  z-index: 4;
  box-sizing: border-box;
}

.guide-progress-title {
  position: absolute;
  left: 294rpx;
  width: 156rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-progress-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.guide-progress-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.guide-progress-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f9fafb;
  color: #101010;
  box-sizing: border-box;
}

.guide-progress-inner {
  min-height: 100%;
  padding: 30rpx 32rpx 40rpx;
  box-sizing: border-box;
  background: #f9fafb;
}

.guide-progress-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.section-heading {
  display: flex;
  align-items: center;
  height: 32rpx;
  margin-left: 2rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
  letter-spacing: 1rpx;
}

.section-heading.active {
  color: #ea580c;
}

.section-heading.recent {
  margin-top: 24rpx;
  color: #9ca3af;
}

.section-heading-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.guide-progress-state,
.guide-progress-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 36rpx;
}

.guide-progress-state {
  flex-direction: column;
  min-height: 300rpx;
}

.guide-progress-state.error {
  color: #c2410c;
}

.guide-progress-state-action {
  margin-top: 12rpx;
  color: #f97316;
  font-size: 24rpx;
}
