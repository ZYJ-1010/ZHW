page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}
.manage-pagination { display:flex; align-items:center; justify-content:center; gap:18rpx; padding:28rpx 20rpx 44rpx; color:#64748b; font-size:24rpx; }
.manage-pagination button { width:150rpx; margin:0; padding:12rpx 18rpx; border-radius:28rpx; background:#e8f2ff; color:#1677df; font-size:24rpx; line-height:32rpx; }
.manage-pagination button[disabled] { background:#eef1f4; color:#aeb7c2; }
.manage-pagination button::after { border:0; }

.manage-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.manage-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.manage-top-bg,
.manage-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.manage-top-bg {
  z-index: 0;
}

.manage-nav {
  z-index: 4;
  box-sizing: border-box;
}

.manage-title {
  position: absolute;
  left: 248rpx;
  width: 254rpx;
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.manage-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.operation-action::after,
.contact-action::after,
.review-action::after {
  border: 0;
}

.manage-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  color: #111827;
  box-sizing: border-box;
}

.manage-inner {
  min-height: 100%;
  padding: 0 0 58rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.manage-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.manage-summary-card {
  width: 750rpx;
  height: 220rpx;
  padding: 34rpx 40rpx 28rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #4a7afa 0%, #295af2 100%);
  color: #ffffff;
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.summary-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 36rpx;
}

.summary-amount {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.summary-chart-icon {
  position: relative;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.summary-chart-line {
  position: absolute;
  left: 19rpx;
  top: 20rpx;
  width: 34rpx;
  height: 28rpx;
}

.summary-chart-line::before {
  position: absolute;
  left: 0;
  bottom: 2rpx;
  width: 36rpx;
  height: 22rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  border-radius: 0 0 0 4rpx;
  content: '';
}

.summary-chart-line::after {
  position: absolute;
  left: 6rpx;
  top: 12rpx;
  width: 28rpx;
  height: 16rpx;
  border-top: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  transform: skewY(-24deg);
  content: '';
}

.summary-stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.summary-stat {
  margin-right: 38rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.manage-tabs {
  display: flex;
  align-items: center;
  width: 750rpx;
  height: 92rpx;
  padding: 0 20rpx;
  border-bottom: 2rpx solid #f3f4f6;
  background: #ffffff;
  box-sizing: border-box;
}

.manage-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  white-space: nowrap;
}

.manage-tab.active {
  color: #2563eb;
  font-weight: 700;
}

.manage-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 96rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #2563eb;
  transform: translateX(-50%);
  content: '';
}

.manage-order-card {
  padding: 30rpx 30rpx 32rpx;
  box-sizing: border-box;
  border: 2rpx solid #f8fafc;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.04);
}

.active-card {
  width: 684rpx;
  height: auto;
  min-height: 500rpx;
  margin: 32rpx 0 0 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.early-card {
  width: 686rpx;
  min-height: 416rpx;
  margin: 32rpx auto 0;
  border-left: 8rpx solid #4ade80;
  border-color: #dcfce7;
}

.completed-card,
.canceled-card {
  width: 686rpx;
  min-height: 404rpx;
  margin: 32rpx auto 0;
}

.completed-card {
  border-color: #bfdbfe;
}

.completed-card.early-card {
  border-left: 8rpx solid #4ade80;
  border-color: #dcfce7;
}

.order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.status-pill.active {
  width: 210rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 40rpx;
  color: #2563eb;
  background: #dbeafe;
}

.status-pill.complete {
  color: #15803d;
  background: #f0fdf4;
}

.status-pill.canceled {
  color: #b91c1c;
  background: #fef2f2;
}

.status-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #3b82f6;
}

.status-dot.complete {
  background: #22c55e;
}

.status-dot.canceled {
  background: #ef4444;
}

.status-icon {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
}

.order-ref {
  max-width: 260rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.client-row {
  display: flex;
  align-items: flex-start;
  margin-top: 34rpx;
}

.client-row.compact {
  margin-top: 30rpx;
}

.avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.avatar.pink {
  background: #ec4899;
}

.avatar.purple {
  background: #a855f7;
}

.avatar.green {
  background: #22c55e;
}

.avatar.blue {
  background: #3b82f6;
}

.client-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 24rpx;
}

.client-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.client-name {
  max-width: 300rpx;
  overflow: hidden;
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.client-name.muted {
  color: #4b5563;
}

.client-role-tag {
  flex: none;
  margin-left: 14rpx;
  padding: 2rpx 10rpx;
  border: 2rpx solid #fce7f3;
  border-radius: 8rpx;
  color: #ec4899;
  background: #fdf2f8;
  font-size: 20rpx;
  line-height: 28rpx;
}

.client-service-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 36rpx;
}

.client-service {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.client-amount {
  flex: none;
  color: #4b5563;
}

.client-separator {
  flex: none;
  margin: 0 12rpx;
  color: #6b7280;
}

.client-guide {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 32rpx;
}

.client-guide.success {
  color: #16a34a;
}

.timeline-panel {
  margin: 48rpx 0 36rpx;
  padding-left: 4rpx;
  box-sizing: border-box;
}

.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 104rpx;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.timeline-item.last {
  min-height: 44rpx;
  padding-bottom: 0;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border: 4rpx solid #d1d5db;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ffffff;
}

.timeline-dot::after {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d1d5db;
  content: '';
}

.timeline-dot.done {
  border-color: #34c38f;
}

.timeline-dot.done::after {
  background: #34c38f;
}

.timeline-dot.current {
  width: 28rpx;
  height: 28rpx;
  margin: 8rpx 6rpx 0;
  border: 0;
  background: #2585f5;
}

.timeline-dot.current::after {
  display: none;
}

.timeline-dot.future {
  border-color: #d1d5db;
}

.timeline-dot.future::after {
  background: #e5e7eb;
}

.timeline-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 22rpx;
}

.timeline-title {
  color: #374151;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.timeline-item.current .timeline-title {
  color: #2563eb;
}

.timeline-item.future .timeline-title {
  color: #9ca3af;
}

.timeline-time {
  margin-top: 2rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
}

.operation-group {
  width: 618rpx;
  margin-top: 34rpx;
  padding: 20rpx 26rpx 18rpx;
  border-radius: 24rpx;
  background: #f9fafb;
  box-sizing: border-box;
}

.operation-label {
  display: block;
  margin-bottom: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
}

.operation-row,
.contact-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
}

.operation-action,
.contact-action,
.review-action {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  min-width: 0;
  padding: 0 8rpx;
  border: 0;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
  white-space: nowrap;
}

.operation-action {
  justify-content: flex-start;
  width: 276rpx;
  min-width: 276rpx;
  max-width: 276rpx;
  height: 64rpx;
  padding: 0 16rpx 0 24rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
}

.operation-action.finish {
  margin-right: 14rpx;
}

.action-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operation-action.finish {
  color: #15803d;
  border-color: #dcfce7;
  background: #f0fdf4;
}

.operation-action.cancel {
  color: #dc2626;
  border-color: #ffe4e6;
  background: #fff1f2;
}

.operation-icon,
.contact-icon,
.action-icon-image,
.review-icon {
  display: block;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.contact-icon-image {
  display: block;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.action-icon-text {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.action-icon-text.finish {
  background: #22c55e;
}

.action-icon-text.cancel {
  background: #ef4444;
}

.action-icon-text.contact {
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: 26rpx;
  line-height: 28rpx;
}

.contact-row {
  width: 100%;
  margin: 14rpx 0 0;
  padding-top: 0;
  border-top: 0;
}

.contact-action {
  justify-content: flex-start;
  width: 276rpx;
  min-width: 276rpx;
  max-width: 276rpx;
  height: 64rpx;
  padding: 0 16rpx 0 24rpx;
  border-radius: 16rpx;
}

.contact-action.player {
  margin-right: 14rpx;
}

.contact-action.player {
  color: #2563eb;
  background: #eff6ff;
}

.contact-action.guide {
  color: #374151;
  background: #f3f4f6;
}

.settlement-panel {
  margin-top: 26rpx;
  padding: 22rpx 26rpx;
  border: 0;
  border-radius: 22rpx;
  background: #f0fdf4;
}

.settlement-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 40rpx;
}

.settlement-row + .settlement-row {
  margin-top: 12rpx;
}

.settlement-label {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 36rpx;
}

.settlement-value {
  max-width: 360rpx;
  overflow: hidden;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settlement-value.highlight {
  color: #16a34a;
  font-weight: 800;
}

.review-action {
  width: 460rpx;
  height: 58rpx;
  margin: 18rpx auto 0;
  border-radius: 10rpx;
  color: #b45309;
  background: #fef3c7;
}

.review-action.disabled {
  color: #9ca3af;
  background: #f3f4f6;
}

.review-action.disabled .review-icon {
  opacity: .45;
}

.completed-panel,
.refund-panel {
  margin-top: 26rpx;
  padding: 26rpx 30rpx;
  border-radius: 16rpx;
}

.completed-panel {
  border: 2rpx solid #bbf7d0;
  color: #047857;
  background: #ecfdf5;
}

.refund-panel {
  border: 2rpx solid #fee2e2;
  color: #b91c1c;
  background: #fef2f2;
}

.completed-top,
.refund-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 38rpx;
}

.completed-amount,
.refund-amount {
  font-weight: 800;
}

.completed-time,
.refund-reason {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
}

.completed-result {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #047857;
  font-size: 24rpx;
  line-height: 32rpx;
}

.completed-check {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #10b981;
}

.completed-check::after {
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(42deg);
  content: '';
}

.manage-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 686rpx;
  height: 180rpx;
  margin: 32rpx auto 0;
  border-radius: 24rpx;
  color: #9ca3af;
  font-size: 26rpx;
  background: #ffffff;
}
