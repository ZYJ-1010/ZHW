page {
  width: 100%;
  height: 100%;
  background: #f7f8fa;
}
.record-pagination { display:flex; align-items:center; justify-content:center; gap:18rpx; padding:28rpx 20rpx 44rpx; color:#64748b; font-size:24rpx; }
.record-pagination button { width:150rpx; margin:0; padding:12rpx 18rpx; border-radius:28rpx; background:#fff0df; color:#e87921; font-size:24rpx; line-height:32rpx; }
.record-pagination button[disabled] { background:#eef1f4; color:#aeb7c2; }
.record-pagination button::after { border:0; }

.referral-record-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f7f8fa;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.referral-record-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #f7f8fa;
  box-sizing: border-box;
}

.referral-record-top-bg,
.referral-record-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.referral-record-top-bg {
  z-index: 0;
}

.referral-record-nav {
  z-index: 4;
  box-sizing: border-box;
}

.referral-record-title {
  position: absolute;
  left: 240rpx;
  width: 270rpx;
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.referral-record-back {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}

.referral-record-back {
  left: 32rpx;
}

.referral-record-back-icon {
  display: block;
  width: 18rpx;
  height: 28rpx;
}

.referral-record-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  color: #111827;
  box-sizing: border-box;
}

.referral-record-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.tab-bar {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  height: 92rpx;
  border-bottom: 2rpx solid #f3f4f6;
  background: #ffffff;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: #6b7280;
  font-size: 30rpx;
  line-height: 42rpx;
}

.tab-item.active {
  color: #3b82f6;
  font-weight: 500;
}

.tab-item.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 88rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  content: "";
  transform: translateX(-50%);
}

.record-list {
  padding: 44rpx 34rpx 40rpx;
  box-sizing: border-box;
}

.record-card {
  position: relative;
  width: 684rpx;
  height: 608rpx;
  margin: 0 auto 32rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.record-card.review-needed {
  border: 2rpx solid #fde68a;
}

.record-meta-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  height: 36rpx;
  margin-bottom: 32rpx;
}

.record-meta-row.compact {
  margin-bottom: 24rpx;
}

.state-pill,
.extra-tag {
  flex: none;
  display: flex;
  align-items: center;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 36rpx;
}

.state-pill.blue {
  color: #3b82f6;
  background: #eff6ff;
}

.state-pill.green {
  color: #16a34a;
  background: #f0fdf4;
}

.state-pill.gray {
  color: #6b7280;
  background: #f3f4f6;
}

.extra-tag {
  margin-left: 14rpx;
  color: #ef4444;
  background: #fef2f2;
}

.state-icon {
  display: block;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
}

.record-id {
  position: absolute;
  left: 50%;
  top: 50%;
  max-width: 280rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translate(-50%, -50%);
}

.record-time {
  flex: none;
  margin-left: auto;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 32rpx;
}

.record-time {
  margin-left: 16rpx;
}

.record-time,
.extra-tag {
  margin-left: auto;
}

.relation-panel {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding: 28rpx 36rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  box-sizing: border-box;
}

.relation-line {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 86rpx;
  height: 0;
  border-top: 2rpx dashed #d1d5db;
}

.person-node,
.match-node {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 110rpx;
  padding: 0 10rpx;
  background: #f9fafb;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
}

.avatar.blue {
  background: #3b82f6;
}

.avatar.pink {
  background: #ec4899;
}

.avatar.green {
  background: #10b981;
}

.avatar.purple {
  background: #8b5cf6;
}

.avatar.gray {
  background: #9ca3af;
}

.person-name {
  margin-top: 8rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.role-tag {
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.role-tag.expert {
  color: #2563eb;
  background: #dbeafe;
}

.role-tag.player {
  color: #db2777;
  background: #fce7f3;
}

.match-icon {
  display: block;
  width: 54rpx;
  height: 40rpx;
}

.match-complete-check {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.match-guide-line {
  width: 4rpx;
  height: 48rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #fde68a;
}

.record-card.state-completed .match-guide-line {
  background: #22c55e;
}

.match-label {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 28rpx;
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  margin-bottom: 28rpx;
}

.service-title {
  overflow: hidden;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reward-value {
  flex: none;
  margin-left: 20rpx;
  min-width: 92rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-align: right;
}

.reward-value.orange {
  color: #f97316;
}

.reward-value.green {
  color: #16a34a;
}

.reward-value.gray {
  color: #6b7280;
}

.record-card.state-processing .reward-value {
  color: #f97316;
}

.record-card.state-completed .reward-value {
  color: #16a34a;
}

.record-card.state-canceled .reward-value {
  color: #6b7280;
}

.record-card.state-canceled {
  height: auto;
  min-height: 212rpx;
  padding: 30rpx 28rpx 26rpx;
  border: 2rpx solid #dbeafe;
  border-radius: 0;
  box-shadow: none;
}

.cancel-record-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  height: 40rpx;
}

.cancel-record-id {
  position: static;
  flex: none;
  max-width: 310rpx;
  color: #b6beca;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: right;
  transform: none;
}

.cancel-record-party {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 22rpx;
}

.cancel-avatar {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  font-size: 24rpx;
  line-height: 58rpx;
}

.cancel-party-name {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  overflow: hidden;
  color: #7b8493;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cancel-reason-line {
  display: block;
  margin-top: 18rpx;
  overflow: hidden;
  color: #98a1af;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card.state-canceled .state-pill {
  height: 40rpx;
  padding: 0 18rpx;
  color: #7b8493;
  background: #f4f5f7;
  font-size: 24rpx;
  line-height: 40rpx;
}

.record-card.state-canceled .state-icon {
  width: 20rpx;
  height: 20rpx;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-row.single {
  margin-bottom: 0;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 80rpx;
  box-sizing: border-box;
}

.action-button::after {
  border: 0;
}

.action-button.primary {
  color: #2563eb;
  background: #eff6ff;
}

.action-button.plain {
  color: #374151;
  background: #f9fafb;
}

.action-button.highlight {
  height: 84rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #fb923c 0%, #f97316 100%);
  font-size: 30rpx;
}

.action-button.disabled {
  color: #9ca3af;
  background: #f3f4f6;
  opacity: 1;
}

.action-button.disabled .action-icon {
  opacity: .45;
}

.action-icon {
  display: block;
  width: 24rpx;
  height: 24rpx;
  margin-right: 10rpx;
}

.notice-strip {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 14rpx 20rpx;
  border: 2rpx solid #fef3c7;
  border-radius: 16rpx;
  color: #a16207;
  background: #fffbeb;
  font-size: 24rpx;
  line-height: 34rpx;
  box-sizing: border-box;
}

.action-icon-remind {
  width: 30rpx;
  height: 30rpx;
}

.action-icon-chat {
  width: 34rpx;
  height: 34rpx;
}

.notice-icon {
  display: block;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 10rpx;
}

.empty-records {
  margin: 28rpx 32rpx 0;
  padding: 44rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #9ca3af;
  font-size: 24rpx;
  text-align: center;
}
