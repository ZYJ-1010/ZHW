<home-shell
  online-text="{{onlineText}}"
  nav-items="{{navItems}}"
  shell-variant="joinApply"
  nav-toast-enabled="{{false}}"
  bindnavtap="handleShellNavTap"
  bindnavlongpress="handleShellNavLongPress"
  bindnavtouchend="handleShellNavTouchEnd"
>
  <scroll-view
    class="game-apply-scroll"
    scroll-y
    enhanced
    show-scrollbar="false"
    scroll-with-animation
    scroll-top="{{applyScrollTop}}"
    bindscroll="handleApplyScroll"
    enable-back-to-top
  >
    <view wx:if="{{eligibilityLoading}}" class="game-apply-page">正在向后端核验申请资格…</view>
    <view wx:elif="{{eligibilityError}}" class="game-apply-page">{{eligibilityError}}</view>
    <view wx:else class="game-apply-page">
      <view class="apply-heading">
        <text class="apply-subtitle">{{applicationConfig.texts.subtitle}}</text>
      </view>

      <view wx:if="{{eligibilityBlocked}}" class="apply-blocked-notice">
        <text>{{eligibilityBlockReason}}</text>
      </view>

      <view wx:if="{{applyRoleOptions.length}}" class="apply-role-card">
        <view class="apply-role-heading">
          <text class="apply-role-title">选择入局身份</text>
          <text class="apply-role-hint">仅可使用本局已开放的身份申请</text>
        </view>
        <view class="apply-role-list">
          <button
            wx:for="{{applyRoleOptions}}"
            wx:key="key"
            class="apply-role-option {{selectedRole === item.key ? 'selected' : ''}} {{item.enabled ? '' : 'disabled'}}"
            data-key="{{item.key}}"
            bindtap="onSelectRole"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{!item.enabled}}" class="apply-role-reason">{{item.disabledReason}}</text>
          </button>
        </view>
      </view>

      <view class="wechat-card">
        <image
          wx:if="{{wechatInfo.avatarUrl}}"
          class="wechat-avatar-image"
          src="{{wechatInfo.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="wechat-avatar">{{wechatInfo.avatarFallback}}</view>
        <view class="wechat-copy">
          <text class="wechat-title">{{applicationConfig.texts.wechatTitle}}</text>
          <text class="wechat-desc">{{applicationConfig.texts.nicknameLabel}}：{{wechatInfo.nickname}} · {{wechatInfo.syncText}}</text>
        </view>
      </view>

      <view wx:if="{{applicationConfig.agreementText || applicationConfig.recommendationHint}}" class="apply-rule-card">
        <text wx:if="{{applicationConfig.agreementText}}" class="apply-rule-text">{{applicationConfig.agreementText}}</text>
        <text wx:if="{{applicationConfig.recommendationHint}}" class="apply-rule-hint">{{applicationConfig.recommendationHint}}</text>
      </view>

      <view class="apply-section">
        <view class="apply-section-label required">
          <text>{{applicationConfig.texts.introLabel}}</text>
          <text class="required-mark">*</text>
        </view>
        <textarea
          class="apply-textarea intro"
          value="{{form.intro}}"
          maxlength="{{applicationConfig.maxIntroLength}}"
          auto-height="{{false}}"
          bindinput="onIntroInput"
          placeholder="{{applicationConfig.texts.introPlaceholder}}"
          placeholder-class="apply-placeholder"
        />
      </view>

      <view class="apply-section">
        <text class="apply-section-label">{{applicationConfig.texts.portfolioLabel}}{{applicationConfig.uploadRequired ? ' *' : ''}}</text>
        <work-upload-panel panel-class="framed" bind:imageupload="onUploadImage" bind:fileupload="onUploadFile" />
      </view>

      <view class="apply-section">
        <text class="apply-section-label">{{applicationConfig.texts.messageLabel}}</text>
        <textarea
          class="apply-textarea message"
          value="{{form.message}}"
          maxlength="{{applicationConfig.maxMessageLength || -1}}"
          auto-height="{{false}}"
          bindinput="onMessageInput"
          placeholder="{{applicationConfig.texts.messagePlaceholder}}"
          placeholder-class="apply-placeholder"
        />
      </view>

      <checkbox-group class="agreement-group" bindchange="onAgreementChange">
        <label class="agreement-row">
          <checkbox class="agreement-checkbox-native" value="agreed" checked="{{form.agreed}}" />
          <view class="agreement-checkbox-visual {{form.agreed ? 'checked' : ''}}">
            <view wx:if="{{form.agreed}}" class="agreement-check-mark"></view>
          </view>
          <view class="agreement-copy">
            <text>{{applicationConfig.texts.agreementPrefix}}</text>
            <text class="agreement-link" catchtap="onAgreementTap">《{{applicationConfig.agreementTitle}}》</text>
          </view>
        </label>
      </checkbox-group>

      <view class="action-row">
        <button class="action-button secondary" hover-class="none" bindtap="onCancel">{{applicationConfig.texts.cancelText}}</button>
        <button class="action-button primary {{eligibilityReady && !submitting ? '' : 'disabled'}}" hover-class="none" aria-disabled="{{!eligibilityReady || submitting}}" bindtap="onSubmit">{{eligibilityReady ? applicationConfig.texts.submitText : (isGameFull ? '已满员' : applicationConfig.texts.submitText)}}</button>
      </view>
    </view>
  </scroll-view>
</home-shell>
