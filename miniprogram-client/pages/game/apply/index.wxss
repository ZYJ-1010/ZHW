page {
  background: #007bd3;
}

.game-apply-scroll {
  width: 100%;
  height: 100%;
  background: #0f1014;
}

.game-apply-page {
  min-height: 100%;
  box-sizing: border-box;
  /* 原型主内容区为 335pt：375pt 画布左右各保留 20pt。 */
  padding: 34rpx 40rpx 72rpx;
  color: #f6f7fb;
  background: #111216;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.apply-heading {
  margin-bottom: 24rpx;
}

.apply-subtitle {
  display: block;
  color: #00f2ff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.wechat-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  min-height: 142rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(15, 16, 20, 0.04);
  border-radius: 28rpx;
  background: #f6f7fb;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.16);
}

.wechat-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(180deg, #00f2ff 0%, #3a86ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(0, 242, 255, 0.22);
}

.wechat-avatar-image {
  flex: none;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #dfe4f2;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.12);
}

.wechat-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.wechat-title {
  color: #9a9a9a;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.wechat-desc {
  color: #aeb5d6;
  font-size: 26rpx;
  line-height: 36rpx;
}

.apply-rule-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid rgba(0, 242, 255, 0.24);
  border-radius: 24rpx;
  background: rgba(0, 242, 255, 0.08);
}

.apply-rule-text,
.apply-rule-hint {
  display: block;
  color: #e5f8ff;
  font-size: 24rpx;
  line-height: 36rpx;
}

.apply-rule-hint {
  color: #9ee7ff;
}

.apply-role-card {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.07);
}

.apply-role-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.apply-role-title {
  color: #f6f7fb;
  font-size: 28rpx;
  font-weight: 600;
}

.apply-role-hint {
  color: #9aa4b6;
  font-size: 21rpx;
}

.apply-role-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.apply-role-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 148rpx;
  margin: 0;
  padding: 16rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 18rpx;
  color: #e9faff;
  font-size: 25rpx;
  line-height: 34rpx;
  background: rgba(255, 255, 255, 0.08);
}

.apply-role-option::after {
  border: 0;
}

.apply-role-option.selected {
  border-color: #00f2ff;
  color: #00f2ff;
  background: rgba(0, 242, 255, 0.13);
}

.apply-role-option.disabled {
  border-color: rgba(255, 255, 255, 0.08);
  color: #748095;
  background: rgba(255, 255, 255, 0.03);
}

.apply-role-reason {
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: left;
}

.apply-section {
  margin-top: 28rpx;
}

.apply-section-label {
  display: block;
  margin-bottom: 14rpx;
  color: #00f2ff;
  font-size: 28rpx;
  line-height: 36rpx;
}

.apply-section-label.required {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.required-mark {
  color: #ff4fa6;
  font-size: 28rpx;
  line-height: 36rpx;
}

.apply-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(15, 16, 20, 0.04);
  border-radius: 24rpx;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 42rpx;
  background: #f6f7fb;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.16);
}

.apply-textarea.intro {
  height: 186rpx;
}

.apply-textarea.message {
  height: 150rpx;
}

.apply-placeholder {
  color: rgba(148, 163, 184, 0.72);
}

.action-button::after {
  border: 0;
}

.agreement-group {
  margin-top: 30rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(94, 160, 255, 0.4);
  border-radius: 24rpx;
  background: rgba(94, 160, 255, 0.15);
}

.agreement-checkbox-native {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.agreement-checkbox-visual {
  position: relative;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(94, 160, 255, 0.72);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
}

.agreement-checkbox-visual.checked {
  border-color: rgba(255, 255, 255, 0.92);
  background: transparent;
}

.agreement-check-mark {
  position: absolute;
  left: 7rpx;
  top: 1rpx;
  width: 11rpx;
  height: 19rpx;
  border-right: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(42deg);
}

.agreement-copy {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 38rpx;
}

.agreement-link {
  color: #00f2ff;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
}

.action-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.action-button.secondary {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #c7cbe0;
  background: rgba(32, 34, 41, 0.98);
}

.action-button.primary {
  color: #ffffff;
  background: linear-gradient(90deg, #3a86ff 0%, #8b5cf6 52%, #ff4fa6 100%);
  box-shadow: 0 16rpx 32rpx rgba(139, 92, 246, 0.32);
}

.action-button.primary.disabled {
  color: rgba(255, 255, 255, 0.72);
  background: #6b7280;
  box-shadow: none;
  opacity: 0.72;
}

.apply-blocked-notice {
  margin: 0 0 24rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 117, 117, 0.45);
  border-radius: 12rpx;
  background: rgba(127, 29, 29, 0.22);
  color: #fecaca;
  font-size: 24rpx;
  line-height: 34rpx;
}
