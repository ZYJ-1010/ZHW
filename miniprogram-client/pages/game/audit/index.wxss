page {
  background: #007bd3;
}

.game-audit-scroll {
  width: 100%;
  height: 100%;
  background: #000000;
}

.game-audit-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 0 0 38rpx;
  color: #ffffff;
  background: #000000;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.audit-tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  height: 90rpx;
  background: #000000;
}

.audit-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.audit-tab.active {
  color: #00f2ff;
}

.audit-tab.active::after {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 0;
  height: 4rpx;
  background: #00f2ff;
  content: '';
}

.audit-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 46rpx 16rpx 28rpx 22rpx;
}

.audit-card {
  position: relative;
  box-sizing: border-box;
  width: 666rpx;
  height: 250rpx;
  padding: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.audit-initiator {
  position: absolute;
  left: 8rpx;
  top: 28rpx;
  display: flex;
  align-items: flex-start;
  width: 428rpx;
  min-height: 104rpx;
}

.audit-initiator-avatar {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 104rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 242, 255, 0.5);
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
	background: #1f2937;
	overflow: hidden;
}

.audit-initiator-avatar-image {
	display: block;
	width: 100%;
	height: 100%;
}

.audit-initiator-copy {
  margin-left: 140rpx;
  padding-top: 0;
  min-width: 0;
}

.audit-initiator-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 40rpx;
}

.audit-initiator-name {
  max-width: 196rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audit-initiator-role {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 70rpx;
  height: 36rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  color: #adff2f;
  font-size: 20rpx;
  line-height: 30rpx;
}

.audit-initiator-role.expert {
  color: #adff2f;
}

.audit-initiator-role.player {
  color: #00f2ff;
}

.audit-initiator-role.guide {
  color: #ff00ff;
}

.audit-initiator-time {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
  line-height: 30rpx;
}

.audit-card-status {
  position: absolute;
  left: 542rpx;
  top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 42rpx;
  border-radius: 8rpx;
  color: #000000;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  background: #ffa500;
}

.audit-card-status.pending {
  background: #ffa500;
}

.audit-card-status.approved {
  background: #adff2f;
}

.audit-card-status.rejected {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
}

.audit-approve-button {
  position: absolute;
  left: 10rpx;
  top: 158rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 254rpx;
  height: 62rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  color: #000000;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  background: #adff2f;
}

.audit-approve-button::after {
  border: 0;
}

.audit-reject-button {
  position: absolute;
  left: 290rpx;
  top: 158rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 254rpx;
  height: 62rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  background: rgba(255, 255, 255, 0.1);
}

.audit-detail-button {
  position: absolute;
  left: 566rpx;
  top: 156rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}

.audit-reject-button::after,
.audit-detail-button::after {
  border: 0;
}

.audit-reviewed-button {
  position: absolute;
  left: 10rpx;
  top: 158rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 434rpx;
  height: 62rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}

.audit-card.muted {
  opacity: 0.68;
}

.audit-avatar {
  position: absolute;
  left: 8rpx;
  top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 104rpx;
  border: 2rpx solid rgba(0, 242, 255, 0.5);
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
  background: radial-gradient(circle at 32% 24%, rgba(255, 255, 255, 0.2), rgba(31, 41, 55, 0) 38%), #1f2937;
}

.audit-avatar.expert {
  border-color: rgba(173, 255, 47, 0.68);
}

.audit-avatar.player {
  border-color: rgba(0, 242, 255, 0.68);
}

.audit-avatar.guide {
  border-color: rgba(255, 0, 255, 0.68);
}

.audit-card-main {
  min-height: 74rpx;
  margin-left: 140rpx;
  padding-right: 108rpx;
}

.audit-card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 40rpx;
}

.audit-name {
  max-width: 188rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audit-role {
  flex: none;
  box-sizing: border-box;
  min-width: 70rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.audit-role.expert {
  color: #adff2f;
}

.audit-role.player {
  color: #00f2ff;
}

.audit-role.guide {
  color: #ff00ff;
}

.audit-time {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
  line-height: 30rpx;
}

.audit-status {
  position: absolute;
  right: 22rpx;
  top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 42rpx;
  border-radius: 8rpx;
  color: #000000;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.audit-status.pending {
  background: #ffa500;
}

.audit-status.approved {
  background: #adff2f;
}

.audit-status.rejected {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

.audit-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 64rpx;
  gap: 18rpx;
  margin-top: 36rpx;
}

.audit-button,
.audit-batch-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 24rpx;
  font-size: 20rpx;
  line-height: 30rpx;
}

.audit-button::after,
.audit-batch-button::after {
  border: 0;
}

.audit-button {
  height: 62rpx;
  font-weight: 700;
}

.audit-button.approve {
  color: #000000;
  background: #adff2f;
}

.audit-button.reject {
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
}

.audit-button.detail {
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
  background: rgba(255, 255, 255, 0.05);
}

.audit-reviewed-row {
  display: grid;
  grid-template-columns: 1fr 64rpx;
  gap: 34rpx;
  align-items: center;
  margin-top: 42rpx;
}

.audit-reviewed-text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}

.audit-button.detail.reviewed {
  width: 64rpx;
}

.audit-batch-bar {
  display: grid;
  grid-template-columns: 1fr 238rpx 232rpx;
  gap: 36rpx;
  align-items: center;
  box-sizing: border-box;
  width: 660rpx;
  height: 150rpx;
  margin-left: 28rpx;
  padding: 0 36rpx 0 44rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #111827;
}

.audit-select-all {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 34rpx;
}

.audit-checkbox {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.05);
}

.audit-checkbox.checked {
  border-color: #00f2ff;
  background: #00f2ff;
}

.audit-checkmark {
  position: absolute;
  left: 7rpx;
  top: 2rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid #000000;
  border-bottom: 4rpx solid #000000;
  transform: rotate(42deg);
}

.audit-batch-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.audit-batch-button.reject {
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.64);
  background: rgba(255, 255, 255, 0.05);
}

.audit-batch-button.approve {
  color: #000000;
  background: #00f2ff;
}
