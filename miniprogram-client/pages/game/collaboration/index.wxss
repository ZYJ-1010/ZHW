page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.collab-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #101010;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "PingFang SC", sans-serif;
}

.collab-frame {
  position: relative;
  width: 750rpx;
  height: 100vh;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.collab-top-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 0;
  height: 160rpx;
  background: #ffffff;
}

.collab-nav {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 5;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.collab-nav-title {
  position: absolute;
  left: 280rpx;
  display: block;
  width: 190rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.collab-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.collab-back::after {
  border: 0;
}

.collab-back--hover {
  background: #f3f4f6;
}

.collab-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.collab-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #1a1c29;
  color: #ffffff;
}

.collab-main {
  min-height: 100%;
  padding: 34rpx 40rpx 240rpx;
  box-sizing: border-box;
  background: #1a1c29;
}

.collab-header {
  display: flex;
  flex-direction: column;
  padding: 10rpx 0 30rpx;
  box-sizing: border-box;
}

.collab-title {
  color: rgba(255, 255, 255, 0.9);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 66rpx;
  letter-spacing: 0;
}

.collab-subtitle {
  margin-top: 10rpx;
  color: #949ab1;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 38rpx;
}

.collab-error {
  margin-top: 10rpx;
  color: #fecaca;
  font-size: 24rpx;
  line-height: 34rpx;
}

.collab-card {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 38rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 48rpx;
  box-sizing: border-box;
  background: #272a3e;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.16);
}

.inline-editor,
.checkin-editor {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: -4rpx 0 24rpx;
}

.inline-editor-input,
.checkin-input {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #1a1c29;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.inline-editor-button,
.checkin-submit {
  flex: none;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #38bdf8;
  color: #062135;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.checkin-editor {
  align-items: flex-end;
}

.checkin-input {
  min-height: 64rpx;
}

.milestone-list,
.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.milestone-item,
.checkin-item {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #1a1c29;
}

.checkin-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 6rpx;
}

.checkin-meta {
  display: flex;
  align-items: center;
  min-width: 0;
}

.milestone-state {
  flex: none;
  width: 36rpx;
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 36rpx;
}

.milestone-item.completed .milestone-state,
.milestone-item.completed .milestone-title {
  color: #34d399;
}

.milestone-title,
.checkin-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #e5e7eb;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.milestone-action,
.checkin-type {
  flex: none;
  margin-left: 16rpx;
  color: #7dd3fc;
  font-size: 22rpx;
  line-height: 32rpx;
}

.checkin-type {
  margin-left: 0;
}

.checkin-author,
.checkin-time {
  overflow: hidden;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkin-author {
  margin-left: 14rpx;
  max-width: 160rpx;
}

.checkin-time {
  flex: 1;
  margin-left: 14rpx;
  text-align: right;
}

.card-title {
  display: block;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.progress-card .card-title {
  margin-bottom: 28rpx;
}

.progress-track {
  width: 100%;
  height: 20rpx;
  margin-bottom: 46rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #363a55;
}

.progress-fill {
  position: relative;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #34d399 0%, #38bdf8 100%);
}

.progress-glow {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 32rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: rgba(255, 255, 255, 0.38);
  filter: blur(4rpx);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
}

.task-dot {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 20rpx;
  height: 20rpx;
  margin: 12rpx 28rpx 0 0;
  border-radius: 50%;
  background: #60a5fa;
  box-shadow: 0 0 16rpx rgba(96, 165, 250, 0.45);
}

.task-dot--completed {
  width: 28rpx;
  height: 28rpx;
  margin-top: 8rpx;
  margin-right: 20rpx;
  background: #34d399;
  box-shadow: 0 0 16rpx rgba(52, 211, 153, 0.38);
}

.task-dot--pending {
  background: transparent;
  border: 3rpx solid #596078;
  box-shadow: none;
}

.task-check {
  color: #10251f;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 28rpx;
}

.task-item--pending .task-title,
.task-item--pending .task-desc {
  color: #777e96;
}

.task-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.task-title {
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.task-desc {
  margin-top: 6rpx;
  color: #949ab1;
  font-size: 26rpx;
  line-height: 38rpx;
}

.members-text {
  display: block;
  color: #b4b9cc;
  font-size: 26rpx;
  line-height: 42rpx;
}

.member-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx 18rpx;
}

.member-item {
  display: flex;
  min-width: 0;
  align-items: center;
}

.member-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  overflow: hidden;
  border-radius: 50%;
  color: #ffffff;
  background: #ec7891;
  font-size: 23rpx;
  font-weight: 700;
}

.member-avatar--guide {
  background: #f59e5b;
}

.member-avatar--expert {
  background: #5496e8;
}

.member-copy {
  display: flex;
  min-width: 0;
  margin-left: 14rpx;
  flex-direction: column;
}

.member-name,
.member-role {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-name {
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.member-role {
  color: #949ab1;
  font-size: 22rpx;
  line-height: 32rpx;
}

.chat-card {
  margin-bottom: 0;
}

.chat-card--hover {
  opacity: 0.88;
}

.chat-card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-card-title .card-title {
  margin-bottom: 24rpx;
}

.chat-entry {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.chat-entry-text {
  color: #75b8ff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.chat-entry-icon {
  width: 13rpx;
  height: 13rpx;
  margin-left: 10rpx;
  border-top: 3rpx solid #75b8ff;
  border-right: 3rpx solid #75b8ff;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.chat-line {
  color: #b4b9cc;
  font-size: 26rpx;
  line-height: 42rpx;
}

.chat-name {
  color: rgba(255, 255, 255, 0.82);
  font-weight: 600;
}

.chat-content {
  color: #b4b9cc;
}

.collab-empty {
  color: #949ab1;
  font-size: 26rpx;
  line-height: 38rpx;
}

.progress-editor {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(117, 184, 255, 0.28);
  border-radius: 14rpx;
  background: rgba(40, 49, 75, 0.52);
}

.progress-editor-title {
  grid-column: 1 / -1;
  color: #d8e9ff;
  font-size: 24rpx;
}

.progress-editor-number,
.progress-editor-note {
  width: 100%;
  min-height: 64rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  color: #f7fbff;
  background: #262c42;
  font-size: 24rpx;
}

.progress-editor-note {
  grid-column: 1 / -1;
  min-height: 92rpx;
}

.progress-editor-submit {
  grid-column: 1 / -1;
  height: 64rpx;
  margin: 0;
  border-radius: 10rpx;
  color: #ffffff;
  background: #4a91e8;
  font-size: 24rpx;
}

.progress-editor-submit::after {
  border: 0;
}

.collab-footer {
  position: absolute;
  left: 2rpx;
  right: 0;
  bottom: 0;
  z-index: 4;
  display: flex;
  gap: 24rpx;
  width: 750rpx;
  padding: 66rpx 36rpx 34rpx;
  box-sizing: border-box;
  background: linear-gradient(0deg, #1a1c29 0%, #1a1c29 66%, rgba(26, 28, 41, 0) 100%);
}

.collab-button {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: 0;
  min-width: 0;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.collab-button::after {
  border: 0;
}

.collab-button.secondary {
  color: #c0c6d9;
  background: #32364e;
  box-shadow: none;
}

.collab-button.primary {
  color: #ffffff;
  background: linear-gradient(90deg, #ff8e8b 0%, #ff7170 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 113, 112, 0.28);
}

.collab-button--hover {
  background: #3d425f;
}

.collab-button--active {
  opacity: 0.9;
}

.collab-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}
