page {
  background: #007bd3;
}

.play-again-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  background: #050914;
}

.game-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #061522 0%, #05070c 57%, #061a2b 100%);
}

.dim-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.58);
}

.recommend-panel {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 0;
  box-sizing: border-box;
  height: 66.6667%;
  padding: 16rpx 40rpx 34rpx;
  border-radius: 46rpx 46rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.drag-handle {
  width: 70rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.panel-header {
  position: relative;
  display: block;
  min-height: 94rpx;
  margin-bottom: 34rpx;
}

.panel-copy {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  padding-right: 78rpx;
  padding-top: 8rpx;
}

.panel-title {
  display: block;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  white-space: nowrap;
}

.panel-subtitle {
  display: block;
  margin-top: 18rpx;
  color: #c7c7c7;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.close-button {
  position: absolute;
  right: 4rpx;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.close-button::after {
  border: 0;
}

.close-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.option-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 114rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid transparent;
  border-radius: 30rpx;
}

.option-card.green {
  border-color: #d1fae5;
  background: #ecfdf5;
}

.option-card.blue {
  border-color: #dbeafe;
  background: #eff6ff;
}

.option-card.pink {
  border-color: #fce7f3;
  background: #fdf2f8;
}

.option-card.active.green {
  border-color: #10b981;
}

.option-card.active.blue {
  border-color: #3b82f6;
}

.option-card.active.pink {
  border-color: #ec4899;
}

.option-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 78rpx;
  height: 78rpx;
  margin-right: 22rpx;
  border-radius: 22rpx;
}

.option-icon.green {
  background: #10b981;
}

.option-icon.blue {
  background: #3b82f6;
}

.option-icon.pink {
  background: #ec4899;
}

.option-emoji {
  font-size: 44rpx;
  line-height: 52rpx;
}

.option-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.option-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.green .option-title {
  color: #064e3b;
}

.blue .option-title {
  color: #1e3a8a;
}

.pink .option-title {
  color: #831843;
}

.option-desc {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 21rpx;
  line-height: 30rpx;
}

.green .option-desc {
  color: #9ca3af;
}

.blue .option-desc {
  color: #9ca3af;
}

.pink .option-desc {
  color: #9ca3af;
}

.option-arrow {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-left: 18rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.green .option-arrow {
  color: #86efac;
}

.blue .option-arrow {
  color: #93c5fd;
}

.pink .option-arrow {
  color: #f9a8d4;
}

.plus-icon,
.plus-icon::after {
  width: 38rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  content: '';
}

.plus-icon {
  position: relative;
}

.plus-icon::after {
  position: absolute;
  left: 0;
  top: 0;
  transform: rotate(90deg);
}

.panel-footnote {
  display: block;
  margin-top: 22rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}
