page { background: #000000; }
.draft-page { min-height: 100vh; background: #000000; color: #ffffff; font-family: "Noto Sans SC", "PingFang SC", sans-serif; }
.draft-nav { position: relative; display: flex; align-items: center; justify-content: center; height: 160rpx; border-bottom: 1rpx solid rgba(255,255,255,.1); }
.draft-title { color: #28e2c8; font-size: 36rpx; font-weight: 700; }
.back-button { position: absolute; left: 34rpx; top: 92rpx; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border: 1rpx solid rgba(255,255,255,.46); border-radius: 50%; }
.back-icon { width: 14rpx; height: 14rpx; border-left: 3rpx solid #ffffff; border-bottom: 3rpx solid #ffffff; transform: translateX(3rpx) rotate(45deg); }
.draft-scroll { height: calc(100vh - 160rpx); }
.draft-list { padding: 32rpx 34rpx 72rpx; }
.draft-card { margin-bottom: 22rpx; padding: 28rpx; border-radius: 28rpx; background: #0d6ecb; box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.1); }
.draft-card-title { display: block; color: #ffffff; font-size: 32rpx; font-weight: 700; line-height: 46rpx; }
.draft-card-info { display: block; margin-top: 12rpx; color: rgba(237,249,255,.82); font-size: 24rpx; line-height: 34rpx; }
.draft-card-time { display: block; margin-top: 16rpx; color: rgba(188,232,255,.76); font-size: 22rpx; }
.draft-card-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }
.draft-card-actions button { height: 52rpx; margin: 0; padding: 0 20rpx; border-radius: 26rpx; font-size: 22rpx; line-height: 52rpx; }
.draft-card-actions button::after { border: 0; }
.draft-delete { background: rgba(0,0,0,.16); color: rgba(255,255,255,.8); }
.draft-edit { background: #28e2c8; color: #003d67; font-weight: 600; }
.empty-state { padding: 200rpx 70rpx 0; text-align: center; }
.empty-title { display: block; color: #ffffff; font-size: 32rpx; font-weight: 700; }
.empty-desc { display: block; margin-top: 18rpx; color: rgba(255,255,255,.66); font-size: 24rpx; line-height: 38rpx; }
