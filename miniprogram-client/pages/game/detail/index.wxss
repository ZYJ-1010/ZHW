page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.detail-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  height: 160rpx;
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(17, 24, 39, 0.06);
}

.detail-nav-title {
  position: absolute;
  left: 220rpx;
  right: 220rpx;
  top: 92rpx;
  height: 50rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-nav-back,
.detail-nav-share {
  position: absolute;
  top: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
}

.detail-nav-back {
  left: 48rpx;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.24);
}

.detail-nav-share {
  right: 48rpx;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.18);
}

.detail-nav-share::after,
.tool-button::after,
.enroll-button::after,
.detail-share-option::after,
.detail-share-cancel::after {
  border: 0;
}

.detail-nav-back-icon {
  width: 14rpx;
  height: 14rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.75);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.75);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.detail-share-image {
  display: block;
  width: 32rpx;
  height: 32rpx;
}

.detail-scroll {
  position: fixed;
  left: 0;
  right: 0;
  top: 160rpx;
  height: calc(100vh - 308rpx - env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.detail-content {
  min-height: 100%;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.cover-image {
  display: block;
  width: 750rpx;
  height: 448rpx;
  background: #dbeafe;
}

.detail-stack {
  position: relative;
  z-index: 1;
  width: 702rpx;
  margin: -48rpx auto 0;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.event-card,
.tag-row,
.plain-card,
.organizer-card {
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.event-card {
  padding: 30rpx 28rpx 22rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.event-title {
  display: block;
  color: #111827;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.event-info-list {
  margin-top: 22rpx;
}

.event-info-line,
.event-meta-item,
.stats-item {
  display: flex;
  align-items: center;
  min-width: 0;
}

.event-info-line {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 36rpx;
}

.event-info-line:first-child {
  margin-top: 0;
}

.event-info-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.event-meta-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.event-meta-list {
  min-width: 0;
}

.event-meta-item {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 34rpx;
}

.event-meta-item:first-child {
  margin-top: 0;
}

.event-meta-icon {
  display: block;
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.interest-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: auto;
  min-width: 0;
  height: 58rpx;
  margin: 0 0 2rpx 18rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: #ffecd6;
  color: #e88b25;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
  white-space: nowrap;
}

.interest-button.active {
  background: #e8f7ef;
  color: #0e9f6e;
}

.interest-mark {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.stats-row {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr) minmax(0, 1.25fr);
  gap: 0;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f0f2f5;
}

.stats-item {
  justify-content: center;
  overflow: hidden;
  padding: 0 8rpx;
  box-sizing: border-box;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.stats-item.disabled {
  opacity: 0.72;
}

.stats-item:not(:first-child) {
  border-left: 1rpx solid #e5e7eb;
}

.stats-label {
  display: block;
  flex: none;
  margin-right: 4rpx;
}

.stats-value {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.stats-icon-image {
  display: block;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.stats-emoji {
  display: block;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
  font-size: 24rpx;
  line-height: 28rpx;
  text-align: center;
}

.stats-icon.view {
  border: 3rpx solid #9ca3af;
  border-radius: 50%;
  box-sizing: border-box;
}

.stats-icon.view::after {
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9ca3af;
  content: '';
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
  width: 100%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.tag-pill {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 32rpx;
}

.tag-pill.blue {
  background: #eff6ff;
  color: #3b82f6;
}

.tag-pill.green {
  background: #ecfdf5;
  color: #10b981;
}

.tag-pill.purple {
  background: #f5f3ff;
  color: #8b5cf6;
}

.detail-section {
  margin-top: 28rpx;
}

.section-title {
  display: block;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.section-heading-row,
.section-topline {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.section-helper {
  flex: 1;
  min-width: 0;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: right;
}

.section-link {
  display: flex;
  align-items: center;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.section-link-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-top: 3rpx solid #6b7280;
  border-right: 3rpx solid #6b7280;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.plain-card,
.organizer-card {
  margin-top: 14rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.plain-card {
  padding: 28rpx;
  color: #5b6472;
  font-size: 28rpx;
  line-height: 44rpx;
}

.compact-text-card {
  font-size: 24rpx;
  line-height: 38rpx;
}

.organizer-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 144rpx;
  padding: 24rpx;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: linear-gradient(135deg, #7dd3fc 0%, #60a5fa 48%, #f9a8d4 100%);
  color: #ffffff;
  font-weight: 800;
}

.organizer-avatar {
  width: 96rpx;
  height: 96rpx;
  font-size: 30rpx;
}

.organizer-avatar-image {
  display: block;
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e5e7eb;
}

.organizer-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding-right: 86rpx;
}

.organizer-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.organizer-name {
  flex: none;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.organizer-blue-badge {
  margin-left: 10rpx;
  padding: 2rpx 9rpx;
  border-radius: 8rpx;
  background: #168bff;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
}

.organizer-role {
  min-width: 0;
  margin-left: 14rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.organizer-summary {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.rating-badge {
  position: absolute;
  right: 22rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #fffbeb;
  color: #d97706;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.rating-icon {
  display: block;
  width: 20rpx;
  height: 20rpx;
  margin-right: 6rpx;
}

.highlight-card {
  border: 1rpx solid #eef2f7;
}

.number-row {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  color: #5b6472;
  font-size: inherit;
  line-height: inherit;
}

.number-row:first-child {
  margin-top: 0;
}

.number-index {
  flex: none;
  width: 44rpx;
  color: #3b82f6;
  font-weight: 400;
}

.flow-card {
  padding: 28rpx 22rpx;
}

.flow-title {
  display: block;
  margin-bottom: 22rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-align: center;
}

.flow-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  color: #5b6472;
  font-size: 20rpx;
  line-height: 32rpx;
}

.flow-row:first-child {
  margin-top: 0;
}

.flow-index {
  flex: none;
  width: 32rpx;
  color: #3b82f6;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.flow-body {
  flex: 1;
  min-width: 0;
  display: block;
  color: #5b6472;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.flow-time {
  color: #374151;
  font-weight: 600;
}

.detail-image-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.detail-image {
  display: block;
  width: 100%;
  height: 312rpx;
  border-radius: 18rpx;
  background: #e5e7eb;
}

.notice-card {
  padding: 24rpx;
}

.notice-tip {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border: 1rpx solid #fde68a;
  border-radius: 18rpx;
  background: #fffbeb;
  color: #a16207;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.notice-tip-icon {
  display: block;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin: 3rpx 12rpx 0 0;
  font-size: 24rpx;
  line-height: 28rpx;
  text-align: center;
}

.notice-list {
  margin-top: 22rpx;
}

.bullet-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.bullet-row:first-child {
  margin-top: 0;
}

.bullet-index {
  display: block;
  flex: none;
  width: 34rpx;
  margin-right: 8rpx;
  color: #3b82f6;
  line-height: 38rpx;
}

.participants-section {
  padding-bottom: 24rpx;
}

.participants-panel {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.participants-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 35;
  display: grid;
  grid-template-columns: 266rpx minmax(0, 1fr);
  column-gap: 94rpx;
  align-items: center;
  height: calc(118rpx + env(safe-area-inset-bottom));
  min-height: 118rpx;
  padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)) 14rpx;
  border: 0;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: none;
}

.bottom-action-bar.without-tools {
  display: flex;
  justify-content: center;
  padding-left: 26rpx;
}

.bottom-tools {
  display: grid;
  grid-template-columns: repeat(4, 62rpx);
  gap: 6rpx;
  width: 266rpx;
  height: 78rpx;
  overflow: visible;
}

.tool-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  min-width: 0;
  max-width: 62rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  color: #6b7280;
  font-size: 18rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: visible;
}

.tool-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.tool-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 2rpx;
}

.tool-icon.bookmark {
  border: 4rpx solid #6b7280;
  border-bottom: 0;
  border-radius: 7rpx 7rpx 2rpx 2rpx;
  box-sizing: border-box;
}

.tool-icon.bookmark::after {
  position: absolute;
  left: 7rpx;
  bottom: -5rpx;
  width: 14rpx;
  height: 14rpx;
  border-left: 4rpx solid #6b7280;
  border-bottom: 4rpx solid #6b7280;
  background: #ffffff;
  box-sizing: border-box;
  transform: rotate(-45deg);
  content: '';
}

.tool-icon.checkin {
  border: 4rpx solid #6b7280;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.tool-icon.checkin::before,
.tool-icon.checkin::after {
  position: absolute;
  left: 8rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #6b7280;
  content: '';
}

.tool-icon.checkin::before {
  top: 9rpx;
  width: 17rpx;
}

.tool-icon.checkin::after {
  top: 18rpx;
  width: 13rpx;
}

.tool-icon.greet {
  border: 4rpx solid #6b7280;
  border-radius: 50%;
  box-sizing: border-box;
}

.tool-icon.greet::before,
.tool-icon.greet::after {
  position: absolute;
  top: 9rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #6b7280;
  content: '';
}

.tool-icon.greet::before {
  left: 8rpx;
}

.tool-icon.greet::after {
  right: 8rpx;
}

.enroll-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 40rpx;
  background: #e61e40;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 78rpx;
  box-shadow: 0 10rpx 22rpx rgba(230, 30, 64, 0.18);
}

.bottom-action-bar.without-tools .enroll-button {
  width: 350rpx;
}

.enroll-button.disabled {
  background: #bbbbbb;
  color: #ffffff;
  box-shadow: none;
}

.detail-share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 75;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.6);
}

.detail-share-sheet {
  width: 100%;
  padding: 32rpx 56rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.detail-share-title {
  display: block;
  color: #111827;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 52rpx;
  text-align: left;
}

.detail-share-options {
  display: grid;
  grid-template-columns: repeat(3, 92rpx);
  justify-content: start;
  column-gap: 34rpx;
  width: 344rpx;
  margin-top: 54rpx;
  margin-bottom: 62rpx;
  overflow-x: auto;
}

.detail-share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 92rpx;
  min-width: 92rpx;
  max-width: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
  overflow: visible;
}

.detail-share-option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-bottom: 14rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.12);
}

.detail-share-option-icon.wechat,
.detail-share-option-icon.moments {
  background: #07c160;
}

.detail-share-option-icon.direct {
  background: #1b82d2;
}

.detail-share-option-image {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.detail-share-option-label {
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
  white-space: nowrap;
}

.detail-moments-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.detail-moments-icon::before {
  position: absolute;
  left: 15rpx;
  top: 15rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  content: '';
}

.detail-moments-icon::after {
  display: none;
}

.detail-moments-dot {
  position: absolute;
  left: 18rpx;
  top: 1rpx;
  width: 6rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform-origin: 3rpx 20rpx;
  content: '';
}

.detail-moments-dot.dot-one {
  transform: rotate(0deg);
}

.detail-moments-dot.dot-two {
  transform: rotate(60deg);
}

.detail-moments-dot.dot-three {
  transform: rotate(120deg);
}

.detail-moments-dot.dot-four {
  transform: rotate(180deg);
}

.detail-moments-dot.dot-five {
  transform: rotate(240deg);
}

.detail-moments-dot.dot-six {
  transform: rotate(300deg);
}

.detail-share-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 346rpx;
  height: 92rpx;
  margin: 0 auto;
  border: 1rpx solid #eacfa8;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #fff7ed;
  color: #c18146;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.auth-prompt-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.4);
}

.auth-prompt-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 638rpx;
  max-width: 100%;
  padding: 58rpx 44rpx 46rpx;
  box-sizing: border-box;
  border-radius: 48rpx;
  background: #ffffff;
  color: #111827;
  text-align: center;
  box-shadow: 0 24rpx 54rpx rgba(15, 23, 42, 0.18);
}

.auth-prompt-title {
  display: block;
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.auth-prompt-desc {
  display: block;
  margin-top: 18rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 38rpx;
}

.auth-prompt-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin-top: 44rpx;
  border-radius: 999rpx;
  background: #f6b95b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-shadow: 0 10rpx 20rpx rgba(246, 185, 91, 0.18);
}

.auth-prompt-status {
  display: block;
  margin-top: 28rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 32rpx;
}

@media (max-width: 360px) {
  .bottom-tools {
    left: 10rpx;
    grid-template-columns: repeat(4, 58rpx);
    gap: 4rpx;
    width: 244rpx;
  }

  .tool-button {
    width: 58rpx;
    max-width: 58rpx;
    font-size: 16rpx;
  }

  .enroll-button {
    left: 354rpx;
    right: 20rpx;
    font-size: 26rpx;
  }
}
