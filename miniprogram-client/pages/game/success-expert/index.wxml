<view class="success-expert-page">
  <view class="success-expert-frame" style="{{shellLayout.frameStyle}}">
    <view class="success-expert-top-bg"></view>
    <view class="success-expert-nav">
      <view class="success-expert-back" style="{{shellLayout.backStyle}}" bindtap="onBackTap">
        <view class="success-expert-back-icon"></view>
      </view>
      <text class="success-expert-title" style="{{shellLayout.titleStyle}}">{{pageTexts.navTitle}}</text>
      <view class="success-expert-more" style="{{shellLayout.moreStyle}}" bindtap="onMoreTap">
        <view class="more-dot"></view>
        <view class="more-dot"></view>
        <view class="more-dot"></view>
      </view>
    </view>

    <scroll-view
      class="success-expert-content"
      style="{{shellLayout.contentStyle}}"
      scroll-y
      enhanced
      show-scrollbar="false"
    >
      <view class="success-expert-inner">
        <view wx:if="{{errorText}}" class="success-page-state error">{{errorText}}</view>
        <block wx:else>
        <view class="success-banner">
          <view class="success-mark">
            <image class="success-icon" src="{{iconSources.successCheck}}" mode="aspectFit"></image>
          </view>
          <text class="success-heading">{{pageTexts.successHeading}}</text>
          <text class="success-subtitle">{{group.hint || pageTexts.subtitleFallback}}</text>
        </view>

        <view class="section group-section">
          <view class="group-card">
            <text class="group-section-title">{{pageTexts.groupSectionTitle}}</text>

            <view class="group-panel">
              <view class="group-head">
                <view class="group-icon">
                  <view class="group-person main"></view>
                  <view class="group-person left"></view>
                  <view class="group-person right"></view>
                </view>
                <view class="group-copy">
                  <view class="group-title-row">
                    <text class="group-title">{{group.title}}</text>
                    <view class="online-pill">
                      <view class="online-dot"></view>
                      <text>{{pageTexts.onlineText}}</text>
                    </view>
                  </view>
                  <text class="group-subtitle">{{group.roles}}</text>
                </view>
              </view>

              <view class="participants-row">
                <view class="participant-list">
                  <view wx:for="{{participants}}" wx:key="id" class="participant-item">
                    <view class="participant-avatar {{item.colorClass}}">
                      <image wx:if="{{item.avatarUrl}}" class="participant-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                      <text wx:else>{{item.avatar}}</text>
                    </view>
                    <text class="participant-name">{{item.name}}</text>
                    <text class="participant-role">{{item.roleLabel}}</text>
                  </view>
                </view>
              </view>

              <button class="chat-button" hover-class="none" bindtap="onEnterChatTap">
                <image class="chat-icon" src="https://static.haowan.net.cn/miniprogram/pages/game/success-expert/assets/chat-entry-icon.png" mode="aspectFit"></image>
                <text>{{pageTexts.chatButtonText}}</text>
              </button>
            </view>

            <view class="hint-box">
              <view class="hint-icon"></view>
              <text class="hint-text">{{group.hint}}</text>
            </view>
          </view>
        </view>

        <view class="section info-section">
          <view class="info-card">
            <text class="info-card-title">{{pageTexts.activityTitle}}</text>
            <view wx:for="{{activityRows}}" wx:key="label" class="info-row {{item.highlight ? 'highlight' : ''}}">
              <text class="info-label">{{item.label}}</text>
              <text class="info-value">{{item.value}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{fund.show}}" class="section fund-section">
          <view class="fund-card">
            <text class="fund-card-title">{{pageTexts.fundTitle}}</text>
            <view class="fund-head">
              <view class="fund-status">
                <view class="fund-lock">
                  <image class="fund-lock-icon" src="https://static.haowan.net.cn/miniprogram/pages/game/success-expert/assets/fund-lock-icon.png" mode="aspectFit"></image>
                </view>
                <view class="fund-copy">
                  <text class="fund-title">{{fund.title}}</text>
                  <text class="fund-desc">{{fund.desc}}</text>
                </view>
              </view>
              <text class="fund-amount">{{fund.amountText}}</text>
            </view>
            <view class="fund-progress">
              <view class="fund-progress-fill" style="{{fund.progressStyle}}"></view>
            </view>
            <view class="fund-steps">
              <text wx:for="{{fund.stepLabels}}" wx:key="*this" class="{{index === 0 ? 'active' : ''}}">{{item}}</text>
            </view>
            <text wx:if="{{!fund.stepLabels.length}}" class="fund-desc">{{pageTexts.fundEmptyText}}</text>
          </view>
        </view>

        <view class="section steps-section">
          <view class="steps-card">
            <text class="steps-card-title">{{pageTexts.stepsTitle}}</text>
            <view
              wx:for="{{nextSteps}}"
              wx:key="index"
              class="step-item {{item.active ? 'active' : ''}}"
              data-action="{{item.action}}"
              bindtap="onStepTap"
            >
              <view class="step-index">{{item.index}}</view>
              <view class="step-copy">
                <text class="step-title">{{item.title}}</text>
                <text class="step-desc">{{item.desc}}</text>
              </view>
              <view wx:if="{{item.active}}" class="step-arrow"></view>
            </view>
            <text wx:if="{{!nextSteps.length}}" class="step-desc">{{pageTexts.stepsEmptyText}}</text>
          </view>
        </view>

        <view class="section manage-section">
          <button class="manage-button" hover-class="none" bindtap="onManageTap">{{pageTexts.manageButtonText}}</button>
        </view>

        <view class="bottom-spacer"></view>
        </block>
      </view>
    </scroll-view>

    <view class="success-expert-bottom-bg" style="{{shellLayout.bottomStyle}}"></view>
  </view>
</view>
