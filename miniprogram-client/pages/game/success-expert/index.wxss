page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.success-expert-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.success-expert-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.success-expert-top-bg,
.success-expert-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.success-expert-top-bg {
  z-index: 0;
}

.success-expert-nav {
  z-index: 4;
  box-sizing: border-box;
}

.success-expert-title {
  position: absolute;
  left: 258rpx;
  width: 236rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.success-expert-back,
.success-expert-more {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}

.success-expert-back {
  left: 50rpx;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.success-expert-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.success-expert-more {
  gap: 5rpx;
}

.more-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4b5563;
}

.success-expert-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  color: #111827;
  box-sizing: border-box;
}

.success-expert-inner {
  min-height: 100%;
  padding: 28rpx 32rpx 0;
  box-sizing: border-box;
  background: #f7f8fa;
}

.success-expert-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.success-banner {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 684rpx;
  height: 414rpx;
  margin: 24rpx 0 0;
  padding: 42rpx 30rpx 38rpx;
  overflow: hidden;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(147.99deg, rgba(34, 197, 94, 1) 13.72%, rgba(22, 163, 74, 1) 86.28%);
}

.success-mark {
  position: absolute;
  left: 256rpx;
  top: 48rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.success-icon {
  display: block;
  width: 116rpx;
  height: 116rpx;
}

.success-heading {
  position: absolute;
  left: 0;
  top: 198rpx;
  z-index: 1;
  width: 100%;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.success-subtitle {
  position: absolute;
  left: 0;
  top: 296rpx;
  z-index: 1;
  width: 100%;
  color: rgba(236, 253, 245, 0.96);
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.section {
  width: 686rpx;
  margin: 34rpx auto 0;
}

.group-section {
  margin-top: 32rpx;
}

.section-label {
  display: block;
  padding-left: 4rpx;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.info-card,
.fund-card {
  width: 100%;
  margin-top: 16rpx;
  border: 2rpx solid #eef2f7;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.group-card {
  position: relative;
  width: 684rpx;
  height: 742rpx;
  margin: 0;
  border: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.group-section-title {
  position: absolute;
  left: 42rpx;
  top: 40rpx;
  width: 168rpx;
  height: 48rpx;
  color: rgba(31, 41, 55, 1);
  font-family: "Noto Sans SC", "NotoSans-regular", sans-serif;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: justify;
  white-space: nowrap;
}

.group-panel {
  position: absolute;
  left: 42rpx;
  top: 122rpx;
  width: 600rpx;
  height: 430rpx;
  border-radius: 24rpx;
  background: rgba(239, 246, 255, 1);
  box-sizing: border-box;
  overflow: hidden;
}

.group-head {
  position: absolute;
  left: 0;
  top: 28rpx;
  display: flex;
  align-items: flex-start;
  width: 600rpx;
  height: 100rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: transparent;
}

.group-icon {
  position: relative;
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: #3b82f6;
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.16);
}

.group-person {
  position: absolute;
  border-radius: 999rpx;
  background: #ffffff;
}

.group-person.main {
  left: 34rpx;
  top: 22rpx;
  width: 28rpx;
  height: 28rpx;
}

.group-person.main::after,
.group-person.left::after,
.group-person.right::after {
  position: absolute;
  left: 50%;
  top: 24rpx;
  width: 42rpx;
  height: 22rpx;
  border-radius: 22rpx 22rpx 8rpx 8rpx;
  background: #ffffff;
  transform: translateX(-50%);
  content: "";
}

.group-person.left,
.group-person.right {
  top: 36rpx;
  width: 20rpx;
  height: 20rpx;
  opacity: 0.78;
}

.group-person.left {
  left: 18rpx;
}

.group-person.right {
  right: 18rpx;
}

.group-person.left::after,
.group-person.right::after {
  top: 18rpx;
  width: 30rpx;
  height: 16rpx;
}

.group-copy {
  flex: 1;
  min-width: 0;
}

.group-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.group-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #111827;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.online-pill {
  flex: none;
  display: flex;
  align-items: center;
  height: 38rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #15803d;
  background: #dcfce7;
  font-size: 22rpx;
  line-height: 38rpx;
}

.online-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #22c55e;
}

.group-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.participants-row {
  position: absolute;
  left: 32rpx;
  top: 226rpx;
  display: flex;
  align-items: center;
  width: 544rpx;
  height: 122rpx;
  padding: 0;
  border-top: 0;
  box-sizing: border-box;
}

.participant-list {
  width: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 0 auto;
  min-width: 0;
}

.participant-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 140rpx;
  min-width: 0;
}

.participant-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 4rpx solid #ffffff;
  border-radius: 9999rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: rgba(255, 255, 255, 1);
  font-size: 22rpx;
  font-weight: 600;
	line-height: 30rpx;
	overflow: hidden;
}

.participant-avatar-image {
	display: block;
	width: 100%;
	height: 100%;
}

.participant-avatar.blue {
  background: #3b82f6;
}

.participant-avatar.orange {
  background: #f59e0b;
}

.participant-avatar.pink {
  background: #ec4899;
}

.participant-name,
.participant-role {
  display: block;
  max-width: 140rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-name {
  margin-top: 6rpx;
  color: #111827;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.participant-role {
  color: #6b7280;
  font-size: 20rpx;
  line-height: 26rpx;
}

.chat-button {
  position: absolute;
  left: 50%;
  top: 354rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 534rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 72rpx;
  transform: translateX(-50%);
}

.chat-button::after {
  border: 0;
}

.chat-icon {
  display: block;
  width: 30rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex: none;
}

.hint-box {
  position: absolute;
  left: 42rpx;
  top: 584rpx;
  display: flex;
  align-items: flex-start;
  width: 600rpx;
  min-height: 112rpx;
  padding: 18rpx 28rpx;
  border-top: 0;
  border-radius: 0 0 24rpx 24rpx;
  background: #fffbeb;
  box-sizing: border-box;
}

.hint-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin: 4rpx 16rpx 0 0;
  border-radius: 50%;
  background: #f59e0b;
}

.hint-icon::before {
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 4rpx;
  height: 10rpx;
  border-radius: 4rpx;
  background: #ffffff;
  content: "";
}

.hint-icon::after {
  position: absolute;
  left: 12rpx;
  bottom: 5rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #ffffff;
  content: "";
}

.hint-text {
  flex: 1;
  min-width: 0;
  color: #b45309;
  font-size: 24rpx;
  line-height: 34rpx;
}

.info-section {
  margin-top: 34rpx;
}

.info-card {
  display: flex;
  flex-direction: column;
  width: 684rpx;
  height: 398rpx;
  margin-top: 0;
  padding: 28rpx 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 1);
}

.info-card-title {
  flex: none;
  display: block;
  height: 44rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-height: 0;
  color: #111827;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.info-row.highlight {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.info-label {
  flex: none;
  color: #6b7280;
  font-weight: 400;
}

.info-value {
  margin-left: 20rpx;
  overflow: hidden;
  color: #111827;
  font-weight: 400;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-row.highlight .info-value {
  color: #3b82f6;
  font-weight: 400;
}

.fund-section {
  margin-top: 32rpx;
}

.fund-card {
  width: 684rpx;
  height: 332rpx;
  margin-top: 0;
  padding: 28rpx 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 1);
}

.fund-card-title {
  display: block;
  height: 44rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.fund-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.fund-status {
  display: flex;
  align-items: center;
  min-width: 0;
}

.fund-lock {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: #ecfdf5;
}

.fund-lock-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.fund-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.fund-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.fund-desc {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
}

.fund-amount {
  flex: none;
  margin-left: 20rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.fund-progress {
  position: relative;
  height: 12rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.fund-progress-fill {
  width: 33.33%;
  height: 100%;
  border-radius: 999rpx;
  background: #22c55e;
}

.fund-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
}

.fund-steps text:nth-child(2) {
  text-align: center;
}

.fund-steps text:nth-child(3) {
  text-align: right;
}

.fund-steps .active {
  color: #16a34a;
  font-weight: 600;
}

.steps-card {
  display: flex;
  flex-direction: column;
  width: 684rpx;
  height: 536rpx;
  margin-top: 0;
  padding: 28rpx 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 1);
  box-sizing: border-box;
}

.steps-section {
  margin-top: 32rpx;
}

.steps-card-title {
  flex: none;
  display: block;
  height: 44rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.step-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  flex: none;
  width: 600rpx;
  height: 122rpx;
  margin: 18rpx auto 0;
  padding: 22rpx 18rpx;
  box-sizing: border-box;
}

.step-item.active {
  margin: 34rpx auto 0;
  padding: 22rpx 18rpx;
  border: 2rpx solid #bfdbfe;
  border-radius: 24rpx;
  background: rgba(239, 246, 255, 1);
}

.step-item + .step-item {
  margin-top: 0;
}

.step-index {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #6b7280;
  background: #e5e7eb;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.step-item.active .step-index {
  color: #ffffff;
  background: #3b82f6;
}

.step-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.step-title {
  display: block;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
}

.step-item.active .step-title {
  color: #111827;
  font-weight: 600;
}

.step-desc {
  display: block;
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 32rpx;
}

.step-item.active .step-desc {
  color: #6b7280;
}

.step-arrow {
  flex: none;
  width: 15rpx;
  height: 15rpx;
  margin: 12rpx 0 0 18rpx;
  border-top: 4rpx solid #9ca3af;
  border-right: 4rpx solid #9ca3af;
  transform: rotate(45deg);
}

.manage-section {
  margin-top: 32rpx;
}

.manage-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 684rpx;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-shadow: 0 12rpx 24rpx rgba(59, 130, 246, 0.18);
}

.manage-button::after {
  border: 0;
}

.bottom-spacer {
  height: 56rpx;
}
