page {
  background: #007bd3;
}

.create-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.home-shell-page-title {
  display: none;
}

.create-page {
  min-height: 1227rpx;
  padding: 42rpx 34rpx 96rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #000000;
  color: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.cover-section,
.create-title,
.block-title,
.form-panel {
  width: 662rpx;
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
}

.cover-section {
  display: block;
}

.create-title {
  display: block;
  margin: 0;
  color: #28e2c8;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-align: center;
}

.create-title-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 662rpx;
  max-width: 100%;
  min-height: 50rpx;
  margin: 0 auto 42rpx;
}

.draft-box-button {
  position: absolute;
  /* 标题居中时，操作入口对齐页面右侧安全边距，而不是表单内容右边。 */
  right: -124rpx;
  top: 50%;
  width: 84rpx;
  min-width: 0;
  height: 50rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #72f7e3;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 50rpx;
  box-sizing: border-box;
  transform: translateY(-50%);
}

.draft-box-button::after {
  border: 0;
}

.cover-hint {
  display: block;
  margin-top: 8rpx;
  color: #8f98a6;
  font-size: 22rpx;
  line-height: 32rpx;
}

.section-heading,
.field-heading {
  display: flex;
  align-items: center;
}

.section-title,
.block-title {
  color: #28e2c8;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.section-required,
.field-required {
  color: rgba(199, 225, 255, 0.82);
  font-size: 22rpx;
  line-height: 30rpx;
}

.field-required {
  margin-left: 10rpx;
}

.cover-uploader {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 16rpx 0 42rpx;
  padding: 0;
  border: 0;
  border-radius: 22rpx;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
}

.cover-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.option-chip::after,
.tag-chip::after,
.completion-chip::after,
.outline-chip::after,
.fee-chip::after,
.secondary-action::after,
.primary-action::after {
  border: 0;
}

.plus-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.plus-icon::before,
.plus-icon::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #9ca3af;
  content: '';
}

.plus-icon::before {
  transform: translate(-50%, -50%);
}

.plus-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.block-title {
  display: block;
  margin-top: 0;
  margin-bottom: 22rpx;
}

.form-panel {
  position: relative;
  margin-top: 0;
  margin-bottom: 46rpx;
  /* PT：331pt 宽卡片的内部输入区约 287pt，对应左右 44rpx 内边距。 */
  padding: 34rpx 44rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 36rpx;
  background: #0d6ecb;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08), 0 18rpx 36rpx rgba(0, 55, 120, 0.22);
}

.form-field {
  margin-top: 34rpx;
}

.category-child-field {
  margin-top: 22rpx;
}

.form-field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  color: #28e2c8;
  font-size: 26rpx;
  line-height: 36rpx;
}

.theme-control {
  width: 100%;
  height: 72rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(67, 151, 229, 0.54);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
  text-align: center;
}

.field-count {
  display: block;
  margin-top: 8rpx;
  color: rgba(193, 224, 255, 0.78);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: right;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
}

.type-row {
  flex-wrap: wrap;
  gap: 16rpx;
}

.participation-row {
  flex-wrap: nowrap;
  gap: 12rpx;
}

.chip-row.dense {
  gap: 16rpx;
}

.option-chip,
.outline-chip,
.tag-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 122rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 48rpx;
}

.option-chip {
  min-width: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  background: #ffffff;
  color: #101010;
  font-weight: 400;
}

.type-chip {
  flex: 0 0 124rpx;
  width: 124rpx;
  min-width: 124rpx;
  padding: 0;
}

.participation-chip {
  flex: 1;
  padding: 0 12rpx;
}

.option-chip.active {
  border-color: #ffb13b;
  background: #ffb13b;
  color: #101010;
  font-weight: 400;
}

.divider {
  width: 100%;
  height: 1rpx;
  margin: 34rpx 0 0;
  background: rgba(141, 198, 255, 0.36);
}

.schedule-block {
  padding: 24rpx 0 0;
}

.schedule-block.with-line {
  border-top: 1rpx solid rgba(141, 198, 255, 0.36);
}

.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  box-sizing: border-box;
}

.select-main {
  flex: 1;
  min-width: 0;
}

.field-hint,
.field-tip,
.field-help {
  display: block;
  color: rgba(193, 224, 255, 0.78);
  font-size: 20rpx;
  line-height: 30rpx;
}

.field-hint {
  margin-top: 12rpx;
  text-align: center;
}

.field-help {
  margin-top: 8rpx;
}

.field-tip {
  margin-top: 12rpx;
  text-align: center;
}

.select-action {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 18rpx;
  color: rgba(218, 236, 255, 0.92);
  font-size: 24rpx;
  line-height: 34rpx;
}

.select-action.selected {
  max-width: 270rpx;
  color: #ffffff;
  text-align: right;
}

.select-action.selected text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  margin-left: 8rpx;
  font-size: 42rpx;
  line-height: 34rpx;
}

.time-panel {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(4, 47, 95, 0.42);
}

.time-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.time-picker-cell {
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.time-picker-label,
.time-picker-value {
  display: block;
}

.time-picker-label {
  color: #7b8492;
  font-size: 20rpx;
  line-height: 28rpx;
}

.time-picker-value {
  margin-top: 6rpx;
  color: #101010;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.location-map-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.location-map {
  display: block;
  width: 100%;
  height: 260rpx;
}

.location-map-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #101010;
  font-size: 22rpx;
  line-height: 30rpx;
}

.location-map-footer text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-map-button {
  flex: none;
  height: 48rpx;
  margin: 0 0 0 16rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #ffb13b;
  color: #101010;
  font-size: 20rpx;
  line-height: 48rpx;
}

.location-map-button::after {
  border: 0;
}

.time-panel-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}

.time-panel-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.time-panel-button::after {
  border: 0;
}

.time-panel-button.secondary {
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  background: transparent;
  color: #ffffff;
}

.time-panel-button.primary {
  background: #ffb13b;
  color: #101010;
}

.time-summary {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.time-summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.time-summary-label,
.time-summary-value {
  display: block;
  font-size: 22rpx;
  line-height: 30rpx;
}

.time-summary-label {
  color: #7b8492;
}

.time-summary-value {
  color: #101010;
  text-align: right;
  white-space: nowrap;
}

.location-summary-item {
  align-items: flex-start;
  min-height: 72rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.location-summary-value {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  white-space: normal;
  word-break: break-all;
}

.capacity-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.capacity-slider {
  flex: 1;
  margin: 0 22rpx 0 0;
}

.capacity-input {
  display: flex;
  align-items: center;
  flex: none;
}

.capacity-input input {
  width: 84rpx;
  height: 56rpx;
  margin-right: 10rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #333333;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
}

.capacity-input text {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
}

.tag-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag-chip {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  padding: 0 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  background: #ffffff;
  color: #101010;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 44rpx;
  white-space: nowrap;
}

.tag-chip.active {
  border-color: #ffb13b;
  background: #ffb13b;
  color: #101010;
}

.completion-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.completion-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 44rpx;
  margin: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: #ffffff;
  color: #101010;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 44rpx;
  white-space: nowrap;
}

.completion-chip.active {
  border-color: #ffb13b;
  background: #ffb13b;
  color: #101010;
}

.text-control,
.textarea-control {
  width: 100%;
  margin-top: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #ffffff;
  color: #333333;
  font-size: 24rpx;
}

.text-control {
  height: 72rpx;
  line-height: 72rpx;
}

.textarea-control {
  min-height: 72rpx;
  height: auto;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 34rpx;
}

.intro-help,
.highlights-help,
.description-help,
.notice-help,
.audience-help {
  text-align: left;
  white-space: normal;
  word-break: break-all;
  overflow: visible;
}

.intro-control,
.highlights-control,
.description-control {
  min-height: 72rpx;
  text-align: left;
}

.text-control.centered,
.textarea-control {
  text-align: center;
}

.text-control.notice-control,
.text-control.audience-control {
  text-align: left;
}

.price-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #ffffff;
  color: #333333;
}

.price-control.readonly {
  background: #f4f7fb;
}

.price-input {
  flex: 0 1 180rpx;
  min-width: 0;
  height: 80rpx;
  color: #333333;
  font-size: 24rpx;
  line-height: 80rpx;
  text-align: right;
}

.price-unit,
.price-static {
  color: #333333;
  font-size: 24rpx;
  line-height: 80rpx;
}

.price-unit {
  margin-left: 8rpx;
}

.textarea-control.intro-control,
.textarea-control.highlights-control,
.textarea-control.description-control {
  text-align: left;
}

.description-media-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.description-media-button {
  flex: 1;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 28rpx;
  background: #ffffff;
  color: #101010;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.description-media-button::after,
.description-media-remove::after {
  border: 0;
}

.description-media-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}

.description-media-item {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.18);
}

.description-media-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.description-media-duration {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.62);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 24rpx;
}

.description-media-remove {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.62);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
}

.control-placeholder {
  color: #9098a3;
}

.outline-chip {
  min-width: 130rpx;
  border: 1rpx solid rgba(151, 210, 255, 0.54);
  background: rgba(33, 118, 201, 0.42);
  font-size: 22rpx;
}

.outline-chip.active {
  border-color: rgba(255, 255, 255, 0.64);
  background: rgba(255, 255, 255, 0.18);
}

.fee-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.fee-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 138rpx;
  width: 138rpx;
  min-width: 138rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  background: #ffffff;
  color: #101010;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 48rpx;
  white-space: nowrap;
}

.fee-chip.active {
  border-color: #ffb13b;
  background: #ffb13b;
  color: #101010;
}

.profit-list {
  margin-top: 18rpx;
}

.profit-card {
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
}

.profit-card:first-child {
  margin-top: 0;
}

.profit-card.active {
  border-color: #ffb13b;
  background: #ffb13b;
  box-shadow: 0 10rpx 24rpx rgba(255, 177, 59, 0.28);
}

.profit-card.disabled {
  opacity: 0.58;
}

.profit-card.active .profit-title,
.profit-card.active .profit-desc {
  color: #101010;
}

.profit-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.profit-desc {
  margin-top: 8rpx;
  color: rgba(218, 236, 255, 0.84);
  font-size: 20rpx;
  line-height: 30rpx;
}

.profit-disabled-reason {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  line-height: 30rpx;
}

.rule-box {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(93, 175, 255, 0.36);
  border-radius: 22rpx;
  background: rgba(5, 52, 111, 0.4);
}

.deposit-notice-label {
  color: #ffffff;
}

.rule-box text {
  color: rgba(231, 243, 255, 0.96);
  font-size: 24rpx;
  line-height: 36rpx;
}

.rule-box.subtle text {
  color: rgba(218, 236, 255, 0.84);
  font-size: 22rpx;
  line-height: 34rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  width: 620rpx;
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;
  padding: 6rpx 0 26rpx;
  box-sizing: border-box;
}

.secondary-action,
.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-align: center;
  white-space: nowrap;
}

.secondary-action {
  flex: 1;
  width: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  background: #111111;
  color: #d8dee9;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.72), 0 10rpx 18rpx rgba(0, 0, 0, 0.28);
}

.primary-action {
  width: 264rpx;
  background: linear-gradient(135deg, #0be221 59%, #0af722 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  box-shadow: 0 10rpx 18rpx rgba(20, 126, 43, 0.28);
}

button.primary-action[disabled],
.primary-action.disabled {
  background: linear-gradient(135deg, #0be221 59%, #0af722 100%);
  color: #ffffff;
  opacity: 1;
  box-shadow: 0 10rpx 18rpx rgba(20, 126, 43, 0.28);
}

@media (max-width: 360px) {
  .action-row {
    gap: 10rpx;
  }

  .primary-action {
    width: 238rpx;
    font-size: 24rpx;
  }
}
