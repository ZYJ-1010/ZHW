<home-shell
  online-text="{{onlineText}}"
  nav-items="{{navItems}}"
  nav-toast-enabled="{{false}}"
  bindnavtap="handleShellNavTap"
  bindnavlongpress="handleShellNavLongPress"
  bindnavtouchend="handleShellNavTouchEnd"
>
  <scroll-view
    class="game-hall-scroll"
    scroll-y
    enhanced
    show-scrollbar="false"
    scroll-with-animation
    scroll-top="{{hallScrollTop}}"
    bindscroll="handleHallScroll"
    enable-back-to-top
  >
    <view class="game-hall-page">
      <view class="search-panel">
        <view class="search-symbol"></view>
        <input
          class="search-input"
          placeholder="搜索感兴趣的局、玩家或地点..."
          placeholder-class="search-placeholder"
          value="{{keyword}}"
          bindinput="onSearchInput"
          confirm-type="search"
          bindconfirm="onSearch"
        />
      </view>

      <view class="featured-card" bindtap="onBannerTap">
        <image class="featured-image" src="{{featuredCover}}" mode="aspectFill" />
        <view class="featured-mask"></view>
        <view class="featured-copy">
          <text class="featured-title">真好玩·再玩一局全球首发</text>
          <text class="featured-kicker">HOT 官方局</text>
          <text class="featured-desc">已有 100+人报名</text>
        </view>
      </view>

      <view class="category-row">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-item {{activeFilter === item.key ? 'active' : ''}}"
          bindtap="onCategoryTap"
          data-type="{{item.key}}"
        >
          <view class="category-icon {{item.className}}">
            <image class="category-icon-image" src="{{item.iconSrc}}" mode="aspectFit" />
          </view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>

      <view class="filter-bar">
        <view
          class="filter-tab {{activeFilter === 'all' ? 'active' : ''}}"
          bindtap="onCategoryTap"
          data-type="all"
        >
          <text>全部</text>
          <view class="filter-active-line"></view>
        </view>
        <view class="filter-option {{sortKey === 'time' ? 'active' : ''}}" bindtap="toggleTimeFilter">时间 {{sortKey === 'time' ? sortArrow : '▼'}}</view>
        <view class="filter-option {{sortKey === 'distance' ? 'active' : ''}}" bindtap="toggleLocationFilter">地点·{{nearbyRadiusMeters >= 1000 ? nearbyRadiusMeters / 1000 + 'km' : nearbyRadiusMeters + 'm'}} ▼</view>
        <view class="filter-option {{activeTypeFilter !== 'all' ? 'active' : ''}}" bindtap="toggleTypeFilter">{{typeFilterText}} ▼</view>
        <view class="sort-option {{sortFilterActive ? 'active' : ''}}" bindtap="openSortFilter">
          <text>{{sortFilterText}}</text>
          <text class="sort-arrow">▼</text>
        </view>
      </view>

      <view class="feed-list">
        <view
          wx:for="{{displayEventsList}}"
          wx:key="id"
          class="feed-card-item"
        >
          <game-card
            item="{{item}}"
            bind:cardtap="onViewDetail"
            bind:cardaction="onCardAction"
          />
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{locationGuideVisible}}" class="hall-location-guide">
    <text class="hall-location-guide-title">未获取当前位置</text>
    <text class="hall-location-guide-desc">可开启定位查看附近局，也可手动选位置或使用同城推荐。</text>
    <view class="hall-location-guide-actions">
      <button data-action="setting" bindtap="handleHallLocationGuideTap">开启定位</button>
      <button data-action="manual" bindtap="handleHallLocationGuideTap">手动选位置</button>
      <button data-action="city" bindtap="handleHallLocationGuideTap">同城推荐</button>
    </view>
  </view>

  <view wx:if="{{sortFilterVisible}}" class="sort-filter-mask" catchtap="closeSortFilter">
    <view class="sort-filter-panel" catchtap="noop">
      <view class="sort-filter-header">
        <text class="sort-filter-title">排序</text>
        <text class="sort-filter-reset" bindtap="resetSortFilter">默认</text>
      </view>
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-filter-item {{activeSortMode === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="selectSortFilter"
      >
        <text>{{item.name}}</text>
        <text wx:if="{{activeSortMode === item.key}}" class="sort-filter-check">✓</text>
      </view>
    </view>
  </view>
</home-shell>
