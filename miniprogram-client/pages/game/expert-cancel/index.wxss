page {
  width: 100%;
  height: 100%;
  background: #f7f8fa;
}

.expert-cancel-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f7f8fa;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.expert-cancel-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #f7f8fa;
  box-sizing: border-box;
}

.expert-cancel-top-bg,
.expert-cancel-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.expert-cancel-top-bg {
  z-index: 0;
}

.expert-cancel-nav {
  z-index: 4;
  box-sizing: border-box;
}

.expert-cancel-title {
  position: absolute;
  left: 232rpx;
  width: 286rpx;
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expert-cancel-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.expert-cancel-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.expert-cancel-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  color: #111827;
  box-sizing: border-box;
}

.expert-cancel-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  border-top: 2rpx solid #e5e7eb;
  background: #ffffff;
}

.expert-cancel-inner {
  min-height: 100%;
  padding: 32rpx 32rpx 0 34rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.warning-card,
.section-card {
  width: 684rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
}

.warning-card {
  display: flex;
  align-items: flex-start;
  min-height: 166rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid rgba(254, 202, 202, 1);
  border-radius: 32rpx;
  color: #dc2626;
  background: rgba(254, 242, 242, 1);
}

.warning-icon {
  position: relative;
  flex: none;
  width: 44rpx;
  height: 40rpx;
  margin-top: 4rpx;
}

.warning-icon::before {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  border-right: 22rpx solid transparent;
  border-bottom: 40rpx solid #ef4444;
  border-left: 22rpx solid transparent;
  content: '';
}

.warning-mark {
  position: absolute;
  left: 0;
  top: 7rpx;
  z-index: 1;
  width: 44rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}

.warning-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.warning-title {
  display: block;
  color: #b91c1c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.warning-desc {
  display: block;
  margin-top: 10rpx;
  color: #dc2626;
  font-size: 25rpx;
  line-height: 36rpx;
}

.section-card {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
}

.section-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.compensation-card {
  width: 684rpx;
  height: 662rpx;
  margin-top: 32rpx;
  padding: 30rpx 28rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.ratio-head,
.ratio-limit-row,
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ratio-head {
  margin-top: 30rpx;
}

.ratio-label {
  color: #374151;
  font-size: 27rpx;
  line-height: 38rpx;
}

.ratio-value {
  color: #2563eb;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.ratio-slider {
  margin: 22rpx -6rpx 0;
}

.ratio-limit-row {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 32rpx;
}

.suggestion-row {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 22rpx 22rpx;
  border-radius: 16rpx;
  background: #f9fafb;
}

.suggestion-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin: 4rpx 12rpx 0 0;
  border-radius: 50%;
  color: #ffffff;
  background: #9ca3af;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.suggestion-text {
  flex: 1;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.amount-panel {
  margin-top: 28rpx;
  padding: 28rpx 28rpx;
  border: 2rpx solid #fee2e2;
  border-radius: 24rpx;
  background: #fff5f5;
}

.amount-row {
  min-height: 48rpx;
}

.amount-row + .amount-row {
  margin-top: 20rpx;
}

.amount-row.fee {
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #fee2e2;
}

.amount-label,
.fee-label {
  color: #4b5563;
  font-size: 26rpx;
  line-height: 38rpx;
}

.fee-label {
  display: flex;
  align-items: center;
}

.fee-rate {
  color: #9ca3af;
  font-size: 22rpx;
}

.amount-value {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.amount-value.danger {
  color: #dc2626;
}

.amount-value.muted {
  color: #9ca3af;
  font-size: 26rpx;
  font-weight: 600;
  text-decoration: line-through;
}

.amount-row.total {
  margin-top: 22rpx;
}

.total-label {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.content-spacer {
  height: 42rpx;
}
