page {
  background: #007bd3;
}

.audit-detail-shell {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000000;
}

.audit-detail-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #000000;
}

.audit-detail-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 34rpx 0 232rpx;
  color: #111827;
  background: #000000;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.detail-card,
.recommend-card,
.notice-card {
  width: 682rpx;
  margin-right: auto;
  margin-left: auto;
  box-sizing: border-box;
}

.detail-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.audit-empty-card {
  width: 682rpx;
  margin: 36rpx auto 0;
  padding: 42rpx 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffffff;
}

.audit-empty-title,
.audit-empty-text {
  display: block;
  letter-spacing: 0;
}

.audit-empty-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.audit-empty-text {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.card-head,
.card-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.card-title.block {
  display: block;
  margin-bottom: 26rpx;
}

.upload-card .card-title {
  font-weight: 400;
}

.confirm-card .card-title {
  font-weight: 400;
}

.option-card .card-title {
  font-weight: 400;
}

.card-tip {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.player-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.player-head .card-title {
  font-weight: 400;
}

.player-badge-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
}

.compact-expert-card .player-badge-row {
  margin-top: 0;
}

.compact-expert-card .player-profile {
  margin-top: 24rpx;
}

.player-top-badge {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #1d4ed8;
  background: #dbeafe;
  font-size: 20rpx;
  line-height: 30rpx;
}

.player-top-badge.success {
  color: #16a34a;
  background: #dcfce7;
}

.confirm-pill {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #16a34a;
  background: rgba(34, 197, 94, 0.12);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.confirm-dot {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #22c55e;
}

.confirm-dot::after {
  position: absolute;
  left: 5rpx;
  top: 2rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(42deg);
  content: "";
}

.player-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.player-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: 22rpx;
  color: #ffffff;
  background: #ec4899;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.player-avatar.blue,
.player-avatar.player {
  background: #3b82f6;
}

.player-avatar.pink,
.player-avatar.expert {
  background: #f472b6;
}

.player-avatar-image {
  width: 100%;
  height: 100%;
}

.player-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.player-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.player-name {
  max-width: 300rpx;
  overflow: hidden;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-role-badge {
  flex: none;
  box-sizing: border-box;
  min-width: 68rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 6rpx;
  color: #0891b2;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.player-role-badge.expert {
  color: #65a30d;
}

.player-role-badge.guide {
  color: #c026d3;
}

.player-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.metric-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.metric-tag {
  display: inline-flex;
  align-items: center;
  min-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  color: #4b5563;
  background: #f3f4f6;
  font-size: 20rpx;
  line-height: 28rpx;
}

.metric-tag.gold {
  color: #92400e;
  background: #fef3c7;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.gray-tag {
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  color: #2563eb;
  background: #eff6ff;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.need-panel,
.remark-panel {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.need-panel {
  color: #374151;
  background: #f9fafb;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.need-title {
  display: block;
  margin-bottom: 12rpx;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.profile-section:not(:first-child) {
  margin-top: 18rpx;
}

.compact-profile-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 0;
  background: transparent;
}

.compact-profile-panel .profile-section {
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.compact-profile-panel .profile-section:not(:first-child) {
  margin-top: 0;
}

.compact-profile-panel .profile-section.need {
  background: #f8fafc;
}

.compact-profile-panel .profile-section.domain {
  background: #f8fafc;
}

.compact-profile-panel .profile-section.service {
  background: #eff6ff;
}

.compact-profile-panel .profile-section.time {
  background: #f6f8fb;
}

.compact-profile-panel .profile-section.remark {
  background: #fff1f7;
}

.profile-section-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.profile-section-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-top: 5rpx;
}

.profile-section-copy {
  flex: 1;
  min-width: 0;
  color: #374151;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.profile-section-label {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.compact-profile-panel .profile-section.time .profile-section-copy,
.compact-profile-panel .profile-section.time .profile-section-label,
.compact-profile-panel .profile-section.time .profile-section-text {
  color: #6b7280;
}

.compact-profile-panel .profile-section.remark .profile-section-copy,
.compact-profile-panel .profile-section.remark .profile-section-label,
.compact-profile-panel .profile-section.remark .profile-section-text {
  color: #db2777;
}

.profile-section-text {
  display: inline;
  color: #374151;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.compact-profile-panel .profile-section.remark .profile-section-text {
  color: #9d174d;
}

.profile-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 14rpx;
  margin-top: 10rpx;
}

.profile-tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #2563eb;
  background: #dbeafe;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.compact-profile-panel .profile-section.service .profile-section-label {
  display: block;
  margin-bottom: 12rpx;
  color: #1d4ed8;
}

.compact-profile-panel .profile-section.service .profile-section-text {
  display: block;
  color: #374151;
  line-height: 40rpx;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.clock-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #9ca3af;
  border-radius: 50%;
  box-sizing: border-box;
}

.clock-icon::before,
.clock-icon::after {
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  background: #9ca3af;
  content: "";
}

.clock-icon::before {
  width: 3rpx;
  height: 8rpx;
}

.clock-icon::after {
  width: 8rpx;
  height: 3rpx;
  top: 10rpx;
}

.remark-panel {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #db2777;
  background: #fdf2f8;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.remark-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 24rpx;
  margin-top: 5rpx;
  border-radius: 12rpx;
  background: #ec4899;
}

.remark-icon::after {
  position: absolute;
  left: 8rpx;
  bottom: -6rpx;
  width: 0;
  height: 0;
  border-top: 8rpx solid #ec4899;
  border-right: 8rpx solid transparent;
  content: "";
}

.confirm-list {
  display: flex;
  flex-direction: column;
}

.confirm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 82rpx;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.08);
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.confirm-row.divider {
  border-bottom-color: rgba(17, 24, 39, 0.08);
}

.confirm-row.total {
  min-height: 82rpx;
  padding-top: 8rpx;
  border-bottom: 0;
}

.confirm-label {
  flex: none;
}

.confirm-value {
  min-width: 0;
  color: #374151;
  text-align: right;
}

.confirm-value.highlight {
  color: #f97316;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.confirm-row.total .confirm-label {
  color: #111827;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.confirm-value.success {
  color: #22c55e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.recommend-card {
  position: relative;
  margin-top: 24rpx;
  padding: 34rpx 34rpx 30rpx;
  border: 2rpx solid #fef3c7;
  border-radius: 32rpx;
  background: #fffbeb;
}

.quote-mark {
  position: absolute;
  left: 26rpx;
  top: 18rpx;
  color: #fde68a;
  font-family: Georgia, serif;
  font-size: 76rpx;
  line-height: 76rpx;
}

.recommend-copy {
  display: flex;
  flex-direction: column;
  margin-left: 54rpx;
  gap: 22rpx;
}

.recommend-text {
  color: #374151;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.recommend-author {
  color: #f97316;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: right;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78rpx;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: #f9fafb;
}

.option-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.option-icon {
  flex: none;
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.option-chevron {
  color: #9ca3af;
  font-size: 42rpx;
  line-height: 42rpx;
}

.notice-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 32rpx;
  background: #fffbeb;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #a16207;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.notice-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #fffbeb;
  background: #a16207;
  font-size: 20rpx;
  font-weight: 800;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 34rpx;
}

.notice-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #f59e0b;
}

.audit-detail-action-layer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 18rpx 0 24rpx;
  box-sizing: border-box;
  background: #000000;
  pointer-events: auto;
}

.audit-detail-action-layer .detail-action-bar {
  width: 682rpx;
  min-height: 0;
  margin: 0 auto;
  padding: 0;
  background: transparent;
}

.audit-detail-action-layer .action-buttons {
  height: 86rpx;
}

.audit-detail-action-layer .action-tip {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
}

.audit-readonly-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 682rpx;
  min-height: 86rpx;
  margin: 0 auto;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #6b7280;
  background: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
}

.detail-action.secondary {
  background: #ffffff;
}

.action-tip {
  color: #6b7280;
}
