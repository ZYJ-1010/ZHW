  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.2);
}

.form-card:first-of-type {
