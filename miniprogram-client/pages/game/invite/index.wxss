  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.28);
}

.player-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.player-picker-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.player-picker-title {
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.player-picker-subtitle {
  color: #8c8c8c;
  font-size: 24rpx;
  line-height: 32rpx;
}

.player-picker-close {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #6b7280;
  background: #f3f4f6;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 48rpx;
}

.player-picker-scroll {
  max-height: 540rpx;
}

.invite-bottom-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  padding: 22rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.78) 24%, #000000 100%);
}

.invite-bottom-bar.two-actions {
  display: flex;
  gap: 24rpx;
}

.next-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 92rpx;
  margin: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #4785ff;
  box-shadow: 0 14rpx 30rpx rgba(71, 133, 255, 0.28);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
  white-space: nowrap;
}

.next-button text {
  white-space: nowrap;
}

.next-arrow {
  font-size: 38rpx;
  line-height: 38rpx;
}

.invite-action-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.invite-action-button.secondary {
  color: #111111;
  background: #ffffff;
}

.invite-action-button.primary {
  color: #ffffff;
  background: #4785ff;
  box-shadow: 0 14rpx 30rpx rgba(71, 133, 255, 0.28);
}
