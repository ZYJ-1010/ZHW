.page {
  min-height: 100vh;
  background: #031018;
  color: #ffffff;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  background: #0d8bd3;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
  background: #e94498;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
}

.brand-title,
.brand-online,
.hello-title,
.hello-sub,
.journey-title,
.journey-desc,
.quick-icon,
.quick-title,
.quick-desc,
.section-title,
.section-desc,
.nearby-tag,
.nearby-title,
.nearby-meta {
  display: block;
}

.brand-title {
  color: #b7ff52;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.brand-online {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffcf4f;
  color: #031018;
  font-size: 22rpx;
  font-weight: 800;
}

.content {
  height: calc(100vh - 96rpx);
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.hello {
  padding: 8rpx 12rpx 18rpx;
}

.hello-title {
  color: #b7ff52;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hello-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.journey-card {
  display: flex;
  justify-content: space-between;
  min-height: 236rpx;
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: #086aa5;
  box-sizing: border-box;
}

.journey-copy {
  min-width: 0;
}

.journey-title {
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
}

.journey-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  line-height: 1.45;
}

.login-pill {
  width: 168rpx;
  height: 60rpx;
  margin: 30rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #b7ff52;
  color: #031018;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 60rpx;
}

.rocket,
.earth {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: #031018;
  color: #22d9ff;
  font-size: 30rpx;
  font-weight: 900;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.quick-card {
  min-height: 160rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #07334f;
  box-sizing: border-box;
}

.quick-hot {
  background: #421336;
}

.quick-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #0d8bd3;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.quick-title {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.quick-desc,
.section-desc,
.nearby-meta {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 21rpx;
  line-height: 1.35;
}

.earth-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #064a72;
}

.section-title {
  color: #b7ff52;
  font-size: 30rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 6rpx 16rpx;
}

.section-filter {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #052739;
  color: #ffffff;
  font-size: 20rpx;
}

.nearby-card {
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #086aa5;
}

.cover {
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #e94498, #22d9ff);
}

.nearby-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.nearby-tag {
  width: 88rpx;
  border-radius: 6rpx;
  background: #b7ff52;
  color: #031018;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

.nearby-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.nearby-action {
  flex: 0 0 92rpx;
  text-align: right;
}

.nearby-action text {
  display: block;
  color: #b7ff52;
  font-size: 20rpx;
}

.nearby-action button,
.invite-link {
  margin: 12rpx 0 0;
  padding: 0;
  border: 0;
}

.nearby-action button {
  width: 82rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #e94498;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 42rpx;
}

.invite-link {
  width: 100%;
  height: 72rpx;
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #052739;
  color: #b7ff52;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
}

button::after {
  border: 0;
}
