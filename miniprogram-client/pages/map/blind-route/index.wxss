page {
  width: 100%;
  height: 100%;
  background: #000000;
}

.blind-route-page {
  min-height: 100%;
  padding: 34rpx 28rpx 56rpx;
  box-sizing: border-box;
  color: #ffffff;
  background:
    linear-gradient(180deg, rgba(0, 122, 255, 0.2) 0%, rgba(0, 0, 0, 0) 210rpx),
    #000000;
  font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.blind-route-hero,
.blind-route-card-copy,
.blind-route-recent-copy {
  display: flex;
  flex-direction: column;
}

.blind-route-title,
.blind-route-desc,
.blind-route-card-title,
.blind-route-card-desc,
.blind-route-tag,
.blind-route-section-title,
.blind-route-recent-title,
.blind-route-recent-time,
.blind-route-recent-status {
  display: block;
}

.blind-route-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.blind-route-desc {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 40rpx;
}

.blind-route-card-list {
  margin-top: 48rpx;
}

.blind-route-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 254rpx;
  margin-top: 32rpx;
  padding: 44rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.32);
}

.blind-route-card:first-child {
  margin-top: 0;
}

.blind-route-card.selected {
  border-color: rgba(255, 255, 255, 0.8);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.1), 0 10rpx 26rpx rgba(0, 0, 0, 0.36);
}

.blind-route-card.tone-blue {
  background: linear-gradient(90deg, #1e3c72 0%, #2a5298 100%);
}

.blind-route-card.tone-orange {
  background: linear-gradient(90deg, #ff6b6b 0%, #feca57 100%);
}

.blind-route-card.tone-purple {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.blind-route-card.tone-green {
  background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
}

.blind-route-card.tone-pink {
  background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
}

.blind-route-card-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.blind-route-card-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.blind-route-card-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 32rpx;
}

.blind-route-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.blind-route-tag {
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.blind-route-card-icon {
  position: relative;
  z-index: 1;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-left: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.blind-route-card-icon-image {
  display: block;
  width: 76rpx;
  height: 60rpx;
}

.blind-route-recent {
  margin-top: 48rpx;
  margin-bottom: 0;
  padding: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  box-sizing: border-box;
  background: rgba(20, 25, 45, 0.85);
}

.blind-route-section-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.blind-route-recent-item {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-top: 24rpx;
}

.blind-route-recent-clock {
  position: relative;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.2);
}

.blind-route-recent-clock::before {
  position: absolute;
  left: 30rpx;
  top: 18rpx;
  width: 4rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  content: '';
}

.blind-route-recent-clock::after {
  position: absolute;
  left: 30rpx;
  top: 31rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  transform: rotate(35deg);
  transform-origin: left center;
  content: '';
}

.blind-route-recent-copy {
  flex: 1;
  min-width: 0;
}

.blind-route-recent-title {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.blind-route-recent-time {
  margin-top: 0;
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
  line-height: 30rpx;
}

.blind-route-recent-status {
  flex: none;
  color: #46e986;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}
