page {
  width: 100%;
  height: 100%;
  background: #000000;
}

.city-atlas-page {
  min-height: 100%;
  padding: 16rpx 42rpx 56rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #000000;
  font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.city-atlas-header {
  position: relative;
  display: flex;
  align-items: center;
  height: 68rpx;
}

.city-atlas-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform: translateY(-50%);
}

.city-atlas-back::after {
  border: 0;
}

.city-atlas-back-icon {
  width: 15rpx;
  height: 15rpx;
  border-left: 4rpx solid #9aa6bd;
  border-bottom: 4rpx solid #9aa6bd;
  box-sizing: border-box;
  transform: translateX(0) rotate(45deg);
}

.city-atlas-title,
.city-atlas-section-title,
.city-atlas-unlock-label,
.city-atlas-unlocked-count,
.city-atlas-total-count,
.city-atlas-card-title,
.city-atlas-card-meta,
.city-atlas-card-value,
.city-atlas-star,
.city-atlas-value-text,
.city-atlas-route-title,
.city-atlas-route-meta,
.city-atlas-route-progress {
  display: block;
}

.city-atlas-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-unlock-panel {
  position: relative;
  min-height: 238rpx;
  margin-top: 10rpx;
  padding: 54rpx 34rpx 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #111827;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.38);
}

.city-atlas-unlock-copy {
  padding-right: 190rpx;
}

.city-atlas-unlock-label {
  color: #9aa6bd;
  font-size: 22rpx;
  line-height: 32rpx;
}

.city-atlas-count-row {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
}

.city-atlas-unlocked-count {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.city-atlas-total-count {
  margin-left: 10rpx;
  color: #9aa6bd;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.city-atlas-ring {
  position: absolute;
  right: 36rpx;
  top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border: 8rpx solid #2f8cff;
  border-radius: 50%;
  box-sizing: border-box;
  background: #111827;
}

.city-atlas-ring-core {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #111827;
}

.city-atlas-ring-core text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.city-atlas-progress-track {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 34rpx;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #344052;
}

.city-atlas-progress-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #1789ff 0%, #8a59f7 100%);
}

.city-atlas-filter-scroll {
  width: 100%;
  margin-top: 34rpx;
  white-space: nowrap;
}

.city-atlas-filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
}

.city-atlas-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  min-width: 116rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.11);
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #a8b2c5;
  background: #111827;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 70rpx;
}

.city-atlas-filter.active {
  border-color: #087ff2;
  color: #ffffff;
  background: #087ff2;
}

.city-atlas-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
  margin-top: 28rpx;
}

.city-atlas-card {
  min-width: 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #111827;
}

.city-atlas-card-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 192rpx;
  overflow: hidden;
}

.city-atlas-card.status-locked .city-atlas-card-cover {
  background: #1f2937;
}

.city-atlas-card.tone-blue .city-atlas-card-cover {
  background: linear-gradient(135deg, #0578e8 0%, #8053e8 100%);
}

.city-atlas-card.tone-green .city-atlas-card-cover {
  background: linear-gradient(135deg, #3ca35c 0%, #349e99 100%);
}

.city-atlas-card.tone-locked .city-atlas-card-cover {
  background: #1f2937;
}

.city-atlas-card.tone-purple .city-atlas-card-cover {
  background: linear-gradient(135deg, #581c87 0%, #000000 100%);
}

.city-atlas-card.status-locked {
  border-color: rgba(255, 255, 255, 0.08);
}

.city-atlas-card.status-locked .city-atlas-card-title,
.city-atlas-card.status-locked .city-atlas-card-meta {
  color: #6f7a8c;
}

.city-atlas-card.status-locked .city-atlas-card-title {
  color: #d7dde8;
}

.city-atlas-check,
.city-atlas-hidden-badge {
  position: absolute;
}

.city-atlas-check {
  right: 20rpx;
  top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  color: #111827;
  background: #ffc444;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 50rpx;
}

.city-atlas-hidden-badge {
  right: 18rpx;
  top: 18rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.city-atlas-card-body {
  min-height: 176rpx;
  padding: 26rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.city-atlas-card-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-card-meta {
  margin-top: 12rpx;
  overflow: hidden;
  color: #a8b2c5;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-card-value {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  overflow: hidden;
}

.city-atlas-star {
  flex: none;
  margin-right: 8rpx;
  color: #ffc444;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.city-atlas-value-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #d7dde8;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-route-section {
  margin-top: 56rpx;
}

.city-atlas-section-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.city-atlas-route-list {
  margin-top: 24rpx;
}

.city-atlas-route-card {
  display: flex;
  align-items: center;
  min-height: 180rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #111827;
}

.city-atlas-route-card + .city-atlas-route-card {
  margin-top: 22rpx;
}

.city-atlas-route-icon {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-right: 26rpx;
  border-radius: 12rpx;
}

.city-atlas-route-card.tone-sunset .city-atlas-route-icon {
  background: linear-gradient(135deg, #e84ea3 0%, #ff944d 100%);
}

.city-atlas-route-card.tone-cyan .city-atlas-route-icon {
  background: linear-gradient(135deg, #198cff 0%, #35d5d3 100%);
}

.city-atlas-route-emoji {
  display: block;
  font-size: 44rpx;
  line-height: 52rpx;
}

.city-atlas-route-copy {
  flex: 1;
  min-width: 0;
}

.city-atlas-route-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-route-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #a8b2c5;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-route-progress {
  margin-top: 8rpx;
  overflow: hidden;
  color: #52a8ff;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-atlas-route-arrow {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  margin-left: 20rpx;
  border-right: 6rpx solid #526077;
  border-bottom: 6rpx solid #526077;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.city-atlas-point-icon {
  position: relative;
  width: 78rpx;
  height: 78rpx;
}

.icon-building {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #08111f;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  background:
    linear-gradient(90deg, #2baeea 0 16rpx, transparent 16rpx 24rpx, #2baeea 24rpx 40rpx, transparent 40rpx 48rpx, #2baeea 48rpx 64rpx),
    repeating-linear-gradient(180deg, #ffc444 0 8rpx, #129bd8 8rpx 18rpx);
  box-sizing: border-box;
}

.icon-building::before {
  position: absolute;
  right: -22rpx;
  top: -16rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fff34d;
  box-shadow: -9rpx 5rpx 0 #08111f;
  content: "";
}

.icon-building::after {
  position: absolute;
  left: -18rpx;
  bottom: 0;
  width: 18rpx;
  height: 36rpx;
  border: 5rpx solid #08111f;
  border-right: 0;
  background: #1d9bd1;
  content: "";
}

.icon-lantern {
  width: 58rpx;
  height: 70rpx;
  border: 6rpx solid #08111f;
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  box-sizing: border-box;
  background: repeating-linear-gradient(180deg, #ff4646 0 10rpx, #d92538 10rpx 18rpx);
}

.icon-lantern::before,
.icon-lantern::after {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #08111f;
  content: "";
}

.icon-lantern::before {
  top: -5rpx;
}

.icon-lantern::after {
  bottom: -5rpx;
}

.icon-lock {
  width: 58rpx;
  height: 44rpx;
  margin-top: 22rpx;
  border-radius: 10rpx;
  background: #3c4656;
}

.icon-lock::before {
  position: absolute;
  left: 11rpx;
  top: -28rpx;
  width: 36rpx;
  height: 36rpx;
  border: 8rpx solid #3c4656;
  border-bottom: 0;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.icon-hidden {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  color: #c084fc;
  font-size: 78rpx;
  font-weight: 900;
  line-height: 78rpx;
  text-shadow: 0 0 18rpx rgba(192, 132, 252, 0.48);
}

.icon-hidden::before {
  content: "?";
}

.icon-hidden::after {
  content: none;
}
