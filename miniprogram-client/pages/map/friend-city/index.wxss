page {
  width: 100%;
  height: 100%;
  background: #000000;
}

.friend-city-page {
  min-height: 100%;
  padding: 16rpx 42rpx 58rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #000000;
  font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.friend-city-header {
  position: relative;
  display: flex;
  align-items: center;
  height: 68rpx;
}

.friend-city-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform: translateY(-50%);
}

.friend-city-back::after {
  border: 0;
}

.friend-city-back-icon {
  width: 15rpx;
  height: 15rpx;
  border-left: 4rpx solid #9aa6bd;
  border-bottom: 4rpx solid #9aa6bd;
  box-sizing: border-box;
  transform: translateX(0) rotate(45deg);
}

.friend-city-title,
.friend-player-name,
.friend-player-count,
.friend-vs-text,
.friend-vs-subtitle,
.friend-section-title,
.friend-challenge-title,
.friend-challenge-time,
.friend-status-pill,
.friend-progress-meta text,
.friend-rank-number,
.friend-rank-name,
.friend-rank-desc,
.friend-rank-score {
  display: block;
}

.friend-city-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 48rpx;
  letter-spacing: 0;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-duel-card {
  min-height: 408rpx;
  margin-top: 10rpx;
  padding: 34rpx 30rpx 36rpx;
  border: 2rpx solid rgba(8, 127, 242, 0.82);
  border-radius: 0;
  box-sizing: border-box;
  background: #101526;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.03), 0 10rpx 24rpx rgba(0, 0, 0, 0.28);
}

.friend-duel-top {
  display: grid;
  grid-template-columns: 1fr 108rpx 1fr;
  align-items: center;
}

.friend-player {
  min-width: 0;
  text-align: center;
}

.friend-avatar-ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 114rpx;
  height: 114rpx;
  margin: 0 auto;
  border: 8rpx solid #3b82ff;
  border-radius: 50%;
  box-sizing: border-box;
}

.friend-player.rival .friend-avatar-ring {
  border-color: #a855f7;
}

.friend-avatar-placeholder {
  position: relative;
  width: 30rpx;
  height: 24rpx;
  border: 4rpx solid #94a3b8;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.friend-avatar-placeholder::before {
  position: absolute;
  left: 4rpx;
  top: 5rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #94a3b8;
  content: "";
}

.friend-avatar-placeholder::after {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 3rpx;
  height: 9rpx;
  background: linear-gradient(135deg, transparent 0%, transparent 32%, #94a3b8 33%, #94a3b8 48%, transparent 49%, transparent 58%, #94a3b8 59%, #94a3b8 100%);
  content: "";
}

.friend-player-name {
  margin-top: 18rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-player-count {
  margin-top: 2rpx;
  overflow: hidden;
  color: #60a5fa;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-player.rival .friend-player-count {
  color: #c084fc;
}

.friend-vs {
  min-width: 0;
  text-align: center;
}

.friend-vs-text {
  color: #ff4343;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.friend-vs-subtitle {
  margin-top: 8rpx;
  color: #9aa6bd;
  font-size: 20rpx;
  line-height: 28rpx;
}

.friend-action-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 30rpx;
  padding: 0;
}

.friend-primary-button,
.friend-secondary-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 208rpx;
  min-width: 208rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 76rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-more-button::after {
  border: 0;
}

.friend-primary-button {
  background: #2563eb;
}

.friend-secondary-button {
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  background: #151b31;
}

.friend-section {
  margin-top: 30rpx;
}

.friend-section-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.friend-section-title.spaced {
  letter-spacing: 0;
}

.friend-challenge-list,
.friend-ranking-card {
  margin-top: 20rpx;
}

.friend-challenge-card,
.friend-ranking-card {
  border: 2rpx solid rgba(90, 105, 150, 0.38);
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #101526;
}

.friend-challenge-card {
  min-height: 224rpx;
  padding: 24rpx 28rpx 22rpx;
}

.friend-challenge-card + .friend-challenge-card {
  margin-top: 24rpx;
}

.friend-challenge-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.friend-challenge-copy {
  flex: 1;
  min-width: 0;
}

.friend-challenge-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-challenge-time {
  margin-top: 8rpx;
  color: #9aa6bd;
  font-size: 18rpx;
  line-height: 28rpx;
}

.friend-status-pill {
  flex: none;
  min-width: 74rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #ffd51e;
  background: rgba(120, 86, 0, 0.58);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-align: center;
}

.friend-status-pill.leading {
  color: #40f58d;
  background: rgba(15, 103, 59, 0.68);
}

.friend-progress-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-top: 22rpx;
}

.friend-progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #e5ebf5;
  font-size: 18rpx;
  line-height: 28rpx;
}

.friend-progress-meta text:last-child {
  color: #60a5fa;
  font-size: 20rpx;
}

.friend-progress-block:nth-child(2) .friend-progress-meta text:last-child {
  color: #c084fc;
}

.friend-progress-track {
  height: 14rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #334155;
}

.friend-progress-fill {
  height: 100%;
  border-radius: inherit;
}

.friend-progress-fill.self {
  background: #3b82f6;
}

.friend-progress-fill.rival {
  background: #a855f7;
}

.friend-ranking-card {
  min-height: 604rpx;
  padding: 22rpx 26rpx 26rpx;
}

.friend-rank-row {
  display: grid;
  grid-template-columns: 64rpx 52rpx 1fr auto;
  align-items: center;
  min-height: 104rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #151c2d;
}

.friend-rank-row + .friend-rank-row {
  margin-top: 16rpx;
}

.friend-rank-row.tone-gold {
  border: 2rpx solid rgba(234, 179, 8, 0.58);
  background: rgba(234, 179, 8, 0.1);
}

.friend-rank-row.tone-bronze {
  border: 2rpx solid rgba(249, 115, 22, 0.48);
  background: rgba(127, 29, 29, 0.22);
}

.friend-rank-number {
  color: #94a3b8;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.friend-rank-row.tone-gold .friend-rank-number,
.friend-rank-row.tone-gold .friend-rank-score {
  color: #facc15;
}

.friend-rank-row.tone-bronze .friend-rank-number,
.friend-rank-row.tone-bronze .friend-rank-score {
  color: #fb923c;
}

.friend-rank-avatar {
  position: relative;
  width: 24rpx;
  height: 22rpx;
  border: 4rpx solid #94a3b8;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.friend-rank-avatar::before {
  position: absolute;
  left: 3rpx;
  top: 4rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #94a3b8;
  content: "";
}

.friend-rank-avatar::after {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  bottom: 3rpx;
  height: 8rpx;
  background: linear-gradient(135deg, transparent 0%, transparent 35%, #94a3b8 36%, #94a3b8 50%, transparent 51%, transparent 60%, #94a3b8 61%, #94a3b8 100%);
  content: "";
}

.friend-rank-copy {
  min-width: 0;
  padding-left: 18rpx;
}

.friend-rank-name {
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-rank-desc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #9aa6bd;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-rank-score {
  margin-left: 18rpx;
  color: #d8deea;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.friend-more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 26rpx auto 0;
  padding: 0 20rpx;
  color: #60a5fa;
  background: transparent;
  font-size: 24rpx;
  line-height: 64rpx;
}
