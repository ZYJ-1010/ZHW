page {
  width: 100%;
  height: 100%;
  background: #0f172a;
}

.nearby-map-page {
  width: 100%;
  min-height: 100%;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  overflow: visible;
  color: #ffffff;
  background: #101827;
  font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.map-top-panel {
  flex: 0 0 auto;
  padding: 18rpx 22rpx 14rpx;
  box-sizing: border-box;
  background: #101827;
}

.map-search-field {
  position: relative;
  display: flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx 0 62rpx;
  border: 2rpx solid #2e3a52;
  border-radius: 10rpx;
  box-sizing: border-box;
  background: #08111f;
}

.map-search-icon {
  position: absolute;
  left: 24rpx;
  top: 18rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #8aa0b8;
  border-radius: 50%;
  box-sizing: border-box;
}

.map-search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #8aa0b8;
  transform: rotate(45deg);
  content: "";
}

.map-search-input {
  width: 100%;
  height: 54rpx;
  min-height: 54rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 54rpx;
}

.map-search-placeholder {
  color: #7d8aa0;
  font-size: 22rpx;
}

.map-filter-scroll {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.map-filter-row {
  display: inline-flex;
  align-items: center;
  min-width: 100%;
}

.map-filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 18rpx;
  border: 2rpx solid #313b51;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #afbad0;
  background: #20283a;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.map-filter-pill + .map-filter-pill {
  margin-left: 10rpx;
}

.map-filter-pill.active {
  border-color: #14c58a;
  color: #ffffff;
  background: #087f5b;
}

.nearby-map-card {
  position: relative;
  width: 100%;
  height: 538rpx;
  overflow: hidden;
  background: #dbe5ed;
}

.nearby-map {
  width: 100%;
  height: 100%;
}

.map-loading-tip {
  position: absolute;
  left: 50%;
  top: 22rpx;
  z-index: 20;
  width: 248rpx;
  height: 44rpx;
  margin-left: -124rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.12);
}

.map-tool-stack {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  z-index: 22;
  width: 56rpx;
}

.map-tool-button {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 14rpx;
  border-radius: 50%;
  color: #06b6d4;
  background: rgba(255, 255, 255, 0.94);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.18);
}

.map-tool-button.radius {
  color: #0891b2;
  font-size: 18rpx;
}

.map-legend-panel {
  position: absolute;
  left: 28rpx;
  bottom: 40rpx;
  z-index: 24;
  width: 230rpx;
  padding: 16rpx 16rpx 14rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: rgba(10, 16, 28, 0.92);
  box-shadow: 0 16rpx 34rpx rgba(15, 23, 42, 0.34);
}

.map-legend-row {
  display: flex;
  align-items: center;
  height: 38rpx;
}

.map-legend-row + .map-legend-row {
  margin-top: 6rpx;
}

.map-legend-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.map-legend-dot.groups {
  border: 4rpx solid #d1fae5;
  background: transparent;
}

.map-legend-dot.location {
  border: 4rpx solid #dbeafe;
  background: #22d3ee;
  box-shadow: 0 0 0 6rpx rgba(34, 211, 238, 0.16);
}

.map-legend-dot.online {
  border: 3rpx solid #dcfce7;
  background: #22c55e;
  box-shadow: 0 0 16rpx rgba(34, 197, 94, 0.78);
}

.map-legend-dot.offline {
  border: 3rpx solid #475569;
  background: #1f2937;
  opacity: 0.72;
}

.map-legend-label {
  display: block;
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  overflow: hidden;
  color: #e5e7eb;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-date-range {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  z-index: 22;
  color: #08bfc8;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 26rpx;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.8);
}

.marker-info-card {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 84rpx;
  z-index: 30;
  min-height: 204rpx;
  padding: 18rpx 20rpx 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #111827;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.32);
}

.game-info-card {
  border: 2rpx solid rgba(52, 211, 153, 0.34);
  background: linear-gradient(180deg, #12302f 0%, #101827 100%);
}

.player-info-card {
  border: 2rpx solid rgba(96, 165, 250, 0.28);
  background: linear-gradient(180deg, #17243a 0%, #101827 100%);
}

.marker-info-head,
.marker-info-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.marker-info-status {
  display: inline-block;
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #86efac;
  background: rgba(34, 197, 94, 0.18);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.marker-info-status.online {
  color: #bbf7d0;
  background: rgba(34, 197, 94, 0.22);
}

.marker-info-status.offline {
  color: #cbd5e1;
  background: rgba(71, 85, 105, 0.38);
}

.marker-info-close {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #cbd5e1;
  background: rgba(255, 255, 255, 0.12);
  font-size: 30rpx;
  line-height: 38rpx;
  text-align: center;
}

.marker-info-title,
.marker-info-desc,
.marker-info-meta,
.nearby-info-card-title,
.nearby-info-desc {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.marker-info-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.marker-info-desc {
  margin-top: 6rpx;
  color: #cbd5e1;
  font-size: 22rpx;
  line-height: 30rpx;
}

.marker-info-meta {
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 28rpx;
}

.marker-info-foot {
  margin-top: 14rpx;
}

.marker-info-price {
  color: #a7f3d0;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.marker-info-action {
  width: 132rpx;
  height: 48rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #10b981;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.nearby-info-section {
  padding: 20rpx 22rpx 34rpx;
  box-sizing: border-box;
  background: #101827;
}

.nearby-info-title-row {
  display: flex;
  align-items: center;
  height: 46rpx;
}

.nearby-info-mark {
  display: block;
  margin-right: 10rpx;
  color: #facc15;
  font-size: 24rpx;
  line-height: 34rpx;
}

.nearby-info-title {
  display: block;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.nearby-info-list {
  margin-top: 8rpx;
}

.nearby-empty {
  padding: 34rpx 20rpx;
  border-radius: 12rpx;
  color: #94a3b8;
  background: #1a2334;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.nearby-info-card {
  padding: 22rpx;
  border: 2rpx solid #34445f;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #233049 0%, #1b263a 100%);
  box-shadow: 0 10rpx 26rpx rgba(6, 12, 24, 0.2);
}

.nearby-info-card + .nearby-info-card {
  margin-top: 18rpx;
}

.nearby-info-card.active {
  border-color: #35d39d;
  box-shadow: 0 0 0 4rpx rgba(53, 211, 157, 0.12);
}

.nearby-info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.nearby-info-card-title {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.nearby-info-badge {
  flex: none;
  height: 34rpx;
  margin-left: 16rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #c7f9e6;
  background: rgba(16, 185, 129, 0.24);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.nearby-info-desc {
  margin-top: 8rpx;
  color: #9aa8be;
  font-size: 20rpx;
  line-height: 30rpx;
}

.nearby-info-actions {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.nearby-info-action {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: 0;
  min-width: 0;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 62rpx;
}

.nearby-info-action + .nearby-info-action {
  margin-left: 18rpx;
}

.nearby-info-action::after {
  border: 0;
}

.nearby-info-action.primary {
  color: #07111f;
  background: #55e0ae;
}

.nearby-info-action.secondary {
  color: #ffffff;
  background: #263248;
}
