<home-shell
  online-text="{{onlineText}}"
  nav-items="{{navItems}}"
  nav-toast-enabled="{{false}}"
  content-scroll-y="{{true}}"
  bindnavtap="handleShellNavTap"
>
  <view class="nearby-map-page">
    <view class="map-top-panel">
      <view class="map-search-field">
        <view class="map-search-icon"></view>
        <input
          class="map-search-input"
          disabled
          placeholder="{{mapTexts.searchPlaceholder}}"
          placeholder-class="map-search-placeholder"
        />
      </view>

      <scroll-view class="map-filter-scroll" scroll-x enhanced show-scrollbar="false">
        <view class="map-filter-row">
          <view
            wx:for="{{mapFilters}}"
            wx:key="*this"
            data-index="{{index}}"
            class="map-filter-pill {{index === activeFilterIndex ? 'active' : ''}}"
            bindtap="handleMapFilterTap"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>

    </view>

    <view class="nearby-map-card">
      <map
        id="nearbyMap"
        class="nearby-map"
        latitude="{{latitude}}"
        longitude="{{longitude}}"
        scale="{{scale}}"
        markers="{{markers}}"
        circles="{{circles}}"
        show-location="{{true}}"
        enable-zoom="{{true}}"
        enable-scroll="{{true}}"
        bindmarkertap="handleMarkerTap"
        bindcallouttap="handleMarkerTap"
        bindregionchange="handleRegionChange"
        bindtap="handleMapTap"
      ></map>

      <cover-view wx:if="{{loadingNearby}}" class="map-loading-tip">{{mapTexts.loadingNearbyText}}</cover-view>

      <cover-view class="map-tool-stack">
        <cover-view class="map-tool-button" data-action="locate" bindtap="handleMapToolTap">{{mapTexts.locateToolText}}</cover-view>
        <cover-view class="map-tool-button" data-action="refresh" bindtap="handleMapToolTap">{{mapTexts.refreshToolText}}</cover-view>
        <cover-view class="map-tool-button radius" data-action="radius" bindtap="handleMapToolTap">{{radiusButtonText}}</cover-view>
      </cover-view>

      <cover-view class="map-legend-panel">
        <cover-view
          wx:for="{{mapLegendItems}}"
          wx:key="key"
          class="map-legend-row"
        >
          <cover-view class="map-legend-dot {{item.key}}"></cover-view>
          <cover-view class="map-legend-label">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>

      <cover-view class="map-date-range">{{mapTexts.dateRangeText}}</cover-view>

      <cover-view wx:if="{{selectedPlayer}}" class="marker-info-card player-info-card">
        <cover-view class="marker-info-head">
          <cover-view class="marker-info-status {{selectedPlayer.status}}">{{selectedPlayer.statusText}}</cover-view>
          <cover-view class="marker-info-close" bindtap="handleCloseInfoTap">×</cover-view>
        </cover-view>
        <cover-view class="marker-info-title">{{selectedPlayer.name}}</cover-view>
        <cover-view class="marker-info-foot">
          <cover-view class="marker-info-price">{{selectedPlayer.statusText}}</cover-view>
          <cover-view class="marker-info-action" bindtap="handlePlayerDetailTap">{{mapTexts.playerDetailActionText}}</cover-view>
        </cover-view>
        <cover-view class="marker-info-desc">{{selectedPlayer.distanceText}} · {{selectedPlayer.activeText}}</cover-view>
        <cover-view class="marker-info-meta">{{selectedPlayer.status === 'online' ? mapTexts.currentInteractText : mapTexts.offlineInteractText}}</cover-view>
      </cover-view>

    </view>

    <view wx:if="{{locationGuideVisible}}" class="location-guide-card">
      <text class="location-guide-title">未获取当前位置</text>
      <text class="location-guide-desc">可开启定位查看附近组局，也可手动选点或使用同城推荐。</text>
      <view class="location-guide-actions">
        <button data-action="setting" bindtap="handleLocationGuideTap">开启定位</button>
        <button data-action="manual" bindtap="handleLocationGuideTap">手动选位置</button>
        <button data-action="city" bindtap="handleLocationGuideTap">同城推荐</button>
      </view>
    </view>

    <view class="nearby-info-section">
      <view class="nearby-info-title-row">
        <text class="nearby-info-mark">✦</text>
        <text class="nearby-info-title">{{mapTexts.nearbySectionTitle}}</text>
      </view>

      <view class="nearby-info-list">
        <view wx:if="{{!nearbyItems.length && !loadingNearby}}" class="nearby-empty">
          <text>{{mapTexts.nearbyEmptyText}}</text>
        </view>

        <view
          wx:for="{{nearbyItems}}"
          wx:key="id"
          data-marker-id="{{item.markerId}}"
          class="nearby-info-card {{selectedMarkerId === item.markerId ? 'active' : ''}}"
          bindtap="handleNearbyItemTap"
        >
          <view class="nearby-info-head">
            <text class="nearby-info-card-title">{{item.title}}</text>
            <text class="nearby-info-badge">{{item.statusText}}</text>
          </view>
          <text class="nearby-info-desc">{{item.distanceText}} · {{item.memberText}} · {{item.addressText}}</text>
          <text class="nearby-info-desc">{{item.timeText}} · {{item.priceText}}</text>
          <view class="nearby-info-actions">
            <button
              class="nearby-info-action primary"
              data-marker-id="{{item.markerId}}"
              data-action="detail"
              catchtap="handleNearbyActionTap"
            >
              {{mapTexts.detailActionText}}
            </button>
            <button
              class="nearby-info-action secondary"
              data-marker-id="{{item.markerId}}"
              data-action="join"
              catchtap="handleNearbyActionTap"
            >
              {{mapTexts.joinActionText}}
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
</home-shell>
