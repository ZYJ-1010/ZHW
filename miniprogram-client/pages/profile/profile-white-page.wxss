page {
  width: 100%;
  height: 100%;
  background: #f8fafd;
}

.profile-page {
  min-height: 100%;
  padding: 24rpx 34rpx 72rpx;
  box-sizing: border-box;
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.profile-page.is-white {
  background: #ffffff;
}

.profile-tabs,
.profile-filter-tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 0 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.profile-tab,
.profile-filter-tab {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #6b7280;
  background: #f3f4f6;
  font-size: 25rpx;
  line-height: 34rpx;
}

.profile-tab.active,
.profile-filter-tab.active {
  color: #ffffff;
  background: #111827;
  font-weight: 400;
}

.profile-section {
  margin-top: 24rpx;
}

.profile-section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.profile-card {
  overflow: hidden;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.profile-card + .profile-card {
  margin-top: 24rpx;
}

.profile-card-body {
  padding: 28rpx;
  box-sizing: border-box;
}

.profile-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.profile-title-group {
  flex: 1;
  min-width: 0;
}

.profile-card-title {
  display: block;
  overflow: hidden;
  color: #111827;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card-desc,
.profile-muted {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 36rpx;
}

.profile-status {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  box-sizing: border-box;
  color: #2563eb;
  background: #dbeafe;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.profile-status.green {
  color: #047857;
  background: #d1fae5;
}

.profile-status.gray {
  color: #6b7280;
  background: #f3f4f6;
}

.profile-status.orange {
  color: #c2410c;
  background: #ffedd5;
}

.profile-status.red {
  color: #dc2626;
  background: #fee2e2;
}

.profile-meta-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
}

.profile-meta-item {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.profile-action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
}

.profile-action,
.profile-action-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.profile-action {
  color: #ffffff;
  background: #2563eb;
}

.profile-action-secondary {
  color: #374151;
  background: #f3f4f6;
}

.profile-list-card {
  overflow: hidden;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.profile-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-bottom: 2rpx solid #f1f5f9;
}

.profile-list-row:last-child {
  border-bottom: 0;
}

.profile-row-title {
  color: #111827;
  font-size: 28rpx;
  line-height: 38rpx;
}

.profile-row-value {
  max-width: 360rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-save-bar {
  margin-top: 44rpx;
  padding: 0 20rpx;
}

.profile-save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  color: #ffffff;
  background: #111827;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.profile-warning {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #92400e;
  background: #fffbeb;
}

.profile-warning-title {
  display: block;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.profile-warning-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.profile-dot {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
}

.profile-empty-note {
  display: block;
  margin-top: 26rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}
