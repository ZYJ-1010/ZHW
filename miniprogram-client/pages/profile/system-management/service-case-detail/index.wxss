page {
  background: #070b14;
}

.case-detail-page {
  min-height: 100%;
  height: auto;
  padding: 26rpx 74rpx 132rpx;
  box-sizing: border-box;
  background: #070b14;
  color: #eef3ff;
}

.hero-card,
.info-card {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid rgba(46, 76, 139, 0.68);
  border-radius: 34rpx;
  background: #121927;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.02);
}

.hero-card {
  min-height: 370rpx;
  padding: 50rpx 52rpx 42rpx;
  background: linear-gradient(132deg, #10223f 0%, #15152b 78%);
  overflow: hidden;
}

.case-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
}

.case-cover.blue {
  background: linear-gradient(135deg, #1b9dff 0%, #14c4d7 100%);
}

.case-cover.purple {
  background: linear-gradient(135deg, #a065ff 0%, #6e4bea 100%);
}

.case-cover.orange {
  background: linear-gradient(135deg, #ff4d4d 0%, #ff7a37 100%);
}

.case-cover-emoji {
  display: block;
  font-size: 64rpx;
  line-height: 1;
  transform: translateY(2rpx);
}

.hero-title {
  display: block;
  margin-top: 44rpx;
  color: #f2f6ff;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  white-space: normal;
  word-break: break-all;
}

.case-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 22rpx;
  margin-top: 31rpx;
  color: rgba(188, 199, 220, 0.64);
  font-size: 20rpx;
  line-height: 25rpx;
}

.meta-item,
.mini-rating {
  display: flex;
  align-items: center;
}

.meta-icon {
  width: 21rpx;
  height: 21rpx;
  margin-right: 15rpx;
  opacity: 0.78;
}

.meta-icon.users {
  width: 24rpx;
  height: 22rpx;
}

.mini-rating {
  gap: 7rpx;
}

.mini-star {
  width: 20rpx;
  height: 20rpx;
}

.mini-star.inactive {
  opacity: 0.28;
}

.mini-rating text {
  margin-left: 7rpx;
}

.info-card {
  margin-top: 42rpx;
  padding: 53rpx 42rpx;
}

.rating-card {
  min-height: 310rpx;
}

.rating-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title,
.players-title {
  color: #d9e0ec;
  font-size: 25rpx;
  line-height: 35rpx;
  font-weight: 700;
}

.rating-score {
  display: flex;
  align-items: center;
}

.score-star {
  width: 29rpx;
  height: 29rpx;
  margin-right: 12rpx;
}

.score-star.inactive {
  opacity: 0.28;
}

.score-text {
  margin-left: 2rpx;
  color: #ffc526;
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 400;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx 20rpx;
  margin-top: 37rpx;
}

.tag-pill {
  min-width: 98rpx;
  height: 52rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(43, 105, 208, 0.58);
  border-radius: 30rpx;
  box-sizing: border-box;
  color: #2f78ff;
  font-size: 22rpx;
  line-height: 50rpx;
  text-align: center;
  background: rgba(18, 44, 82, 0.54);
}

.service-card {
  padding: 50rpx 42rpx 56rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
}

.title-icon {
  width: 25rpx;
  height: 32rpx;
  margin-right: 18rpx;
  opacity: 0.78;
}

.service-copy {
  margin-top: 36rpx;
}

.service-line {
  margin-bottom: 32rpx;
  color: rgba(180, 191, 209, 0.86);
  font-size: 26rpx;
  line-height: 48rpx;
  word-break: break-all;
}

.service-line:last-child {
  margin-bottom: 0;
}

.service-label {
  color: #dce4ef;
  font-weight: 700;
}

.service-text {
  color: rgba(180, 191, 209, 0.86);
}

.players-card {
  margin-top: 0;
  padding: 48rpx 42rpx 46rpx;
}

.players-title {
  display: block;
}

.player-list {
  margin-top: 42rpx;
}

.player-row {
  display: flex;
  align-items: center;
  min-height: 122rpx;
  border-bottom: 1rpx solid rgba(63, 76, 100, 0.42);
}

.player-row.last {
  border-bottom: 0;
}

.avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3f80ff 0%, #7b4ff1 100%);
}

.avatar {
  width: 49rpx;
  height: 49rpx;
}

.player-copy {
  display: flex;
  flex-direction: column;
}

.player-name {
  color: #f0f5ff;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.player-desc {
  margin-top: 8rpx;
  color: rgba(145, 158, 181, 0.86);
  font-size: 22rpx;
  line-height: 30rpx;
}
