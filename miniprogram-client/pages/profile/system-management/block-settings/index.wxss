@import "./shared.wxss";

.block-home {
  padding-top: 28rpx;
}

.debug-banner {
  margin: 0 0 24rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid rgba(255, 149, 0, 0.42);
  border-radius: 18rpx;
  color: #ffb020;
  background: rgba(255, 149, 0, 0.12);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.hero-card {
  min-height: 400rpx;
  padding: 44rpx 42rpx;
  border-radius: 40rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #12d8ff 0%, #0a8cff 100%);
}

.hero-head {
  display: flex;
  align-items: center;
}

.hero-icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  margin-right: 28rpx;
}

.emoji-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
  font-weight: 400;
  line-height: 1;
}

.hero-icon.emoji-icon {
  font-size: 52rpx;
}

.hero-title {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.switch {
  position: relative;
  flex: none;
  width: 104rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.36);
}

.switch.on {
  background: #00e676;
}

.switch-thumb {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.2s ease;
}

.switch.on .switch-thumb {
  transform: translateX(44rpx);
}

.hero-desc {
  margin-top: 38rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.hero-strong {
  color: #ffffff;
  font-weight: 400;
}

.hero-stats {
  display: flex;
  gap: 46rpx;
  margin-top: 32rpx;
}

.hero-stat {
  flex: 1;
  min-width: 0;
}

.hero-stat-value,
.hero-stat-label {
  display: block;
}

.hero-stat-value {
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 300;
  line-height: 62rpx;
}

.hero-stat-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.expiry-banner {
  display: flex;
  align-items: center;
  height: 100rpx;
  margin-top: 32rpx;
  padding: 0 38rpx;
  border: 2rpx solid rgba(255, 149, 0, 0.36);
  border-radius: 24rpx;
  box-sizing: border-box;
  background: rgba(255, 149, 0, 0.08);
}

.expiry-icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
  font-size: 42rpx;
}

.expiry-label {
  flex: 1;
  color: #ffb020;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.expiry-value {
  color: #ffb020;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.block-home .section-label {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.block-home .row-title {
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.block-home .row-desc {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.block-home .pill {
  min-width: 82rpx;
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 25rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.block-home .note-line {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.block-home .note-strong {
  font-weight: 400;
}

.block-home .icon-tile .tile-icon {
  display: block;
  width: 52rpx;
  height: 52rpx;
}
