page {
  background: #0a0e1a;
}

.block-page {
  min-height: 100%;
  padding: 28rpx 32rpx 178rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #0a0e1a;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.block-page.no-bottom {
  padding-bottom: 54rpx;
}

.section-label {
  display: block;
  margin: 34rpx 8rpx 18rpx;
  color: #667788;
  font-size: 30rpx;
  line-height: 42rpx;
}

.card {
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.card-row {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 28rpx 34rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.card-row:last-child {
  border-bottom: 0;
}

.icon-tile {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 30rpx;
  border-radius: 22rpx;
  background: rgba(0, 212, 255, 0.14);
}

.icon-tile.green {
  background: rgba(0, 230, 118, 0.16);
}

.icon-tile.gold {
  background: rgba(255, 149, 0, 0.16);
}

.icon-tile.red {
  background: rgba(255, 77, 77, 0.16);
}

.icon-tile image {
  width: 52rpx;
  height: 52rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-desc {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #667788;
  font-size: 28rpx;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-side {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 27rpx;
  box-sizing: border-box;
  color: #12d8ff;
  background: rgba(0, 212, 255, 0.14);
  font-size: 26rpx;
  line-height: 54rpx;
}

.pill.muted {
  color: #7c8ca2;
  background: #253044;
}

.pill.red {
  color: #ff6b6b;
  background: rgba(255, 77, 77, 0.14);
}

.chevron {
  width: 18rpx;
  height: 28rpx;
  margin-left: 16rpx;
}

.note-card {
  padding: 32rpx 42rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.03);
}

.note-line {
  display: flex;
  align-items: flex-start;
  margin: 14rpx 0;
  color: #7c8ca2;
  font-size: 28rpx;
  line-height: 46rpx;
}

.note-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin: 19rpx 22rpx 0 0;
  border-radius: 50%;
  background: #667788;
}

.note-strong {
  color: #ffffff;
  font-weight: 700;
}

.bottom-action {
  position: fixed;
  left: 50%;
  bottom: 0;
  z-index: 30;
  width: 750rpx;
  padding: 24rpx 32rpx 38rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
  background: #0d1322;
  transform: translateX(-50%);
}

.primary-btn,
.secondary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  font-size: 34rpx;
  line-height: 112rpx;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #12d8ff 0%, #0a8cff 100%);
}

.primary-btn.disabled {
  color: #7c8ca2;
  background: #344457;
}

.secondary-btn {
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.08);
}

.bottom-action.two {
  display: flex;
  gap: 18rpx;
}

.bottom-action.two .primary-btn,
.bottom-action.two .secondary-btn {
  flex: 1;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 178rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.stat-value {
  color: #12d8ff;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.stat-value.gold {
  color: #ff9500;
}

.stat-value.green {
  color: #00e676;
}

.stat-label {
  margin-top: 18rpx;
  color: #667788;
  font-size: 26rpx;
  line-height: 34rpx;
}

.info-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 32rpx;
  padding: 28rpx 34rpx;
  border: 2rpx solid rgba(0, 212, 255, 0.12);
  border-radius: 24rpx;
  background: rgba(0, 212, 255, 0.04);
  color: #7c8ca2;
  font-size: 28rpx;
  line-height: 44rpx;
}

.info-banner image {
  flex: none;
  width: 42rpx;
  height: 42rpx;
}

.form-card {
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.placeholder {
  color: #3f5166;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(5, 8, 16, 0.76);
}

.bottom-sheet {
  position: fixed;
  left: 50%;
  bottom: 0;
  z-index: 70;
  width: 750rpx;
  padding: 46rpx 32rpx 36rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 0;
  border-radius: 36rpx 36rpx 0 0;
  box-sizing: border-box;
  background: #171d2c;
  transform: translateX(-50%);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.sheet-title {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.sheet-close {
  width: 58rpx;
  height: 58rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 26rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
}

.search-box image {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 30rpx;
}

.avatar-circle {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border: 2rpx solid rgba(0, 212, 255, 0.36);
  border-radius: 50%;
  background: rgba(0, 136, 255, 0.14);
}

.avatar-circle.red {
  border-color: rgba(255, 77, 77, 0.36);
}

.avatar-circle image {
  width: 52rpx;
  height: 52rpx;
}

.compact-page {
  padding: 18rpx 28rpx 132rpx;
}

.compact-page.no-bottom {
  padding-bottom: 36rpx;
}

.compact-page .section-label {
  margin: 22rpx 6rpx 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.compact-page .card {
  border-radius: 22rpx;
}

.compact-page .card-row {
  min-height: 96rpx;
  padding: 18rpx 24rpx;
}

.compact-page .row-title {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.compact-page .row-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 32rpx;
}

.compact-page .row-side {
  margin-left: 14rpx;
}

.compact-page .pill {
  min-width: 72rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  line-height: 42rpx;
}

.compact-page .chevron {
  width: 14rpx;
  height: 22rpx;
  margin-left: 10rpx;
}

.compact-page .note-card {
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
}

.compact-page .note-line {
  margin: 6rpx 0;
  font-size: 24rpx;
  line-height: 34rpx;
}

.compact-page .note-dot {
  margin: 14rpx 16rpx 0 0;
}

.compact-page .stats-grid {
  gap: 14rpx;
}

.compact-page .stat-card {
  min-height: 116rpx;
  border-radius: 22rpx;
}

.compact-page .stat-value {
  font-size: 38rpx;
  line-height: 48rpx;
}

.compact-page .stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}

.compact-page .info-banner {
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 34rpx;
}

.compact-page .info-banner image {
  width: 32rpx;
  height: 32rpx;
}

.compact-page .form-card {
  padding: 22rpx;
  border-radius: 22rpx;
}

.compact-page .search-box {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
}

.compact-page .search-box image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.compact-page .search-box input {
  font-size: 24rpx;
}

.compact-page .avatar-circle {
  width: 64rpx;
  height: 64rpx;
}

.compact-page .avatar-circle image {
  width: 40rpx;
  height: 40rpx;
}

.compact-action {
  padding: 16rpx 32rpx 24rpx;
}

.compact-action .primary-btn,
.compact-action .secondary-btn {
  height: 104rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 104rpx;
}

.compact-sheet {
  padding: 32rpx 28rpx 28rpx;
  border-radius: 28rpx 28rpx 0 0;
}

.compact-sheet .sheet-title {
  font-size: 34rpx;
  line-height: 44rpx;
}

.compact-sheet .sheet-head {
  margin-bottom: 22rpx;
}

.compact-sheet .sheet-close {
  width: 46rpx;
  height: 46rpx;
}
