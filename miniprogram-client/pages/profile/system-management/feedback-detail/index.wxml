<profile-white-shell
  title=""
  background="#080d19"
  nav-background="#080d19"
  title-color="#f8fbff"
  title-weight="400"
  back-background="transparent"
  back-border-color="transparent"
  back-icon-color="#f8fbff"
>
  <view class="detail-nav-title">反馈详情</view>
  <view class="detail-nav-status">{{record.status}}</view>

  <view class="feedback-page detail-page">
    <view wx:if="{{loadError}}" class="feedback-card detail-summary">
      <text class="summary-content">{{loadError}}</text>
    </view>

    <block wx:else>
    <view class="feedback-card detail-summary">
      <view class="summary-head">
        <view class="type-chip {{record.typeTone}}">{{record.type}}</view>
        <text class="summary-time">{{record.time}}</text>
      </view>
      <text class="summary-content">{{record.content}}</text>
      <image wx:if="{{feedbackImage}}" class="summary-image" src="{{feedbackImage}}" mode="aspectFill"></image>
    </view>

    <text wx:if="{{recordDateLabel}}" class="date-divider">{{recordDateLabel}}</text>

    <view class="message-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="message-row {{item.role}}"
      >
        <view wx:if="{{item.role === 'service'}}" class="avatar service-avatar">{{item.avatar}}</view>
        <view class="message-bubble">
          <text class="message-content">{{item.content}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
        <view wx:if="{{item.role === 'me'}}" class="avatar me-avatar">{{item.avatar}}</view>
      </view>
    </view>

    </block>
  </view>

  <view class="detail-input-bar">
    <view class="attach-button" bindtap="handleAttachTap">
      <image src="{{icons.attachment}}" mode="aspectFit"></image>
    </view>
    <input class="reply-input" value="{{replyContent}}" bindinput="handleReplyInput" placeholder="补充说明..." placeholder-class="placeholder" />
    <view class="send-button" bindtap="handleSendTap">
      <image src="{{icons.send}}" mode="aspectFit"></image>
    </view>
  </view>
</profile-white-shell>
