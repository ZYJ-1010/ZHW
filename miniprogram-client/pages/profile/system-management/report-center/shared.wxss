page {
  background: #071321;
}

.report-page {
  min-height: 100%;
  padding: 24rpx 34rpx 60rpx;
  box-sizing: border-box;
  color: #f8fbff;
  background: #071321;
  font-weight: 400;
}

.report-page.with-bottom {
  padding-bottom: 172rpx;
}

.report-tabs {
  display: flex;
  align-items: center;
  height: 96rpx;
  margin: 0 0 24rpx;
  padding: 10rpx;
  border: 2rpx solid rgba(0, 255, 157, 0.12);
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #132135;
}

.report-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 26rpx;
  color: #6f7e96;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 76rpx;
}

.report-tab.active {
  color: #061421;
  font-weight: 400;
  background: linear-gradient(135deg, #00ff97 0%, #09d4bd 100%);
  box-shadow: 0 14rpx 30rpx rgba(0, 255, 157, 0.22);
}

.report-card {
  margin-bottom: 24rpx;
  padding: 34rpx;
  border: 2rpx solid rgba(0, 255, 157, 0.1);
  border-radius: 30rpx;
  box-sizing: border-box;
  background: #142237;
}

.section-title {
  display: block;
  margin-bottom: 28rpx;
  color: #f8fbff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.muted-text {
  color: #7b8ba5;
}

.report-chip-row,
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx 18rpx;
}

.report-type-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 22rpx;
}

.report-type-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.report-chip,
.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 134rpx;
  height: 64rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(0, 255, 157, 0.15);
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #7d8da6;
  background: rgba(255, 255, 255, 0.02);
  font-size: 25rpx;
  font-weight: 400;
  line-height: 62rpx;
  white-space: nowrap;
}

.report-chip.active,
.filter-chip.active {
  color: #061421;
  font-weight: 400;
  border-color: transparent;
  background: linear-gradient(135deg, #00ff97 0%, #09d4bd 100%);
  box-shadow: 0 12rpx 28rpx rgba(0, 255, 157, 0.2);
}

.report-type-row .report-chip {
  flex: none;
  min-width: 0;
  padding: 0 28rpx;
}

.report-input,
.report-textarea {
  width: 100%;
  border: 2rpx solid rgba(0, 255, 157, 0.11);
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #f8fbff;
  background: #1b2a40;
  font-size: 30rpx;
  font-weight: 400;
}

.report-input {
  height: 92rpx;
  padding: 0 32rpx;
  line-height: 92rpx;
}

.report-textarea-wrap {
  position: relative;
}

.report-textarea {
  height: 204rpx;
  padding: 30rpx 32rpx 52rpx;
  line-height: 42rpx;
}

.placeholder {
  color: #53627a;
}

.counter {
  position: absolute;
  right: 30rpx;
  bottom: 20rpx;
  color: #5e6d84;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.counter-active {
  color: #00ff9d;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22rpx;
}

.upload-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 136rpx;
  border: 2rpx dashed rgba(0, 255, 157, 0.22);
  border-radius: 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.02);
}

.upload-plus {
  width: 34rpx;
  height: 34rpx;
}

.upload-preview {
  overflow: hidden;
  border-style: solid;
  border-color: rgba(0, 255, 157, 0.18);
  background: #1b2a40;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-remove {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.56);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.primary-report-button,
.secondary-report-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 100rpx;
}

.primary-report-button {
  color: #061421;
  background: linear-gradient(135deg, #00ff97 0%, #09d4bd 100%);
}

.secondary-report-button {
  color: #8b99af;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  background: #172338;
}

.tip-card {
  padding: 34rpx 36rpx;
  border-color: rgba(255, 193, 7, 0.18);
  background: rgba(255, 193, 7, 0.03);
}

.tip-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  color: #ffc928;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.tip-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.tip-line {
  display: block;
  margin-top: 12rpx;
  color: #75849c;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.list-card {
  position: relative;
  min-height: 196rpx;
  margin-bottom: 24rpx;
  padding: 34rpx;
  border: 2rpx solid rgba(0, 255, 157, 0.08);
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #142237;
}

.list-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.list-title {
  flex: 1;
  color: #f8fbff;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.status-badge {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 54rpx;
}

.status-badge.success,
.text-success {
  color: #00ff9d;
}

.status-badge.success {
  background: rgba(0, 255, 157, 0.12);
}

.status-badge.warning,
.text-warning {
  color: #ffc928;
}

.status-badge.warning {
  background: rgba(255, 201, 40, 0.13);
}

.status-badge.danger,
.text-danger {
  color: #ff4d57;
}

.status-badge.danger {
  background: rgba(255, 77, 87, 0.13);
}

.status-badge.muted {
  color: #7b8ba5;
  background: rgba(255, 255, 255, 0.05);
}

.list-desc {
  margin-top: 28rpx;
  color: #7b8ba5;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.list-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}

.list-time {
  color: #4f5e75;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.detail-link {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 172rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  color: #00ff9d;
  background: rgba(0, 255, 157, 0.09);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 60rpx;
}

.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 16rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid rgba(255, 255, 255, 0.07);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: #00ff9d;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.stat-value.danger {
  color: #ff4d57;
}

.stat-label {
  margin-top: 12rpx;
  color: #74839b;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.detail-status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 188rpx;
  text-align: center;
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
}

.status-icon.success {
  background: rgba(0, 255, 157, 0.16);
}

.status-icon.warning {
  background: rgba(255, 201, 40, 0.18);
}

.status-icon image {
  width: 62rpx;
  height: 62rpx;
}

.status-main {
  color: #00ff9d;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.status-main.warning {
  color: #ffc928;
}

.status-sub {
  margin-top: 10rpx;
  color: #7b8ba5;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.reward-card {
  min-height: 176rpx;
  text-align: center;
  border-color: rgba(0, 255, 157, 0.16);
  background: rgba(0, 255, 157, 0.06);
}

.reward-label {
  color: #7b8ba5;
  font-size: 26rpx;
  line-height: 36rpx;
}

.reward-value {
  margin-top: 8rpx;
  color: #00ff9d;
  font-size: 54rpx;
  font-weight: 400;
  line-height: 68rpx;
}

.reward-desc {
  margin-top: 4rpx;
  color: #66758c;
  font-size: 24rpx;
  line-height: 34rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.04);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  color: #6f7e96;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.info-value {
  max-width: 430rpx;
  color: #dce6f8;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-align: right;
}

.paragraph-label {
  display: block;
  margin: 0 0 18rpx;
  color: #6f7e96;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.paragraph {
  display: block;
  color: #c5d1e5;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.evidence-row {
  display: flex;
  gap: 18rpx;
}

.evidence-card {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: 14rpx;
}

.evidence-card.teal {
  background: linear-gradient(135deg, #51d3c6 0%, #41a99e 100%);
}

.evidence-card.red {
  background: linear-gradient(135deg, #ff5e66 0%, #f44f58 100%);
}

.evidence-card.purple {
  background: linear-gradient(135deg, #9a8cff 0%, #7464e8 100%);
}

.evidence-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
  text-align: center;
}

.evidence-index {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  min-width: 38rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.48);
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.result-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.04);
}

.result-row:last-child {
  border-bottom: 0;
}

.result-label {
  flex: none;
  color: #6f7e96;
  font-size: 28rpx;
  line-height: 42rpx;
}

.result-value {
  flex: 1;
  color: #dce6f8;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-align: right;
}

.result-note {
  margin-top: 18rpx;
  color: #c5d1e5;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.timeline {
  position: relative;
  padding-left: 48rpx;
}

.timeline::before {
  position: absolute;
  left: 14rpx;
  top: 18rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.08);
  content: "";
}

.timeline-item {
  position: relative;
  padding-bottom: 34rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -48rpx;
  top: 8rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #00ff9d;
}

.timeline-dot.current {
  border: 5rpx solid #00ff9d;
  background: #142237;
  box-shadow: 0 0 14rpx rgba(0, 255, 157, 0.45);
}

.timeline-dot.pending {
  border: 5rpx solid #40526b;
  background: transparent;
}

.timeline-time {
  display: block;
  color: #40526b;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.timeline-title {
  display: block;
  margin-top: 6rpx;
  color: #f8fbff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.timeline-desc {
  display: block;
  margin-top: 4rpx;
  color: #6f7e96;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.report-bottom-actions {
  position: fixed;
  left: 50%;
  bottom: 0;
  z-index: 40;
  display: flex;
  gap: 20rpx;
  width: 750rpx;
  padding: 20rpx 34rpx 42rpx;
  box-sizing: border-box;
  background: #071321;
  transform: translateX(-50%);
}

.report-bottom-actions .secondary-report-button,
.report-bottom-actions .primary-report-button {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
}

.single-submit {
  margin: 30rpx 0;
}
