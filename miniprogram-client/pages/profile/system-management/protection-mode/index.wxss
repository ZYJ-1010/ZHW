@import "../block-settings/shared.wxss";

.mode-card {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 28rpx;
  border: 3rpx solid transparent;
  border-radius: 26rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.04);
}

.mode-card.active {
  border-color: #12d8ff;
  background: rgba(0, 212, 255, 0.08);
}

.mode-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 212, 255, 0.14);
}

.mode-lock-emoji {
  display: block;
  font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 72rpx;
  text-align: center;
}

.mode-copy {
  flex: 1;
  min-width: 0;
}

.mode-title,
.mode-desc {
  display: block;
}

.mode-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.mode-desc {
  margin-top: 4rpx;
  color: #7c8ca2;
  font-size: 24rpx;
  line-height: 32rpx;
}

.mode-radio {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #3f5166;
  border-radius: 50%;
  box-sizing: border-box;
}

.mode-radio image {
  width: 44rpx;
  height: 44rpx;
  margin: -4rpx 0 0 -4rpx;
}

.mode-card.active .mode-radio {
  border-color: transparent;
}

.protection-rule-card {
  padding: 18rpx 26rpx;
}

.protection-rule {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  color: #8a9ab0;
  font-size: 24rpx;
  line-height: 34rpx;
}

.protection-rule:last-child {
  border-bottom: 0;
}

.cyan-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #12d8ff;
}
