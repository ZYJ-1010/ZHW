<profile-white-shell
  title="积分商城"
  background="#0d1117"
  nav-background="#0d1117"
  title-color="#ffffff"
  title-weight="400"
  back-background="#0d1117"
  back-border-color="transparent"
  back-icon-color="#ffffff"
>
  <view class="points-mall-page">
    <view class="points-overview-card">
      <view class="points-overview-copy">
        <text class="points-overview-label">我的积分</text>
        <text class="points-overview-value">{{points}}</text>
      </view>
      <button class="points-detail-button" bindtap="handlePointsTap">积分明细</button>
    </view>

    <text class="mall-section-title">热门兑换</text>

    <view class="goods-grid">
      <view
        wx:for="{{goods}}"
        wx:key="id"
        class="goods-card"
        data-id="{{item.id}}"
        bindtap="handleDetailTap"
      >
        <view class="goods-visual">
          <image wx:if="{{item.imageUrl}}" class="goods-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else class="goods-icon">{{item.iconText}}</text>
        </view>
        <view class="goods-copy">
          <text class="goods-title">{{item.title}}</text>
          <view class="goods-points-row">
            <view class="points-token">
              <text class="points-token-icon">🏆</text>
            </view>
            <text class="goods-points">{{item.points}}</text>
          </view>
          <text class="goods-stock">{{item.stock}}</text>
        </view>
      </view>
    </view>

    <text class="mall-expire-tip">{{expireTip}}</text>

    <view
      wx:if="{{showExchangeModal && selectedGood}}"
      class="exchange-modal-overlay"
      bindtap="handleCloseExchangeModal"
    >
      <view class="exchange-modal" catchtap="handleModalContentTap">
        <view class="exchange-modal-head">
          <text class="exchange-modal-title">确认兑换</text>
        </view>

        <view class="exchange-modal-body">
          <view class="exchange-product-card">
          <view class="exchange-product-visual">
              <image wx:if="{{selectedGood.imageUrl}}" class="exchange-product-image" src="{{selectedGood.imageUrl}}" mode="aspectFill" />
              <text wx:else class="exchange-product-icon">{{selectedGood.iconText}}</text>
            </view>
            <view class="exchange-product-copy">
              <text class="exchange-product-title">{{selectedGood.title}}</text>
              <view class="exchange-product-points">
                <view class="points-token">
                  <text class="points-token-icon">🏆</text>
                </view>
                <text class="exchange-product-cost">{{selectedGood.cost}} 积</text>
              </view>
              <text class="exchange-product-stock">{{selectedGood.stock}}</text>
            </view>
          </view>

          <view class="exchange-detail-list">
            <view class="exchange-detail-row">
              <text class="exchange-detail-label">兑换商品</text>
              <text class="exchange-detail-value">{{selectedGood.title}}</text>
            </view>
            <view class="exchange-detail-row">
              <text class="exchange-detail-label">消耗积分</text>
              <text class="exchange-detail-value orange">- {{selectedGood.cost}}</text>
            </view>
            <view class="exchange-detail-row">
              <text class="exchange-detail-label">兑换后剩余</text>
              <text class="exchange-detail-value">{{selectedGood.remaining}}</text>
            </view>
            <view class="exchange-detail-row last">
              <text class="exchange-detail-label">有效期</text>
              <text class="exchange-detail-value">兑换后30天内发货</text>
            </view>
          </view>

          <view class="exchange-actions">
            <button class="exchange-action cancel" bindtap="handleCloseExchangeModal">取消</button>
            <button
              class="exchange-action confirm {{isExchanging ? 'disabled' : ''}}"
              loading="{{isExchanging}}"
              disabled="{{isExchanging}}"
              bindtap="handleConfirmExchange"
            >
              {{isExchanging ? '兑换中...' : '确认兑换'}}
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
</profile-white-shell>
