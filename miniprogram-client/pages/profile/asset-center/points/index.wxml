<profile-white-shell
  title="积分中心"
  background="#f7f8fa"
  nav-background="#f7f8fa"
  title-color="#111827"
  back-background="transparent"
  back-border-color="transparent"
  back-icon-color="#7b7b7b"
>
  <view class="points-page">
    <view class="points-hero">
      <view class="points-hero-main">
        <text class="points-hero-label">可用积分</text>
        <text class="points-hero-value">{{summary.available}}</text>
      </view>
      <view class="points-stat-grid">
        <view wx:for="{{summary.stats}}" wx:key="key" class="points-stat-item">
          <text class="points-stat-value">{{item.value}}</text>
          <text class="points-stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="points-content">
      <view class="rules-card">
        <view class="points-section-head">
          <text class="head-icon rule-head-icon">📜</text>
          <text>积分规则</text>
        </view>
        <view class="rule-list">
          <view wx:for="{{rules}}" wx:key="strong" class="rule-row">
            <text class="rule-dot"></text>
            <text class="rule-text">{{item.text}} <text class="rule-strong">{{item.strong}}</text>{{item.suffix}}</text>
          </view>
        </view>
        <view class="rule-limit-row">
          <view class="rule-limit"><text class="limit-mark">!</text><text>不可提现</text></view>
        </view>
      </view>

      <view class="points-card">
        <view class="history-head">
          <view class="points-section-head dark no-margin">
            <text class="head-icon detail-head-icon">📋</text>
            <text>积分明细</text>
          </view>
          <view class="filter-tabs">
            <text
              wx:for="{{filters}}"
              wx:key="key"
              class="filter-tab {{activeFilter === item.key ? 'active' : ''}}"
              data-filter="{{item.key}}"
              bindtap="handleFilterTap"
            >{{item.label}}</text>
          </view>
        </view>

        <view class="record-list">
          <view wx:if="{{loading}}" class="points-empty">积分明细加载中...</view>
          <view wx:elif="{{!visibleRecords.length}}" class="points-empty">暂无积分明细</view>
          <block wx:else>
            <view wx:for="{{visibleRecords}}" wx:key="id" class="record-row" bindtap="handleDeveloping">
              <view class="record-left">
                <view class="record-icon-wrap {{item.iconTone}}">
                  <text class="record-icon">{{item.iconText}}</text>
                </view>
                <view class="record-copy">
                  <text class="record-title">{{item.title}}</text>
                  <text class="record-desc">{{item.desc}}</text>
                  <text wx:if="{{item.time}}" class="record-time">{{item.time}}</text>
                </view>
              </view>
              <text class="record-points {{item.tone}}">{{item.points}}</text>
            </view>
          </block>
        </view>
      </view>

    </view>
  </view>
</profile-white-shell>
