page {
  background: #f5f6f8;
}

.points-page {
  min-height: 100%;
  padding-bottom: 54rpx;
  box-sizing: border-box;
  color: #22252c;
  background: #f5f6f8;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.points-hero {
  padding: 36rpx 32rpx 44rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #ffc20b 0%, #ff9700 100%);
}

.points-stat-grid,
.points-section-head,
.rule-row,
.rule-limit-row,
.rule-limit,
.history-head,
.filter-tabs,
.record-row,
.record-left {
  display: flex;
  align-items: center;
}

.points-hero-main {
  text-align: center;
}

.points-hero-label,
.points-hero-value,
.points-stat-value,
.points-stat-label,
.record-title,
.record-desc,
.record-time {
  display: block;
}

.points-hero-label {
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.points-hero-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 86rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 96rpx;
}

.points-stat-grid {
  justify-content: space-between;
  margin-top: 26rpx;
  text-align: center;
}

.points-stat-item {
  width: 31%;
  min-width: 0;
}

.points-stat-value {
  overflow: hidden;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.points-stat-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.points-content {
  position: relative;
  z-index: 2;
  margin-top: 14rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.rules-card,
.points-card {
  border-radius: 26rpx;
  box-sizing: border-box;
}

.rules-card {
  overflow: hidden;
  padding: 30rpx 36rpx 34rpx;
  border: 2rpx solid #ffd979;
  background: #fff2bd;
}

.points-section-head {
  margin-bottom: 24rpx;
  color: #ee3e34;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.points-section-head.dark {
  color: #22252c;
}

.points-section-head.no-margin {
  margin-bottom: 0;
}

.head-icon {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
  font-size: 34rpx;
  line-height: 38rpx;
}

.head-icon.rule-head-icon {
  font-size: 34rpx;
}

.head-icon.detail-head-icon {
  font-size: 32rpx;
}

.rule-list {
  padding-right: 4rpx;
}

.rule-row {
  align-items: flex-start;
  margin-top: 28rpx;
}

.rule-row:first-child {
  margin-top: 0;
}

.rule-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 13rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #ff9500;
  color: transparent;
  font-size: 0;
  line-height: 0;
}

.rule-text {
  flex: 1;
  min-width: 0;
  color: #8b7b64;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.rule-strong {
  color: #f05a28;
  font-weight: 600;
}

.rule-limit-row {
  flex-wrap: wrap;
  gap: 18rpx 28rpx;
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(219, 158, 53, 0.28);
}

.rule-limit {
  min-width: 150rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #e45b62;
  background: rgba(255, 222, 226, 0.72);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.limit-mark {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
  line-height: 28rpx;
}

.points-card {
  margin-top: 28rpx;
  padding: 30rpx 34rpx;
  background: #ffffff;
}

.history-head {
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tabs {
  flex: none;
  gap: 8rpx;
}

.filter-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 66rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #b7b7b7;
  background: #f6f6f6;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.filter-tab.active {
  color: #ff9600;
  background: #fff7e8;
  box-shadow: inset 0 0 0 2rpx #ffe0ab;
}

.record-list {
  padding-left: 4rpx;
}

.points-empty {
  padding: 54rpx 0 46rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
}

.record-row {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 128rpx;
  padding: 22rpx 0 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
  box-sizing: border-box;
}

.record-row:last-child {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 24rpx;
  border-radius: 50%;
}

.record-icon-wrap.green {
  background: #e5f7e7;
}

.record-icon-wrap.pink {
  background: #ffecef;
}

.record-icon {
  font-size: 32rpx;
  line-height: 42rpx;
}

.record-copy {
  flex: 1;
  min-width: 0;
}

.record-title {
  overflow: hidden;
  color: #30343b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-desc,
.record-time {
  overflow: hidden;
  color: #b5b5b5;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-desc {
  margin-top: 2rpx;
}

.record-points {
  flex: none;
  margin-left: 4rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.record-points.plus {
  color: #33ae50;
}

.record-points.minus {
  color: #ff3b30;
}
