page {
  background: #007bd3;
}

.profile-home-shell {
  width: 100%;
  min-height: 100%;
  background: #000000;
  color: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.profile-join-master .home-shell-content {
  box-shadow: 0 -12rpx 26rpx rgba(0, 0, 0, 0.22);
}

.profile-join-master .home-shell-toolbar {
  display: none;
}

.profile-home-page {
  min-height: 100%;
  padding: 15rpx 24rpx 44rpx;
  box-sizing: border-box;
  background: #000000;
}

.profile-user-block {
  padding: 0 6rpx;
  box-sizing: border-box;
}

.profile-user,
.profile-name-row,
.profile-role-row,
.asset-head,
.asset-more,
.vip-banner,
.vip-left,
.profile-menu-item,
.profile-menu-left,
.profile-menu-right {
  display: flex;
  align-items: center;
}

.profile-user {
  gap: 22rpx;
  margin-bottom: 25rpx;
}

.profile-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  border: 5rpx solid #7c3aed;
  border-radius: 50%;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #5b8cff 0%, #f472b6 100%);
  font-size: 50rpx;
  font-weight: 400;
  line-height: 60rpx;
}

.profile-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.profile-user-copy {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  gap: 14rpx;
  min-width: 0;
}

.profile-name {
  max-width: 260rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 52rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-member {
  flex: none;
  padding: 5rpx 15rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #fb923c;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.profile-role-row {
  gap: 18rpx;
  margin-top: 8rpx;
  color: #93c5fd;
  font-size: 24rpx;
  line-height: 34rpx;
}

.profile-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.profile-stat-card {
  min-width: 0;
  padding: 23rpx 8rpx 20rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #1a1c24;
  text-align: center;
}

.profile-stat-value,
.profile-stat-label,
.asset-title,
.asset-value,
.asset-label,
.profile-section-title,
.profile-menu-title {
  display: block;
}

.profile-stat-value {
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-stat-label {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 28rpx;
}

.profile-main {
  padding: 0;
  box-sizing: border-box;
}

.asset-card {
  margin-top: 27rpx;
  padding: 28rpx 28rpx 27rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  color: #333333;
  background: #ffffff;
}

.asset-head {
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.asset-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.asset-more {
  flex: none;
  color: #2563eb;
  font-size: 23rpx;
  line-height: 32rpx;
}

.asset-more-arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 32rpx;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 28rpx;
  text-align: center;
}

.asset-item {
  min-width: 0;
}

.asset-value {
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-value.green {
  color: #22c55e;
}

.asset-value.orange {
  color: #f97316;
}

.asset-label {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 28rpx;
}

.vip-banner {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 70rpx;
  padding: 18rpx;
  border: 2rpx solid #fecaca;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #fff5f5;
}

.vip-left {
  min-width: 0;
  gap: 12rpx;
}

.vip-chip {
  flex: none;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #ffffff;
  background: #facc15;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 26rpx;
}

.vip-copy {
  overflow: hidden;
  color: #f87171;
  font-size: 23rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-link {
  flex: none;
  color: #f87171;
  font-size: 20rpx;
  line-height: 28rpx;
}

.profile-section {
  margin-top: 32rpx;
}

.profile-section-title {
  margin: 0 0 15rpx 2rpx;
  color: #7f8da6;
  font-size: 25rpx;
  line-height: 36rpx;
}

.profile-menu-card {
  overflow: hidden;
  border: 2rpx solid rgba(85, 101, 130, 0.62);
  border-radius: 20rpx;
  background: #171c28;
}

.profile-menu-item {
  justify-content: space-between;
  gap: 20rpx;
  min-height: 108rpx;
  padding: 22rpx 25rpx;
  border-bottom: 2rpx solid rgba(79, 92, 119, 0.42);
  box-sizing: border-box;
}

.profile-menu-item:last-child {
  border-bottom: 0;
}

.profile-menu-left {
  min-width: 0;
  gap: 20rpx;
}

.profile-menu-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.18);
}

.profile-menu-icon.purple-blue {
  background: linear-gradient(135deg, #c033d8 0%, #007edb 100%);
}

.profile-menu-icon.violet-blue {
  background: linear-gradient(135deg, #b33bd7 0%, #0078d6 100%);
}

.profile-menu-icon.orange {
  background: linear-gradient(180deg, #ffb21f 0%, #ff6a00 100%);
}

.profile-menu-icon.teal {
  background: linear-gradient(180deg, #13f4ce 0%, #00ad9c 100%);
}

.profile-menu-icon.blue-purple {
  background: linear-gradient(180deg, #1989ff 0%, #d31ba9 100%);
}

.profile-menu-icon-img {
  width: 33rpx;
  height: 33rpx;
}

.profile-menu-title {
  overflow: hidden;
  color: #f6f9ff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-menu-right {
  flex: none;
  gap: 14rpx;
}

.profile-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  min-width: 86rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.profile-badge.pink {
  color: #ec4899;
  background: #ffe4ef;
}

.profile-badge.blue {
  color: #1d62ff;
  background: #dbeafe;
}

.profile-badge.orange {
  color: #d97706;
  background: #fff4c7;
}

.profile-arrow {
  color: #6f7d94;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.profile-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  margin-top: 28rpx;
  border-radius: 24rpx;
  color: #9ca3af;
  background: rgba(255, 255, 255, 0.08);
  font-size: 26rpx;
  line-height: 38rpx;
}
