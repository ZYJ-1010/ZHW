<profile-white-shell title="成员详情查看页" background="#050b14" nav-background="#050b14" title-color="#ffffff" title-weight="400" back-background="#050b14" back-border-color="transparent" back-icon-color="#12d8ff">
  <view class="invite-page member-detail-page dark-page">
    <view class="member-card">
      <view wx:if="{{member.name}}" class="member-hero">
        <text class="member-avatar">{{member.avatar}}</text>
        <text class="member-name">{{member.name}}</text>
        <text class="pill member-level">{{member.level}}</text>
      </view>
      <view wx:else class="empty-state">暂无成员详情</view>

      <view class="stat-row">
        <view wx:for="{{stats}}" wx:key="label" class="stat-card">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>

      <view class="section-card income-section">
        <view class="section-title"><text class="title-icon">💰</text><text>收益贡献</text></view>
        <view wx:for="{{income}}" wx:key="label" class="income-row {{item.highlight ? 'highlight' : ''}}">
          <text class="income-label">{{item.label}}</text>
          <text class="income-value">{{item.value}}</text>
        </view>
        <view wx:if="{{!income.length}}" class="empty-state">暂无收益贡献</view>
      </view>

      <view class="section-card activity-section">
        <view class="section-title"><text class="title-icon">📈</text><text>最近动态</text></view>
        <view wx:for="{{activities}}" wx:key="title" class="activity-row">
          <text class="activity-icon">{{item.icon}}</text>
          <view class="activity-info">
            <text class="activity-title">{{item.title}}</text>
            <text class="activity-time">{{item.time}}</text>
          </view>
          <text class="activity-amount">{{item.amount}}</text>
        </view>
        <view wx:if="{{!activities.length}}" class="empty-state">暂无最近动态</view>
      </view>
    </view>
  </view>
</profile-white-shell>
