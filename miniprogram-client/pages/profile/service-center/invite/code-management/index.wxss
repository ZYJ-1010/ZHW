.invite-code-page { min-height: 100vh; padding: 28rpx 24rpx 64rpx; box-sizing: border-box; color: #fff; }
.section { margin-bottom: 24rpx; padding: 24rpx; border: 1rpx solid rgba(18,216,255,.2); border-radius: 16rpx; background: #0a1525; }
.section-title { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 600; }
.summary-grid { display:grid; grid-template-columns:repeat(3,1fr); margin-bottom:24rpx; padding:22rpx 12rpx; background:#0a1525; border:1rpx solid rgba(18,216,255,.2); border-radius:16rpx; }.summary-grid view{display:flex;flex-direction:column;align-items:center;gap:8rpx;}.summary-grid text:first-child{font-size:34rpx;color:#18d7ff;font-weight:600;}.summary-grid text:last-child{font-size:22rpx;color:#8ba4bd;}
.code-card,.request-row { display:flex; justify-content:space-between; align-items:center; padding:18rpx 0; border-bottom:1rpx solid rgba(255,255,255,.08); }
.code-card:last-child,.request-row:last-child { border-bottom:0; }
.code { font-size: 28rpx; font-weight: 600; letter-spacing: 2rpx; }.entry,.status { margin-left:16rpx; font-size:24rpx; color:#8ba4bd; }.status { color:#18d7ff; }.detail{display:block;margin-top:8rpx;font-size:22rpx;color:#8ba4bd;}
.input { width:100%; min-height:76rpx; margin-bottom:16rpx; padding:18rpx; box-sizing:border-box; border-radius:10rpx; background:#07101d; color:#fff; border:1rpx solid rgba(255,255,255,.15); font-size:28rpx; }.textarea{height:140rpx;}
.primary { margin:0; border-radius:10rpx; background:#12bfe8; color:#02101d; font-size:28rpx; }.empty{padding:30rpx 0;text-align:center;color:#7e94aa;font-size:26rpx;}
