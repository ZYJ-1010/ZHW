page { background: #050b14; min-height: 100%; }
.page { min-height: 100vh; padding: 48rpx 32rpx; box-sizing: border-box; }
.card { background: #111925; border: 1rpx solid #263445; border-radius: 24rpx; padding: 48rpx 36rpx; text-align: center; }
.title { display: block; color: #fff; font-size: 38rpx; font-weight: 700; }
.subtitle { display: block; margin-top: 16rpx; color: #91a2b7; font-size: 26rpx; }
.qrcode-box { width: 440rpx; height: 440rpx; margin: 44rpx auto 24rpx; background: #fff; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.qrcode { width: 400rpx; height: 400rpx; }
.code-card { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(180deg, #f7fbff, #dff5ff); }
.code-label { color: #5c6673; font-size: 26rpx; }
.code-large { margin-top: 24rpx; color: #07121f; font-size: 46rpx; font-weight: 800; word-break: break-all; max-width: 360rpx; text-align: center; }
.status, .error { padding: 30rpx; color: #5c6673; font-size: 26rpx; }
.error { color: #d84b4b; }
.code { display: block; color: #19d8ff; font-size: 28rpx; margin-bottom: 36rpx; }
.hint { display: block; margin-top: 20rpx; color: #91a2b7; font-size: 24rpx; }
button { border-radius: 44rpx; font-size: 30rpx; margin-top: 20rpx; }
.primary { color: #031018; background: linear-gradient(90deg, #19d8ff, #42e6ad); }
.secondary { color: #d9f7ff; background: #1b2b3a; border: 1rpx solid #2d5267; }
