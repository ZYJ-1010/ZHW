<profile-white-shell title="数据概览页" background="#050b14" nav-background="#050b14" title-color="#ffffff" back-background="#050b14" back-border-color="transparent" back-icon-color="#12d8ff">
  <view class="invite-page overview-page dark-page">
    <view class="tab-strip">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{item.key === 'overview' ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="handleTabTap"
      >{{item.label}}</view>
    </view>

    <view class="hero-card">
      <view class="avatar">👤</view>
      <view class="hero-info">
        <view class="name-line">
          <text class="name">{{profile.name}}</text>
          <text class="level">{{profile.level}}</text>
        </view>
        <text class="desc">{{profile.desc}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title"><text class="title-icon">📊</text><text>核心指标</text></view>
      <view class="metric-grid">
        <view wx:for="{{metrics}}" wx:key="label" class="metric-item">
          <text class="metric-value">{{item.value}}</text>
          <text class="metric-label">{{item.label}}</text>
          <text wx:if="{{item.trend}}" class="metric-trend {{item.tone}}">{{item.trend}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title"><text class="title-icon">⚡</text><text>快捷操作</text></view>
      <view class="action-grid">
        <view wx:for="{{actions}}" wx:key="label" class="quick-action" data-key="{{item.key}}" bindtap="handleActionTap">
          <text class="quick-icon {{item.iconClass}}">{{item.icon}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title"><text class="title-icon">📈</text><text>趋势速览</text></view>
      <view class="trend-list">
        <view wx:for="{{trends}}" wx:key="label" class="trend-row">
          <text class="trend-label">{{item.label}}</text>
          <text class="trend-value {{item.tone}}">{{item.value}}</text>
        </view>
        <view wx:if="{{!trends.length}}" class="empty-state">暂无趋势数据</view>
      </view>
    </view>
  </view>
</profile-white-shell>
