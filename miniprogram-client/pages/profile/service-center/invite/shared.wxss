.invite-page {
  min-height: 100%;
  padding: 24rpx 24rpx 52rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.dark-page {
  background: #050b14;
  color: #ffffff;
}

.member-close {
  position: absolute;
  z-index: 30;
  color: #7f8da3;
  font-size: 32rpx;
  line-height: 48rpx;
  text-align: center;
}

.member-close {
  right: 38rpx;
  top: 196rpx;
  width: 48rpx;
  height: 48rpx;
}

.section-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.dark-page .section-card {
  border: 1rpx solid rgba(148, 163, 184, 0.08);
  background: #111822;
  box-shadow: none;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.dark-page .section-title {
  color: #ffffff;
}

.title-icon {
  margin-right: 10rpx;
}

.tab-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: #ffffff;
  overflow-x: auto;
  white-space: nowrap;
}

.dark-page .tab-strip {
  background: transparent;
}

.tab-item {
  flex: none;
  padding: 13rpx 20rpx;
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.dark-page .tab-item {
  background: #151c27;
  color: #c7d2e2;
}

.tab-item.active {
  background: #2388ff;
  color: #ffffff;
}

.dark-page .tab-item.active {
  background: #19bfff;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2388ff;
  font-size: 21rpx;
}

.dark-page .pill {
  background: rgba(18, 216, 255, 0.16);
  color: #12d8ff;
}

.muted {
  color: #8b95a5;
}

.primary-btn,
.secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.primary-btn {
  background: #2388ff;
  color: #ffffff;
}

.secondary-btn {
  background: #f3f4f6;
  color: #374151;
}

.dark-page .primary-btn {
  background: #073a4f;
  color: #12d8ff;
}

.dark-page .secondary-btn {
  background: #0e2f45;
  color: #38d5ff;
}

.empty-bottom-space {
  height: 28rpx;
}
