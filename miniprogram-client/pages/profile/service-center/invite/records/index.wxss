@import "../shared.wxss";

.role-tabs {
  display: flex;
  height: 70rpx;
  gap: 18rpx;
  border-radius: 0;
  background: transparent;
  overflow: hidden;
}

.role-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #111822;
  color: #8fa0b6;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
}

.role-tab::after,
.filter-chip::after {
  border: 0;
}

.role-tab.active {
  background: #19bfff;
  color: #ffffff;
  font-weight: 400;
}

.role-tab:not(.active) {
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.filter-strip {
  display: flex;
  gap: 8rpx;
  margin-top: 18rpx;
  overflow: hidden;
  white-space: nowrap;
}

.filter-chip {
  flex: 1 1 0;
  min-width: 0;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111827;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 56rpx;
  text-align: center;
}

.filter-chip.active {
  background: #19bfff;
  color: #ffffff;
}

.warning-card {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
}

.warning-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 16rpx;
}

.warning-title,
.warning-desc {
  display: block;
}

.warning-copy {
  flex: 1;
  min-width: 0;
}

.warning-title {
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 400;
}

.warning-desc {
  margin-top: 4rpx;
  color: #dc2626;
  font-size: 20rpx;
  font-weight: 400;
}

.warning-arrow {
  flex: none;
  margin-left: 16rpx;
  color: #fb7185;
  font-size: 42rpx;
  line-height: 1;
}

.invite-card {
  margin-top: 20rpx;
  padding: 24rpx 26rpx 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.invite-card.is-compact {
  background: #fffafa;
}

.invite-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 42rpx;
}

.invite-card-meta {
  display: flex;
  align-items: center;
  min-width: 0;
}

.invite-card-status {
  flex: none;
  margin-right: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.invite-card-status.blue {
  background: #eff6ff;
  color: #2388ff;
}

.invite-card-status.green {
  background: #dcfce7;
  color: #16a34a;
}

.invite-card-status.red {
  background: #fee2e2;
  color: #ef4444;
}

.invite-card-id,
.invite-card-time {
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.invite-card-id {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-card-time {
  flex: none;
  margin-left: 18rpx;
}

.invite-card-relation {
  display: grid;
  grid-template-columns: 150rpx 1fr 150rpx;
  align-items: start;
  min-height: 144rpx;
  padding: 22rpx 76rpx 0;
}

.invite-card-person {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
}

.invite-card-person.right {
  justify-self: center;
}

.invite-card-person:first-child {
  justify-self: center;
}

.invite-card-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.invite-card-avatar.expert {
  background: #2388ff;
}

.invite-card-avatar.player {
  background: #41bd84;
}

.invite-card-avatar.muted {
  background: #9ca3af;
}

.invite-card-person-copy {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  margin-top: 10rpx;
}

.invite-card-person-name {
  overflow: hidden;
  max-width: 150rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-card-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  height: 30rpx;
  margin-top: 4rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.invite-card-role.expert {
  background: #dbeafe;
  color: #2388ff;
}

.invite-card-role.player {
  background: #fce7f3;
  color: #db2777;
}

.invite-card-role.muted {
  background: #fee2e2;
  color: #ef4444;
}

.invite-card-me {
  display: flex;
  align-items: center;
  flex-direction: column;
  color: #8b95a5;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-align: center;
}

.invite-card-handshake {
  width: 38rpx;
  height: 28rpx;
  margin-top: 20rpx;
}

.invite-card-check {
  height: 28rpx;
  margin-top: 18rpx;
  color: #4ade80;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.invite-card-me-line {
  width: 4rpx;
  height: 42rpx;
  margin-top: 10rpx;
  margin-bottom: 4rpx;
  border-radius: 999rpx;
  background: #fde68a;
}

.invite-card-me-line.completed {
  background: #86efac;
}

.invite-card-compact-person {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.invite-card-compact-person .invite-card-avatar {
  margin-right: 14rpx;
}

.invite-card-compact-person .invite-card-person-copy {
  align-items: flex-start;
  margin-top: 0;
}

.invite-card-bottom {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
}

.invite-card-summary {
  flex: 1;
  min-width: 0;
  padding-right: 22rpx;
}

.invite-card-title {
  display: block;
  overflow: hidden;
  color: #111827;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-card-budget {
  display: block;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.invite-card-income {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  height: 48rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #16a34a;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.invite-card-arrow {
  position: relative;
  flex: none;
  width: 64rpx;
  height: 70rpx;
}

.invite-card-arrow::before,
.invite-card-arrow::after {
  position: absolute;
  content: "";
}

.invite-card-arrow::before {
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-right: 5rpx solid #94a3b8;
  border-bottom: 5rpx solid #94a3b8;
  box-sizing: border-box;
  transform: translate(-50%, -68%) rotate(45deg);
}

.invite-card-arrow::after {
  display: none;
}

.timeout-note {
  display: block;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #fef2f2;
  color: #ef4444;
  font-size: 21rpx;
  font-weight: 400;
}

.empty-records {
  margin-top: 28rpx;
  padding: 44rpx 0;
  border-radius: 14rpx;
  background: #111822;
  color: #7f8da3;
  font-size: 24rpx;
  font-weight: 400;
  text-align: center;
}
