page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.my-games-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.my-games-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.my-games-nav {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.nav-back,
.filter-button {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
}

.nav-back {
  left: 42rpx;
}

.nav-back::after,
.filter-button::after {
  border: 0;
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #374151;
  border-bottom: 4rpx solid #374151;
  box-sizing: border-box;
  transform: translateX(4rpx) rotate(45deg);
}

.nav-title {
  position: absolute;
  left: 245rpx;
  width: 260rpx;
  overflow: hidden;
  color: #111111;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-button {
  right: 42rpx;
}

.filter-icon {
  position: relative;
  width: 34rpx;
  height: 30rpx;
}

.filter-icon::before {
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 30rpx;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 16rpx solid #4b5563;
  box-sizing: border-box;
  content: '';
}

.filter-icon::after {
  position: absolute;
  left: 14rpx;
  top: 18rpx;
  width: 7rpx;
  height: 9rpx;
  border-radius: 0 0 2rpx 2rpx;
  background: #4b5563;
  content: '';
}

.my-games-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  box-sizing: border-box;
}

.my-games-inner {
  min-height: 100%;
  padding-bottom: 56rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.category-tabs {
  display: flex;
  align-items: center;
  width: 750rpx;
  height: 84rpx;
  padding: 0 38rpx;
  border-top: 2rpx solid #f1f3f5;
  border-bottom: 2rpx solid #edf0f3;
  box-sizing: border-box;
  background: #ffffff;
}

.category-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.category-tab.active {
  color: #1683f8;
  font-weight: 700;
}

.category-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 72rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #1683f8;
  transform: translateX(-50%);
  content: '';
}

.status-scroll {
  width: 750rpx;
  height: 74rpx;
  background: #ffffff;
  white-space: nowrap;
}

.status-tabs {
  display: inline-flex;
  align-items: center;
  height: 74rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.status-tab {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  min-width: 80rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  color: #6b7280;
  background: #f1f4f8;
  font-size: 21rpx;
  line-height: 30rpx;
  box-sizing: border-box;
}

.status-tab.active {
  color: #ffffff;
  background: #1683f8;
  font-weight: 700;
}

.game-list {
  padding-top: 20rpx;
}

.game-card {
  width: 684rpx;
  margin: 0 auto 24rpx;
  padding: 26rpx 28rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  min-height: 38rpx;
}

.status-pill {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.status-pill.active {
  color: #1683f8;
  background: #dbeafe;
}

.status-pill.complete {
  color: #059669;
  background: #d1fae5;
}

.status-pill.canceled,
.status-pill.overdue {
  color: #6b7280;
  background: #f3f4f6;
}

.card-ref {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  overflow: hidden;
  color: #a7b0bd;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  flex: none;
  margin-left: 14rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.game-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.game-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.game-avatar.active {
  background: linear-gradient(135deg, #60a5fa 0%, #1683f8 100%);
}

.game-avatar.complete {
  background: linear-gradient(135deg, #34d399 0%, #059669 100%);
}

.game-avatar.canceled,
.game-avatar.overdue {
  background: #9ca3af;
}

.game-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.game-title {
  display: block;
  overflow: hidden;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-title.muted {
  color: #4b5563;
}

.game-line {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-row {
  display: flex;
  align-items: center;
  min-height: 40rpx;
  margin-top: 24rpx;
  color: #6b7280;
}

.clock-icon {
  position: relative;
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #9ca3af;
}

.clock-icon::before {
  position: absolute;
  left: 10rpx;
  top: 5rpx;
  width: 2rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: #ffffff;
  content: '';
}

.clock-icon::after {
  position: absolute;
  left: 10rpx;
  top: 11rpx;
  width: 6rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #ffffff;
  content: '';
}

.schedule-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron-down {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-left: 16rpx;
  border-right: 4rpx solid #9ca3af;
  border-bottom: 4rpx solid #9ca3af;
  box-sizing: border-box;
  transform: rotate(45deg) translateY(-4rpx);
}

.action-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.card-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  width: 0;
  height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 14rpx;
  box-sizing: border-box;
  color: #374151;
  background: #f3f4f6;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
  overflow: hidden;
  white-space: nowrap;
}

.card-action::after {
  border: 0;
}

.card-action.review {
  color: #9a3412;
  background: #fef3c7;
}

.action-icon {
  margin-right: 8rpx;
  color: #f97316;
  font-size: 24rpx;
  line-height: 32rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 684rpx;
  height: 220rpx;
  margin: 20rpx auto 0;
  border-radius: 16rpx;
  color: #9ca3af;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
}
