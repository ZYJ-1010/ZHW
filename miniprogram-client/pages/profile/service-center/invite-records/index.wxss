@import "../../profile-white-page.wxss";

.invite-role-tabs {
  width: 100%;
  justify-content: stretch;
  gap: 0;
}

.invite-role-tabs .profile-tab {
  flex: 1 1 0;
  min-width: 0;
  height: 90rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #6b7280;
}

.invite-role-tabs .profile-tab.active {
  color: #111827;
  background: transparent;
  box-shadow: inset 0 -4rpx 0 #111827;
}

.invite-card {
  margin-top: 24rpx;
}

.invite-people {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.invite-name {
  color: #111827;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.invite-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  color: #2563eb;
  background: #dbeafe;
  font-size: 20rpx;
  line-height: 28rpx;
}

.invite-role.player {
  color: #db2777;
  background: #fce7f3;
}

.invite-arrow {
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.invite-side {
  flex: none;
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 10rpx;
}

.my-game-time {
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 32rpx;
}

.invite-step-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  overflow-x: auto;
}

.invite-step {
  flex: none;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  color: #374151;
  background: #f3f4f6;
  font-size: 24rpx;
  line-height: 34rpx;
}
