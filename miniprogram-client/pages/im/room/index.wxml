<home-shell
  online-text="{{memberText}}"
  topbar-title="{{pageTitle}}"
  shell-class="home-shell--blue-topbar im-room-shell"
  shell-variant="topNoBrand"
  back-visible="{{true}}"
  bindbacktap="onBackTap"
  toolbar-actions-visible="{{false}}"
  nav-toast-enabled="{{false}}"
  nav-auto-navigate="{{true}}"
>
  <view class="im-room-page">
    <scroll-view
      class="message-scroll"
      scroll-y
      enhanced
      show-scrollbar="false"
      scroll-with-animation
      scroll-into-view="{{scrollAnchor}}"
      lower-threshold="80"
      bindscroll="onMessageScroll"
      bindscrolltolower="onMessageScrollToLower"
    >
      <view class="message-body">
        <view class="room-strip">
          <view class="room-strip-copy">
            <text class="room-strip-title">{{title}}</text>
            <text class="room-strip-desc">{{desc}}</text>
          </view>
          <view class="room-strip-actions">
            <button wx:if="{{collaborationEntry}}" class="room-collab-entry" hover-class="none" bindtap="onCollaborationTap">
              <text>{{collaborationEntry.text}}</text>
            </button>
            <button class="room-member-entry" hover-class="none" bindtap="onMembersTap">
              <text>{{memberText}}</text>
            </button>
          </view>
        </view>

        <block wx:for="{{messages}}" wx:key="id">
          <view id="message-{{index}}" class="message-node">
            <view wx:if="{{item.showDateDivider}}" class="message-date-divider">
              <text>{{item.dateDividerText}}</text>
            </view>
            <view wx:if="{{item.kind === 'system'}}" class="system-notice-wrap">
              <view class="system-notice">
                <text>{{item.card.title}}：{{item.card.subtitle}}</text>
              </view>
              <view wx:if="{{item.card.acceptButtonText || item.card.declineButtonText}}" class="system-actions">
                <button
                  wx:if="{{item.card.acceptButtonText}}"
                  class="system-action primary"
                  hover-class="none"
                  data-action="accept"
                  data-route="{{item.card.actionRoute}}"
                  bindtap="onSystemActionTap"
                >
                  {{item.card.acceptButtonText}}
                </button>
                <button
                  wx:if="{{item.card.declineButtonText}}"
                  class="system-action secondary"
                  hover-class="none"
                  data-action="decline"
                  bindtap="onSystemActionTap"
                >
                  {{item.card.declineButtonText}}
                </button>
              </view>
            </view>

            <view wx:else class="chat-row {{item.rowClass}}">
              <view wx:if="{{!item.isSelf}}" class="member-avatar">
                <image wx:if="{{item.avatarSrc}}" src="{{item.avatarSrc}}" mode="aspectFill" />
                <text wx:else>{{item.avatarText}}</text>
              </view>

              <view
                wx:if="{{item.failed}}"
                class="message-fail-icon"
                data-reason="{{item.failReason}}"
                bindtap="onFailedMessageTap"
              >!</view>

              <view class="message-stack">
                <view class="sender-line {{item.isSelf ? 'self' : ''}}">
                  <text class="sender-name">{{item.senderName}}</text>
                  <text class="sender-role">{{item.senderRoleText}}</text>
                  <text wx:if="{{item.createdAtText}}" class="message-time">{{item.createdAtText}}</text>
                </view>

                <view wx:if="{{item.kind === 'media'}}" class="media-bubble {{item.messageType}}" data-file-id="{{item.fileId}}" data-message-type="{{item.messageType}}" data-file-name="{{item.fileName}}" bindtap="onMediaTap">
                  <view class="media-icon"><text>{{item.messageType === 'image' ? '图' : (item.messageType === 'voice' ? '音' : '文')}}</text></view>
                  <view class="media-copy">
                    <text class="media-title">{{item.messageType === 'image' ? '图片消息' : (item.messageType === 'voice' ? '语音消息' : item.fileName)}}</text>
                    <text class="media-desc">{{item.fileId ? (item.messageType === 'voice' ? '点击播放' : (item.messageType === 'image' ? '点击查看' : '点击打开')) : '等待文件信息同步'}}</text>
                  </view>
                </view>
                <view wx:else class="text-bubble">
                  <text>{{item.contentText}}</text>
                </view>

                <text wx:if="{{item.statusText}}" class="message-status">{{item.statusText}}</text>
              </view>

              <view wx:if="{{item.isSelf}}" class="member-avatar self-avatar">
                <image wx:if="{{item.avatarSrc}}" src="{{item.avatarSrc}}" mode="aspectFill" />
                <text wx:else>{{item.avatarText}}</text>
              </view>
            </view>
          </view>
        </block>

        <view wx:if="{{!messages.length && !loading}}" class="empty-state">
          <text>暂无消息</text>
        </view>
        <view wx:if="{{loading}}" class="empty-state">
          <text>正在加载局内群聊...</text>
        </view>
      </view>
    </scroll-view>

    <view class="compose-zone">
      <view wx:if="{{readOnly}}" class="readonly-bar">
        <text>{{readOnlyText}}</text>
        <button class="readonly-action" hover-class="none" bindtap="onGameInfoTap">查看局信息</button>
      </view>

      <chat-input-bar
        wx:else
        placeholder="发送局内消息"
        bindsendtext="onSendMessage"
        bindrecordstart="onRecordStart"
        bindrecordstop="onRecordStop"
        bindrecorderror="onRecordError"
        bindchooseimage="onChooseImage"
        bindchoosefile="onChooseFile"
      />
      <view wx:if="{{uploading}}" class="upload-mask"><text>文件发送中...</text></view>
    </view>
  </view>
</home-shell>
