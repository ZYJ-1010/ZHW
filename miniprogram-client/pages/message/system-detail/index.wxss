page {
  background: #007bd3;
}

.system-detail-page {
  min-height: 100%;
  background: #ffffff;
  color: #111827;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.system-inner {
  min-height: 100%;
  padding: 0 0 44rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.article-card {
  width: 100%;
  min-height: 1010rpx;
  border-radius: 0;
  box-shadow: none;
}

.article-head {
  padding: 58rpx 48rpx 0;
  box-sizing: border-box;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 50rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  color: #2563eb;
  background: #dbeafe;
  font-size: 24rpx;
  line-height: 50rpx;
}

.article-title {
  display: block;
  margin-top: 20rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.dot {
  margin: 0 16rpx;
}

.article-body {
  padding: 28rpx 34rpx 44rpx;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.paragraph {
  display: block;
  margin-top: 22rpx;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 42rpx;
}

.paragraph.lead {
  margin-top: 0;
  color: #374151;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.update-box {
  width: 100%;
  margin: 24rpx 0 0;
  padding: 18rpx 22rpx 22rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  box-sizing: border-box;
}

.update-box-title {
  display: flex;
  align-items: center;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.update-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 20rpx;
  line-height: 34rpx;
}

.update-list {
  margin-top: 16rpx;
}

.update-item {
  display: flex;
  align-items: flex-start;
  min-height: 30rpx;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.update-item + .update-item {
  margin-top: 12rpx;
}

.check-dot {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin: 2rpx 10rpx 0 0;
}

.check-dot::after {
  display: block;
  width: 12rpx;
  height: 7rpx;
  margin: 5rpx 0 0 3rpx;
  border-left: 3rpx solid #3b82f6;
  border-bottom: 3rpx solid #3b82f6;
  content: "";
  transform: rotate(-45deg);
}

.cover-panel {
  margin: 26rpx auto 0;
  text-align: center;
}

.cover-image {
  display: block;
  width: 510rpx;
  height: 208rpx;
  margin: 0 auto;
  border-radius: 10rpx;
}

.cover-panel text {
  display: block;
  margin-top: 10rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.signature {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  margin-top: 20rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 38rpx;
}

.feedback-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx 40rpx;
  color: #6b7280;
  font-size: 20rpx;
  line-height: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.feedback-row > text {
  flex: none;
  width: 220rpx;
  white-space: nowrap;
}

.feedback-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.feedback-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: #374151;
  background: #f3f4f6;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.feedback-button::after {
  border: 0;
}

.feedback-button + .feedback-button {
  margin-left: 16rpx;
}

.feedback-icon {
  flex: none;
  margin-right: 10rpx;
  font-size: 24rpx;
  line-height: 28rpx;
}

.feedback-copy {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.feedback-copy text {
  display: block;
  line-height: 26rpx;
}
