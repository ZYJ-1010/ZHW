page {
  background: #007bd3;
}

.message-center-page {
  min-height: 100%;
  padding: 24rpx 24rpx 52rpx;
  box-sizing: border-box;
  background: #000000;
  color: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.quick-grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0 28rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 118rpx;
  min-width: 0;
}

.quick-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.24);
}

.quick-icon text {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.quick-icon.blue text {
  color: #2563eb;
}

.quick-icon.green text {
  color: #22c55e;
}

.quick-icon.yellow text {
  color: #f59e0b;
}

.quick-icon.red text {
  color: #ef4444;
}

.quick-icon.cyan text {
  color: #38bdf8;
}

.quick-badge {
  position: absolute;
  right: 0;
  top: 0;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #ef4444;
}

.quick-label {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-scroll {
  width: 100%;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  align-items: center;
}

.tab-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 0 50rpx 0 0;
  padding: 0;
  color: #9ca3af;
  background: transparent;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 76rpx;
}

.tab-button::after {
  border: 0;
}

.tab-button.active {
  color: #f97316;
  font-weight: 800;
}

.tab-button.active::before {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: #f97316;
  content: "";
}

.message-list {
  padding-top: 28rpx;
}

.message-section + .message-section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #22d3ee;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.section-more {
  margin: 0;
  padding: 0;
  color: #22c55e;
  background: transparent;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.section-more::after {
  border: 0;
}

.section-cards {
  display: flex;
  flex-direction: column;
}

.message-card + .message-card {
  margin-top: 18rpx;
}

.message-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  border-radius: 28rpx;
  color: #1f2937;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
}

.message-card.alert {
  border-left: 8rpx solid #f87171;
}

.message-icon-wrap {
  position: relative;
  flex: none;
  width: 92rpx;
  height: 92rpx;
  margin-right: 22rpx;
}

.message-icon,
.avatar-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.message-icon text,
.avatar-icon text {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.message-icon.blue {
  color: #2563eb;
  background: #dbeafe;
}

.message-icon.purple {
  color: #7c3aed;
  background: #ede9fe;
}

.message-icon.orange,
.message-icon.orangeLight {
  color: #f97316;
  background: #ffedd5;
}

.message-icon.green {
  color: #22c55e;
  background: #dcfce7;
}

.message-icon.yellow {
  color: #f59e0b;
  background: #fef3c7;
}

.message-icon.red {
  color: #ef4444;
  background: #fee2e2;
  border-radius: 50%;
}

.avatar-icon {
  color: #ffffff;
  background: #0ea5e9;
}

.avatar-icon.online::after {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #22c55e;
  content: "";
}

.message-dot {
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #ef4444;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.message-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  flex: none;
  margin-left: 18rpx;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.message-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.message-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.message-tag.success {
  color: #22c55e;
  background: #f0fdf4;
  border: 2rpx solid #dcfce7;
}

.message-summary {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.summary-main {
  color: #22c55e;
  font-weight: 800;
}

.summary-sub {
  margin-left: 18rpx;
  color: #9ca3af;
}

.message-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.message-meta {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-link {
  flex: none;
  margin: 0;
  margin-left: 18rpx;
  padding: 0;
  color: #ef4444;
  background: transparent;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.message-link::after {
  border: 0;
}

.message-actions {
  display: flex;
  margin-top: 22rpx;
}

.action-button + .action-button {
  margin-left: 18rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #6b7280;
  background: #f3f4f6;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.action-button::after {
  border: 0;
}

.action-button.primary {
  color: #ffffff;
  background: #22c55e;
  box-shadow: 0 6rpx 12rpx rgba(34, 197, 94, 0.22);
}

.action-button.orange {
  background: #f97316;
  box-shadow: 0 6rpx 12rpx rgba(249, 115, 22, 0.24);
}

.unread-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ef4444;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 34rpx;
  box-sizing: border-box;
}
