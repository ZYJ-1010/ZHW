page {
  background: #007bd3;
}

.game-apply-scroll {
  width: 100%;
  height: 100%;
  background: #0f1014;
}

.game-apply-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 34rpx 34rpx 72rpx;
  color: #f6f7fb;
  background: #111216;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.apply-heading {
  margin-bottom: 24rpx;
}

.apply-subtitle {
  display: block;
  color: #00f2ff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.wechat-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  min-height: 142rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(15, 16, 20, 0.04);
  border-radius: 28rpx;
  background: #f6f7fb;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.16);
}

.wechat-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(180deg, #00f2ff 0%, #3a86ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(0, 242, 255, 0.22);
}

.wechat-avatar-image {
  flex: none;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #dfe4f2;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.12);
}

.wechat-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.wechat-title {
  color: #9a9a9a;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.wechat-desc {
  color: #aeb5d6;
  font-size: 26rpx;
  line-height: 36rpx;
}

.apply-section {
  margin-top: 28rpx;
}

.apply-section-label {
  display: block;
  margin-bottom: 14rpx;
  color: #00f2ff;
  font-size: 28rpx;
  line-height: 36rpx;
}

.apply-section-label.required {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.required-mark {
  color: #ff4fa6;
  font-size: 28rpx;
  line-height: 36rpx;
}

.apply-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(15, 16, 20, 0.04);
  border-radius: 24rpx;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 42rpx;
  background: #f6f7fb;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.16);
}

.apply-textarea.intro {
  height: 186rpx;
}

.apply-textarea.message {
  height: 150rpx;
}

.apply-placeholder {
  color: rgba(148, 163, 184, 0.72);
}

.action-button::after {
  border: 0;
}

.agreement-group {
  margin-top: 30rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(94, 160, 255, 0.4);
  border-radius: 24rpx;
  background: rgba(94, 160, 255, 0.15);
}

.agreement-checkbox-native {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.agreement-checkbox-visual {
  position: relative;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(94, 160, 255, 0.72);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
}

.agreement-checkbox-visual.checked {
  border-color: rgba(255, 255, 255, 0.92);
  background: transparent;
}

.agreement-check-mark {
  position: absolute;
  left: 7rpx;
  top: 1rpx;
  width: 11rpx;
  height: 19rpx;
  border-right: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(42deg);
}

.agreement-copy {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 38rpx;
}

.agreement-link {
  color: #00f2ff;
}

.action-row {
  position: relative;
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
}

.action-button {
  position: absolute;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  min-width: 0;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.action-button.secondary {
  left: 44rpx;
  width: 264rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #c7cbe0;
  background: rgba(32, 34, 41, 0.98);
}

.action-button.primary {
  right: 44rpx;
  width: 264rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #3a86ff 0%, #8b5cf6 52%, #ff4fa6 100%);
  box-shadow: 0 16rpx 32rpx rgba(139, 92, 246, 0.32);
}
