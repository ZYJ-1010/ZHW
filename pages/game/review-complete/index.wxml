<home-shell
  online-text="{{onlineText}}"
  nav-items="{{navItems}}"
  topbar-title="评价完成"
  shell-variant="topNoBrand"
  toolbar-actions-visible="{{false}}"
  nav-toast-enabled="{{false}}"
  bindnavtap="handleShellNavTap"
  bindnavlongpress="handleShellNavLongPress"
  bindnavtouchend="handleShellNavTouchEnd"
>
  <scroll-view
    class="review-complete-scroll"
    scroll-y
    enhanced
    show-scrollbar="false"
    scroll-with-animation
    scroll-top="{{pageScrollTop}}"
    bindscroll="handlePageScroll"
    enable-back-to-top
  >
    <view class="review-complete-page">
      <view class="success-section">
        <view class="success-check">
          <view class="success-check-mark"></view>
        </view>
        <text wx:if="{{success.title}}" class="success-title">{{success.title}}</text>
        <text wx:if="{{success.desc}}" class="success-desc">{{success.desc}}</text>
      </view>

      <view class="reward-card" wx:if="{{rewardCard.iconText || rewardCard.value || rewardCard.title || rewardCard.desc}}">
        <view wx:if="{{rewardCard.iconText}}" class="reward-icon">{{rewardCard.iconText}}</view>
        <text wx:if="{{rewardCard.value}}" class="reward-points">{{rewardCard.value}}</text>
        <text wx:if="{{rewardCard.title}}" class="reward-title">{{rewardCard.title}}</text>
        <text wx:if="{{rewardCard.desc}}" class="reward-desc">{{rewardCard.desc}}</text>
      </view>

      <view class="benefits-card">
        <text class="section-title">获得的权益</text>
        <view class="benefit-list">
          <view wx:for="{{benefits}}" wx:key="title" class="benefit-item">
            <view class="benefit-icon {{item.theme}}">{{item.iconText}}</view>
            <view class="benefit-copy">
              <text class="benefit-title">{{item.title}}</text>
              <text class="benefit-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="play-again-card">
        <text class="section-title play-title">愿意和这些小伙伴再玩一局吗？</text>
        <view class="intent-grid">
          <view
            wx:for="{{playOptions}}"
            wx:key="id"
            class="intent-option {{item.theme}} {{selectedPlayIntent === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onPlayIntentTap"
          >
            <view class="intent-dot {{item.theme}}"></view>
            <text class="intent-title">{{item.title}}</text>
            <text class="intent-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</home-shell>
