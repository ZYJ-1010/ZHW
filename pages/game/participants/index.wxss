page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.participants-shell-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #101010;
  font-family: "PingFang SC", "Noto Sans SC", sans-serif;
}

.participants-shell-stage {
  width: 750rpx;
  height: 100vh;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  box-sizing: border-box;
}

.participants-shell-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
}

.participants-white-top-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 0;
  height: 160rpx;
  background: #ffffff;
}

.participants-white-nav {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 6;
  width: 750rpx;
  height: 160rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.participants-nav-title {
  position: absolute;
  left: 294rpx;
  display: block;
  width: 150rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participants-nav-button {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.participants-nav-button::after {
  border: 0;
}

.participants-nav-button--active {
  background: #f3f4f6;
}

.participants-chevron-left {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.participants-phone-panel {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  color: #101010;
  box-sizing: border-box;
}

.participants-content {
  min-height: 100%;
  padding: 24rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.participants-count-row {
  display: flex;
  align-items: center;
  height: 44rpx;
  margin-bottom: 18rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.participants-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.participants-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 36rpx;
}

.participants-white-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}
