page {
  background: #007bd3;
}

.audit-detail-shell {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000000;
}

.audit-detail-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #000000;
}

.audit-detail-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 34rpx 0 42rpx;
  color: #111827;
  background: #000000;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.detail-card,
.recommend-card,
.notice-card {
  width: 682rpx;
  margin-right: auto;
  margin-left: auto;
  box-sizing: border-box;
}

.detail-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.audit-empty-card {
  width: 682rpx;
  margin: 36rpx auto 0;
  padding: 42rpx 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffffff;
}

.audit-empty-title,
.audit-empty-text {
  display: block;
  letter-spacing: 0;
}

.audit-empty-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.audit-empty-text {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 36rpx;
}

.card-head,
.card-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.card-title.block {
  display: block;
  margin-bottom: 26rpx;
}

.upload-card .card-title {
  font-weight: 400;
}

.confirm-card .card-title {
  font-weight: 400;
}

.option-card .card-title {
  font-weight: 400;
}

.card-tip {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.player-head {
  align-items: flex-start;
}

.player-head .card-title {
  font-weight: 400;
}

.confirm-pill {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #16a34a;
  background: rgba(34, 197, 94, 0.12);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.confirm-dot {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #22c55e;
}

.confirm-dot::after {
  position: absolute;
  left: 5rpx;
  top: 2rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(42deg);
  content: "";
}

.player-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.player-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #ec4899;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.player-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.player-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.player-desc {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.gray-tag {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: #4b5563;
  background: #f3f4f6;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.need-panel,
.remark-panel {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.need-panel {
  color: #374151;
  background: #f9fafb;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.clock-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #9ca3af;
  border-radius: 50%;
  box-sizing: border-box;
}

.clock-icon::before,
.clock-icon::after {
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  background: #9ca3af;
  content: "";
}

.clock-icon::before {
  width: 3rpx;
  height: 8rpx;
}

.clock-icon::after {
  width: 8rpx;
  height: 3rpx;
  top: 10rpx;
}

.remark-panel {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #db2777;
  background: #fdf2f8;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.remark-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 24rpx;
  margin-top: 5rpx;
  border-radius: 12rpx;
  background: #ec4899;
}

.remark-icon::after {
  position: absolute;
  left: 8rpx;
  bottom: -6rpx;
  width: 0;
  height: 0;
  border-top: 8rpx solid #ec4899;
  border-right: 8rpx solid transparent;
  content: "";
}

.confirm-list {
  display: flex;
  flex-direction: column;
}

.confirm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 82rpx;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.08);
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.confirm-row.divider {
  border-bottom-color: rgba(17, 24, 39, 0.08);
}

.confirm-row.total {
  min-height: 82rpx;
  padding-top: 8rpx;
  border-bottom: 0;
}

.confirm-label {
  flex: none;
}

.confirm-value {
  min-width: 0;
  color: #374151;
  text-align: right;
}

.confirm-value.highlight {
  color: #f97316;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.confirm-row.total .confirm-label {
  color: #111827;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.confirm-value.success {
  color: #22c55e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.recommend-card {
  position: relative;
  margin-top: 24rpx;
  padding: 34rpx 34rpx 30rpx;
  border: 2rpx solid #fef3c7;
  border-radius: 32rpx;
  background: #fffbeb;
}

.quote-mark {
  position: absolute;
  left: 26rpx;
  top: 18rpx;
  color: #fde68a;
  font-family: Georgia, serif;
  font-size: 76rpx;
  line-height: 76rpx;
}

.recommend-copy {
  display: flex;
  flex-direction: column;
  margin-left: 54rpx;
  gap: 22rpx;
}

.recommend-text {
  color: #374151;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.recommend-author {
  color: #f97316;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: right;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78rpx;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: #f9fafb;
}

.option-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.option-icon {
  flex: none;
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.option-chevron {
  color: #9ca3af;
  font-size: 42rpx;
  line-height: 42rpx;
}

.notice-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 32rpx;
  background: #fffbeb;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #a16207;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.notice-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #fffbeb;
  background: #a16207;
  font-size: 20rpx;
  font-weight: 800;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 34rpx;
}

.notice-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #f59e0b;
}

.detail-action-bar {
  margin: 24rpx auto 0;
}

.detail-action.secondary {
  background: #ffffff;
}

.action-tip {
  color: #6b7280;
}
