<home-shell
  online-text="{{onlineText}}"
  nav-items="{{navItems}}"
  topbar-title="{{auditPage.pageTitle}}"
  toolbar-actions-visible="{{false}}"
  nav-toast-enabled="{{false}}"
  bindnavtap="handleShellNavTap"
  bindnavlongpress="handleShellNavLongPress"
  bindnavtouchend="handleShellNavTouchEnd"
>
  <scroll-view
    class="game-audit-scroll"
    scroll-y
    enhanced
    show-scrollbar="false"
    scroll-with-animation
    scroll-top="{{auditScrollTop}}"
    bindscroll="handleAuditScroll"
    enable-back-to-top
  >
    <view class="game-audit-page">
      <view class="audit-tabs">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          data-key="{{item.key}}"
          class="audit-tab {{activeFilter === item.key ? 'active' : ''}}"
          bindtap="handleFilterTap"
        >
          <text>{{item.name}}</text>
        </view>
      </view>

      <view class="audit-list">
        <view wx:for="{{displayApplications}}" wx:key="id" class="audit-card">
          <view class="audit-initiator">
            <view class="audit-initiator-avatar">
              <text>{{item.initiator.avatarText}}</text>
            </view>
            <view class="audit-initiator-copy">
              <view class="audit-initiator-head">
                <text class="audit-initiator-name">{{item.initiator.nickname}}</text>
                <text class="audit-initiator-role {{item.roleKey}}">{{item.initiator.roleName}}</text>
              </view>
              <text class="audit-initiator-time">{{auditPage.texts.applyTimeLabel}}: {{item.applyTime}}</text>
            </view>
          </view>
          <text class="audit-card-status {{item.statusKey}}">{{item.statusText}}</text>
          <view wx:if="{{item.statusKey === 'pending'}}" class="audit-approve-button" data-id="{{item.id}}" bindtap="handleApproveTap">{{auditPage.texts.approveText}}</view>
          <view wx:if="{{item.statusKey === 'pending'}}" class="audit-reject-button" data-id="{{item.id}}" bindtap="handleRejectTap">{{auditPage.texts.rejectText}}</view>
          <view wx:else class="audit-reviewed-button">{{auditPage.texts.reviewedText}}</view>
          <view class="audit-detail-button" data-id="{{item.id}}" bindtap="handleDetailTap">{{auditPage.texts.detailText}}</view>
        </view>
      </view>

      <view class="audit-batch-bar">
        <label class="audit-select-all" bindtap="handleSelectAllTap">
          <view class="audit-checkbox {{allSelected ? 'checked' : ''}}">
            <view wx:if="{{allSelected}}" class="audit-checkmark"></view>
          </view>
          <text>{{auditPage.texts.selectAllText}}</text>
        </label>
        <view class="audit-batch-button reject" bindtap="handleBatchRejectTap">{{auditPage.texts.batchRejectText}}</view>
        <view class="audit-batch-button approve" bindtap="handleBatchApproveTap">{{auditPage.texts.batchApproveText}}</view>
      </view>
    </view>
  </scroll-view>
</home-shell>
