page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.progress-detail-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.progress-detail-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.progress-detail-top-bg,
.progress-detail-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.progress-detail-top-bg {
  z-index: 0;
}

.progress-detail-nav {
  z-index: 4;
  box-sizing: border-box;
}

.progress-detail-title {
  position: absolute;
  left: 258rpx;
  width: 236rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-detail-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.progress-detail-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.progress-detail-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f9fafb;
  color: #111827;
  box-sizing: border-box;
}

.progress-detail-inner {
  min-height: 100%;
  padding: 30rpx 32rpx 0;
  box-sizing: border-box;
  background: #f9fafb;
}

.progress-detail-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.progress-detail-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 500rpx;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 36rpx;
}

.progress-detail-state.error {
  color: #c2410c;
}

.progress-detail-state-action {
  margin-top: 12rpx;
  color: #f97316;
  font-size: 24rpx;
}

.timeline-section {
  width: 684rpx;
  height: 706rpx;
  margin: 46rpx auto 0;
  padding: 34rpx 30rpx 0;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.timeline-section-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.timeline-list {
  position: relative;
  margin-top: 28rpx;
}

.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 116rpx;
}

.timeline-item.with-line::after {
  position: absolute;
  left: 17rpx;
  top: 38rpx;
  bottom: -6rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
  content: "";
}

.timeline-item.line-confirmed.with-line::after {
  background: #33c16d;
}

.timeline-rail {
  position: relative;
  z-index: 1;
  flex: none;
  width: 40rpx;
  padding-top: 4rpx;
}

.timeline-mark {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid #e5e7eb;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.timeline-mark::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #e5e7eb;
  transform: translate(-50%, -50%);
  content: "";
}

.timeline-item.confirmed .timeline-mark,
.timeline-item.done .timeline-mark {
  border-color: #33c16d;
  background: #ffffff;
}

.timeline-item.confirmed .timeline-mark::after,
.timeline-item.done .timeline-mark::after {
  background: #33c16d;
}

.timeline-item.active .timeline-mark {
  border-color: #e5e7eb;
  background: #ffffff;
}

.timeline-item.pending .timeline-mark {
  border-color: #e5e7eb;
  background: #ffffff;
}

.timeline-item.line-pending.with-line::after {
  background: #e5e7eb;
}

.timeline-copy {
  flex: 1;
  min-width: 0;
  padding-left: 38rpx;
  padding-bottom: 28rpx;
}

.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.timeline-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #374151;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-time {
  flex: none;
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.timeline-item.confirmed.emphasis .timeline-title,
.timeline-item.confirmed.emphasis .timeline-time {
  color: #f15a24;
}

.timeline-item.active .timeline-title {
  color: #9ca3af;
}

.timeline-item.active .timeline-time {
  color: #9ca3af;
}

.timeline-item.pending .timeline-title {
  color: #9ca3af;
}

.timeline-desc {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.timeline-item.pending .timeline-desc,
.timeline-item.active .timeline-desc {
  color: #9ca3af;
}

.timeline-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 274rpx;
  height: 50rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #f15a24;
  background: #ffedda;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.timeline-action::after {
  border: 0;
}

.timeline-action-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.detail-card {
  width: 100%;
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid #edf0f4;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.participants-card {
  width: 684rpx;
  height: 562rpx;
  margin: 32rpx auto 0;
  padding: 30rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.card-title {
  display: block;
  color: #374151;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.card-title.compact {
  display: inline;
}

.participant-flow {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 38rpx;
  padding: 0 0 4rpx;
  box-sizing: border-box;
}

.participant-card {
  position: relative;
  display: flex;
  align-items: center;
  width: 602rpx;
  height: 150rpx;
  padding: 22rpx 26rpx;
  border: 2rpx solid #dcfce7;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #f0fdf4;
}

.participant-card.waiting {
  border-color: #fed7aa;
  background: #fff7ed;
}

.participant-avatar {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  overflow: visible;
  border-radius: 50%;
  color: #ffffff;
  background: #3b82f6;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.participant-avatar.pink {
  background: #ec4899;
}

.participant-avatar.orange {
  background: #f97316;
}

.participant-avatar.green {
  background: #10b981;
}

.participant-avatar.teal {
  background: #14b8a6;
}

.participant-avatar.purple {
  background: #8b5cf6;
}

.participant-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.participant-badge-icon {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
  pointer-events: none;
}

.participant-badge-icon.confirmed {
  right: -7rpx;
  bottom: -7rpx;
  width: 38rpx;
  height: 38rpx;
}

.participant-badge-icon.waiting {
  right: -10rpx;
  bottom: -9rpx;
  width: 40rpx;
  height: 40rpx;
}

.participant-badge-img {
  display: block;
  width: 26rpx;
  height: 26rpx;
}

.participant-badge-icon.confirmed .participant-badge-img {
  width: 30rpx;
  height: 30rpx;
}

.participant-badge-icon.waiting .participant-badge-img {
  width: 34rpx;
  height: 34rpx;
}

.participant-badge {
  position: absolute;
  right: -4rpx;
  bottom: -3rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.participant-badge.confirmed {
  background: #46c46c;
}

.participant-badge.confirmed::after {
  position: absolute;
  left: 6rpx;
  top: 2rpx;
  width: 6rpx;
  height: 10rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(42deg);
  content: "";
}

.participant-badge.waiting {
  background: #ffffff;
  border-color: #f59e0b;
}

.participant-badge.waiting::before {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f59e0b;
  transform: translate(-50%, -50%);
  content: "";
}

.participant-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  margin-right: 14rpx;
}

.participant-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.participant-name {
  max-width: 128rpx;
  overflow: hidden;
  color: #111827;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-role-tag {
  height: 32rpx;
  margin-left: 14rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  color: #db2777;
  background: #fce7f3;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.participant-role-tag.expert {
  color: #2563eb;
  background: #dbeafe;
}

.participant-desc {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  word-break: keep-all;
  white-space: nowrap;
}

.participant-state {
  flex: none;
  width: 78rpx;
  color: #16a34a;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: right;
}

.participant-state.waiting {
  color: #f15a24;
}

.exchange-mark {
  position: relative;
  width: 52rpx;
  height: 54rpx;
  margin: 10rpx auto 10rpx;
}

.exchange-arrow {
  position: absolute;
  left: 8rpx;
  width: 36rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #d1d5db;
}

.exchange-arrow.top {
  top: 17rpx;
}

.exchange-arrow.bottom {
  bottom: 17rpx;
}

.exchange-arrow.top::after,
.exchange-arrow.bottom::before {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #d1d5db;
  border-right: 4rpx solid #d1d5db;
  box-sizing: border-box;
  content: "";
}

.exchange-arrow.top::after {
  right: 0;
  top: -5rpx;
  transform: rotate(45deg);
}

.exchange-arrow.bottom::before {
  left: 0;
  top: -5rpx;
  transform: rotate(225deg);
}

.detail-button::after {
  border: 0;
}

.bottom-spacer {
  height: 174rpx;
}

.bottom-action-bar {
  position: absolute;
  left: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 750rpx;
  padding: 20rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.78) 0%, #ffffff 32%, #ffffff 100%);
}

.detail-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.detail-button.secondary {
  flex: 1;
  border: 2rpx solid #f97316;
  color: #ea580c;
  background: #ffffff;
}

.detail-button.primary {
  flex: 1.22;
  color: #ffffff;
  background: #f97316;
  box-shadow: 0 12rpx 26rpx rgba(249, 115, 22, 0.22);
}
