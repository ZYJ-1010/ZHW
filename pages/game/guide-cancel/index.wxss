page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.guide-cancel-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.guide-cancel-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.guide-cancel-top-bg,
.guide-cancel-nav {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
}

.guide-cancel-top-bg {
  z-index: 0;
}

.guide-cancel-nav {
  z-index: 4;
  box-sizing: border-box;
}

.guide-cancel-title {
  position: absolute;
  left: 258rpx;
  width: 236rpx;
  overflow: hidden;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-cancel-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.guide-cancel-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.guide-cancel-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f7f8fa;
  color: #111827;
  box-sizing: border-box;
}

.guide-cancel-inner {
  min-height: 100%;
  padding: 44rpx 30rpx 54rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.cancel-empty {
  width: 684rpx;
  margin: 0 auto 24rpx;
  padding: 120rpx 30rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #6b7280;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.cancel-empty.error {
  color: #ef4444;
}

.guide-cancel-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.cancel-status-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 684rpx;
  height: 416rpx;
  padding: 38rpx 32rpx 34rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(147.99deg, rgba(156, 163, 175, 1) 13.72%, rgba(75, 85, 99, 1) 86.28%);
  box-shadow: 0 12rpx 28rpx rgba(75, 85, 104, 0.12);
}

.cancel-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.11);
}

.cancel-mark-image {
  display: block;
  width: 76rpx;
  height: 74rpx;
}

.reason-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fee2e2;
}

.reason-icon-image {
  display: block;
  width: 42rpx;
  height: 32rpx;
}

.action-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.action-card.orange .action-icon {
  background: #fed7aa;
}

.action-card.blue .action-icon {
  background: #bee3f8;
}

.action-icon-image {
  display: block;
}

.action-icon-image.restart {
  width: 50rpx;
  height: 48rpx;
}

.action-icon-image.recommend {
  width: 62rpx;
  height: 48rpx;
}

.hint-icon {
  flex: none;
  display: block;
  width: 34rpx;
  height: 32rpx;
  margin-top: 4rpx;
}

.cancel-status-title {
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 52rpx;
}

.cancel-status-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.cancel-section {
  overflow: hidden;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.reason-section {
  position: relative;
  width: 684rpx;
  height: 588rpx;
  margin-top: 24rpx;
  margin-left: 2rpx;
  padding: 30rpx 28rpx 0;
}

.timeline-section {
  width: 678rpx;
  height: 504rpx;
  margin-top: 42rpx;
  margin-left: 2rpx;
  padding: 30rpx 30rpx 0;
}

.action-section {
  width: 678rpx;
  height: 372rpx;
  margin-top: 28rpx;
  margin-left: 2rpx;
  padding: 30rpx 30rpx 0;
}

.section-title {
  display: block;
  padding-left: 0;
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 46rpx;
}

.reason-card {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-height: 124rpx;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid #fee2e2;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #fff1f2;
}

.reason-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.reason-title {
  display: block;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.reason-desc {
  display: block;
  margin-top: 2rpx;
  color: #6b7280;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.message-card {
  position: absolute;
  left: 40rpx;
  top: 264rpx;
  width: 600rpx;
  height: 204rpx;
  margin-top: 0;
  padding: 28rpx 24rpx 0 56rpx;
  border: 0;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f9fafb;
  box-shadow: inset 10rpx 0 0 #9ca3af;
}

.quote-mark {
  position: absolute;
  left: 26rpx;
  top: 10rpx;
  color: rgba(209, 213, 219, 0.72);
  font-family: Georgia, serif;
  font-size: 66rpx;
  font-weight: 700;
  line-height: 66rpx;
}

.message-text {
  position: relative;
  z-index: 1;
  display: block;
  padding-left: 0;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
  word-break: break-all;
}

.message-text {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.message-meta {
  position: absolute;
  left: 40rpx;
  top: 482rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 600rpx;
  height: 58rpx;
  box-sizing: border-box;
}

.message-user {
  display: flex;
  align-items: center;
  min-width: 0;
}

.user-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  overflow: hidden;
  border-radius: 50%;
  color: #ffffff;
  background: #6b7280;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.user-avatar.player {
  background: #ec4899;
}

.user-avatar.expert {
  background: #3b82f6;
}

.user-avatar.guide {
  background: #10b981;
}

.user-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.user-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-left: 14rpx;
}

.user-name {
  max-width: 150rpx;
  overflow: hidden;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-role {
  flex: none;
  height: 28rpx;
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  color: #4b5563;
  background: #f3f4f6;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.user-role.player {
  color: #db2777;
  background: #fce7f3;
}

.user-role.expert {
  color: #2563eb;
  background: #dbeafe;
}

.user-role.guide {
  color: #047857;
  background: #d1fae5;
}

.message-time {
  flex: none;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.action-grid {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  width: 100%;
  margin-top: 24rpx;
}

.action-card {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 204rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  box-sizing: border-box;
  font-family: inherit;
}

.action-card::after {
  border: 0;
}

.action-card.orange {
  border: 2rpx solid #fed7aa;
  background: #fff7ed;
}

.action-card.blue {
  border: 2rpx solid #bee3f8;
  background: #ebf8ff;
}

.action-title {
  margin-top: 14rpx;
  color: #1f2937;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.action-desc {
  margin-top: 2rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.hint-card {
  display: flex;
  align-items: flex-start;
  width: 684rpx;
  height: 180rpx;
  margin-top: 36rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid #bfdbfe;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #eff6ff;
}

.hint-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.hint-title {
  display: block;
  color: #1e40af;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.hint-desc {
  display: block;
  margin-top: 4rpx;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 34rpx;
}
