page {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.player-manage-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.manage-frame {
  position: relative;
  width: 750rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}

.manage-nav {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 750rpx;
  height: 160rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.manage-title {
  position: absolute;
  left: 250rpx;
  width: 252rpx;
  overflow: hidden;
  color: #000000;
  font-size: 36rpx;
  font-weight: 400;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-back {
  position: absolute;
  left: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(51, 51, 51, 0.28);
}

.manage-back-icon {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid rgba(51, 51, 51, 0.71);
  border-bottom: 4rpx solid rgba(51, 51, 51, 0.71);
  box-sizing: border-box;
  transform: translateX(3rpx) rotate(45deg);
}

.manage-service-button {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.manage-service-button::after {
  border: 0;
}

.manage-service-icon {
  width: 44rpx;
  height: 44rpx;
}

.manage-content {
  position: absolute;
  z-index: 1;
  display: block;
  margin: 0;
  overflow: hidden;
  background: #f9fafb;
  color: #111827;
  box-sizing: border-box;
}

.manage-inner {
  min-height: 100%;
  padding: 16rpx 0 58rpx;
  box-sizing: border-box;
  background: #f9fafb;
}

.manage-bottom-bg {
  position: absolute;
  left: 0;
  z-index: 0;
  width: 750rpx;
  background: #ffffff;
}

.summary-card {
  width: 728rpx;
  height: 216rpx;
  margin: 0 auto;
  padding: 32rpx 34rpx 28rpx;
  box-sizing: border-box;
  background: linear-gradient(90deg, #f472b6 0%, #a855f7 100%);
  color: #ffffff;
}

.summary-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.summary-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  line-height: 40rpx;
}

.summary-amount {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.summary-icon {
  position: relative;
  flex: none;
  width: 82rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.summary-icon-mark {
  position: absolute;
  left: 26rpx;
  top: 22rpx;
  width: 28rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 4rpx solid #ffffff;
  border-top-width: 8rpx;
  border-radius: 5rpx;
}

.summary-icon-mark::before {
  position: absolute;
  left: 5rpx;
  top: -17rpx;
  width: 14rpx;
  height: 12rpx;
  box-sizing: border-box;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
  content: '';
}

.summary-stats {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.summary-stat {
  margin-right: 38rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.manage-tabs {
  display: flex;
  align-items: center;
  width: 728rpx;
  height: 90rpx;
  margin: 0 auto;
  border-bottom: 2rpx solid #e5e7eb;
  background: #ffffff;
  box-sizing: border-box;
}

.manage-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  color: #6b7280;
  font-size: 28rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.manage-tab.active {
  color: #2563eb;
  font-weight: 700;
}

.manage-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: -2rpx;
  width: 96rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #2563eb;
  transform: translateX(-50%);
  content: '';
}

.order-card {
  width: 662rpx;
  margin: 30rpx auto 0;
  padding: 34rpx 32rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.03);
}

.active-card {
  min-height: 620rpx;
}

.complete-card,
.canceled-card {
  min-height: 392rpx;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx 0 18rpx;
  border-radius: 40rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 34rpx;
}

.status-pill.active {
  color: #1d4ed8;
  background: #dbeafe;
}

.status-pill.complete {
  color: #047857;
  background: #d1fae5;
}

.status-pill.canceled {
  color: #4b5563;
  background: #f3f4f6;
}

.status-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #3b82f6;
}

.status-dot.complete {
  background: #10b981;
}

.status-dot.canceled {
  background: #9ca3af;
}

.order-ref {
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  white-space: nowrap;
}

.expert-row {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.expert-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 48rpx;
}

.expert-avatar.active {
  background: linear-gradient(135deg, #60a5fa 0%, #1683f8 100%);
}

.expert-avatar.complete {
  background: linear-gradient(135deg, #34d399 0%, #059669 100%);
}

.expert-avatar.canceled {
  background: linear-gradient(135deg, #fb7185 0%, #dc2626 100%);
}

.expert-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 26rpx;
}

.expert-name {
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.expert-name.muted {
  color: #4b5563;
}

.service-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 28rpx;
  line-height: 36rpx;
}

.service-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-separator {
  flex: none;
  margin: 0 14rpx;
  color: #6b7280;
}

.service-amount {
  flex: none;
  color: #6b7280;
}

.guide-text {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 32rpx;
}

.progress-panel {
  margin-top: 28rpx;
  padding: 26rpx 26rpx 24rpx;
  border-radius: 14rpx;
  background: #f9fafb;
}

.progress-heading,
.progress-days {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-heading {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 38rpx;
}

.progress-track {
  width: 550rpx;
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-fill {
  height: 14rpx;
  border-radius: 999rpx;
  background: #2288f5;
}

.delivery-text {
  display: block;
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 34rpx;
}

.progress-days {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
}

.action-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 34rpx;
  box-sizing: border-box;
}

.order-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  overflow: hidden;
  white-space: nowrap;
}

.order-action::after {
  border: 0;
}

.order-action.contact {
  color: #2563eb;
  background: #eff6ff;
}

.order-action.cancel {
  margin-left: 16rpx;
  color: #dc2626;
  background: #fff1f2;
}

.action-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.notice-row {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid #fde68a;
  border-radius: 12rpx;
  color: #854d0e;
  font-size: 24rpx;
  line-height: 32rpx;
  background: #fefce8;
  box-sizing: border-box;
}

.notice-icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 10rpx;
}

.notice-icon::before {
  position: absolute;
  left: 10rpx;
  top: 2rpx;
  width: 4rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: #854d0e;
  content: '';
}

.notice-icon::after {
  position: absolute;
  left: 10rpx;
  bottom: 2rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #854d0e;
  content: '';
}

.completed-panel,
.refund-panel {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
}

.completed-panel {
  border: 2rpx solid #d1fae5;
  color: #047857;
  background: #ecfdf5;
}

.refund-panel {
  border: 2rpx solid #fee2e2;
  color: #b91c1c;
  background: #fef2f2;
}

.completed-top,
.refund-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  line-height: 40rpx;
}

.completed-amount {
  color: #059669;
  font-weight: 700;
}

.refund-amount {
  color: #dc2626;
  font-weight: 700;
}

.completed-time,
.refund-reason {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
}

.completed-result {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #047857;
  font-size: 24rpx;
  line-height: 32rpx;
}

.completed-check {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #10b981;
}

.completed-check::after {
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(42deg);
  content: '';
}

.review-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  margin: 24rpx 0 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #fb923c 0%, #f97316 100%);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  box-sizing: border-box;
}

.review-action::after {
  border: 0;
}

.review-action.disabled {
  color: #9ca3af;
  background: #f3f4f6;
  opacity: 1;
}
