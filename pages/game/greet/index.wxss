.greet-shell {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000000;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.greet-message-scroll {
  width: 100%;
  height: calc(100% - 96rpx);
  box-sizing: border-box;
}

.greet-message-page {
  min-height: 100%;
  padding: 38rpx 26rpx 42rpx;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.self-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 17rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #00bfa5;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.22);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.message-stack {
  flex: 1;
  min-width: 0;
}

.invite-card {
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.22);
}

.card-header {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #edf0f3;
  box-sizing: border-box;
}

.assistant-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 24rpx;
  margin-right: 13rpx;
  border-radius: 5rpx;
  color: #ffffff;
  background: #20c968;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 24rpx;
}

.assistant-name {
  color: #69707a;
  font-size: 25rpx;
  line-height: 34rpx;
}

.card-body {
  padding: 28rpx;
  box-sizing: border-box;
}

.invite-title-row {
  display: flex;
  align-items: center;
}

.invite-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  margin-right: 21rpx;
  border-radius: 50%;
  background: #fff1db;
}

.handshake-icon {
  position: relative;
  width: 48rpx;
  height: 34rpx;
}

.handshake-icon::before,
.handshake-icon::after {
  position: absolute;
  width: 30rpx;
  height: 18rpx;
  border: 5rpx solid #f3a544;
  border-radius: 9rpx;
  box-sizing: border-box;
  content: '';
}

.handshake-icon::before {
  left: 0;
  top: 6rpx;
  transform: rotate(25deg);
}

.handshake-icon::after {
  right: 0;
  top: 10rpx;
  transform: rotate(-25deg);
}

.invite-title-copy {
  flex: 1;
  min-width: 0;
}

.invite-title,
.invite-subtitle,
.player-info-label,
.player-name,
.player-desc,
.event-detail-row,
.referrer-bubble text {
  display: block;
}

.invite-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.invite-subtitle {
  margin-top: 4rpx;
  color: #8a8f98;
  font-size: 24rpx;
  line-height: 34rpx;
}

.player-info-box {
  margin-top: 30rpx;
  padding: 22rpx;
  border-radius: 15rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.player-info-label {
  margin-bottom: 16rpx;
  color: #a3a8b0;
  font-size: 21rpx;
  line-height: 29rpx;
}

.player-info-row {
  display: flex;
  align-items: center;
}

.player-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 21rpx;
  border-radius: 12rpx;
  color: #9aa2ad;
  background: #e1e5ea;
  font-size: 24rpx;
  font-weight: 700;
}

.player-copy {
  flex: 1;
  min-width: 0;
}

.player-name {
  overflow: hidden;
  color: #333333;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-desc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #8a8f98;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-detail-list {
  margin-top: 27rpx;
  padding-left: 2rpx;
}

.event-detail-row {
  display: flex;
  align-items: center;
  min-height: 36rpx;
  margin-top: 13rpx;
  color: #333333;
  font-size: 24rpx;
  line-height: 34rpx;
}

.event-detail-row:first-child {
  margin-top: 0;
}

.detail-icon {
  position: relative;
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.detail-icon.calendar {
  border: 4rpx solid #a4abb5;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.detail-icon.calendar::before {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 7rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #a4abb5;
  content: '';
}

.detail-icon.pin::before {
  position: absolute;
  left: 5rpx;
  top: 1rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #a4abb5;
  border-radius: 50% 50% 50% 0;
  box-sizing: border-box;
  transform: rotate(-45deg);
  content: '';
}

.detail-icon.pin::after {
  position: absolute;
  left: 13rpx;
  top: 9rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #a4abb5;
  content: '';
}

.card-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 22rpx;
  padding: 0 28rpx 28rpx;
}

.card-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.card-button::after,
.input-tool::after {
  border: 0;
}

.card-button.primary {
  color: #ffffff;
  background: #20c968;
  box-shadow: 0 7rpx 14rpx rgba(32, 201, 104, 0.22);
}

.card-button.secondary {
  color: #333333;
  background: #f1f2f4;
}

.referrer-bubble-wrap {
  position: relative;
  margin-top: 18rpx;
}

.bubble-caret {
  position: absolute;
  left: 29rpx;
  top: -15rpx;
  width: 0;
  height: 0;
  border-right: 14rpx solid transparent;
  border-bottom: 18rpx solid #a8f076;
  border-left: 14rpx solid transparent;
}

.referrer-bubble {
  padding: 27rpx 28rpx;
  border-radius: 22rpx;
  color: #333333;
  background: #a8f076;
  box-shadow: 0 7rpx 14rpx rgba(0, 0, 0, 0.1);
  font-size: 27rpx;
  line-height: 43rpx;
}

.chat-input-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 14rpx 20rpx;
  border-top: 1rpx solid #d9dde3;
  box-sizing: border-box;
  background: #f4f5f7;
}

.message-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  border: 1rpx solid #d2d7df;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.input-tool {
  position: relative;
  flex: none;
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}

.input-tool.voice {
  margin-right: 14rpx;
}

.input-tool.emoji,
.input-tool.add {
  margin-left: 14rpx;
}

.input-tool.voice::before {
  position: absolute;
  left: 20rpx;
  top: 11rpx;
  width: 14rpx;
  height: 24rpx;
  border: 4rpx solid #747b85;
  border-radius: 10rpx;
  box-sizing: border-box;
  content: '';
}

.input-tool.voice::after {
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  width: 26rpx;
  height: 16rpx;
  border-right: 4rpx solid #747b85;
  border-bottom: 4rpx solid #747b85;
  border-left: 4rpx solid #747b85;
  border-radius: 0 0 18rpx 18rpx;
  box-sizing: border-box;
  content: '';
}

.input-tool.emoji::before {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid #747b85;
  border-radius: 50%;
  box-sizing: border-box;
  content: '';
}

.input-tool.emoji::after {
  position: absolute;
  left: 20rpx;
  top: 29rpx;
  width: 14rpx;
  height: 7rpx;
  border-bottom: 4rpx solid #747b85;
  border-radius: 0 0 14rpx 14rpx;
  content: '';
}

.input-tool.add::before {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid #747b85;
  border-radius: 50%;
  box-sizing: border-box;
  content: '';
}

.input-tool.add::after {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 18rpx;
  height: 18rpx;
  background:
    linear-gradient(#747b85, #747b85) center / 4rpx 18rpx no-repeat,
    linear-gradient(#747b85, #747b85) center / 18rpx 4rpx no-repeat;
  content: '';
}
