.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.loading,
.hello,
.sub,
.section-title,
.section-more,
.game-title,
.game-meta {
  display: block;
}

.loading {
  padding-top: 120rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 28rpx;
  text-align: center;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0 28rpx;
}

.hello {
  color: #111111;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.sub {
  margin-top: 12rpx;
  color: rgba(17, 17, 17, 0.58);
  font-size: 25rpx;
}

.status {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 24rpx;
  font-weight: 700;
}

.status.warn {
  color: #111111;
  background: rgba(17, 17, 17, 0.06);
}

.notice,
.section {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 8rpx;
  background: #ffffff;
}

.notice {
  color: rgba(17, 17, 17, 0.72);
  font-size: 26rpx;
  line-height: 1.5;
}

.section-head,
.game-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  color: rgba(17, 17, 17, 0.48);
  font-size: 23rpx;
}

.actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.action {
  min-height: 78rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  color: #111111;
  background: rgba(17, 17, 17, 0.04);
  font-size: 25rpx;
  line-height: 78rpx;
  text-align: center;
}

.game-card {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(17, 17, 17, 0.06);
}

.game-title {
  color: #111111;
  font-size: 29rpx;
  font-weight: 700;
}

.game-status {
  flex: 0 0 auto;
  color: #07c160;
  font-size: 24rpx;
  font-weight: 700;
}

.game-meta {
  margin-top: 12rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  font-size: 22rpx;
}
