.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: #f7f7f8;
}

.loading,
.hello,
.hero-sub,
.online,
.section-title,
.section-more,
.game-title,
.game-meta,
.game-status,
.game-price,
.game-joined,
.player-role,
.player-name,
.xp,
.progress-tip,
.stat-value,
.stat-label,
.rank-name,
.rank-desc,
.metaverse-title,
.metaverse-desc {
  display: block;
}

.loading {
  padding-top: 120rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 28rpx;
  text-align: center;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0 18rpx;
}

.hello {
  color: #111111;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 24rpx;
}

.online {
  flex: 0 0 auto;
  margin-top: 6rpx;
  color: #07c160;
  font-size: 24rpx;
  font-weight: 700;
}

.notice,
.section,
.player-card,
.metaverse {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.notice {
  color: rgba(17, 17, 17, 0.68);
  font-size: 25rpx;
  line-height: 1.5;
}

.section-head,
.game-main,
.game-bottom,
.player-head,
.rank-row,
.achievement,
.metaverse {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #111111;
  font-size: 31rpx;
  font-weight: 700;
}

.section-more {
  color: rgba(17, 17, 17, 0.46);
  font-size: 23rpx;
}

.game-card,
.friend-card {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(17, 17, 17, 0.06);
}

.game-title {
  color: #111111;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.game-meta {
  margin-top: 10rpx;
  color: rgba(17, 17, 17, 0.55);
  font-size: 23rpx;
  line-height: 1.4;
}

.join-pill {
  flex: 0 0 auto;
  min-width: 82rpx;
  height: 54rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
}

.game-bottom {
  justify-content: flex-start;
  margin-top: 16rpx;
}

.game-status,
.game-price,
.game-joined {
  font-size: 23rpx;
}

.game-status {
  color: #07c160;
  font-weight: 700;
}

.game-price {
  color: #111111;
  font-weight: 700;
}

.game-joined {
  color: rgba(17, 17, 17, 0.46);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  font-size: 22rpx;
}

.player-role {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
}

.player-name,
.progress-tip {
  margin-top: 8rpx;
  color: rgba(17, 17, 17, 0.54);
  font-size: 23rpx;
}

.xp {
  color: #07c160;
  font-size: 26rpx;
  font-weight: 700;
}

.progress {
  height: 12rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.06);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #07c160;
}

.stats,
.actions {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.stats {
  grid-template-columns: repeat(3, 1fr);
}

.stat {
  padding: 18rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(17, 17, 17, 0.04);
  text-align: center;
}

.stat-value {
  color: #111111;
  font-size: 29rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: rgba(17, 17, 17, 0.48);
  font-size: 22rpx;
}

.actions {
  grid-template-columns: repeat(3, 1fr);
}

.action {
  min-height: 74rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: #111111;
  background: rgba(17, 17, 17, 0.04);
  font-size: 24rpx;
  line-height: 74rpx;
  text-align: center;
}

.rank-row {
  margin-top: 20rpx;
}

.rank-no {
  flex: 0 0 44rpx;
  color: #07c160;
  font-size: 25rpx;
  font-weight: 700;
}

.rank-copy {
  flex: 1;
  min-width: 0;
}

.rank-name {
  color: #111111;
  font-size: 25rpx;
  font-weight: 700;
}

.rank-desc,
.rank-xp {
  color: rgba(17, 17, 17, 0.48);
  font-size: 22rpx;
}

.rank-xp {
  flex: 0 0 auto;
}

.achievement-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(17, 17, 17, 0.06);
}

.achievement {
  margin-top: 16rpx;
  color: rgba(17, 17, 17, 0.68);
  font-size: 24rpx;
}

.metaverse {
  color: #ffffff;
  background: #111111;
}

.metaverse-title {
  font-size: 28rpx;
  font-weight: 700;
}

.metaverse-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
}

.metaverse-action {
  flex: 0 0 auto;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  color: #111111;
  background: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}

.home-preview-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #f7f7f8;
  color: #1a1a2e;
}

.home-preview-screen {
  position: relative;
  width: 100%;
  height: 100vh;
  padding: 54rpx 48rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #f7f7f8;
}

.home-preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.home-preview-badge,
.home-preview-title,
.home-preview-subtitle,
.home-preview-desc,
.home-preview-count,
.home-preview-stat-value,
.home-preview-stat-label,
.home-preview-card-title,
.home-preview-card-meta,
.home-preview-plan-name,
.home-preview-plan-desc {
  display: block;
}

.home-preview-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(100deg, #8a5cf6 0%, #e44f9b 100%);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.home-preview-title {
  margin-top: 28rpx;
  color: #1a1a2e;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.home-preview-subtitle {
  margin-top: 10rpx;
  color: #666672;
  font-size: 26rpx;
  line-height: 38rpx;
}

.home-preview-desc {
  margin-top: 34rpx;
  color: #777783;
  font-size: 24rpx;
  line-height: 36rpx;
}

.home-preview-count {
  flex: 0 0 auto;
  color: #9a9aa3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.home-preview-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 44rpx;
}

.home-preview-stat {
  height: 118rpx;
  padding: 22rpx 12rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.home-preview-stat-value {
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.home-preview-stat-label {
  margin-top: 10rpx;
  color: #8a8a96;
  font-size: 22rpx;
  line-height: 30rpx;
}

.home-preview-card-list {
  margin-top: 30rpx;
}

.home-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 132rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.home-preview-card-title {
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.home-preview-card-meta {
  margin-top: 10rpx;
  color: #8a8a96;
  font-size: 22rpx;
  line-height: 30rpx;
}

.home-preview-card-tag {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #22c79a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.home-preview-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.home-preview-action {
  height: 82rpx;
  border-radius: 20rpx;
  color: #1a1a2e;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 82rpx;
  text-align: center;
}

.home-preview-permission,
.home-preview-compare,
.home-preview-apply,
.home-preview-review,
.home-preview-theme {
  margin-top: 48rpx;
}

.home-preview-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 38rpx;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(100deg, #8a5cf6 0%, #e44f9b 100%);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 112rpx;
}

.home-preview-benefits {
  margin-top: 20rpx;
}

.home-preview-benefit {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #1a1a2e;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.home-preview-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #22c79a;
}

.home-preview-primary,
.home-preview-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.home-preview-primary {
  margin-top: 42rpx;
  color: #ffffff;
  background: linear-gradient(100deg, #8a5cf6 0%, #e44f9b 100%);
}

.home-preview-secondary {
  margin-top: 18rpx;
  color: #777783;
  background: #ffffff;
}

.home-preview-plan {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.home-preview-plan-name {
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.home-preview-plan-desc {
  margin-top: 8rpx;
  color: #777783;
  font-size: 22rpx;
  line-height: 32rpx;
}

.home-preview-plan-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.home-preview-plan-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8a5cf6;
  background: #f2ecff;
  font-size: 20rpx;
  font-weight: 700;
}

.home-preview-form-row,
.home-preview-status-card,
.home-preview-step,
.home-preview-color-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #1a1a2e;
  font-size: 25rpx;
  font-weight: 800;
}

.home-preview-form-placeholder,
.home-preview-color-row text:last-child {
  color: #8a5cf6;
  font-size: 22rpx;
  font-weight: 700;
}

.home-preview-status-card {
  justify-content: center;
  min-height: 120rpx;
  color: #8a5cf6;
  text-align: center;
}

.home-preview-steps {
  margin-top: 28rpx;
}

.home-preview-step {
  justify-content: flex-start;
}

.home-preview-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #22c79a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.home-preview-hit {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 50;
  width: 54rpx;
  opacity: 0;
  pointer-events: auto;
}

.home-preview-hit.left {
  left: 0;
}

.home-preview-hit.right {
  right: 0;
}

.home-preview-page.playerHome {
  height: 100vh;
  overflow: hidden;
  background: #101010;
  color: #ffffff;
}

.home-player-stage {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #101010;
}

.home-player-stage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 132rpx;
  padding: 26rpx 28rpx 18rpx;
  box-sizing: border-box;
  background: #264462;
}

.home-player-stage-brand,
.home-player-stage-tools,
.home-player-today-copy view {
  display: flex;
  align-items: center;
}

.home-player-stage-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: #ef4444;
  font-size: 28rpx;
  line-height: 48rpx;
}

.home-player-stage-title,
.home-player-stage-online,
.home-player-hero-copy text,
.home-player-today-copy text,
.home-player-mini-entry text {
  display: block;
}

.home-player-stage-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 40rpx;
}

.home-player-stage-online {
  margin-top: 4rpx;
  color: #facc15;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 26rpx;
}

.home-player-stage-tools {
  gap: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.home-player-stage-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 4rpx solid #f87171;
  border-radius: 50%;
  color: #101010;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 58rpx;
}

.home-player-stage-main {
  position: relative;
  height: calc(100vh - 132rpx - 220rpx);
  min-height: 460rpx;
  padding: 30rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.home-player-hero-copy {
  position: relative;
  z-index: 2;
}

.home-player-hero-copy text:first-child {
  color: #a2ef4d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.home-player-hero-copy text:last-child {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.home-player-start-orb {
  position: absolute;
  left: 50%;
  top: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 320rpx;
  margin-left: -160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 50%, #3b82f6 100%);
  box-shadow: 0 0 56rpx rgba(59, 130, 246, 0.45);
  animation: homePlayerGlow 3s ease-in-out infinite;
}

@keyframes homePlayerGlow {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 44rpx rgba(59, 130, 246, 0.45);
  }

  50% {
    transform: scale(1.04);
    box-shadow: 0 0 76rpx rgba(59, 130, 246, 0.78);
  }
}

.home-player-console {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 174rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: inset 0 10rpx 22rpx rgba(0, 0, 0, 0.18);
}

.home-player-console-plus {
  color: #101010;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 74rpx;
}

.home-player-console-buttons {
  display: flex;
  gap: 12rpx;
  margin-left: 24rpx;
}

.home-player-console-buttons text {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #101010;
}

.home-player-console-flash {
  position: absolute;
  right: 24rpx;
  top: 10rpx;
  color: #3b82f6;
  font-size: 28rpx;
  font-weight: 900;
}

.home-player-go {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border: 8rpx solid #101010;
  border-radius: 50%;
  color: #101010;
  background: #60a5fa;
  font-size: 28rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 86rpx;
  transform: rotate(12deg);
}

.home-player-today-card {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 92rpx;
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 26rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #007bd3 0%, #034373 100%);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.36);
}

.home-player-today-cover {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  color: #001722;
  background: linear-gradient(135deg, #77f6ff 0%, #1c5dff 100%);
  font-size: 36rpx;
  font-weight: 900;
}

.home-player-today-copy {
  flex: 1;
  min-width: 0;
}

.home-player-today-copy view {
  justify-content: space-between;
  gap: 16rpx;
}

.home-player-today-copy view text:first-child {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 30rpx;
  padding: 0 10rpx;
  color: #ffffff;
  background: #f39e1e;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 30rpx;
}

.home-player-today-copy view text:last-child {
  color: #a2ef4d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 30rpx;
}

.home-player-today-copy > text:nth-child(2) {
  margin-top: 8rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-player-today-copy > text:nth-child(3),
.home-player-today-copy > text:nth-child(4) {
  margin-top: 4rpx;
  overflow: hidden;
  color: #d9f1ff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-player-today-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 42rpx;
  margin-left: 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ff006e;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.home-player-mini-grid {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.home-player-mini-entry {
  display: flex;
  align-items: center;
