.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: #f7f7f8;
}

.loading,
.hello,
.hero-sub,
.online,
.section-title,
.section-more,
.game-title,
.game-meta,
.game-status,
.game-price,
.game-joined,
.player-role,
.player-name,
.xp,
.progress-tip,
.stat-value,
.stat-label,
.rank-name,
.rank-desc,
.metaverse-title,
.metaverse-desc {
  display: block;
}

.loading {
  padding-top: 120rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 28rpx;
  text-align: center;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0 18rpx;
}

.hello {
  color: #111111;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 24rpx;
}

.online {
  flex: 0 0 auto;
  margin-top: 6rpx;
  color: #07c160;
  font-size: 24rpx;
  font-weight: 700;
}

.notice,
.section,
.player-card,
.metaverse {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.notice {
  color: rgba(17, 17, 17, 0.68);
  font-size: 25rpx;
  line-height: 1.5;
}

.section-head,
.game-main,
.game-bottom,
.player-head,
.rank-row,
.achievement,
.metaverse {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #111111;
  font-size: 31rpx;
  font-weight: 700;
}

.section-more {
  color: rgba(17, 17, 17, 0.46);
  font-size: 23rpx;
}

.game-card,
.friend-card {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(17, 17, 17, 0.06);
}

.game-title {
  color: #111111;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.game-meta {
  margin-top: 10rpx;
  color: rgba(17, 17, 17, 0.55);
  font-size: 23rpx;
  line-height: 1.4;
}

.join-pill {
  flex: 0 0 auto;
  min-width: 82rpx;
  height: 54rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
}

.game-bottom {
  justify-content: flex-start;
  margin-top: 16rpx;
}

.game-status,
.game-price,
.game-joined {
  font-size: 23rpx;
}

.game-status {
  color: #07c160;
  font-weight: 700;
}

.game-price {
  color: #111111;
  font-weight: 700;
}

.game-joined {
  color: rgba(17, 17, 17, 0.46);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  font-size: 22rpx;
}

.player-role {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
}

.player-name,
.progress-tip {
  margin-top: 8rpx;
  color: rgba(17, 17, 17, 0.54);
  font-size: 23rpx;
}

.xp {
  color: #07c160;
  font-size: 26rpx;
  font-weight: 700;
}

.progress {
  height: 12rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.06);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #07c160;
}

.stats,
.actions {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.stats {
  grid-template-columns: repeat(3, 1fr);
}

.stat {
  padding: 18rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(17, 17, 17, 0.04);
  text-align: center;
}

.stat-value {
  color: #111111;
  font-size: 29rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: rgba(17, 17, 17, 0.48);
  font-size: 22rpx;
}

.actions {
  grid-template-columns: repeat(3, 1fr);
}

.action {
  min-height: 74rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: #111111;
  background: rgba(17, 17, 17, 0.04);
  font-size: 24rpx;
  line-height: 74rpx;
  text-align: center;
}

.rank-row {
  margin-top: 20rpx;
}

.rank-no {
  flex: 0 0 44rpx;
  color: #07c160;
  font-size: 25rpx;
  font-weight: 700;
}

.rank-copy {
  flex: 1;
  min-width: 0;
}

.rank-name {
  color: #111111;
  font-size: 25rpx;
  font-weight: 700;
}

.rank-desc,
.rank-xp {
  color: rgba(17, 17, 17, 0.48);
  font-size: 22rpx;
}

.rank-xp {
  flex: 0 0 auto;
}

.achievement-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(17, 17, 17, 0.06);
}

.achievement {
  margin-top: 16rpx;
  color: rgba(17, 17, 17, 0.68);
  font-size: 24rpx;
}

.metaverse {
  color: #ffffff;
  background: #111111;
}

.metaverse-title {
  font-size: 28rpx;
  font-weight: 700;
}

.metaverse-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
}

.metaverse-action {
  flex: 0 0 auto;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  color: #111111;
  background: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}

.home-preview-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #f7f7f8;
  color: #1a1a2e;
}

.home-preview-screen {
  position: relative;
  width: 100%;
  height: 100vh;
  padding: 54rpx 48rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #f7f7f8;
}

.home-preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.home-preview-badge,
.home-preview-title,
.home-preview-subtitle,
.home-preview-desc,
.home-preview-count,
.home-preview-stat-value,
.home-preview-stat-label,
.home-preview-card-title,
.home-preview-card-meta,
.home-preview-plan-name,
.home-preview-plan-desc {
  display: block;
}

.home-preview-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(100deg, #8a5cf6 0%, #e44f9b 100%);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.home-preview-title {
  margin-top: 28rpx;
  color: #1a1a2e;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.home-preview-subtitle {
  margin-top: 10rpx;
  color: #666672;
  font-size: 26rpx;
  line-height: 38rpx;
}

.home-preview-desc {
  margin-top: 34rpx;
  color: #777783;
  font-size: 24rpx;
  line-height: 36rpx;
}

.home-preview-count {
  flex: 0 0 auto;
  color: #9a9aa3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.home-preview-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 44rpx;
}

.home-preview-stat {
  height: 118rpx;
  padding: 22rpx 12rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.home-preview-stat-value {
  color: #1a1a2e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.home-preview-stat-label {
  margin-top: 10rpx;
  color: #8a8a96;
  font-size: 22rpx;
  line-height: 30rpx;
}

.home-preview-card-list {
  margin-top: 30rpx;
}

.home-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 132rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.home-preview-card-title {
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.home-preview-card-meta {
  margin-top: 10rpx;
  color: #8a8a96;
  font-size: 22rpx;
  line-height: 30rpx;
}

.home-preview-card-tag {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #22c79a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.home-preview-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.home-preview-action {
  height: 82rpx;
  border-radius: 20rpx;
  color: #1a1a2e;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 82rpx;
  text-align: center;
}

.home-preview-permission,
.home-preview-compare,
.home-preview-apply,
.home-preview-review,
.home-preview-theme {
  margin-top: 48rpx;
}

.home-preview-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 38rpx;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(100deg, #8a5cf6 0%, #e44f9b 100%);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 112rpx;
}

.home-preview-benefits {
  margin-top: 20rpx;
}

.home-preview-benefit {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #1a1a2e;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.home-preview-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #22c79a;
}

.home-preview-primary,
.home-preview-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.home-preview-primary {
  margin-top: 42rpx;
  color: #ffffff;
  background: linear-gradient(100deg, #8a5cf6 0%, #e44f9b 100%);
}

.home-preview-secondary {
  margin-top: 18rpx;
  color: #777783;
  background: #ffffff;
}

.home-preview-plan {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.home-preview-plan-name {
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.home-preview-plan-desc {
  margin-top: 8rpx;
  color: #777783;
  font-size: 22rpx;
  line-height: 32rpx;
}

.home-preview-plan-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.home-preview-plan-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8a5cf6;
  background: #f2ecff;
  font-size: 20rpx;
  font-weight: 700;
}

.home-preview-form-row,
.home-preview-status-card,
.home-preview-step,
.home-preview-color-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #1a1a2e;
  font-size: 25rpx;
  font-weight: 800;
}

.home-preview-form-placeholder,
.home-preview-color-row text:last-child {
  color: #8a5cf6;
  font-size: 22rpx;
  font-weight: 700;
}

.home-preview-status-card {
  justify-content: center;
  min-height: 120rpx;
  color: #8a5cf6;
  text-align: center;
}

.home-preview-steps {
  margin-top: 28rpx;
}

.home-preview-step {
  justify-content: flex-start;
}

.home-preview-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #22c79a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.home-preview-hit {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 50;
  width: 54rpx;
  opacity: 0;
  pointer-events: auto;
}

.home-preview-hit.left {
  left: 0;
}

.home-preview-hit.right {
  right: 0;
}

.home-preview-page.playerHome {
  height: 100vh;
  overflow: hidden;
  background: #007bd3;
  color: #ffffff;
}

.home-player-scroll {
  width: 100%;
  height: 100vh;
  background: #007bd3;
  box-sizing: border-box;
}

.home-player-canvas {
  position: relative;
  width: 750rpx;
  min-height: 4070rpx;
  background: #007bd3;
}

.home-player-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 184rpx;
  padding: 82rpx 28rpx 20rpx;
  box-sizing: border-box;
  background: #007bd3;
}

.home-player-flag {
  display: inline-block;
  width: 70rpx;
  height: 46rpx;
  margin-right: 8rpx;
  background: linear-gradient(135deg, #ff2b8f 0%, #ff2b8f 50%, #16c0f6 50%, #16c0f6 100%);
  vertical-align: middle;
}

.home-player-brand {
  color: #bff8ff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 34rpx;
  vertical-align: middle;
}

.home-player-online {
  display: block;
  margin: 8rpx 0 0 84rpx;
  color: #fefa83;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.home-player-tools {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.home-player-tool-dot {
  display: block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ec4899;
}

.home-player-tool-search {
  color: #d9fbff;
  font-size: 32rpx;
  font-weight: 900;
}

.home-player-avatar {
  display: block;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 38%, #ffda78 0 18%, transparent 19%),
    radial-gradient(circle at 51% 62%, #2c1711 0 44%, transparent 45%),
    linear-gradient(135deg, #a855f7, #ec4899);
}

.home-player-content {
  width: 704rpx;
  height: 3882rpx;
  min-height: 3882rpx;
  margin-left: 20rpx;
  padding: 18rpx 22rpx 180rpx;
  box-sizing: border-box;
  background: #101010;
}

.home-player-greeting {
  padding: 0 22rpx 30rpx;
}

.home-player-title,
.home-player-date,
.home-player-game-title,
.home-player-game-meta,
.home-player-joined,
.home-player-section-title,
.home-player-panel-title,
.home-player-rank-name,
.home-player-rank-desc,
.home-player-rank-more,
.home-player-achievement-title,
.home-player-achievement-status,
.home-player-profile-role,
.home-player-profile-title,
.home-player-profile-name,
.home-player-profile-xp,
.home-player-next,
.home-player-earth-title,
.home-player-earth-desc,
.home-player-entry-title,
.home-player-entry-desc,
.home-player-metaverse-title,
.home-player-metaverse-desc {
  display: block;
}

.home-player-title {
  color: #a2ef4d;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 62rpx;
  letter-spacing: 0;
}

.home-player-date {
  margin-top: 4rpx;
  color: #e8f3ff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
  letter-spacing: 0;
}

.home-player-game,
.home-player-rank-panel,
.home-player-achievement-panel,
.home-player-profile-card,
.home-player-earth,
.home-player-metaverse {
  width: 662rpx;
  margin-right: auto;
  margin-left: auto;
  box-sizing: border-box;
}

.home-player-game {
  position: relative;
  display: block;
  height: 244rpx;
  min-height: 244rpx;
  padding: 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #007bd3 0%, #034373 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.home-player-featured {
  margin-top: 8rpx;
}

.home-player-game-image,
.home-player-game-image.small,
.home-player-game-image.warm {
  position: absolute;
  left: 34rpx;
  top: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 178rpx;
  height: 180rpx;
  border-radius: 8rpx;
  color: #001722;
  background: linear-gradient(135deg, #77f6ff 0%, #1c5dff 100%);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 180rpx;
}

.home-player-game-image.small {
  background: linear-gradient(135deg, #6fffeb 0%, #007bd3 100%);
}

.home-player-game-image.warm {
  background: linear-gradient(135deg, #ffb347 0%, #ff2b8f 100%);
}

.home-player-game-body,
.home-player-game-head {
  display: block;
  min-width: 0;
  padding: 0;
}

.home-player-game-tag {
  position: absolute;
  left: 228rpx;
  top: 34rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  min-width: 0;
  height: 30rpx;
  padding: 0;
  color: #ffffff;
  background: #f39e1e;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 30rpx;
}

.home-player-game-tag.explore {
  background: #ff2b8f;
}

.home-player-game-price {
  position: absolute;
  right: 104rpx;
  top: 34rpx;
  z-index: 2;
  display: block;
  width: 86rpx;
  color: #a2ef4d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-align: right;
  white-space: nowrap;
}

.home-player-game-title {
  position: absolute;
  left: 228rpx;
  right: 98rpx;
  top: 76rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-player-game-meta {
  position: absolute;
  left: 228rpx;
  right: 142rpx;
  overflow: hidden;
  margin: 0;
  color: #d9f1ff;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-player-game-meta.location {
  top: 112rpx;
}

.home-player-game-meta.time {
  top: 140rpx;
}

.home-player-game-foot {
  position: absolute;
  left: 228rpx;
  right: 24rpx;
  bottom: 22rpx;
  display: flex;
  align-items: center;
  min-height: 36rpx;
  margin: 0;
}

.home-player-avatars {
  display: flex;
  flex: 0 0 76rpx;
  width: 76rpx;
}

.home-player-avatars text {
  width: 32rpx;
  height: 34rpx;
  margin-right: -10rpx;
  border: 2rpx solid #000000;
  border-radius: 50%;
  box-sizing: border-box;
  background: #4b5563;
}

.home-player-avatars text:nth-child(2) {
  background: #6b7280;
}

.home-player-avatars text:nth-child(3) {
  background: #9ca3af;
}

.home-player-joined {
  flex: 0 0 116rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 22rpx;
  text-overflow: ellipsis;
