<view wx:if="{{isHomePreview}}" class="home-preview-page {{currentHomePreview.mode}}" bindtap="handleHomePreviewTap">
  <block wx:if="{{currentHomePreview.mode === 'playerHome'}}">
    <view class="home-player-stage">
      <view class="home-player-stage-header">
        <view class="home-player-stage-brand">
          <text class="home-player-stage-mark">🎮</text>
          <view>
            <text class="home-player-stage-title">{{currentHomePreview.brand}}</text>
            <text class="home-player-stage-online">{{currentHomePreview.onlineText}}</text>
          </view>
        </view>
        <view class="home-player-stage-tools">
          <text>⌕</text>
          <text>💬</text>
          <text class="home-player-stage-avatar">A</text>
        </view>
      </view>

      <view class="home-player-stage-main">
        <view class="home-player-hero-copy">
          <text>{{currentHomePreview.title}}</text>
          <text>{{currentHomePreview.subtitle}}</text>
        </view>

        <view class="home-player-start-orb">
          <view class="home-player-console">
            <text class="home-player-console-plus">+</text>
            <view class="home-player-console-buttons">
              <text></text>
              <text></text>
            </view>
            <text class="home-player-console-flash">ϟ</text>
          </view>
          <text class="home-player-go">GO</text>
        </view>

        <view class="home-player-today-card">
          <view class="home-player-today-cover">{{currentHomePreview.featuredGame.imageText}}</view>
          <view class="home-player-today-copy">
            <view>
              <text>{{currentHomePreview.featuredGame.tag}}</text>
              <text>{{currentHomePreview.featuredGame.price}}</text>
            </view>
            <text>{{currentHomePreview.featuredGame.title}}</text>
            <text>{{currentHomePreview.featuredGame.location}}</text>
            <text>{{currentHomePreview.featuredGame.time}}</text>
          </view>
          <text class="home-player-today-action">{{currentHomePreview.featuredGame.action}}</text>
        </view>

        <view class="home-player-mini-grid">
          <view wx:for="{{currentHomePreview.entries}}" wx:key="title" class="home-player-mini-entry {{item.theme}}">
            <text>{{item.icon}}</text>
            <text>{{item.title}}</text>
          </view>
        </view>
      </view>

      <view class="home-player-controller">
        <view class="home-player-dpad">
          <text class="up">▲</text>
          <text class="left">◀</text>
          <text class="right">▶</text>
          <text class="down">▼</text>
        </view>
        <text class="home-player-home-key">Home</text>
        <view class="home-player-action-pad">
          <text class="top">{{currentHomePreview.navItems[1].name}}</text>
          <text class="left">{{currentHomePreview.navItems[0].name}}</text>
          <text class="right">{{currentHomePreview.navItems[2].name}}</text>
          <text class="bottom">{{currentHomePreview.navItems[3].name}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{currentHomePreview.mode === 'launchAnimation'}}" class="home-game-shell home-launch-screen">
    <view class="home-game-topbar">
      <view class="home-game-brand">
        <text class="home-game-logo-mark">🎮</text>
        <view>
          <text class="home-game-brand-name">{{currentHomePreview.brand}}</text>
          <text class="home-game-online">{{currentHomePreview.onlineText}}</text>
        </view>
      </view>
    </view>

    <view class="home-launch-main">
      <view class="home-launch-orb">
        <view class="home-launch-console">
          <text class="home-launch-plus">+</text>
          <view class="home-launch-buttons">
            <text></text>
            <text></text>
          </view>
          <text class="home-launch-flash">ϟ</text>
        </view>
        <text class="home-launch-go">{{currentHomePreview.actionText}}</text>
      </view>
      <view class="home-launch-wordmark">
        <text class="home-launch-title">{{currentHomePreview.title}}</text>
        <text class="home-launch-subtitle">{{currentHomePreview.subtitle}}</text>
      </view>
    </view>

    <view class="home-launch-dots">
      <text wx:for="{{currentHomePreview.featureDots}}" wx:key="*this" class="{{item}}"></text>
    </view>
  </view>

  <view wx:elif="{{currentHomePreview.mode === 'roleComparison'}}" class="home-game-shell home-role-compare">
    <view class="home-game-appbar">
      <text class="home-game-back">‹</text>
      <text class="home-game-app-title">{{currentHomePreview.title}}</text>
    </view>
    <scroll-view class="home-game-scroll" scroll-y enhanced show-scrollbar="false">
      <view class="home-role-hero">
        <text class="home-role-star">★</text>
        <text class="home-role-title">{{currentHomePreview.title}}</text>
        <text class="home-role-subtitle">{{currentHomePreview.subtitle}}</text>
      </view>
      <view class="home-role-cards">
        <view wx:for="{{currentHomePreview.roles}}" wx:key="name" class="home-role-card {{item.active ? 'active' : ''}}">
          <text class="home-role-icon">{{item.icon}}</text>
          <text class="home-role-name">{{item.name}}</text>
          <text class="home-role-level">{{item.level}}</text>
        </view>
      </view>
      <view class="home-role-table">
        <view class="home-role-row head">
          <text>权益功能</text>
          <text>玩家</text>
          <text>领路人</text>
          <text>行家</text>
        </view>
        <view wx:for="{{currentHomePreview.benefits}}" wx:key="name" class="home-role-row">
          <text>{{item.name}}</text>
          <text class="{{item.player === '✓' ? 'ok' : 'muted'}}">{{item.player}}</text>
          <text class="{{item.leader === '✓' ? 'ok' : item.leader === '—' ? 'muted' : 'rate'}}">{{item.leader}}</text>
          <text class="{{item.expert === '✓' ? 'ok' : item.expert === '—' ? 'muted' : 'rate'}}">{{item.expert}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="home-game-bottom-action">
      <text>{{currentHomePreview.primary}}</text>
      <text>»</text>
    </view>
  </view>

  <view wx:elif="{{currentHomePreview.mode === 'leaderProgress'}}" class="home-game-shell home-leader-progress">
    <view class="home-game-appbar">
      <text class="home-game-back">‹</text>
      <text class="home-game-app-title">{{currentHomePreview.title}}</text>
    </view>
    <scroll-view class="home-game-scroll progress" scroll-y enhanced show-scrollbar="false">
      <view class="home-progress-hero">
        <view class="home-progress-compass">◇</view>
        <text class="home-progress-title">{{currentHomePreview.heroTitle}}</text>
        <text class="home-progress-status">{{currentHomePreview.status}}</text>
        <text class="home-progress-desc">{{currentHomePreview.subtitle}}</text>
      </view>
      <view class="home-progress-line">
        <view style="width: {{currentHomePreview.progress}}%;"></view>
      </view>
      <view class="home-progress-section-title">{{currentHomePreview.timelineTitle}}</view>
      <view class="home-progress-timeline">
        <view wx:for="{{currentHomePreview.timeline}}" wx:key="title" class="home-progress-step {{item.state}}">
          <view class="home-progress-step-mark">
            <text></text>
            <view wx:if="{{item.hasLine}}"></view>
          </view>
          <view class="home-progress-step-card">
            <text class="home-progress-step-title">{{item.title}}</text>
            <text class="home-progress-step-desc">{{item.desc}}</text>
            <text class="home-progress-step-time">{{item.time}}</text>
          </view>
        </view>
      </view>
      <view class="home-progress-detail">
        <text class="home-progress-detail-title">{{currentHomePreview.detailsTitle}}</text>
        <view wx:for="{{currentHomePreview.details}}" wx:key="label" class="home-progress-detail-row">
          <text>{{item.label}}</text>
          <text class="{{item.highlight ? 'highlight' : ''}}">{{item.value}}</text>
        </view>
      </view>
      <text class="home-progress-helper">{{currentHomePreview.helperText}}</text>
    </scroll-view>
    <view class="home-progress-actions">
      <text>{{currentHomePreview.actions[0]}}</text>
      <text>{{currentHomePreview.actions[1]}}</text>
    </view>
  </view>

  <view wx:elif="{{currentHomePreview.mode === 'roleAuditPassed'}}" class="home-game-shell home-audit-passed {{currentHomePreview.roleType}}">
    <view class="home-game-appbar compact">
      <text class="home-game-back">‹</text>
      <text class="home-game-app-title">{{currentHomePreview.title}}</text>
    </view>
    <scroll-view class="home-game-scroll audit" scroll-y enhanced show-scrollbar="false">
      <view class="home-audit-icon">✦</view>
      <view class="home-audit-copy">
        <text class="home-audit-headline">{{currentHomePreview.headline}}</text>
        <text class="home-audit-role">{{currentHomePreview.roleText}}</text>
        <text wx:for="{{currentHomePreview.desc}}" wx:key="*this" class="home-audit-desc">{{item}}</text>
      </view>
      <view class="home-audit-cert">
        <text>认证编号</text>
        <text>{{currentHomePreview.certNo}}</text>
        <text>认证时间: {{currentHomePreview.certTime}}</text>
      </view>
      <view class="home-audit-gifts">
        <view class="home-audit-gift-title">
          <text>🎁</text>
          <text>{{currentHomePreview.giftTitle}}</text>
        </view>
        <view wx:for="{{currentHomePreview.gifts}}" wx:key="name" class="home-audit-gift-row">
          <view>
            <text class="home-audit-gift-icon">{{item.icon}}</text>
            <text>{{item.name}}</text>
          </view>
          <text>{{item.tag}}</text>
        </view>
      </view>
      <view class="home-audit-action-grid">
        <view wx:for="{{currentHomePreview.actions}}" wx:key="name">
          <text>{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="home-audit-primary">{{currentHomePreview.primary}}</view>
  </view>

  <view wx:else class="home-preview-screen {{currentHomePreview.mode}}">
    <view class="home-preview-head">
      <view>
        <text class="home-preview-badge">{{currentHomePreview.roleBadge}}</text>
        <text class="home-preview-title">{{currentHomePreview.title}}</text>
        <text class="home-preview-subtitle">{{currentHomePreview.subtitle}}</text>
      </view>
      <text class="home-preview-count">{{homePreviewNo}}/{{homePreviewTotal}}</text>
    </view>

    <text class="home-preview-desc">{{currentHomePreview.desc || currentHomePreview.status}}</text>

    <view wx:if="{{currentHomePreview.mode === 'dashboard'}}" class="home-preview-dashboard">
      <view class="home-preview-stats">
        <view wx:for="{{currentHomePreview.stats}}" wx:key="label" class="home-preview-stat">
          <text class="home-preview-stat-value">{{item.value}}</text>
          <text class="home-preview-stat-label">{{item.label}}</text>
        </view>
      </view>

      <view class="home-preview-card-list">
        <view wx:for="{{currentHomePreview.cards}}" wx:key="title" class="home-preview-card">
          <view>
            <text class="home-preview-card-title">{{item.title}}</text>
            <text class="home-preview-card-meta">{{item.meta}}</text>
          </view>
          <text class="home-preview-card-tag">{{item.tag}}</text>
        </view>
      </view>

      <view class="home-preview-actions">
        <view wx:for="{{currentHomePreview.actions}}" wx:key="*this" class="home-preview-action">{{item}}</view>
      </view>
    </view>

    <view wx:elif="{{currentHomePreview.mode === 'permission'}}" class="home-preview-permission">
      <view class="home-preview-icon">!</view>
      <view class="home-preview-benefits">
        <view wx:for="{{currentHomePreview.benefits}}" wx:key="*this" class="home-preview-benefit">
          <text class="home-preview-dot"></text>
          <text>{{item}}</text>
        </view>
      </view>
      <view class="home-preview-primary">{{currentHomePreview.primary}}</view>
      <view class="home-preview-secondary">{{currentHomePreview.secondary}}</view>
    </view>

    <view wx:elif="{{currentHomePreview.mode === 'compare'}}" class="home-preview-compare">
      <view wx:for="{{currentHomePreview.plans}}" wx:key="name" class="home-preview-plan">
        <text class="home-preview-plan-name">{{item.name}}</text>
        <text class="home-preview-plan-desc">{{item.desc}}</text>
        <view class="home-preview-plan-tags">
          <text wx:for="{{item.highlights}}" wx:key="*this" class="home-preview-plan-tag">{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{currentHomePreview.mode === 'apply'}}" class="home-preview-apply">
      <view wx:for="{{currentHomePreview.formItems}}" wx:key="*this" class="home-preview-form-row">
        <text>{{item}}</text>
        <text class="home-preview-form-placeholder">待填写</text>
      </view>
      <view class="home-preview-primary">{{currentHomePreview.primary}}</view>
    </view>

    <view wx:elif="{{currentHomePreview.mode === 'review'}}" class="home-preview-review">
      <view class="home-preview-status-card">
        <text>{{currentHomePreview.status}}</text>
      </view>
      <view class="home-preview-steps">
        <view wx:for="{{currentHomePreview.steps}}" wx:key="*this" class="home-preview-step">
          <text class="home-preview-step-dot">{{index + 1}}</text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="home-preview-theme">
      <view wx:for="{{currentHomePreview.colors}}" wx:key="name" class="home-preview-color-row">
        <text>{{item.name}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="home-preview-hit left" data-direction="-1" catchtap="handleHomePreviewTap"></view>
  <view class="home-preview-hit right" data-direction="1" catchtap="handleHomePreviewTap"></view>
</view>

<view wx:else class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:else>
    <view class="hero">
      <view>
        <text class="hello">HELLO, {{hero.roleName}}!</text>
        <text class="hero-sub">{{hero.dateLabel}} | {{hero.subtitle}}</text>
      </view>
      <text class="online">{{hero.onlineText}}</text>
    </view>

    <view wx:for="{{notices}}" wx:key="id" class="notice">
      <text>{{item.title}}</text>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">今日推荐</text>
        <text class="section-more">附近正在发生</text>
      </view>

      <view
        wx:for="{{recommendedGames}}"
        wx:key="id"
        class="game-card"
        data-route="{{item.route}}"
        bindtap="goAction"
      >
        <view class="game-main">
          <view>
            <text class="game-title">{{item.title}}</text>
            <text class="game-meta">📍{{item.cityName}} · {{item.distanceText}} · {{item.memberText}}</text>
            <text class="game-meta">⏰{{item.timeText}}</text>
          </view>
          <text class="join-pill">{{item.actionText}}</text>
        </view>
        <view class="game-bottom">
          <text class="game-status">{{item.statusText}}</text>
          <text class="game-price">{{item.priceText}}</text>
          <text class="game-joined">{{item.joinedText}}</text>
        </view>
        <view class="tags">
          <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="player-card">
      <view class="player-head">
        <view>
          <text class="player-role">{{playerSummary.roleLabel}}</text>
          <text class="player-name">{{playerSummary.title}} · {{playerSummary.displayName}}</text>
        </view>
        <text class="xp">{{playerSummary.xpText}}</text>
      </view>
      <view class="progress">
        <view class="progress-bar" style="width: {{playerSummary.progressPercent}}%;"></view>
      </view>
      <text class="progress-tip">{{playerSummary.nextLevelText}}</text>
      <view class="stats">
        <view wx:for="{{playerSummary.stats}}" wx:key="label" class="stat">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">快捷入口</text>
        <text class="section-more">下一步</text>
      </view>
      <view class="actions">
        <view
          wx:for="{{quickActions}}"
          wx:key="id"
          class="action"
          data-route="{{item.route}}"
          bindtap="goAction"
        >
          <text>{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="section two-col">
      <view>
        <view class="section-head">
          <text class="section-title">本周玩霸榜</text>
          <text class="section-more">XP</text>
        </view>
        <view wx:for="{{rankingList}}" wx:key="rank" class="rank-row">
          <text class="rank-no">{{item.rank}}</text>
          <view class="rank-copy">
            <text class="rank-name">{{item.name}}</text>
            <text class="rank-desc">{{item.desc}}</text>
          </view>
          <text class="rank-xp">{{item.xpText}}</text>
        </view>
      </view>

      <view class="achievement-block">
        <text class="section-title">我的成就</text>
        <view wx:for="{{achievementList}}" wx:key="id" class="achievement">
          <text>{{item.title}}</text>
          <text>{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">朋友在玩</text>
        <text class="section-more">查看全部</text>
      </view>
      <view
        wx:for="{{friendGames}}"
        wx:key="id"
        class="friend-card"
        data-route="{{item.route}}"
        bindtap="goAction"
      >
        <text class="game-title">{{item.title}}</text>
        <text class="game-meta">📍{{item.cityName}} · {{item.distanceText}} · {{item.memberText}}</text>
        <text class="game-meta">{{item.timeText}} · {{item.priceText}}</text>
      </view>
    </view>

    <view class="metaverse" data-route="{{metaverseEntry.route}}" bindtap="goAction">
      <view>
        <text class="metaverse-title">{{metaverseEntry.title}}</text>
        <text class="metaverse-desc">{{metaverseEntry.desc}}</text>
      </view>
      <text class="metaverse-action">{{metaverseEntry.actionText}}</text>
    </view>
  </block>
</view>
