page {
  width: 100%;
  height: 100%;
  background: #efefef;
}

.home-master-placeholder {
  width: 100%;
  height: 100%;
  background: #000000;
}

.home-master-apply-page {
  min-height: 100vh;
  padding: 108rpx 0 80rpx;
  box-sizing: border-box;
  background: #efefef;
}

.home-master-apply-stage {
  width: 638rpx;
  margin: 0 auto;
}

.home-master-apply-caption {
  display: block;
  margin: 0 0 14rpx 0;
  color: #333333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.home-master-apply-frame {
  width: 638rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: #0089dc;
}

.home-master-apply-phone {
  overflow: hidden;
  background: #000000;
  color: #ffffff;
}

.home-master-apply-nav {
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #000000;
}

.home-master-apply-back,
.home-master-apply-nav-title {
  display: block;
}

.home-master-apply-back {
  color: #ffffff;
  font-size: 42rpx;
  line-height: 42rpx;
}

.home-master-apply-nav-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.home-master-apply-main {
  padding: 24rpx 34rpx 36rpx;
  box-sizing: border-box;
}
