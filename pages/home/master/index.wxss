page {
  width: 100%;
  height: 100%;
  background: #efefef;
}

.home-master-scroll {
  width: 100%;
  height: 100vh;
  background: #efefef;
}

.home-master-canvas {
  position: relative;
  width: 750rpx;
  height: 1624rpx;
  min-height: 1624rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #007bd3;
}

.home-master-content {
  position: absolute;
  left: 27rpx;
  top: 181rpx;
  width: 704rpx;
  height: 1442rpx;
  background: #000000;
}

.home-master-logo {
  position: absolute;
  display: block;
}

.home-master-logo {
  left: 43rpx;
  top: 127rpx;
  width: 102rpx;
}

.home-master-online-wrap {
  position: absolute;
  left: 95rpx;
  top: 157rpx;
  display: flex;
  align-items: center;
  height: 32rpx;
}

.home-master-online-dot {
  display: block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 4rpx;
  border-radius: 50%;
  background: #fefa83;
}

.home-master-online {
  display: block;
  width: 122rpx;
  color: #00f2ff;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

.home-master-toolbar {
  position: absolute;
  left: 557rpx;
  top: 127rpx;
  width: 168rpx;
  height: 66rpx;
}

.home-master-avatar {
  position: absolute;
  left: 0;
  top: 0;
  width: 58rpx;
  height: 58rpx;
}

.home-master-search {
  position: absolute;
  left: 72rpx;
  top: 20rpx;
  width: 32rpx;
  height: 32rpx;
}

.home-master-chat {
  position: absolute;
  right: 0;
  top: 8rpx;
  width: 60rpx;
  height: 60rpx;
}

.home-master-dock {
  position: absolute;
  left: 0;
  top: 1408rpx;
  width: 750rpx;
  height: 218rpx;
  border-radius: 58rpx 58rpx 0 0;
  background: #007bd3;
}

.home-master-dpad {
  position: absolute;
  left: 68rpx;
  top: 48rpx;
  width: 120rpx;
  height: 122rpx;
}

.home-master-dpad text {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.home-master-dpad .up {
  left: 40rpx;
  top: 0;
}

.home-master-dpad .left {
  left: 0;
  top: 44rpx;
}

.home-master-dpad .right {
  right: 0;
  top: 44rpx;
}

.home-master-dpad .down {
  left: 40rpx;
  bottom: 0;
}

.home-master-home-key {
  position: absolute;
  left: 336rpx;
  top: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
}

.home-master-home-key image {
  position: absolute;
  left: 0;
  top: 0;
  width: 94rpx;
  height: 94rpx;
}

.home-master-home-key text {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 20rpx;
}

.home-master-message {
  position: absolute;
  left: 456rpx;
  top: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 67rpx;
  height: 67rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #ff821c;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 20rpx;
  text-align: center;
}

.home-master-action-pad {
  position: absolute;
  left: 526rpx;
  top: 34rpx;
  width: 184rpx;
  height: 130rpx;
}

.home-master-action-pad text {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 20rpx;
  text-align: center;
}

.home-master-action-pad .metaverse {
  left: 42rpx;
  top: 0;
  background: #7968ff;
}

.home-master-action-pad .mine {
  left: 0;
  top: 50rpx;
  background: #ff2b8f;
}

.home-master-action-pad .map {
  right: 0;
  top: 50rpx;
  background: #55e8be;
}
