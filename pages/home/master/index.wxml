<view wx:if="{{masterMode === 'apply'}}" class="home-master-apply-page">
  <view class="home-master-apply-stage">
    <view class="home-master-apply-frame" style="{{applyShellLayout.frameStyle}}">
      <view class="home-master-apply-top-bg" style="{{applyShellLayout.topBgStyle}}"></view>
      <view class="home-master-apply-nav" style="{{applyShellLayout.navStyle}}">
        <text class="home-master-apply-nav-title">{{applyMaster.navTitle}}</text>
      </view>
      <view class="home-master-apply-phone" style="{{applyShellLayout.phoneStyle}}">
        <view class="home-master-apply-main"></view>
      </view>
    </view>
  </view>
</view>

<home-shell
  wx:else
  online-text="{{onlineText}}"
  nav-items="{{navItems}}"
  dock-visible="{{dockVisible}}"
  content-scroll-y="{{contentScrollY}}"
  shell-class="{{shellClass}}"
  bindnavtap="handleShellNavTap"
>
  <view class="home-master-placeholder"></view>
</home-shell>
