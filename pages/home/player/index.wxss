  border: 2rpx solid rgba(6, 182, 212, 0.3);
  border-radius: 16rpx;
  color: rgb(34, 211, 238);
  background: rgb(26, 39, 62);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.player-world-tags text:last-child {
  border-color: rgba(255, 0, 110, 0.34);
  color: rgba(255, 0, 110, 0.78);
}

.player-world-globe {
  position: absolute;
  right: 42rpx;
  top: 30rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: rgb(11, 137, 216);
  box-shadow: 0 0 0 8rpx #05050b;
  overflow: hidden;
}

.player-world-map-track {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  gap: 0;
  width: 600rpx;
  height: 148rpx;
  animation: player-world-map-slide 5.6s linear infinite;
}

.player-world-map-image {
  flex: 0 0 300rpx;
  min-width: 300rpx;
  width: 300rpx;
  height: 148rpx;
  display: block;
}

.player-world-map-image + .player-world-map-image {
  margin-left: 0;
}

@keyframes player-world-map-slide {
  from {
    transform: translateX(-300rpx);
  }

  to {
    transform: translateX(0);
  }
}

.player-tabs.role-switch {
  justify-content: center;
  width: 662rpx;
  margin: 24rpx auto 0;
}

.player-tabs.role-switch text {
  height: 46rpx;
  padding: 0 24rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.player-friend-more {
  color: #16c0f6;
  font-size: 22rpx;
  font-weight: 900;
}

.player-metaverse-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 662rpx;
  height: 204rpx;
  margin-top: 34rpx;
  margin-right: auto;
  margin-left: auto;
  padding: 22rpx 24rpx 14rpx 36rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 82% 50%, rgba(52, 241, 241, 0.2) 0%, rgba(52, 241, 241, 0) 34%),
    linear-gradient(135deg, #0c1d34 0%, #14243d 46%, #122033 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
