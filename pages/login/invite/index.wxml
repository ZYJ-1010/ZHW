<view class="page">
  <view class="wrap">
    <view class="hero">
      <text class="hi">HI</text>
      <text class="title">邀请注册</text>
      <text class="desc">输入朋友给你的邀请码，确认后继续登录注册。</text>
    </view>

    <view class="form">
      <view class="field">
        <input
          class="field-input"
          value="{{inviteCode}}"
          maxlength="20"
          placeholder="请输入邀请码"
          placeholder-class="placeholder"
          bindinput="onInviteInput"
        />
      </view>

      <button class="primary-button" bindtap="verifyInvite" disabled="{{isVerifying}}">
        {{isVerifying ? '确认中...' : '确认邀请码'}}
      </button>
    </view>

    <view class="status status-{{inviteStatus}}">
      <text class="status-tag">{{statusText}}</text>
      <text class="status-copy">{{statusMessage}}</text>
    </view>

    <view wx:if="{{invite}}" class="invite-card">
      <text class="card-label">邀请人</text>
      <text class="card-name">{{invite.inviterName}}</text>
      <text class="card-desc">{{invite.city}} · 邀请关系将在登录后绑定</text>
    </view>

    <button class="continue-button" bindtap="continueToLogin" disabled="{{inviteStatus !== 'valid'}}">
      继续登录注册
    </button>

    <button class="secondary-button" bindtap="goNormalLogin">普通登录</button>
  </view>
</view>
