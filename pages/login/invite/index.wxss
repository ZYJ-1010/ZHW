.page {
  min-height: 100vh;
  background: #ffffff;
}

.wrap {
  min-height: 100vh;
  padding: 92rpx 64rpx 42rpx;
  box-sizing: border-box;
}

.hi,
.title,
.desc,
.status-tag,
.status-copy,
.card-label,
.card-name,
.card-desc {
  display: block;
}

.hi {
  color: #171627;
  font-size: 72rpx;
  font-weight: 500;
  line-height: 1;
}

.title {
  margin-top: 34rpx;
  color: #171627;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.desc {
  margin-top: 18rpx;
  color: rgba(23, 22, 39, 0.56);
  font-size: 28rpx;
  line-height: 1.5;
}

.form {
  margin-top: 112rpx;
}

.field {
  margin-bottom: 28rpx;
}

.primary-button,
.continue-button,
.secondary-button {
}

.primary-button::after,
.continue-button::after,
.secondary-button::after {
  border: 0;
}

.status {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
}

.status-tag {
  color: rgba(23, 22, 39, 0.64);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.status-valid .status-tag {
  color: #22b979;
}

.status-invalid .status-tag {
  color: #ee4f96;
}

.status-copy {
  margin-top: 6rpx;
  color: rgba(23, 22, 39, 0.52);
  font-size: 24rpx;
  line-height: 1.45;
}

.invite-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  background: #f5f5f7;
}

.card-label {
  color: #22b979;
  font-size: 24rpx;
  font-weight: 700;
}

.card-name {
  margin-top: 12rpx;
  color: #171627;
  font-size: 34rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 8rpx;
  color: rgba(23, 22, 39, 0.52);
  font-size: 24rpx;
  line-height: 1.4;
}

.continue-button {
  margin-top: 28rpx;
}

.secondary-button {
  margin-top: 20rpx;
}
