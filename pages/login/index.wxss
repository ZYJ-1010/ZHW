.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #ffffff;
}

.login-wrap {
  width: 100%;
  min-height: 100vh;
  padding: 84rpx 64rpx 42rpx;
  box-sizing: border-box;
}

.hero {
  padding-top: 28rpx;
}

.landing-invite {
  margin-top: 88rpx;
}

.account-wrap {
  padding-top: 84rpx;
}

.account-hero {
  padding-top: 72rpx;
}

.hi-row {
  display: flex;
  align-items: flex-start;
}

.hi-text {
  display: block;
  color: #171627;
  font-size: 72rpx;
  font-weight: 500;
  line-height: 1;
}

.hi-mark {
  display: block;
  margin-left: 8rpx;
  color: #171627;
  font-size: 32rpx;
  line-height: 1;
}

.welcome {
  display: block;
  margin-top: 28rpx;
  color: #171627;
  font-size: 32rpx;
  line-height: 1.4;
}

.form {
  margin-top: 118rpx;
}

.mode-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: #f5f5f7;
  color: rgba(23, 22, 39, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.mode-tab.active {
  color: #ffffff;
  background: #171627;
}

.account-form {
  margin-top: 118rpx;
}

.invite-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  margin-bottom: 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
  box-sizing: border-box;
}

.invite-copy {
  min-width: 0;
}

.invite-title,
.invite-desc {
  display: block;
}

.invite-title {
  color: #22b979;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.invite-desc {
  margin-top: 4rpx;
  color: rgba(23, 22, 39, 0.56);
  font-size: 22rpx;
  line-height: 1.35;
}

.invite-clear {
  flex: 0 0 138rpx;
  height: 56rpx;
  margin: 0 0 0 18rpx;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  color: rgba(23, 22, 39, 0.64);
  background: #ffffff;
  font-size: 22rpx;
  line-height: 56rpx;
}

.field {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f5f5f7;
  box-sizing: border-box;
}

.country-code {
  flex: 0 0 auto;
  margin-right: 18rpx;
  color: #171627;
  font-size: 26rpx;
}

.field-input {
  flex: 1;
  height: 88rpx;
  color: #171627;
  font-size: 28rpx;
}

.account-field .field-input,
.password-field .field-input {
  width: 100%;
}

.placeholder {
  color: rgba(23, 22, 39, 0.32);
}

.code-field {
  padding-right: 18rpx;
}

.password-field {
  margin-bottom: 0;
}

.code-button {
  flex: 0 0 auto;
  height: 68rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 0;
  color: rgba(23, 22, 39, 0.36);
  background: transparent;
  font-size: 24rpx;
  line-height: 68rpx;
}

.code-button::after,
.primary-login::after,
.option-button::after,
.password-link::after,
.mode-tab::after,
.invite-clear::after,
.allow-button::after,
.reject-button::after,
.back-button::after {
  border: 0;
}

.primary-login {
  width: 100%;
  height: 88rpx;
  margin: 8rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #8f56f5 0%, #ee4f96 100%);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.form-helper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 16rpx;
  color: rgba(23, 22, 39, 0.42);
  font-size: 23rpx;
  line-height: 1.4;
}

.forgot-link {
  color: rgba(23, 22, 39, 0.68);
  font-weight: 600;
}

.account-form-helper {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.account-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 410rpx;
  min-width: 410rpx;
  max-width: 410rpx;
  margin: 38rpx auto 0;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  text-align: center;
}

.account-switches {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  width: 626rpx;
  margin-left: auto;
  margin-right: auto;
  margin-top: 18rpx;
}

.account-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  color: rgba(23, 22, 39, 0.64);
  background: #f2f2f4;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.login-options {
  margin-top: 18rpx;
}

.option-button {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  color: rgba(23, 22, 39, 0.64);
  background: #f2f2f4;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
  margin-top: 18rpx;
  color: rgba(23, 22, 39, 0.56);
  font-size: 23rpx;
  line-height: 1.5;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 26rpx;
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 2rpx solid rgba(23, 22, 39, 0.18);
  border-radius: 50%;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1;
}

.checkbox.checked {
  border-color: #45c58a;
  background: #45c58a;
}

.agreement-copy {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 0;
  white-space: nowrap;
}

.agreement-normal,
.agreement-link {
  display: inline;
  font-size: 22rpx;
  line-height: 1.4;
}

.agreement-normal {
  color: rgba(23, 22, 39, 0.56);
}

.agreement-link {
  color: #22b979;
  font-weight: 600;
}

.auth-wrap {
  padding-top: 42rpx;
}

.back-button {
  margin: 0;
  padding: 0;
  border: 0;
  color: rgba(23, 22, 39, 0.56);
  background: transparent;
  font-size: 26rpx;
  line-height: 48rpx;
  text-align: left;
}

.brand {
  padding: 40rpx 0 34rpx;
  text-align: center;
}

.brand-kicker,
.brand-name,
.brand-subtitle,
.auth-title,
.auth-desc,
.auth-subdesc,
.auth-note,
.auth-note-title,
.result {
  display: block;
}

.brand-kicker {
  color: rgba(23, 22, 39, 0.4);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.brand-name {
  margin-top: 8rpx;
  color: #171627;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: #22b979;
  font-size: 28rpx;
  font-weight: 600;
}

.auth-card {
  padding: 22rpx 0 24rpx;
  text-align: center;
}

.wechat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #45c58a;
  font-size: 42rpx;
  font-weight: 700;
}

.auth-title {
  color: #171627;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.auth-desc {
  margin-top: 20rpx;
  color: rgba(23, 22, 39, 0.64);
  font-size: 26rpx;
  line-height: 1.55;
}

.auth-subdesc {
  margin-top: 6rpx;
  color: rgba(23, 22, 39, 0.48);
  font-size: 24rpx;
  line-height: 1.5;
}

.auth-note {
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: rgba(23, 22, 39, 0.72);
  background: #f5f5f7;
  font-size: 24rpx;
  line-height: 1.45;
}

.auth-note-title {
  margin-bottom: 6rpx;
  color: #171627;
  font-size: 24rpx;
  font-weight: 700;
}

.auth-agreement {
  margin-top: 28rpx;
}

.auth-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.allow-button,
.reject-button {
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.allow-button {
  color: #ffffff;
  background: #45c58a;
}

.reject-button {
  color: rgba(23, 22, 39, 0.72);
  background: #f5f5f7;
}

.result {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  color: #22b979;
  background: #f5f5f7;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.auth-wrap {
  position: relative;
  min-height: 1624rpx;
  padding: 0;
  background: #ffffff;
}

.auth-content {
  position: absolute;
  top: 488rpx;
  left: 115rpx;
  width: 520rpx;
  text-align: center;
}

.auth-wechat-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 42rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: #45c06f;
  line-height: 132rpx;
}

.wechat-bubble {
  position: absolute;
  border-radius: 50%;
  background: #050505;
}

.bubble-main {
  top: 36rpx;
  left: 30rpx;
  width: 52rpx;
  height: 40rpx;
}

.bubble-main::after,
.bubble-sub::after {
  position: absolute;
  content: '';
  width: 14rpx;
  height: 14rpx;
  background: #050505;
  transform: rotate(45deg);
}

.bubble-main::after {
  left: 8rpx;
  bottom: -4rpx;
}

.bubble-sub {
  top: 54rpx;
  left: 60rpx;
  width: 46rpx;
  height: 36rpx;
}

.bubble-sub::after {
  right: 8rpx;
  bottom: -4rpx;
}

.auth-wrap .auth-title {
  color: #171627;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.auth-wrap .auth-desc {
  margin-top: 24rpx;
  color: #999999;
  font-size: 22rpx;
  line-height: 32rpx;
}

.auth-wrap .auth-subdesc {
  margin-top: 4rpx;
  color: #999999;
  font-size: 22rpx;
  line-height: 32rpx;
}

.auth-wrap .auth-actions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 72rpx;
}

.auth-wrap .allow-button,
.auth-wrap .reject-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 520rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.auth-wrap .allow-button {
  color: #ffffff;
  background: #45c06f;
}

.auth-wrap .reject-button {
  color: rgba(23, 22, 39, 0.72);
  background: #f6f7f9;
}

