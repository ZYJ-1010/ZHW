.page {
  min-height: 100vh;
  padding: 56rpx 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.login-wrap {
  width: 100%;
}

.brand {
  padding: 24rpx 0 44rpx;
  text-align: center;
}

.brand-name,
.brand-subtitle,
.auth-title,
.auth-desc,
.auth-note,
.agreement,
.invite-title,
.invite-status,
.invite-tip,
.result {
  display: block;
}

.brand-name {
  color: #111111;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: #07c160;
  font-size: 28rpx;
  font-weight: 600;
}

.auth-card {
  padding: 48rpx 36rpx 36rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 18rpx 44rpx rgba(17, 17, 17, 0.08);
}

.wechat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #07c160;
  font-size: 44rpx;
  font-weight: 700;
}

.auth-title {
  color: #111111;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.auth-desc {
  margin-top: 18rpx;
  color: rgba(17, 17, 17, 0.64);
  font-size: 27rpx;
  line-height: 1.55;
}

.auth-note {
  margin-top: 32rpx;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  color: rgba(17, 17, 17, 0.72);
  background: rgba(17, 17, 17, 0.04);
  font-size: 24rpx;
  line-height: 1.45;
}

.agreement {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 34rpx 0 24rpx;
  color: rgba(17, 17, 17, 0.78);
  font-size: 25rpx;
  line-height: 1.45;
  text-align: left;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.28);
  border-radius: 6rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}

.checkbox.checked {
  border-color: #07c160;
  background: #07c160;
}

.primary-button,
.secondary-button,
.invite-button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  font-weight: 700;
}

.primary-button::after,
.secondary-button::after,
.invite-button::after {
  border: 0;
}

.primary-button {
  width: 100%;
  height: 94rpx;
  color: #ffffff;
  background: #07c160;
  font-size: 30rpx;
  line-height: 94rpx;
}

.button-disabled {
  color: rgba(255, 255, 255, 0.72);
  background: rgba(7, 193, 96, 0.45);
}

.secondary-button {
  width: 100%;
  height: 88rpx;
  margin-top: 16rpx;
  color: rgba(17, 17, 17, 0.72);
  background: rgba(17, 17, 17, 0.04);
  font-size: 28rpx;
  line-height: 88rpx;
}

.invite-box {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.invite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.invite-title {
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
}

.invite-status {
  color: rgba(17, 17, 17, 0.48);
  font-size: 23rpx;
}

.invite-status.success {
  color: #07c160;
}

.invite-status.error {
  color: #111111;
}

.invite-row {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 8rpx;
  overflow: hidden;
}

.invite-input {
  flex: 1;
  height: 86rpx;
  padding: 0 22rpx;
  color: #111111;
  font-size: 27rpx;
}

.placeholder {
  color: rgba(17, 17, 17, 0.36);
}

.invite-button {
  width: 132rpx;
  height: 86rpx;
  color: #07c160;
  background: rgba(17, 17, 17, 0.04);
  font-size: 26rpx;
  line-height: 86rpx;
}

.invite-tip {
  margin-top: 14rpx;
  color: rgba(17, 17, 17, 0.52);
  font-size: 23rpx;
  line-height: 1.45;
}

.result {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  color: #07c160;
  background: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}
