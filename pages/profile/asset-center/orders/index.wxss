page {
  background: #0d1117;
}

.points-orders-page {
  min-height: 100%;
  padding-bottom: 74rpx;
  color: #ffffff;
  background: #0d1117;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.order-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  height: 98rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.06);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
  background: #0d1117;
}

.order-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #8b949e;
  font-size: 28rpx;
  line-height: 36rpx;
}

.order-tab.active {
  color: #ff9500;
}

.order-list {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.order-card {
  overflow: hidden;
  margin-top: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #161b2a;
}

.order-card:first-child {
  margin-top: 0;
}

.orders-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  color: #6e7681;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}

.order-head,
.order-main,
.order-actions {
  display: flex;
  align-items: center;
}

.order-head {
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.order-id,
.order-title,
.order-points,
.order-time {
  display: block;
}

.order-id {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #6e7681;
  font-size: 24rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 118rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 34rpx;
}

.order-status.blue {
  color: #58a6ff;
  background: rgba(47, 129, 247, 0.1);
}

.order-status.success {
  color: #3fb950;
  background: rgba(63, 185, 80, 0.1);
}

.order-status.orange {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.1);
}

.order-main {
  gap: 22rpx;
  min-height: 154rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.order-goods-visual {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: #1a1f2e;
}

.order-goods-icon {
  font-size: 58rpx;
  line-height: 70rpx;
}

.order-goods-image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.order-copy {
  flex: 1;
  min-width: 0;
}

.order-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-points {
  overflow: hidden;
  color: #ff9500;
  font-size: 26rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-points-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 14rpx;
}

.points-token {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #ffd700 14.6%, #ff9500 85.4%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}

.points-token-icon {
  color: #111827;
  font-size: 18rpx;
  line-height: 1;
}

.order-time {
  overflow: hidden;
  margin-top: 10rpx;
  color: #6e7681;
  font-size: 24rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-actions {
  justify-content: flex-end;
  gap: 20rpx;
  min-height: 74rpx;
  padding: 0 32rpx 30rpx;
}

.order-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 74rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 34rpx;
}

.order-action::after {
  border: 0;
}

.order-action.ghost {
  color: #c9d1d9;
  background: transparent;
  box-shadow: inset 0 0 0 2rpx rgba(201, 209, 217, 0.24);
}

.order-action.primary {
  color: #ffffff;
  background: #ff9500;
}

.logistics-modal-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.logistics-modal {
  width: 650rpx;
  max-height: 82vh;
  border-radius: 34rpx 34rpx 0 0;
  box-sizing: border-box;
  background: #191c27;
  color: #ffffff;
  overflow: hidden;
  animation: logisticsFadeIn 0.2s ease-out both;
}

@keyframes logisticsFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.logistics-modal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 150rpx;
}

.logistics-modal-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.logistics-modal-body {
  max-height: calc(82vh - 150rpx);
  padding: 0 36rpx 72rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.logistics-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  color: #6f7285;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.logistics-courier-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 118rpx;
  margin-bottom: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #151b2b;
}

.logistics-courier-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.logistics-courier-logo {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: #111827;
}

.logistics-courier-icon {
  display: block;
  font-size: 26rpx;
  line-height: 1;
}

.logistics-courier-copy {
  flex: 1;
  min-width: 0;
}

.logistics-courier-name,
.logistics-tracking-no,
.logistics-timeline-desc,
.logistics-timeline-time {
  display: block;
}

.logistics-courier-name {
  overflow: hidden;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-tracking-no {
  margin-top: 4rpx;
  color: #6f7285;
  font-size: 22rpx;
  line-height: 28rpx;
  letter-spacing: 0;
  overflow: visible;
  white-space: nowrap;
}

.logistics-copy-button {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  color: #f5a623;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  background: transparent;
}

.logistics-copy-button::after {
  border: 0;
}

.logistics-timeline-list {
  padding: 0 0 0 0;
  box-sizing: border-box;
}

.logistics-timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 112rpx;
  padding-bottom: 26rpx;
  box-sizing: border-box;
}

.logistics-timeline-line {
  position: absolute;
  left: 16rpx;
  top: 32rpx;
  bottom: -4rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: #2a2d3a;
  z-index: 0;
}

.logistics-timeline-dot-wrap {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 20rpx;
  background: #191c27;
}

.logistics-timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #4b5563;
  border-radius: 50%;
  box-sizing: border-box;
  background: #4b5563;
}

.logistics-timeline-item.active .logistics-timeline-dot {
  width: 22rpx;
  height: 22rpx;
  border: 0;
  background: #20c963;
  box-shadow: 0 0 16rpx rgba(32, 201, 99, 0.5);
}

.logistics-timeline-copy {
  flex: 1;
  min-width: 0;
  padding-top: 0;
}

.logistics-timeline-desc {
  overflow: hidden;
  color: #cfd3dc;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-timeline-item.active .logistics-timeline-desc {
  color: #ffffff;
}

.logistics-timeline-time {
  margin-top: 8rpx;
  color: #6f7285;
  font-size: 22rpx;
  line-height: 28rpx;
}
