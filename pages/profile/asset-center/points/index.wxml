<profile-white-shell
  title="积分中心"
  background="#f7f8fa"
  nav-background="#f7f8fa"
  title-color="#111827"
  back-background="transparent"
  back-border-color="transparent"
  back-icon-color="#7b7b7b"
>
  <view class="points-page">
    <view class="points-hero">
      <view class="points-hero-bar">
        <image class="hero-side-icon" src="{{icons.back}}" mode="aspectFit" />
        <text class="hero-title">积分中心</text>
        <image class="hero-side-icon more" src="{{icons.more}}" mode="aspectFit" />
      </view>
      <view class="points-hero-main">
        <text class="points-hero-label">可用积分</text>
        <text class="points-hero-value">{{summary.available}}</text>
      </view>
      <view class="points-stat-grid">
        <view wx:for="{{summary.stats}}" wx:key="key" class="points-stat-item">
          <text class="points-stat-value">{{item.value}}</text>
          <text class="points-stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="points-content">
      <view class="rules-card">
        <view class="points-section-head">
          <text class="head-icon">规</text>
          <text>积分规则</text>
        </view>
        <view class="rule-list">
          <view wx:for="{{rules}}" wx:key="strong" class="rule-row">
            <text class="rule-dot"></text>
            <text class="rule-text">{{item.text}} <text class="rule-strong">{{item.strong}}</text>{{item.suffix}}</text>
          </view>
        </view>
        <view class="rule-limit-row">
          <view class="rule-limit"><text class="limit-mark">!</text><text>不可提现</text></view>
          <view class="rule-limit"><text class="limit-mark">!</text><text>不可支付付费局</text></view>
        </view>
      </view>

      <view class="points-card">
        <view class="points-section-head dark">
          <text class="head-icon star">星</text>
          <text>赚积分</text>
        </view>

        <view class="earn-card">
          <view class="earn-top">
            <view class="earn-title-row">
              <view class="earn-icon-wrap">
                <text class="earn-icon">积</text>
              </view>
              <view class="earn-title-copy">
                <text class="earn-title">{{earnExample.title}}</text>
                <text class="earn-subtitle">{{earnExample.subtitle}}</text>
              </view>
            </view>
            <text class="earn-points">{{earnExample.points}}</text>
          </view>
          <view class="earn-lines">
            <view wx:for="{{earnExample.rows}}" wx:key="label" class="earn-line">
              <text>{{item.label}}</text>
              <text>{{item.value}}</text>
            </view>
            <text class="earn-result">{{earnExample.result}}</text>
          </view>
        </view>

        <view class="role-example-card">
          <text class="role-example-title">积分来源示例</text>
          <view wx:for="{{roleExamples}}" wx:key="key" class="role-example-row">
            <view class="role-left">
              <text class="role-icon">{{item.iconText}}</text>
              <text class="role-name">{{item.role}}</text>
            </view>
            <view class="role-right">
              <text>{{item.amount}}</text>
              <text class="role-points">{{item.points}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="points-card">
        <view class="history-head">
          <view class="points-section-head dark no-margin">
            <text class="head-icon">明</text>
            <text>积分明细</text>
          </view>
          <view class="filter-tabs">
            <text
              wx:for="{{filters}}"
              wx:key="key"
              class="filter-tab {{activeFilter === item.key ? 'active' : ''}}"
              data-filter="{{item.key}}"
              bindtap="handleFilterTap"
            >{{item.label}}</text>
          </view>
        </view>

        <view class="record-list">
          <view wx:if="{{loading}}" class="points-empty">积分明细加载中...</view>
          <view wx:elif="{{!visibleRecords.length}}" class="points-empty">暂无积分明细</view>
          <block wx:else>
            <view wx:for="{{visibleRecords}}" wx:key="id" class="record-row" bindtap="handleDeveloping">
              <view class="record-left">
                <view class="record-icon-wrap {{item.iconTone}}">
                  <text class="record-icon">{{item.iconText}}</text>
                </view>
                <view class="record-copy">
                  <text class="record-title">{{item.title}}</text>
                  <text class="record-desc">{{item.desc}}</text>
                  <text class="record-time">{{item.time}}</text>
                </view>
              </view>
              <text class="record-points {{item.tone}}">{{item.points}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="points-note">
        <text class="note-icon">!</text>
        <text class="note-text">{{noteText}}</text>
      </view>
    </view>
  </view>
</profile-white-shell>
