page {
  background: #f5f6f8;
}

.points-page {
  min-height: 100%;
  padding-bottom: 54rpx;
  box-sizing: border-box;
  color: #22252c;
  background: #f5f6f8;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.points-hero {
  padding: 0 32rpx 44rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #ffc20b 0%, #ff9700 100%);
}

.points-hero-bar,
.points-stat-grid,
.points-section-head,
.rule-row,
.rule-limit-row,
.rule-limit,
.earn-top,
.earn-title-row,
.earn-line,
.role-example-row,
.role-left,
.role-right,
.history-head,
.filter-tabs,
.record-row,
.record-left,
.points-note {
  display: flex;
  align-items: center;
}

.points-hero-bar {
  justify-content: space-between;
  height: 74rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.hero-side-icon {
  width: 26rpx;
  height: 26rpx;
}

.hero-side-icon.more {
  width: 22rpx;
  height: 34rpx;
}

.points-hero-main {
  text-align: center;
}

.points-hero-label,
.points-hero-value,
.points-stat-value,
.points-stat-label,
.earn-title,
.earn-subtitle,
.role-example-title,
.record-title,
.record-desc,
.record-time,
.note-text {
  display: block;
}

.points-hero-label {
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.points-hero-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 86rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 96rpx;
}

.points-stat-grid {
  justify-content: space-between;
  margin-top: 26rpx;
  text-align: center;
}

.points-stat-item {
  width: 31%;
  min-width: 0;
}

.points-stat-value {
  overflow: hidden;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.points-stat-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.points-content {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.rules-card,
.points-card,
.points-note {
  border-radius: 26rpx;
  box-sizing: border-box;
}

.rules-card {
  overflow: hidden;
  padding: 30rpx 36rpx 34rpx;
  border: 2rpx solid #ffd979;
  background: #fff2bd;
}

.points-section-head {
  margin-bottom: 24rpx;
  color: #ee3e34;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.points-section-head.dark {
  color: #22252c;
}

.points-section-head.no-margin {
  margin-bottom: 0;
}

.head-icon {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
  font-size: 32rpx;
  line-height: 38rpx;
}

.head-icon.star {
  font-size: 35rpx;
}

.rule-list {
  padding-right: 4rpx;
}

.rule-row {
  align-items: flex-start;
  margin-top: 28rpx;
}

.rule-row:first-child {
  margin-top: 0;
}

.rule-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 13rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #ff9500;
  color: transparent;
  font-size: 0;
  line-height: 0;
}

.rule-text {
  flex: 1;
  min-width: 0;
  color: #8b7b64;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.rule-strong {
  color: #f05a28;
  font-weight: 600;
}

.rule-limit-row {
  flex-wrap: wrap;
  gap: 18rpx 28rpx;
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(219, 158, 53, 0.28);
}

.rule-limit {
  min-width: 150rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #e45b62;
  background: rgba(255, 222, 226, 0.72);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.limit-mark {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
  line-height: 28rpx;
}

.points-card {
  margin-top: 28rpx;
  padding: 30rpx 34rpx;
  background: #ffffff;
}

.earn-card {
  overflow: hidden;
  padding: 38rpx 36rpx 42rpx;
  border: 2rpx solid #9ed8a8;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e5f8e9 0%, #c8ebd0 100%);
}

.earn-top {
  justify-content: space-between;
  gap: 18rpx;
}

.earn-title-row {
  min-width: 0;
}

.earn-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background: #46ba50;
}

.earn-icon {
  font-size: 49rpx;
  line-height: 54rpx;
}

.earn-title-copy {
  min-width: 0;
}

.earn-title {
  overflow: hidden;
  color: #3f9148;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.earn-subtitle {
  margin-top: 6rpx;
  color: #579c5f;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 31rpx;
}

.earn-points {
  flex: none;
  color: #3a9145;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.earn-lines {
  margin: 26rpx 0 0 54rpx;
  padding: 30rpx 32rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.78);
}

.earn-line {
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 15rpx;
  color: #568b5a;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.earn-line:first-child {
  margin-top: 0;
}

.earn-line text:last-child {
  flex: none;
  color: #4d8d52;
}

.earn-result {
  display: block;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #b4d8b6;
  color: #3a9145;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: right;
}

.role-example-card {
  margin: 24rpx 0 0;
  padding: 30rpx 34rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.role-example-title {
  margin-bottom: 22rpx;
  color: #9b9b9b;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.role-example-row {
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  color: #555f68;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.role-example-row:first-of-type {
  margin-top: 0;
}

.role-left {
  flex: 1;
  min-width: 0;
}

.role-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  font-size: 27rpx;
  line-height: 34rpx;
}

.role-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-right {
  flex: none;
  justify-content: flex-end;
  gap: 36rpx;
  min-width: 150rpx;
  color: #4b5563;
}

.role-points {
  width: 42rpx;
  color: #31a94a;
  text-align: right;
}

.history-head {
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tabs {
  flex: none;
  gap: 8rpx;
}

.filter-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 66rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #b7b7b7;
  background: #f6f6f6;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.filter-tab.active {
  color: #ff9600;
  background: #fff7e8;
  box-shadow: inset 0 0 0 2rpx #ffe0ab;
}

.record-list {
  padding-left: 4rpx;
}

.points-empty {
  padding: 54rpx 0 46rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
}

.record-row {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 128rpx;
  padding: 22rpx 0 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
  box-sizing: border-box;
}

.record-row:last-child {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 24rpx;
  border-radius: 50%;
}

.record-icon-wrap.green {
  background: #e5f7e7;
}

.record-icon-wrap.pink {
  background: #ffecef;
}

.record-icon {
  font-size: 34rpx;
  line-height: 42rpx;
}

.record-copy {
  flex: 1;
  min-width: 0;
}

.record-title {
  overflow: hidden;
  color: #30343b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-desc,
.record-time {
  overflow: hidden;
  color: #b5b5b5;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-desc {
  margin-top: 2rpx;
}

.record-points {
  flex: none;
  margin-left: 4rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.record-points.plus {
  color: #33ae50;
}

.record-points.minus {
  color: #ff3b30;
}

.points-note {
  align-items: flex-start;
  margin-top: 30rpx;
  padding: 31rpx 34rpx;
  border-radius: 0;
  background: #fff0bd;
}

.note-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  margin-right: 16rpx;
  color: #8b7b64;
  font-size: 26rpx;
  line-height: 28rpx;
}

.note-text {
  flex: 1;
  min-width: 0;
  color: #f36b20;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 40rpx;
}
