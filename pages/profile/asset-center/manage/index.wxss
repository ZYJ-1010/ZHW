page {
  background: #f7f8fa;
}

.asset-manage-page {
  min-height: 100%;
  padding: 50rpx 56rpx 76rpx;
  box-sizing: border-box;
  color: #1f2937;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.asset-total-card {
  overflow: hidden;
  padding: 48rpx 42rpx 31rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #268cf4 0%, #0474df 100%);
}

.asset-total-main {
  padding-bottom: 28rpx;
}

.asset-total-label,
.asset-stat-label,
.asset-menu-title,
.asset-menu-desc,
.asset-section-title,
.status-label,
.order-title,
.order-id,
.order-time,
.order-amount {
  display: block;
}

.asset-total-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 27rpx;
  line-height: 36rpx;
}

.asset-total-value {
  display: block;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 70rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 78rpx;
}

.asset-total-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-top: 26rpx;
}

.asset-total-item {
  min-width: 0;
  text-align: center;
}

.asset-stat-value {
  display: block;
  overflow: hidden;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-stat-value.green {
  color: #86efac;
}

.asset-stat-value.yellow {
  color: #fde047;
}

.asset-stat-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
  line-height: 30rpx;
}

.quick-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 34rpx;
  margin-bottom: 34rpx;
}

.quick-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 42rpx;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.quick-action.green {
  background: #4bbf68;
}

.quick-action.blue {
  background: #2d86ea;
}

.quick-action-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
}

.asset-menu-card,
.recent-list-card {
  background: #ffffff;
}

.asset-menu-card {
  overflow: hidden;
  border-radius: 28rpx;
  margin-bottom: 34rpx;
}

.asset-menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 144rpx;
  padding: 28rpx;
  border-bottom: 2rpx solid #edf0f5;
  box-sizing: border-box;
}

.asset-menu-row:last-child {
  border-bottom: 0;
}

.asset-menu-left,
.asset-menu-right,
.section-head,
.order-top,
.order-bottom,
.faq-head,
.faq-links {
  display: flex;
  align-items: center;
}

.asset-menu-left {
  flex: 1;
  min-width: 0;
}

.asset-menu-icon {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-right: 24rpx;
  border-radius: 50%;
}

.asset-menu-icon.blue {
  color: #2563eb;
  background: #dbeafe;
}

.asset-menu-icon.green {
  color: #16a34a;
  background: #dcfce7;
}

.asset-menu-icon.purple {
  color: #7c3aed;
  background: #f3e8ff;
}

.asset-menu-glyph {
  width: 38rpx;
  height: 38rpx;
}

.asset-menu-copy {
  flex: 1;
  min-width: 0;
}

.asset-menu-title {
  overflow: hidden;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-menu-desc {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 34rpx;
}

.asset-menu-right {
  flex: none;
  min-width: 0;
  color: #9ca3af;
}

.asset-menu-value {
  max-width: 150rpx;
  overflow: hidden;
  margin-right: 10rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-chevron {
  color: #d1d5db;
  font-size: 38rpx;
  line-height: 38rpx;
}

.asset-section {
  margin-bottom: 28rpx;
}

.asset-section-title {
  margin: 0 0 28rpx 0;
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.status-card {
  padding: 30rpx 34rpx 34rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6rpx;
  padding: 0;
}

.status-item {
  min-width: 0;
  text-align: center;
}

.status-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
}

.status-icon-wrap.blue {
  color: #3b82f6;
  background: #eff6ff;
}

.status-icon-wrap.orange {
  color: #f97316;
  background: #fff7ed;
}

.status-icon-wrap.green {
  color: #22c55e;
  background: #f0fdf4;
}

.status-icon-wrap.red {
  color: #f87171;
  background: #fef2f2;
}

.status-icon-wrap.gray {
  color: #6b7280;
  background: #f9fafb;
}

.status-icon {
  width: 38rpx;
  height: 38rpx;
}

.status-label {
  overflow: hidden;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-section {
  margin-bottom: 30rpx;
  padding: 31rpx 34rpx 0;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.section-head {
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.section-head .asset-section-title {
  margin-bottom: 0;
}

.section-link {
  color: #3b82f6;
  font-size: 26rpx;
  line-height: 34rpx;
}

.recent-list-card {
  overflow: hidden;
}

.order-card {
  padding: 24rpx 0 27rpx;
  border-bottom: 2rpx solid #edf0f5;
  box-sizing: border-box;
}

.order-card:last-child {
  border-bottom: 0;
}

.order-top {
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.order-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1f2937;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 34rpx;
}

.order-status.blue {
  color: #3b82f6;
  background: #dbeafe;
}

.order-status.green {
  color: #22c55e;
  background: #dcfce7;
}

.order-id {
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 34rpx;
}

.order-bottom {
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
}

.order-time {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-amount {
  flex: none;
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.faq-card {
  padding: 30rpx 34rpx;
  border: 2rpx solid #bfdbfe;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: rgba(239, 246, 255, 0.72);
}

.faq-head {
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.faq-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
}

.faq-links {
  flex-wrap: wrap;
  gap: 12rpx 34rpx;
  margin-top: 12rpx;
}

.faq-link {
  color: #3b82f6;
  font-size: 26rpx;
  line-height: 36rpx;
}
