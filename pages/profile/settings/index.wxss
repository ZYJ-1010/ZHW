@import "../profile-white-page.wxss";

.settings-section:first-child {
  margin-top: 4rpx;
}

.settings-switch {
  position: relative;
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #d1d5db;
  transition: background 0.2s ease;
}

.settings-switch.on {
  background: #111827;
}

.settings-switch-thumb {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.18);
}

.settings-switch.on .settings-switch-thumb {
  left: 44rpx;
}
