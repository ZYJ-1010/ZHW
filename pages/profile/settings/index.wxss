page {
  width: 100%;
  min-height: 100%;
  background: #0a0a0a;
}

.settings-page {
  min-height: 100%;
  padding: 24rpx 24rpx 96rpx;
  box-sizing: border-box;
  background: #0a0a0a;
  color: #ffffff;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.settings-section {
  margin-top: 40rpx;
}

.settings-section:first-child {
  margin-top: 10rpx;
}

.settings-section-title {
  display: block;
  margin: 0 0 16rpx 8rpx;
  color: #888888;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.settings-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #141414;
}

.settings-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 32rpx 0 52rpx;
  box-sizing: border-box;
}

.settings-row::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 176rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.07);
  content: "";
}

.settings-row:last-child::after {
  display: none;
}

.settings-icon {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 40rpx;
}

.settings-label {
  flex: none;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
  white-space: nowrap;
}

.settings-spacer {
  flex: 1;
  min-width: 18rpx;
}

.settings-right {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 290rpx;
}

.settings-value {
  max-width: 258rpx;
  overflow: hidden;
  color: #888888;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-chevron {
  flex: none;
  width: 8rpx;
  height: 16rpx;
  margin-left: 16rpx;
  opacity: 0.88;
}

.settings-switch {
  position: relative;
  flex: none;
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #3b3b3b;
}

.settings-switch.is-on {
  background: #00d97e;
}

.settings-switch-thumb {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.22);
  transition: left 0.18s ease;
}

.settings-switch.is-on .settings-switch-thumb {
  left: 42rpx;
}

.settings-logout {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-top: 46rpx;
  border: 2rpx solid rgba(255, 68, 68, 0.24);
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #ff4444;
  background: #1a0a0a;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.settings-page.is-dynamic {
  padding-bottom: 160rpx;
}
