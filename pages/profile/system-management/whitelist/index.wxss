@import "../block-settings/shared.wxss";

.whitelist-count {
  margin-top: 4rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  line-height: 36rpx;
}

.whitelist-card {
  border-radius: 22rpx;
}

.whitelist-row,
.candidate-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.whitelist-row:last-child,
.candidate-row:last-child {
  border-bottom: 0;
}

.whitelist-name {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.danger-outline,
.add-outline {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}

.danger-outline {
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 77, 77, 0.36);
  background: rgba(255, 77, 77, 0.12);
}

.add-outline {
  color: #12d8ff;
  border: 2rpx solid rgba(0, 212, 255, 0.42);
  background: rgba(0, 212, 255, 0.08);
}

.add-dashed {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 18rpx;
  border: 2rpx dashed rgba(0, 212, 255, 0.42);
  border-radius: 22rpx;
  color: #12d8ff;
  background: rgba(0, 212, 255, 0.04);
  font-size: 27rpx;
  line-height: 36rpx;
}

.whitelist-sheet {
  max-height: 700rpx;
}

.whitelist-search {
  margin-top: 22rpx;
}

.candidate-list {
  margin-top: 18rpx;
}

.candidate-row {
  padding-left: 20rpx;
  padding-right: 8rpx;
}

.candidate-row .row-main {
  margin-left: 20rpx;
}

.empty-row {
  padding: 28rpx 24rpx;
  color: #6b7a90;
  font-size: 24rpx;
  line-height: 36rpx;
}

.sheet-cancel {
  margin-top: 18rpx;
  color: #ff6b6b;
}
