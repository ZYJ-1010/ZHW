page {
  background: #070b14;
}

.skill-config-page {
  min-height: 100%;
  padding: 28rpx 32rpx 74rpx;
  box-sizing: border-box;
  color: #e8edf8;
  background: #070b14;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.status-card,
.quota-left,
.section-head,
.skill-card-head,
.skill-title-row,
.skill-actions,
.case-head,
.case-title-left,
.case-meta,
.case-meta-item,
.rating-row,
.unlock-card,
.unlock-left {
  display: flex;
  align-items: center;
}

.status-stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.status-card {
  border: 2rpx solid rgba(40, 86, 178, 0.62);
  box-sizing: border-box;
}

.identity-card {
  align-items: flex-start;
  gap: 20rpx;
  min-height: 132rpx;
  padding: 28rpx 30rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(12, 28, 57, 0.96) 0%, rgba(18, 19, 43, 0.96) 100%);
}

.quota-card {
  justify-content: space-between;
  gap: 22rpx;
  min-height: 86rpx;
  padding: 18rpx 28rpx;
  border-color: rgba(174, 132, 24, 0.62);
  border-radius: 20rpx;
  background: rgba(45, 39, 21, 0.88);
}

.status-icon-wrap {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
}

.status-icon-wrap.amber,
.status-icon-wrap.blue {
  background: transparent;
}

.status-icon {
  width: 36rpx;
  height: 36rpx;
}

.status-icon.bolt {
  width: 34rpx;
  height: 38rpx;
}

.slot-emoji,
.skill-emoji,
.unlock-emoji {
  display: block;
  line-height: 1;
}

.skill-image-icon {
  width: 42rpx;
  height: 42rpx;
}

.slot-emoji,
.skill-emoji {
  font-size: 46rpx;
}

.unlock-emoji {
  font-size: 42rpx;
}

.status-copy {
  flex: 1;
  min-width: 0;
  color: #8190aa;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.status-strong,
.quota-title,
.quota-value {
  color: #facc15;
  font-weight: 400;
}

.quota-left {
  min-width: 0;
  gap: 14rpx;
}

.quota-title {
  overflow: hidden;
  font-size: 29rpx;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quota-value {
  flex: none;
  font-size: 36rpx;
  line-height: 44rpx;
}

.section-head {
  justify-content: space-between;
  gap: 24rpx;
}

.slot-head {
  margin-top: 34rpx;
  margin-bottom: 20rpx;
}

.list-head {
  align-items: flex-start;
  margin-top: 36rpx;
  margin-bottom: 22rpx;
}

.section-copy {
  min-width: 0;
}

.section-title,
.section-desc,
.section-count,
.slot-title,
.skill-title,
.skill-meta text,
.case-title,
.case-desc,
.unlock-title,
.unlock-desc {
  display: block;
}

.section-title {
  color: #cad3e4;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.section-count,
.section-desc {
  color: #687792;
  font-size: 24rpx;
  line-height: 34rpx;
}

.section-desc {
  margin-top: 6rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.skill-slot {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 214rpx;
  padding: 26rpx 14rpx;
  border: 2rpx solid rgba(41, 91, 185, 0.55);
  border-radius: 34rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #101a31 0%, #11142b 100%);
}

.skill-slot.active {
  border-color: rgba(50, 111, 224, 0.86);
  box-shadow: inset 0 0 0 1rpx rgba(50, 111, 224, 0.18);
}

.skill-slot.empty {
  border-color: rgba(39, 49, 70, 0.9);
  background: #111724;
  opacity: 0.78;
}

.slot-icon-wrap,
.skill-icon-wrap,
.unlock-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
}

.slot-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 22rpx;
}

.slot-icon-wrap.blue,
.skill-icon-wrap.blue {
  background: linear-gradient(135deg, #3287ff 0%, #296eff 100%);
  box-shadow: 0 12rpx 26rpx rgba(47, 120, 255, 0.28);
}

.slot-icon-wrap.purple,
.skill-icon-wrap.purple {
  background: linear-gradient(135deg, #9258ff 0%, #7537de 100%);
  box-shadow: 0 12rpx 26rpx rgba(133, 78, 239, 0.28);
}

.slot-icon-wrap.gray {
  border: 3rpx dashed #334056;
  border-radius: 22rpx;
  background: rgba(17, 23, 36, 0.8);
  box-shadow: none;
}

.skill-slot.empty .slot-emoji {
  font-size: 40rpx;
  opacity: 0.45;
}

.slot-title {
  max-width: 152rpx;
  overflow: hidden;
  color: #c8d1e3;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-slot.empty .slot-title {
  color: #5f6b7d;
}

.skill-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 10rpx;
  border: 2rpx solid rgba(33, 43, 63, 0.95);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #0f1524;
}

.skill-tab {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  border-radius: 14rpx;
  color: #66738b;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 70rpx;
  text-align: center;
}

.skill-tab.active {
  color: #ffffff;
  background: #2f78ff;
  box-shadow: 0 8rpx 20rpx rgba(47, 120, 255, 0.25);
}

.skill-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.case-summary-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-top: 34rpx;
}

.case-summary-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-height: 150rpx;
  padding: 28rpx 34rpx;
  border: 2rpx solid rgba(34, 45, 66, 0.96);
  border-radius: 26rpx;
  box-sizing: border-box;
  background: #111827;
}

.case-summary-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
}

.case-summary-icon.blue {
  background: linear-gradient(135deg, #1b9dff 0%, #14c4d7 100%);
}

.case-summary-icon.purple {
  background: linear-gradient(135deg, #a065ff 0%, #6e4bea 100%);
}

.case-summary-icon.orange {
  background: linear-gradient(135deg, #ff4d4d 0%, #ff7a37 100%);
}

.case-summary-image {
  width: 48rpx;
  height: 48rpx;
}

.case-summary-emoji {
  display: block;
  font-size: 44rpx;
  line-height: 1;
}

.case-summary-main {
  flex: 1;
  min-width: 0;
}

.case-summary-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.case-summary-title,
.case-summary-skill {
  display: block;
  color: #f4f7ff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.case-summary-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-summary-skill {
  flex: none;
}

.case-summary-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  color: #7e8da4;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.case-summary-star,
.case-summary-rating {
  color: #ffc43b;
}

.case-summary-arrow {
  flex: none;
  width: 22rpx;
  height: 34rpx;
  margin-left: 8rpx;
  opacity: 0.72;
}

.hidden-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 420rpx;
  padding: 170rpx 42rpx 80rpx;
  box-sizing: border-box;
  text-align: center;
}

.hidden-empty-lock {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  line-height: 1;
}

.hidden-empty-title {
  display: block;
  color: #f3f7ff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.hidden-empty-desc {
  display: block;
  max-width: 540rpx;
  margin-top: 10rpx;
  color: #8d99ad;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.skill-card {
  padding: 32rpx;
  border: 2rpx solid rgba(34, 45, 66, 0.96);
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #111827;
}

.skill-card-head {
  align-items: flex-start;
  gap: 24rpx;
}

.skill-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  margin-top: 44rpx;
  border-radius: 24rpx;
}

.skill-main {
  flex: 1;
  min-width: 0;
}

.skill-title-row {
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skill-title {
  max-width: 220rpx;
  overflow: hidden;
  color: #eef3ff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-badge,
.case-badge {
  flex: none;
  box-sizing: border-box;
  font-weight: 400;
}

.skill-badge {
  height: 42rpx;
  padding: 0 18rpx;
  border: 2rpx solid transparent;
  border-radius: 21rpx;
  font-size: 22rpx;
  line-height: 38rpx;
}

.skill-badge.info {
  color: #2f78ff;
  border-color: rgba(47, 120, 255, 0.45);
  background: rgba(47, 120, 255, 0.12);
}

.skill-badge.purple {
  color: #a78bfa;
  border-color: rgba(139, 92, 246, 0.44);
  background: rgba(139, 92, 246, 0.15);
}

.skill-badge.green {
  color: #22c55e;
  border-color: rgba(34, 197, 94, 0.36);
  background: rgba(34, 197, 94, 0.12);
}

.skill-meta {
  margin-top: 8rpx;
}

.skill-meta text {
  color: #78869c;
  font-size: 25rpx;
  line-height: 42rpx;
}

.skill-actions {
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  width: 210rpx;
  gap: 16rpx;
}

.skill-action {
  min-width: 86rpx;
  height: 62rpx;
  padding: 0 16rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 58rpx;
  text-align: center;
}

.skill-action.edit {
  color: #8d99ad;
  border-color: #394358;
  background: rgba(49, 57, 76, 0.62);
}

.skill-action.remove {
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.42);
  background: rgba(239, 68, 68, 0.1);
}

.case-box {
  margin-top: 32rpx;
  padding: 28rpx 30rpx;
  border: 2rpx solid rgba(28, 39, 59, 0.95);
  border-radius: 26rpx;
  box-sizing: border-box;
  background: #0f1625;
}

.case-head {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.case-title-left {
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}

.case-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  opacity: 0.86;
}

.case-title {
  overflow: hidden;
  color: #e5ebf7;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-badge {
  height: 42rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(34, 197, 94, 0.36);
  border-radius: 22rpx;
  color: #22c55e;
  background: rgba(34, 197, 94, 0.12);
  font-size: 22rpx;
  line-height: 38rpx;
}

.case-desc {
  color: #9aa8bc;
  font-size: 28rpx;
  line-height: 52rpx;
}

.case-meta {
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-top: 22rpx;
}

.case-meta-item {
  gap: 8rpx;
  color: #78869c;
  font-size: 23rpx;
  line-height: 32rpx;
}

.case-meta-icon {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  opacity: 0.82;
}

.rating-row {
  min-width: 0;
  gap: 4rpx;
  margin-left: auto;
  color: #facc15;
}

.rating-star {
  display: none;
}

.rating-row::before {
  color: #facc15;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  content: "☆ ☆ ☆ ☆ ☆";
}

.rating-text {
  margin-left: 6rpx;
  color: #78869c;
  font-size: 23rpx;
  line-height: 32rpx;
}

.unlock-card {
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 30rpx;
  padding: 30rpx 30rpx;
  border: 2rpx solid rgba(34, 45, 66, 0.96);
  border-radius: 30rpx;
  box-sizing: border-box;
  background: #111827;
}

.unlock-left {
  flex: 1;
  min-width: 0;
  gap: 22rpx;
}

.unlock-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 18rpx;
  background: #fbbf24;
  box-shadow: 0 12rpx 24rpx rgba(251, 191, 36, 0.2);
}

.unlock-copy {
  flex: 1;
  min-width: 0;
}

.unlock-title {
  overflow: hidden;
  color: #eef3ff;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unlock-desc {
  margin-top: 8rpx;
  color: #8c9ab0;
  font-size: 25rpx;
  line-height: 40rpx;
}

.unlock-button {
  flex: none;
  height: 70rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #2f78ff;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 70rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(47, 120, 255, 0.24);
}

.response-mask,
.panel-mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 80;
  display: flex;
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
  background: rgba(2, 6, 13, 0.82);
}

.response-mask {
  align-items: center;
  justify-content: center;
  padding: 0 72rpx;
}

.response-dialog,
.bottom-panel {
  box-sizing: border-box;
  color: #eef3ff;
  background: #1b2638;
  box-shadow: 0 36rpx 90rpx rgba(0, 0, 0, 0.36);
}

.response-dialog {
  width: 100%;
  max-width: 604rpx;
  padding: 60rpx 50rpx 54rpx;
  border: 2rpx solid rgba(83, 100, 128, 0.42);
  border-radius: 38rpx;
  text-align: center;
}

.response-icon-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 42rpx;
  border-radius: 50%;
  background: rgba(250, 204, 21, 0.13);
}

.response-icon-ring.lock {
  background: rgba(20, 184, 166, 0.18);
}

.response-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.response-icon-ring.warning .response-icon-img {
  width: 74rpx;
  height: 74rpx;
}

.response-icon-text {
  display: block;
  font-size: 60rpx;
  line-height: 1;
}

.response-lock-icon {
  display: block;
  font-size: 58rpx;
  line-height: 1;
}

.response-title,
.response-desc-line,
.response-hint,
.panel-title,
.panel-subtitle,
.field-label,
.field-help,
.candidate-title,
.candidate-desc {
  display: block;
}

.response-title {
  color: #f8fbff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.response-desc {
  margin-top: 30rpx;
}

.response-desc-line {
  color: #a7b2c7;
  font-size: 27rpx;
  line-height: 48rpx;
}

.response-hint {
  margin-top: 12rpx;
  color: #77849b;
  font-size: 27rpx;
  line-height: 38rpx;
}

.response-actions,
.panel-actions,
.tag-type-row,
.candidate-card {
  display: flex;
  align-items: center;
}

.response-actions {
  gap: 24rpx;
  margin-top: 50rpx;
}

.response-actions.single {
  display: block;
}

.response-action,
.panel-action {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 88rpx;
  text-align: center;
}

.response-action.secondary,
.panel-action.secondary {
  color: #d9e1ef;
  border: 2rpx solid rgba(119, 132, 155, 0.34);
  background: rgba(60, 72, 92, 0.5);
}

.response-action.primary,
.panel-action.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #4289ff 0%, #2667ee 100%);
  box-shadow: 0 14rpx 30rpx rgba(47, 120, 255, 0.24);
}

.response-action.primary.danger {
  color: #ff7676;
  border: 2rpx solid rgba(239, 68, 68, 0.6);
  background: rgba(116, 54, 74, 0.65);
  box-shadow: none;
}

.panel-mask {
  align-items: flex-end;
  justify-content: center;
  padding-top: 116rpx;
}

.bottom-panel {
  width: 750rpx;
  max-height: 82vh;
  overflow-y: auto;
  padding: 32rpx 44rpx calc(44rpx + env(safe-area-inset-bottom));
  border: 2rpx solid rgba(77, 90, 118, 0.36);
  border-bottom: 0;
  border-radius: 46rpx 46rpx 0 0;
  background: linear-gradient(180deg, #1b2638 0%, #111a2a 100%);
}

.panel-handle {
  width: 82rpx;
  height: 10rpx;
  margin: 0 auto 46rpx;
  border-radius: 5rpx;
  background: rgba(122, 135, 158, 0.42);
}

.panel-title {
  color: #f8fbff;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 50rpx;
  text-align: center;
}

.panel-subtitle {
  margin-top: 18rpx;
  color: #7c8aa4;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.form-field {
  margin-top: 42rpx;
}

.field-label {
  color: #a9b5c9;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.skill-input,
.case-textarea {
  width: 100%;
  margin-top: 18rpx;
  border: 2rpx solid rgba(63, 76, 101, 0.58);
  border-radius: 20rpx;
  box-sizing: border-box;
  color: #dbe4f2;
  background: rgba(22, 31, 48, 0.74);
  font-size: 28rpx;
}

.skill-input {
  height: 84rpx;
  padding: 0 28rpx;
  line-height: 84rpx;
}

.case-textarea {
  height: 260rpx;
  padding: 24rpx 26rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.field-help {
  margin-top: 16rpx;
  color: #718099;
  font-size: 23rpx;
  line-height: 34rpx;
}

.case-help-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.case-help-row .field-help {
  flex: 1;
  min-width: 0;
}

.field-counter {
  flex: none;
  margin-top: 16rpx;
  color: #d2dae8;
  font-size: 23rpx;
  line-height: 34rpx;
}

.tag-type-row {
  gap: 22rpx;
  margin-top: 18rpx;
}

.tag-type-pill {
  min-width: 142rpx;
  height: 72rpx;
  padding: 0 30rpx;
  border: 2rpx solid rgba(45, 106, 214, 0.65);
  border-radius: 36rpx;
  box-sizing: border-box;
  color: #4090ff;
  background: rgba(47, 120, 255, 0.13);
  font-size: 25rpx;
  line-height: 68rpx;
  text-align: center;
}

.tag-type-pill.disabled {
  color: rgba(112, 124, 148, 0.45);
  border-color: rgba(45, 54, 78, 0.48);
  background: rgba(18, 25, 39, 0.5);
}

.panel-actions {
  gap: 24rpx;
  margin-top: 54rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 56rpx;
}

.candidate-card {
  min-height: 130rpx;
  padding: 24rpx 30rpx;
  border: 2rpx solid rgba(60, 73, 98, 0.6);
  border-radius: 24rpx;
  box-sizing: border-box;
  background: rgba(26, 36, 55, 0.78);
}

.candidate-card.selected {
  border-color: rgba(71, 137, 255, 0.72);
}

.candidate-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-right: 28rpx;
  border-radius: 22rpx;
}

.candidate-icon text {
  display: block;
  font-size: 42rpx;
  line-height: 1;
}

.candidate-icon.orange {
  background: #f59e0b;
}

.candidate-icon.pink {
  background: #ec4899;
}

.candidate-icon.green {
  background: #10b981;
}

.candidate-icon.cyan {
  background: #06b6d4;
}

.candidate-copy {
  flex: 1;
  min-width: 0;
}

.candidate-title {
  overflow: hidden;
  color: #f8fbff;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: #9aa8bd;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-check {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  margin-left: 20rpx;
  border: 6rpx solid rgba(128, 145, 170, 0.76);
  border-radius: 50%;
  box-sizing: border-box;
}

.candidate-check.active {
  border-color: transparent;
  background: transparent;
}

.candidate-check image {
  width: 34rpx;
  height: 34rpx;
}

.add-actions {
  margin-top: 54rpx;
}
