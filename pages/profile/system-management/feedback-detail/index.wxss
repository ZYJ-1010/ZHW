@import "../feedback/shared.wxss";

.detail-nav-title {
  position: fixed;
  top: 72rpx;
  left: 248rpx;
  z-index: 90;
  width: 160rpx;
  height: 50rpx;
  overflow: visible;
  color: #f8fbff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 50rpx;
  text-align: center;
  white-space: nowrap;
}

.detail-nav-status {
  position: fixed;
  top: 72rpx;
  right: 190rpx;
  z-index: 90;
  width: 104rpx;
  height: 50rpx;
  overflow: visible;
  color: #12d8ff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 50rpx;
  text-align: right;
  white-space: nowrap;
}

.detail-page {
  padding-top: 28rpx;
  padding-bottom: 168rpx;
}

.detail-summary {
  padding: 36rpx 34rpx;
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-time {
  color: #747a88;
  font-size: 24rpx;
  line-height: 34rpx;
}

.summary-content {
  display: block;
  margin-top: 34rpx;
  color: #dfe3eb;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.summary-image {
  display: block;
  width: 160rpx;
  height: 160rpx;
  margin-top: 28rpx;
  border-radius: 14rpx;
}

.date-divider {
  display: block;
  margin: 72rpx 0 34rpx;
  color: #5f6572;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.date-divider.today {
  margin-top: 52rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.message-row.me {
  justify-content: flex-end;
}

.message-row.service {
  justify-content: flex-start;
}

.avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.service-avatar {
  background: #09a9ff;
}

.me-avatar {
  background: #242b3a;
}

.message-bubble {
  max-width: 502rpx;
  min-width: 220rpx;
  padding: 28rpx 30rpx 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.message-row.me .message-bubble {
  color: #ffffff;
  background: linear-gradient(135deg, #12d8ff 0%, #0a78ff 100%);
}

.message-row.service .message-bubble {
  border: 2rpx solid #2c3342;
  color: #dce1ea;
  background: #151b28;
}

.message-content,
.message-time {
  display: block;
}

.message-content {
  font-size: 27rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.message-time {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 21rpx;
  line-height: 30rpx;
  text-align: right;
}

.message-row.service .message-time {
  color: #5f6572;
  text-align: left;
}

.detail-input-bar {
  position: fixed;
  left: 50%;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 750rpx;
  padding: 24rpx 30rpx 36rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.07);
  box-sizing: border-box;
  background: #0b101b;
  transform: translateX(-50%);
}

.attach-button,
.send-button {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.attach-button {
  border: 2rpx solid #303746;
}

.send-button {
  background: linear-gradient(135deg, #12d8ff 0%, #0a78ff 100%);
}

.attach-button image {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.send-button image {
  width: 40rpx;
  height: 40rpx;
}

.reply-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 30rpx;
  border: 2rpx solid #303746;
  border-radius: 38rpx;
  box-sizing: border-box;
  color: #f8fbff;
  background: #151b28;
  font-size: 26rpx;
}
