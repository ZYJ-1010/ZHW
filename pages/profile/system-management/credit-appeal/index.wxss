.credit-appeal-page {
  min-height: 1864rpx;
  padding: 52rpx 32rpx 72rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  color: #1a1a2e;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.appeal-section {
  width: 686rpx;
}

.appeal-section + .appeal-section {
  margin-top: 44rpx;
}

.field-label {
  display: flex;
  align-items: flex-start;
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.field-label.single {
  display: block;
}

.required-mark {
  margin-left: 8rpx;
  color: #ff5252;
  font-size: 24rpx;
  line-height: 28rpx;
}

.reason-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 26rpx;
}

.reason-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 76rpx;
  border: 2rpx solid #e8e8ed;
  border-radius: 40rpx;
  box-sizing: border-box;
  color: #666666;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.reason-pill.compact {
  width: 124rpx;
}

.reason-pill.active {
  color: #4a7dff;
  border-color: #4a7dff;
  background: #e3f2fd;
}

.record-section {
  margin-top: 74rpx;
}

.record-card {
  display: flex;
  align-items: center;
  width: 686rpx;
  height: 130rpx;
  margin-top: 26rpx;
  padding: 0 28rpx 0 34rpx;
  border: 2rpx solid #e8e8ed;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.record-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffebee;
}

.record-icon {
  width: 44rpx;
  height: 44rpx;
}

.record-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.record-title,
.record-desc {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-title {
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.record-desc {
  margin-top: 10rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 28rpx;
}

.record-chevron {
  flex: none;
  width: 18rpx;
  height: 40rpx;
  opacity: 0.26;
}

.detail-section {
  margin-top: 74rpx;
}

.detail-box {
  position: relative;
  width: 686rpx;
  height: 336rpx;
  margin-top: 26rpx;
  padding: 24rpx 26rpx 54rpx;
  border: 2rpx solid #e8e8ed;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.detail-box textarea {
  width: 100%;
  height: 100%;
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.appeal-placeholder {
  color: #bbbbbb;
}

.detail-counter {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  color: #bbbbbb;
  font-size: 24rpx;
  line-height: 28rpx;
}

.upload-section {
  margin-top: 74rpx;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(4, 156rpx);
  gap: 20rpx;
  margin-top: 26rpx;
}

.upload-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 156rpx;
  border: 2rpx dashed #dddddd;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.upload-plus {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.22;
}

.upload-note {
  display: block;
  margin-top: 18rpx;
  color: #999999;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.review-card {
  width: 686rpx;
  min-height: 264rpx;
  margin-top: 64rpx;
  padding: 34rpx 40rpx 30rpx 120rpx;
  border-left: 8rpx solid #f9a825;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #fff8e1;
}

.review-head {
  position: relative;
  display: flex;
  align-items: center;
  height: 36rpx;
}

.review-icon {
  position: absolute;
  left: -80rpx;
  top: 0;
  width: 36rpx;
  height: 36rpx;
}

.review-title {
  color: #f9a825;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  margin-top: 26rpx;
}

.review-line {
  color: #666666;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 686rpx;
  height: 96rpx;
  margin-top: 94rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.submit-button.disabled {
  color: #f5bd77;
  background: rgba(204, 204, 204, 0.5);
}

.submit-button.ready {
  color: #ffffff;
  background: #f9a825;
}
