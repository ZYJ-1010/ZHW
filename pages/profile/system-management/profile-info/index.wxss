page {
  background: #f7f8fa;
}

.profile-info-page {
  min-height: 100%;
  padding: 30rpx 34rpx 74rpx;
  box-sizing: border-box;
  color: #1f2937;
  background: #f7f8fa;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.profile-info-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  color: #9ca3af;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 38rpx;
}

.section-title-row,
.info-row,
.info-row-main,
.row-right,
.visibility-options,
.public-row,
.cert-row,
.cert-left,
.cert-right,
.privacy-note {
  display: flex;
  align-items: center;
}

.section-title-row {
  height: 54rpx;
  margin: 0 0 18rpx;
}

.enterprise-title-row,
.cert-title-row {
  margin-top: 26rpx;
}

.section-title-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
}

.section-title {
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.info-card,
.cert-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
}

.info-row {
  justify-content: space-between;
  min-height: 116rpx;
  padding: 0 34rpx;
  border-bottom: 2rpx solid #eef0f4;
  box-sizing: border-box;
}

.info-row:last-child,
.cert-row:last-child {
  border-bottom: 0;
}

.contact-row {
  align-items: stretch;
  min-height: 190rpx;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.contact-block {
  width: 100%;
}

.info-row-main {
  justify-content: space-between;
}

.row-label,
.row-value,
.visibility-title,
.public-title,
.public-desc,
.cert-title,
.cert-desc,
.cert-status,
.privacy-text {
  display: block;
}

.row-label {
  flex: none;
  color: #4b5563;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.row-right {
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
  gap: 14rpx;
}

.row-value {
  max-width: 330rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-value.dark {
  color: #374151;
}

.row-value.muted {
  color: #9ca3af;
}

.avatar-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #3b82f6;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 38rpx;
}

.avatar-circle.empty {
  background: #cbd5e1;
}

.chevron-icon {
  flex: none;
  width: 15rpx;
  height: 25rpx;
}

.hidden-tag {
  flex: none;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #3b82f6;
  background: #eaf3ff;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.visibility-title {
  margin-top: 22rpx;
  color: #6b7280;
  font-size: 27rpx;
  line-height: 37rpx;
}

.contact-divider {
  height: 2rpx;
  margin: 22rpx -34rpx 0;
  background: #eef0f4;
}

.visibility-options {
  gap: 18rpx;
  margin-top: 16rpx;
}

.visibility-option {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  border-radius: 28rpx;
  color: #6b7280;
  background: #f3f4f6;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 56rpx;
  text-align: center;
}

.visibility-option.active {
  color: #3b82f6;
  background: #dbeafe;
}

.enterprise-card {
  border-radius: 28rpx;
}

.public-row {
  justify-content: space-between;
  gap: 28rpx;
  min-height: 124rpx;
  padding: 22rpx 34rpx;
  box-sizing: border-box;
}

.public-copy {
  flex: 1;
  min-width: 0;
}

.public-title {
  color: #374151;
  font-size: 31rpx;
  line-height: 42rpx;
}

.public-desc {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 34rpx;
}

.switch {
  position: relative;
  flex: none;
  width: 92rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #e5e7eb;
  transition: background 0.2s ease;
}

.switch.on {
  background: #3b82f6;
}

.switch-thumb {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 3rpx 8rpx rgba(15, 23, 42, 0.18);
  transition: transform 0.2s ease;
}

.switch.on .switch-thumb {
  transform: translateX(40rpx);
}

.cert-card {
  border-radius: 0;
}

.cert-row {
  justify-content: space-between;
  gap: 24rpx;
  min-height: 140rpx;
  padding: 24rpx 34rpx;
  border-bottom: 2rpx solid #eef0f4;
  box-sizing: border-box;
}

.cert-left {
  flex: 1;
  min-width: 0;
}

.cert-icon-wrap {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-right: 28rpx;
  border-radius: 50%;
}

.cert-icon-wrap.green {
  background: #dcfce7;
}

.cert-icon-wrap.blue {
  background: #dbeafe;
}

.cert-icon {
  width: 42rpx;
  height: 42rpx;
}

.cert-copy {
  flex: 1;
  min-width: 0;
}

.cert-title {
  overflow: hidden;
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-desc {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 34rpx;
}

.cert-right {
  flex: none;
  gap: 14rpx;
}

.cert-status {
  color: #6b7280;
  font-size: 27rpx;
  line-height: 36rpx;
}

.cert-status.verified {
  height: 40rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  color: #22c55e;
  background: #dcfce7;
  font-size: 25rpx;
  line-height: 40rpx;
}

.privacy-note {
  align-items: flex-start;
  margin: 58rpx 8rpx 0;
  padding: 32rpx 36rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #eef0f4;
}

.privacy-icon {
  flex: none;
  width: 28rpx;
  height: 34rpx;
  margin: 5rpx 12rpx 0 0;
}

.privacy-text {
  flex: 1;
  min-width: 0;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 42rpx;
}
