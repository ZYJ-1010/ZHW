@import "../feedback/shared.wxss";

.feedback-record-tabs {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 126rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.06);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
  background: #0c111d;
}

.record-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  color: #777d8b;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.record-tab.active {
  color: #f5f7fb;
  font-weight: 400;
}

.tab-count {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #ff4d66;
  font-size: 22rpx;
  line-height: 42rpx;
}

.record-page {
  padding-top: 28rpx;
}

.record-card {
  margin-bottom: 24rpx;
  padding: 36rpx 34rpx;
}

.record-head,
.record-foot,
.reply-state,
.record-images {
  display: flex;
  align-items: center;
}

.record-head {
  justify-content: space-between;
  gap: 24rpx;
}

.record-content {
  display: block;
  margin-top: 34rpx;
  color: #d7dbe4;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.record-images {
  gap: 18rpx;
  margin-top: 24rpx;
}

.record-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
}

.extra-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d94a1;
  background: #242b3a;
  font-size: 25rpx;
}

.record-foot {
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
}

.record-time {
  color: #686e7d;
  font-size: 26rpx;
  line-height: 36rpx;
}

.reply-state {
  color: #12d8ff;
  font-size: 25rpx;
  line-height: 36rpx;
}

.reply-state.resolved {
  color: #33e27d;
}

.reply-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: currentColor;
}
