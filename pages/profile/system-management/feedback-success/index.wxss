@import "../feedback/shared.wxss";

.success-page {
  padding-top: 34rpx;
}

.success-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 30rpx 58rpx;
  text-align: center;
}

.success-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 158rpx;
  height: 158rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #12d8ff 0%, #0a78ff 100%);
  box-shadow: 0 12rpx 34rpx rgba(10, 120, 255, 0.25);
}

.success-icon image {
  width: 58rpx;
  height: 42rpx;
}

.success-title,
.success-desc,
.reward-title,
.reward-desc,
.card-title,
.card-desc {
  display: block;
}

.success-title {
  margin-top: 58rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.success-desc {
  margin-top: 24rpx;
  color: #717887;
  font-size: 25rpx;
  line-height: 36rpx;
}

.success-desc.second {
  margin-top: 8rpx;
}

.reward-card {
  display: flex;
  align-items: center;
  min-height: 146rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(18, 216, 255, 0.2);
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #082333;
}

.reward-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-right: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #12d8ff 0%, #0a78ff 100%);
}

.reward-icon image {
  width: 52rpx;
  height: 52rpx;
}

.reward-copy {
  flex: 1;
  min-width: 0;
}

.reward-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.reward-desc {
  margin-top: 10rpx;
  color: #68707d;
  font-size: 24rpx;
  line-height: 34rpx;
}

.reward-value {
  flex: none;
  color: #12d8ff;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.score-card,
.reason-card {
  margin-top: 32rpx;
  padding: 40rpx 34rpx;
  text-align: center;
}

.card-title {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.card-desc {
  margin-top: 18rpx;
  color: #838995;
  font-size: 23rpx;
  line-height: 34rpx;
}

.score-row {
  display: grid;
  grid-template-columns: repeat(11, 1fr);
  gap: 10rpx;
  margin-top: 34rpx;
}

.score-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74rpx;
  border: 2rpx solid #343b4a;
  border-radius: 20rpx;
  box-sizing: border-box;
  color: #8b91a0;
  background: #1a202d;
  font-size: 27rpx;
  line-height: 74rpx;
}

.score-item.active {
  color: #ffffff;
  border-color: #12d8ff;
  background: #12aef5;
}

.score-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  color: #6d7482;
  font-size: 23rpx;
  line-height: 34rpx;
}

.reason-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 36rpx;
  padding: 0 72rpx;
}

.reason-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border: 2rpx solid #343b4a;
  border-radius: 38rpx;
  box-sizing: border-box;
  color: #8b91a0;
  background: transparent;
  font-size: 25rpx;
  line-height: 76rpx;
}

.reason-pill.active {
  color: #12d8ff;
  border-color: #12d8ff;
  background: rgba(18, 216, 255, 0.08);
}

.success-actions {
  display: grid;
  gap: 24rpx;
  margin-top: 46rpx;
}
