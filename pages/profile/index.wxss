.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 56rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.loading,
.name,
.meta,
.stat-value,
.stat-label,
.growth-title,
.growth-desc,
.menu-title,
.menu-desc {
  display: block;
}

.loading {
  padding-top: 120rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 28rpx;
  text-align: center;
}

.profile-card,
.growth,
.menu {
  border: 2rpx solid rgba(17, 17, 17, 0.08);
  border-radius: 8rpx;
  background: #ffffff;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #07c160;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
}

.name {
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
}

.meta {
  margin-top: 10rpx;
  color: rgba(17, 17, 17, 0.58);
  font-size: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.stat {
  padding: 22rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(17, 17, 17, 0.04);
  text-align: center;
}

.stat-value {
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(17, 17, 17, 0.52);
  font-size: 22rpx;
}

.growth {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 28rpx;
}

.growth-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
}

.growth-desc {
  margin-top: 10rpx;
  color: rgba(17, 17, 17, 0.56);
  font-size: 24rpx;
}

.income {
  flex: 0 0 auto;
  color: #07c160;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.menu {
  margin-top: 22rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid rgba(17, 17, 17, 0.06);
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-title {
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-desc {
  margin-top: 8rpx;
  color: rgba(17, 17, 17, 0.52);
  font-size: 23rpx;
}

.arrow {
  color: rgba(17, 17, 17, 0.36);
  font-size: 38rpx;
}
