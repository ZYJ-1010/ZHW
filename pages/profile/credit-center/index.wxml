<profile-white-shell title="个人中心" background="#ffffff">
  <view class="profile-page is-white">
    <text class="credit-heading">信用中心</text>

    <view class="credit-score-card" wx:if="{{scoreCard.label || scoreCard.score || scoreCard.badges.length}}">
      <text class="credit-score-label">{{scoreCard.label}}</text>
      <view class="credit-score-row">
        <text class="credit-score-number">{{scoreCard.score}}</text>
        <view class="credit-score-badges">
          <text
            wx:for="{{scoreCard.badges}}"
            wx:key="text"
            class="profile-status {{item.tone}}"
          >{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="credit-summary-grid">
      <view wx:for="{{summary}}" wx:key="label" class="credit-summary-item">
        <text class="credit-summary-value">{{item.value}}</text>
        <text class="credit-summary-label">{{item.label}}</text>
      </view>
    </view>

    <view class="profile-section">
      <text class="profile-section-title">信用明细</text>
      <view class="profile-list-card">
        <view wx:for="{{records}}" wx:key="title" class="credit-record-row">
          <view>
            <text class="profile-row-title">{{item.title}}</text>
            <text class="profile-muted">{{item.desc}}</text>
          </view>
          <text class="credit-score-change {{item.tone}}">{{item.score}}</text>
        </view>
      </view>
    </view>

    <text wx:if="{{bottomNote}}" class="credit-bottom-note">{{bottomNote}}</text>
  </view>
</profile-white-shell>
