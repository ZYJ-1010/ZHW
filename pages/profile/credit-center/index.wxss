@import "../profile-white-page.wxss";

.credit-heading {
  display: block;
  margin: 4rpx 0 24rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.credit-score-card {
  padding: 34rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #111827 0%, #374151 100%);
  box-shadow: 0 12rpx 32rpx rgba(17, 24, 39, 0.18);
}

.credit-score-label {
  display: block;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
  line-height: 36rpx;
}

.credit-score-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.credit-score-number {
  color: #ffffff;
  font-size: 88rpx;
  font-weight: 400;
  line-height: 96rpx;
}

.credit-score-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  padding-bottom: 10rpx;
}

.credit-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.credit-summary-item {
  min-height: 126rpx;
  padding: 22rpx 14rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  text-align: center;
}

.credit-summary-value {
  display: block;
  overflow: hidden;
  color: #111827;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credit-summary-label {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 32rpx;
}

.credit-record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 0 28rpx;
  border-bottom: 2rpx solid #f1f5f9;
  box-sizing: border-box;
}

.credit-record-row:last-child {
  border-bottom: 0;
}

.credit-score-change {
  flex: none;
  margin-left: 22rpx;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.credit-score-change.plus {
  color: #16a34a;
}

.credit-score-change.minus {
  color: #dc2626;
}

.credit-bottom-note {
  display: block;
  margin-top: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  color: #6b7280;
  background: #f9fafb;
  font-size: 24rpx;
  line-height: 36rpx;
}

.profile-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-section-action {
  color: #16a34a;
  font-size: 24rpx;
  line-height: 34rpx;
}

.credit-empty {
  padding: 42rpx 28rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}
