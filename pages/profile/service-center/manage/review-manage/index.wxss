page {
  height: 100%;
  background: #0089dc;
  overflow: hidden;
}

.home-master-apply-page.service-review-shell {
  height: 100vh;
  min-height: 100vh;
  padding-top: 108rpx;
  padding-bottom: 0;
  box-sizing: border-box;
  background: #0089dc;
  overflow: hidden;
}

.home-master-apply-page.service-review-shell .home-master-apply-frame,
.home-master-apply-page.service-review-shell .home-master-apply-top-bg {
  background: #0089dc;
}

.home-master-apply-page.service-review-shell .home-master-apply-stage,
.home-master-apply-page.service-review-shell .home-master-apply-frame {
  height: 100%;
  overflow: visible;
}

.home-master-apply-page.service-review-shell .home-master-apply-phone {
  height: calc(100vh - 181rpx);
  min-height: 0;
  overflow: hidden;
  background: #f5f5f9;
  color: #333333;
}

.service-review-scroll {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: #f5f5f9;
}

.review-manage-page {
  min-height: 100%;
  padding-bottom: 42rpx;
  box-sizing: border-box;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.score-section {
  padding: 18rpx 24rpx 0;
  background: #f5f5f9;
}

.score-card {
  padding: 44rpx 38rpx 36rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9d00 0%, #ff6b00 100%);
  box-shadow: 0 16rpx 36rpx rgba(234, 88, 12, 0.22);
}

.score-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.score-main,
.score-side {
  display: flex;
  flex-direction: column;
}

.score-number {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.score-label,
.score-total-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 34rpx;
}

.score-stars {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 40rpx;
}

.score-side {
  align-items: flex-end;
}

.score-total {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.score-good-rate {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.score-bars {
  margin-top: 40rpx;
}

.score-bar-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
}

.score-bar-row:first-child {
  margin-top: 0;
}

.bar-label,
.bar-percent {
  flex: none;
  width: 58rpx;
}

.bar-percent {
  text-align: right;
}

.bar-track {
  flex: 1;
  height: 12rpx;
  margin: 0 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
}

.pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 654rpx;
  height: 92rpx;
  margin: 28rpx auto 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #dbeafe;
  box-sizing: border-box;
  background: #eff6ff;
  box-shadow: none;
}

.pending-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.message-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
}

.pending-text {
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.pending-count {
  color: #2563eb;
  font-weight: 700;
}

.pending-button {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 50rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.reply-action::after,
.like-action::after {
  border: 0;
}

.review-list {
  padding: 0 26rpx;
}

.review-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.review-card:first-child {
  margin-top: 0;
}

.review-card.pending {
  border-left: 8rpx solid #60a5fa;
}

.review-card.critical {
  border-left: 8rpx solid #f87171;
}

.review-head,
.review-person,
.rating-line,
.review-actions,
.alert-box,
.stats-title-row {
  display: flex;
  align-items: center;
}

.review-head {
  justify-content: space-between;
}

.review-person {
  flex: 1;
  min-width: 0;
}

.review-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.review-avatar.pink {
  background: #ec4899;
}

.review-avatar.green {
  background: #10b981;
}

.review-avatar.indigo {
  background: #6366f1;
}

.review-avatar.red {
  background: #ef4444;
}

.review-person-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.review-name,
.review-content,
.reply-label,
.reply-content,
.stat-value,
.stat-label {
  display: block;
}

.review-name {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.rating-line {
  margin-top: 4rpx;
}

.review-stars {
  flex: none;
  color: #f59e0b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.review-service {
  min-width: 0;
  margin-left: 10rpx;
  overflow: hidden;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-date {
  flex: none;
  margin-left: 16rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
}

.review-content {
  margin-top: 24rpx;
  color: #374151;
  font-size: 25rpx;
  line-height: 40rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tag-chip {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  color: #6b7280;
  background: #f3f4f6;
  font-size: 20rpx;
  line-height: 28rpx;
}

.reply-box {
  margin-top: 26rpx;
  padding: 22rpx;
  border: 2rpx solid #f3f4f6;
  border-radius: 16rpx;
  background: #f9fafb;
}

.reply-label {
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 28rpx;
}

.reply-content {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 23rpx;
  line-height: 34rpx;
}

.review-actions {
  gap: 14rpx;
  margin-top: 26rpx;
}

.reply-action {
  flex: 3 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  color: #ffffff;
  background: #3b82f6;
  font-size: 25rpx;
  font-weight: 700;
}

.reply-action-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.like-action {
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  background: #f3f4f6;
}

.like-action-icon {
  width: 30rpx;
  height: 30rpx;
}

.alert-box {
  margin-top: 26rpx;
  padding: 20rpx;
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  color: #dc2626;
  background: #fef2f2;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.alert-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #ef4444;
}

.alert-icon::before {
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 4rpx;
  height: 11rpx;
  border-radius: 4rpx;
  background: #ffffff;
  content: '';
}

.alert-icon::after {
  position: absolute;
  left: 12rpx;
  bottom: 5rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #ffffff;
  content: '';
}

.stats-card {
  margin: 32rpx 26rpx 0;
  padding: 28rpx 26rpx 32rpx;
  border: 2rpx solid #dcfce7;
  border-radius: 28rpx;
  background: #f0fdf4;
}

.stats-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  line-height: 32rpx;
}

.stats-title {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  row-gap: 34rpx;
  margin-top: 30rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  color: #15803d;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.stat-label {
  margin-top: 8rpx;
  color: #16a34a;
  font-size: 20rpx;
  line-height: 28rpx;
}
