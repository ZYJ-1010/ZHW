<profile-white-shell title="关系网络" background="#050b14" nav-background="#050b14" title-color="#ffffff" title-weight="400" back-background="#050b14" back-border-color="transparent" back-icon-color="#12d8ff">
  <view class="invite-page network-page dark-page">
    <view class="summary-row">
      <view wx:for="{{summary}}" wx:key="label" class="summary-card">
        <text class="summary-value">{{item.value}}</text>
        <text class="summary-label">{{item.label}}</text>
      </view>
    </view>

    <view class="network-panel">
      <view class="network-head">
        <view class="network-title-wrap">
          <text class="network-title-icon">🌐</text>
          <text class="network-title">我的关系网</text>
        </view>
        <text class="live-dot">● 实时连接</text>
      </view>

      <view class="network-visual">
        <view class="network-sparkles">
          <text class="spark s1"></text>
          <text class="spark s2"></text>
          <text class="spark s3"></text>
          <text class="spark s4"></text>
          <text class="spark s5"></text>
          <text class="spark s6"></text>
          <text class="spark s7"></text>
          <text class="spark s8"></text>
        </view>
        <view class="node-ring">
          <text class="node-line line-0"></text>
          <text class="node-line line-1"></text>
          <text class="node-line line-2"></text>
          <text class="node-line line-3"></text>
          <text class="node-line line-4"></text>
          <text class="node-line line-5"></text>
          <text class="node-line line-6"></text>
          <text class="node-line line-7"></text>
          <text wx:for="{{networkNodes}}" wx:key="*this" class="node-avatar node-{{index}}">{{item}}</text>
          <view class="node-center">
            <text>我</text>
          </view>
        </view>
        <view class="network-stat stat-served">
          <text>已服务 </text><text class="stat-cyan">156</text><text> 位玩家</text>
        </view>
        <view class="network-stat stat-income">
          <text>本周收益 </text><text class="stat-cyan">¥1,240</text>
        </view>
      </view>
      <view class="invite-member-summary">
        <view class="avatar-stack">
          <text wx:for="{{avatars}}" wx:key="*this" class="stack-avatar">{{item}}</text>
          <text class="stack-more">+8</text>
        </view>
        <view class="summary-copy">
          <text class="summary-main">12 位一级成员</text>
          <text class="summary-sub">直接连接的玩家</text>
        </view>
      </view>
      <view class="network-actions">
        <text class="primary-btn">管理我的邀约</text>
        <text class="secondary-btn">查看分润</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title"><text class="title-icon">👥</text><text>一级成员明细</text></view>
      <view wx:for="{{members}}" wx:key="id" class="member-row" data-id="{{item.id}}" bindtap="handleMemberTap">
        <text class="member-avatar">{{item.avatar}}</text>
        <view class="member-info">
          <view class="member-name-line">
          <text class="member-name">{{item.name}}</text>
          <text class="pill">一级成员</text>
        </view>
        <text class="member-desc">{{item.desc}}</text>
      </view>
      <view class="member-income">
          <text>{{item.direct}}</text>
          <text class="team-label">{{item.team}}</text>
      </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</profile-white-shell>
