@import "../shared.wxss";

.member-detail-page {
  min-height: calc(100vh - 160rpx);
  padding: 24rpx 0 0;
  background: #050b14;
  color: #ffffff;
  box-sizing: border-box;
}

.member-detail-page,
.member-detail-page text,
.member-detail-page view {
  font-weight: 400;
  letter-spacing: 0;
}

.member-card {
  min-height: calc(100vh - 184rpx);
  padding: 48rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #111a29;
  box-sizing: border-box;
}

.member-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.member-avatar {
  width: 104rpx;
  height: 104rpx;
  border: 2rpx solid rgba(0, 212, 255, 0.8);
  border-radius: 50%;
  background: #133246;
  box-shadow: 0 0 20rpx rgba(0, 212, 255, 0.25);
  font-size: 52rpx;
  line-height: 104rpx;
  text-align: center;
}

.member-name {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 36rpx;
}

.member-level {
  height: 26rpx;
  margin-top: 6rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 212, 255, 0.2);
  color: #00d4ff;
  font-size: 17rpx;
  line-height: 26rpx;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.stat-card {
  height: 94rpx;
  padding-top: 18rpx;
  border-radius: 12rpx;
  background: #0a111d;
  box-sizing: border-box;
  text-align: center;
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  color: #00d4ff;
  font-size: 26rpx;
  line-height: 32rpx;
}

.stat-label {
  margin-top: 8rpx;
  color: #8b95a8;
  font-size: 17rpx;
  line-height: 22rpx;
}

.section-card {
  margin-top: 24rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
}

.title-icon {
  margin-right: 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
}

.income-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 0;
  background: #0a111d;
  box-sizing: border-box;
}

.income-row + .income-row {
  margin-top: 8rpx;
}

.income-row.highlight {
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 10rpx;
  background: rgba(0, 212, 255, 0.12);
}

.income-label {
  color: #8b95a8;
  font-size: 22rpx;
  line-height: 30rpx;
}

.income-value {
  color: #32f28a;
  font-size: 23rpx;
  line-height: 30rpx;
}

.activity-section {
  margin-top: 22rpx;
}

.activity-row {
  display: flex;
  align-items: center;
  height: 86rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 14rpx;
  background: #080e18;
  box-sizing: border-box;
}

.activity-row + .activity-row {
  margin-top: 12rpx;
}

.activity-icon {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #133246;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
}

.activity-info {
  flex: 1;
  min-width: 0;
}

.activity-title,
.activity-time {
  display: block;
}

.activity-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-time {
  margin-top: 2rpx;
  color: #8b95a8;
  font-size: 18rpx;
  line-height: 24rpx;
}

.activity-amount {
  flex: none;
  margin-left: 16rpx;
  color: #32f28a;
  font-size: 24rpx;
  line-height: 32rpx;
}
