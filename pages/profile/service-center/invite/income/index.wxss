@import "../shared.wxss";

.income-page {
  min-height: 100%;
  padding: 0 32rpx 64rpx;
  background: #050b14;
  color: #ffffff;
}

.income-page,
.income-page text,
.income-page view {
  font-weight: 400;
  letter-spacing: 0;
}

.income-panel {
  position: relative;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  box-sizing: border-box;
}

.trend-panel {
  padding: 34rpx;
}

.income-section-title {
  display: flex;
  align-items: center;
  height: 48rpx;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 48rpx;
}

.section-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 48rpx;
  text-align: center;
}

.trend-icon {
  background: rgba(0, 212, 255, 0.15);
  color: #00d4ff;
}

.flow-section-icon {
  background: rgba(0, 230, 118, 0.15);
  color: #00e676;
}

.trend-chart {
  position: relative;
  height: 320rpx;
  margin-top: 34rpx;
  border: 2rpx solid #0079d7;
  border-radius: 0;
  background: #0a1420;
  overflow: hidden;
}

.trend-grid {
  position: absolute;
  left: 70rpx;
  right: 72rpx;
  top: 66rpx;
  bottom: 70rpx;
  background:
    linear-gradient(rgba(45, 62, 82, 0.35) 2rpx, transparent 2rpx) 0 0 / 100% 62rpx;
}

.trend-shadow {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 212, 255, 0.18) 0%, rgba(0, 144, 190, 0.13) 34%, rgba(0, 71, 105, 0.05) 72%, rgba(0, 212, 255, 0) 100%);
  opacity: 0.85;
}

.trend-plot {
  position: absolute;
  left: 54rpx;
  right: 56rpx;
  top: 58rpx;
  bottom: 76rpx;
}

.trend-segment {
  position: absolute;
  z-index: 2;
  height: 3rpx;
  border-radius: 999rpx;
  background: #29d9ff;
  box-shadow: 0 0 8rpx rgba(0, 212, 255, 0.55);
  transform-origin: left center;
}

.trend-point-wrap {
  position: absolute;
  z-index: 3;
  top: 0;
  bottom: 0;
  width: 0;
}

.trend-point-halo {
  position: absolute;
  left: -17rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 212, 255, 0.18);
  box-shadow: 0 0 18rpx rgba(0, 212, 255, 0.65);
  transform: translateY(50%);
}

.trend-point {
  position: absolute;
  left: -9rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid rgba(0, 212, 255, 0.22);
  border-radius: 50%;
  background: #27d9ff;
  box-shadow: 0 0 10rpx rgba(0, 212, 255, 0.7);
  box-sizing: border-box;
  transform: translateY(50%);
}

.trend-months {
  position: absolute;
  left: 50rpx;
  right: 50rpx;
  bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  color: #4b5563;
  font-size: 20rpx;
  line-height: 24rpx;
}

.income-grid {
  display: grid;
  grid-template-columns: repeat(2, 334rpx);
  gap: 20rpx;
  margin-top: 24rpx;
}

.income-metric {
  width: 334rpx;
  height: 194rpx;
  padding: 34rpx 30rpx 22rpx;
  border: 2rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 24rpx;
  background: linear-gradient(145.01deg, rgba(0, 212, 255, 0.1) 14.06%, rgba(0, 128, 255, 0.05) 85.94%);
  box-sizing: border-box;
}

.income-label,
.income-desc {
  display: block;
  color: #8b92a8;
  font-size: 23rpx;
  line-height: 28rpx;
}

.income-value {
  display: block;
  margin: 10rpx 0 8rpx;
  color: #00d4ff;
  font-size: 40rpx;
  line-height: 48rpx;
}

.flow-panel {
  margin-top: 32rpx;
  padding: 34rpx;
}

.flow-row {
  display: flex;
  align-items: center;
  height: 132rpx;
  margin-top: 22rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.flow-icon {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: rgba(0, 212, 255, 0.1);
  color: #ffffff;
  font-size: 36rpx;
  line-height: 80rpx;
  text-align: center;
}

.flow-info {
  flex: 1;
  min-width: 0;
}

.flow-title,
.flow-time {
  display: block;
}

.flow-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flow-time {
  margin-top: 8rpx;
  color: #8b92a8;
  font-size: 22rpx;
  line-height: 28rpx;
}

.flow-amount {
  flex: none;
  margin-left: 20rpx;
  color: #00e676;
  font-size: 30rpx;
  line-height: 36rpx;
}
