@import "../shared.wxss";

.overview-page .hero-card {
  display: flex;
  align-items: center;
  padding: 26rpx 0 18rpx;
  border-radius: 0;
  background: transparent;
}

.overview-page .avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: #12aeea;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 68rpx;
  text-align: center;
}

.hero-info {
  display: flex;
  flex-direction: column;
}

.name-line {
  display: flex;
  align-items: center;
}

.hero-info .level {
  display: inline-block;
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(18, 216, 255, 0.16);
  color: #12d8ff;
  font-size: 18rpx;
}

.hero-info .name {
  margin: 0;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.hero-info .desc {
  margin-top: 8rpx;
  color: #8fa0b6;
  font-size: 20rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.metric-item {
  padding: 18rpx 16rpx;
  border-radius: 12rpx;
  background: #080e18;
  text-align: center;
}

.metric-value {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.metric-label,
.trend-label {
  color: #8fa0b6;
  font-size: 20rpx;
}

.metric-trend {
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(34, 197, 94, 0.16);
  font-size: 19rpx;
}

.metric-trend.up {
  color: #16a34a;
}

.metric-trend.down {
  background: rgba(239, 68, 68, 0.14);
  color: #ef4444;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.quick-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  border: 1rpx solid rgba(18, 216, 255, 0.18);
  border-radius: 10rpx;
  background: #073a4f;
  color: #12d8ff;
  font-size: 21rpx;
}

.quick-icon {
  margin-bottom: 6rpx;
  font-size: 30rpx;
}

.quick-icon.white {
  color: #ffffff;
}

.trend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11rpx 0;
  border-bottom: 0;
}

.trend-row:last-child {
  border-bottom: 0;
}

.trend-value {
  color: #12d8ff;
  font-size: 24rpx;
  font-weight: 700;
}

.trend-value.green {
  color: #35f58a;
}

.trend-value.cyan {
  color: #12d8ff;
}

.overview-page .tab-strip {
  gap: 0;
  margin-top: 0;
  padding: 0;
  background: transparent;
  overflow: visible;
  white-space: nowrap;
}

.overview-page .tab-item {
  flex: 1 1 0;
  min-width: 0;
  padding: 13rpx 0;
  background: transparent;
  color: #8fa0b6;
  font-size: 22rpx;
  text-align: center;
}

.overview-page .tab-item.active {
  padding: 13rpx 0;
  border-radius: 999rpx;
  background: #19bfff;
  color: #ffffff;
}

.overview-page .section-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 14rpx;
}

.overview-page .section-title {
  margin-bottom: 14rpx;
  font-size: 25rpx;
  font-weight: 400;
}
