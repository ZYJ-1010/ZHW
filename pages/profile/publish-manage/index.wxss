@import "../profile-white-page.wxss";

.publish-batch-bar {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.publish-check {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.publish-batch-text {
  margin-left: 12rpx;
  color: #374151;
  font-size: 25rpx;
  line-height: 34rpx;
}

.publish-batch-actions {
  display: flex;
  gap: 14rpx;
  margin-left: auto;
}

.publish-batch-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: #2563eb;
  background: #eff6ff;
  font-size: 24rpx;
  font-weight: 400;
}

.publish-batch-button.danger {
  color: #dc2626;
  background: #fee2e2;
}

.publish-card .profile-action-row {
  gap: 12rpx;
}

.publish-card .profile-action-secondary {
  min-width: 0;
  height: 56rpx;
}
