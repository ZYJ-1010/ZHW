@import "../profile-white-page.wxss";

.my-games-top-tabs {
  padding-bottom: 18rpx;
}

.my-game-side {
  flex: none;
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 10rpx;
}

.my-game-time {
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 32rpx;
}

.my-game-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.my-game-steps {
  margin-top: 28rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #f9fafb;
}

.my-game-step {
  position: relative;
  display: flex;
  gap: 16rpx;
}

.my-game-step + .my-game-step {
  margin-top: 24rpx;
}

.my-game-step:not(:last-child)::after {
  position: absolute;
  left: 9rpx;
  top: 24rpx;
  width: 2rpx;
  height: calc(100% + 10rpx);
  background: #d1d5db;
  content: '';
}

.my-game-step.done:not(:last-child)::after {
  background: #2563eb;
}

.my-game-step-dot {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  margin-top: 7rpx;
  border-radius: 50%;
  background: #d1d5db;
}

.my-game-step.done .my-game-step-dot {
  background: #2563eb;
}

.my-game-step-copy {
  flex: 1;
  min-width: 0;
}

.my-game-step-title {
  display: block;
  color: #111827;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.my-game-step-desc {
  display: block;
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}
