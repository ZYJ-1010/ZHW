.page {
  min-height: 100vh;
  overflow: hidden;
  background: #020406;
  color: #ffffff;
}

.topbar {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  background: #0d8bd3;
  box-sizing: border-box;
}

.brand-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
  background: #e94498;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 26rpx;
}

.brand-name,
.brand-sub,
.title,
.subtitle {
  display: block;
}

.brand-name {
  color: #b7ff52;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.brand-sub {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 18rpx;
}

.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 170rpx;
}

.portal {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 312rpx;
  height: 312rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff2c9c 0%, #7447ff 52%, #0fb8ff 100%);
  box-shadow: 36rpx 54rpx 74rpx rgba(0, 201, 255, 0.35);
}

.ticket {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.plus {
  color: #8c56f4;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  margin-left: 26rpx;
  border-radius: 50%;
  background: #8c56f4;
}

.go-button {
  position: absolute;
  right: -38rpx;
  bottom: -12rpx;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid #020406;
  border-radius: 50%;
  background: #22d9ff;
  color: #020406;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 80rpx;
  box-shadow: 16rpx 22rpx 44rpx rgba(34, 217, 255, 0.4);
}

.go-button::after {
  border: 0;
}

.title {
  margin-top: 84rpx;
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 4rpx 6rpx 0 #7d44ff;
}

.subtitle {
  margin-top: 34rpx;
  color: rgba(255, 255, 255, 0.36);
  font-size: 22rpx;
  letter-spacing: 12rpx;
}
