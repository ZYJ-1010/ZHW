page {
  width: 100%;
  height: 100%;
  background: #000000;
}

.real-checkin-page {
  min-height: 100%;
  padding: 18rpx 18rpx 56rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #000000;
  font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.real-checkin-target {
  position: relative;
  min-height: 610rpx;
  padding: 32rpx 30rpx;
  box-sizing: border-box;
  background: #172231;
}

.real-checkin-target-head,
.real-checkin-unlock-card,
.real-checkin-task {
  display: flex;
  align-items: center;
}

.real-checkin-target-head {
  justify-content: flex-start;
  padding-right: 74rpx;
  box-sizing: border-box;
}

.real-checkin-distance-pill {
  display: inline-flex;
  align-items: center;
  height: 50rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #111827;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.real-checkin-distance-icon {
  position: relative;
  display: block;
  width: 0;
  height: 0;
  margin-right: 10rpx;
  border-left: 14rpx solid #60a5fa;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  transform: rotate(-42deg);
}

.real-checkin-close {
  position: absolute;
  left: auto;
  right: 30rpx;
  top: 32rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  background: transparent;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 48rpx;
}

.real-checkin-close::after {
  border: 0;
}

.real-checkin-close::before {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: -1;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.72);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.06);
  transform: translate(-50%, -50%);
  content: "";
}

.real-checkin-photo-area {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 250rpx;
  height: 250rpx;
  margin: 150rpx auto 0;
}

.real-checkin-photo-visual {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}

.real-checkin-scan-corner {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border-color: #4aa3ff;
  border-style: solid;
}

.real-checkin-scan-corner.lt {
  left: 0;
  top: 0;
  border-width: 3rpx 0 0 3rpx;
}

.real-checkin-scan-corner.rt {
  right: 0;
  top: 0;
  border-width: 3rpx 3rpx 0 0;
}

.real-checkin-scan-corner.lb {
  left: 0;
  bottom: 0;
  border-width: 0 0 3rpx 3rpx;
}

.real-checkin-scan-corner.rb {
  right: 0;
  bottom: 0;
  border-width: 0 3rpx 3rpx 0;
}

.real-checkin-camera {
  position: absolute;
  left: 30rpx;
  bottom: 18rpx;
  width: 94rpx;
  height: 72rpx;
  border: 7rpx solid #07111f;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #334155;
}

.real-checkin-camera::before {
  position: absolute;
  left: 12rpx;
  top: -18rpx;
  width: 22rpx;
  height: 18rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #94a3b8;
  content: "";
}

.real-checkin-camera::after {
  position: absolute;
  right: -10rpx;
  top: 10rpx;
  width: 34rpx;
  height: 22rpx;
  background: #a3a86d;
  transform: rotate(18deg);
  content: "";
}

.real-checkin-camera-lens {
  position: absolute;
  left: 26rpx;
  top: 18rpx;
  width: 42rpx;
  height: 42rpx;
  border: 6rpx solid #07111f;
  border-radius: 50%;
  box-sizing: border-box;
  background: #475569;
}

.real-checkin-pin {
  position: absolute;
  left: 55rpx;
  top: 0;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50% 50% 50% 0;
  background: #4aa3ff;
  transform: rotate(-45deg);
}

.real-checkin-pin::after {
  position: absolute;
  left: 19rpx;
  top: 19rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #172231;
  content: "";
}

.real-checkin-spot-label {
  position: absolute;
  left: 50%;
  bottom: -64rpx;
  min-width: 200rpx;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #050910;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 52rpx;
  text-align: center;
  transform: translateX(-50%);
}

.real-checkin-unlock-card,
.real-checkin-story-card,
.real-checkin-task-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(59, 130, 246, 0.38);
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #111827;
}

.real-checkin-unlock-icon {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.22);
  font-size: 38rpx;
  line-height: 88rpx;
}

.real-checkin-unlock-copy,
.real-checkin-task-copy {
  flex: 1;
  min-width: 0;
}

.real-checkin-card-title,
.real-checkin-card-desc,
.real-checkin-section-title,
.real-checkin-task-title,
.real-checkin-task-desc,
.real-checkin-task-score {
  display: block;
}

.real-checkin-card-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.real-checkin-card-desc {
  margin-top: 6rpx;
  color: #a8b2c5;
  font-size: 21rpx;
  line-height: 30rpx;
}

.real-checkin-reward-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.real-checkin-reward {
  display: block;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #93c5fd;
  background: rgba(59, 130, 246, 0.24);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.real-checkin-reward + .real-checkin-reward {
  color: #d8b4fe;
  background: rgba(124, 58, 237, 0.28);
}

.real-checkin-section-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.real-checkin-story-field {
  position: relative;
  margin-top: 20rpx;
  min-height: 154rpx;
  padding: 22rpx 22rpx 50rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.28);
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #0b1220;
}

.real-checkin-story-input {
  display: block;
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 34rpx;
}

.real-checkin-story-placeholder {
  color: #6f7a8c;
  font-size: 22rpx;
}

.real-checkin-story-limit {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #6f7a8c;
  font-size: 18rpx;
  line-height: 26rpx;
}

.real-checkin-photo-list {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 30rpx;
}

.real-checkin-photo-thumb,
.real-checkin-photo-add {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.32);
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #1f2937;
}

.real-checkin-photo-thumb.selected {
  border-color: #3b82f6;
}

.real-checkin-thumb-check {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #3b82f6;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-align: center;
}

.real-checkin-photo-add {
  color: #8b95a7;
  font-size: 42rpx;
  line-height: 92rpx;
}

.real-checkin-thumb-building {
  position: relative;
  width: 38rpx;
  height: 42rpx;
  border: 4rpx solid #08111f;
  border-bottom: 0;
  border-radius: 5rpx 5rpx 0 0;
  background:
    linear-gradient(90deg, #22a9e6 0 10rpx, transparent 10rpx 15rpx, #22a9e6 15rpx 25rpx, transparent 25rpx 30rpx, #22a9e6 30rpx 38rpx),
    repeating-linear-gradient(180deg, #ffc444 0 5rpx, #129bd8 5rpx 12rpx);
}

.real-checkin-thumb-building::before {
  position: absolute;
  right: -13rpx;
  top: -10rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #fff34d;
  box-shadow: -6rpx 3rpx 0 #08111f;
  content: "";
}

.real-checkin-task-list {
  margin-top: 18rpx;
}

.real-checkin-task {
  min-height: 96rpx;
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #1f2937;
}

.real-checkin-task:first-child {
  margin-top: 0;
}

.real-checkin-task-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.real-checkin-task-desc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #7d8aa0;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.real-checkin-task-score {
  flex: none;
  width: 88rpx;
  margin-left: 16rpx;
  color: #60a5fa;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-align: right;
}

.real-checkin-generate {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(90deg, #0ea5e9 0%, #36c5d4 100%);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 92rpx;
  text-align: center;
}

.real-checkin-generate::after {
  border: 0;
}
