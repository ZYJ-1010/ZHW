@import "../../shared/module.wxss";

.im-room {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f7fb;
}

.im-head {
  padding: 24rpx 32rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #eef1f5;
}

.im-head-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.im-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.im-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.im-report {
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 24rpx;
}

.im-list {
  flex: 1;
  padding: 24rpx 24rpx 32rpx;
}

.im-item {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff;
}

.im-item.text {
  border-left: 6rpx solid #3b82f6;
}

.im-meta {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.im-content {
  display: block;
  font-size: 28rpx;
  color: #111827;
  word-break: break-all;
}

.im-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.im-compose {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 20rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eef1f5;
}

.im-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 10rpx;
  background: #fff;
}

.im-send {
  width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 10rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
}
