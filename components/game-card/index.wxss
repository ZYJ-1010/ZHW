.game-card {
  position: relative;
  width: 662rpx;
  height: 258rpx;
  margin: 18rpx auto 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #007bd3 0%, #034373 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.game-card-cover {
  position: absolute;
  left: 24rpx;
  top: 46rpx;
  width: 178rpx;
  height: 180rpx;
  border: 2rpx solid rgba(55, 127, 127, 0.67);
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #0b4f71;
}

.game-card-tag {
  position: absolute;
  left: 218rpx;
  top: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 30rpx;
  color: #ffffff;
  background: rgb(59, 189, 26);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.game-card-tag.explore {
  background: rgb(59, 189, 26);
}

.game-card-price {
  position: absolute;
  left: 546rpx;
  top: 50rpx;
  color: rgb(34, 226, 238);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

.game-card-title {
  position: absolute;
  left: 216rpx;
  right: 142rpx;
  top: 84rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-meta {
  position: absolute;
  left: 218rpx;
  right: 198rpx;
  overflow: hidden;
  color: rgb(190, 190, 190);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-meta.location {
  top: 134rpx;
}

.game-card-meta.time {
  top: 154rpx;
}

.game-card-join {
  position: absolute;
  right: 24rpx;
  top: 130rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 38rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgb(255, 0, 110);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.game-card-avatars {
  position: absolute;
  left: 216rpx;
  bottom: 28rpx;
  display: flex;
  width: 80rpx;
}

.game-card-avatars image,
.game-card-avatar-fallback {
  width: 32rpx;
  height: 34rpx;
  margin-right: -8rpx;
  border: 2rpx solid rgb(33, 84, 118);
  border-radius: 50%;
  box-sizing: border-box;
  background: #2dd4bf;
}

.game-card-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 34rpx;
}

.game-card-joined {
  position: absolute;
  left: 296rpx;
  bottom: 30rpx;
  width: 116rpx;
  overflow: hidden;
  color: rgb(190, 190, 190);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-actions {
  position: absolute;
  right: 32rpx;
  bottom: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 54rpx);
  column-gap: 2rpx;
}

.game-card-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  color: rgb(162, 151, 141);
  font-size: 14rpx;
  font-weight: 400;
  line-height: 20rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card-action-icon {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 2rpx;
}
