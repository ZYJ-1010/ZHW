<view class="game-card" bindtap="handleTap">
  <image class="game-card-cover" src="{{item.coverSrc || defaultCover}}" mode="aspectFill" />
  <view class="game-card-tag {{item.tagTone}}">{{item.tag}}</view>
  <text class="game-card-price">{{item.price}}</text>
  <text class="game-card-title">{{item.title}}</text>
  <text class="game-card-meta location">{{item.location}}</text>
  <text class="game-card-meta time">{{item.time}}</text>
  <text class="game-card-join">{{item.action}}</text>
  <view class="game-card-avatars">
    <block wx:if="{{item.avatarUrls && item.avatarUrls.length}}">
      <image wx:for="{{item.avatarUrls}}" wx:for-item="avatar" wx:key="*this" src="{{avatar}}" mode="aspectFill" />
    </block>
    <block wx:else>
      <view wx:for="{{defaultAvatars}}" wx:for-item="avatar" wx:key="*this" class="game-card-avatar-fallback">{{avatar}}</view>
    </block>
  </view>
  <text class="game-card-joined">{{item.joinedText}}</text>
  <view class="game-card-actions">
    <view wx:for="{{item.actions}}" wx:for-item="action" wx:key="*this" class="game-card-action">
      <image wx:if="{{action === '分享'}}" class="game-card-action-icon" src="/components/game-card/assets/action-share.png" mode="aspectFit" />
      <image wx:elif="{{action === '关注'}}" class="game-card-action-icon" src="/components/game-card/assets/action-follow.png" mode="aspectFit" />
      <image wx:elif="{{action === '引荐'}}" class="game-card-action-icon" src="/components/game-card/assets/action-refer.png" mode="aspectFit" />
      <image wx:elif="{{action === '打招呼'}}" class="game-card-action-icon" src="/components/game-card/assets/action-greet.png" mode="aspectFit" />
      <text>{{action}}</text>
    </view>
  </view>
</view>
