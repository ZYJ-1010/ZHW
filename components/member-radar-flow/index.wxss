.radar-flow {
  position: relative;
  width: 750rpx;
  height: 100vh;
  overflow: hidden;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
}

.radar-flow.dark {
  color: #f8fffc;
  background: #00392f;
}

.radar-flow.light {
  color: #101010;
  background: #ffffff;
}

.radar-top {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 10;
  width: 750rpx;
}

.radar-top-status {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  background: #ffffff;
}

.radar-nav-bg {
  position: absolute;
  left: 0;
  width: 750rpx;
  background: #00392f;
}

.radar-nav-bg.light {
  background: #ffffff;
}

.radar-title {
  position: absolute;
  left: 210rpx;
  right: 210rpx;
  display: block;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.radar-title.light {
  color: #101010;
  font-weight: 400;
}

.radar-back {
  position: absolute;
  left: 52rpx;
}

.radar-back-icon {
  width: 28rpx;
  height: 28rpx;
  border-left: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  box-sizing: border-box;
  transform: translate(10rpx, 5rpx) rotate(45deg);
}

.radar-back.light .radar-back-icon {
  border-left-color: #101010;
  border-bottom-color: #101010;
}

.radar-share-button {
  position: absolute;
  display: block;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

.radar-share-button::after {
  border: 0;
}

.radar-share-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.radar-share-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 22rpx;
  height: 22rpx;
  border-top: 5rpx solid #ffffff;
  border-right: 5rpx solid #ffffff;
  box-sizing: border-box;
}

.radar-share-corner::before {
  position: absolute;
  right: -3rpx;
  top: 15rpx;
  width: 30rpx;
  height: 5rpx;
  background: #ffffff;
  transform: rotate(-45deg);
  transform-origin: right center;
  content: '';
}

.radar-share-corner::after {
  position: absolute;
  right: 9rpx;
  top: 13rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 5rpx solid #ffffff;
  border-bottom: 5rpx solid #ffffff;
  box-sizing: border-box;
  content: '';
}

.radar-content {
  width: 750rpx;
  overflow: hidden;
}

.radar-static-content {
  position: relative;
}

.radar-entry,
.radar-matching,
.radar-result-page {
  position: relative;
  width: 750rpx;
  min-height: 1628rpx;
  overflow: hidden;
  background: #00392f;
}

.radar-disc {
  position: absolute;
  left: 42rpx;
  top: 250rpx;
  width: 666rpx;
  height: 666rpx;
  border-radius: 50%;
  background:
    repeating-radial-gradient(circle, rgba(19, 201, 180, 0.16) 0 2rpx, transparent 3rpx 64rpx),
    radial-gradient(circle, rgba(1, 80, 69, 0.88) 0 30%, rgba(0, 64, 55, 0.92) 31% 60%, rgba(0, 57, 47, 0.18) 61% 100%);
  box-shadow: inset 0 0 0 2rpx rgba(20, 198, 180, 0.14);
}

.radar-disc.active {
  left: 46rpx;
  top: 178rpx;
  width: 658rpx;
  height: 658rpx;
}

.radar-disc.dimmed {
  top: 176rpx;
  opacity: 0.32;
}

.radar-sweep {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 326rpx;
  height: 326rpx;
  border-radius: 0 0 326rpx 0;
  background: linear-gradient(72deg, rgba(0, 228, 194, 0.72), rgba(0, 228, 194, 0.12) 58%, rgba(0, 228, 194, 0));
  transform-origin: left top;
  transform: rotate(80deg);
}

.radar-disc.active .radar-sweep {
  width: 330rpx;
  height: 330rpx;
  animation: radarScan 3.4s linear infinite;
}

.radar-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 3rpx solid rgba(21, 211, 194, 0.55);
  border-radius: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.ring-outer {
  width: 520rpx;
  height: 520rpx;
  border-style: dashed;
}

.ring-mid {
  width: 360rpx;
  height: 360rpx;
}

.ring-inner {
  width: 194rpx;
  height: 194rpx;
}

.radar-axis {
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(21, 211, 194, 0.42);
  transform: translate(-50%, -50%);
}

.axis-x {
  width: 520rpx;
  height: 2rpx;
}

.axis-y {
  width: 2rpx;
  height: 520rpx;
}

.radar-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid rgba(42, 236, 216, 0.7);
  border-radius: 50%;
  background: #00392f;
  box-sizing: border-box;
  box-shadow: 0 0 0 6rpx rgba(42, 236, 216, 0.12);
  transform: translate(-50%, -50%);
}

.radar-core::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2df2da;
  transform: translate(-50%, -50%);
  content: '';
}

.radar-node {
  position: absolute;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  background: #0b5148;
  box-sizing: border-box;
}

.radar-node image {
  width: 100%;
  height: 100%;
}

.radar-node text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #ffe3a7;
  background: rgba(0, 122, 108, 0.86);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.radar-node.scanned {
  animation: radarNodeIn 280ms ease-out both;
}

.node-leader {
  left: 212rpx;
  top: 160rpx;
  width: 86rpx;
  height: 86rpx;
}

.node-maker {
  left: 104rpx;
  top: 344rpx;
  width: 92rpx;
  height: 92rpx;
}

.node-owner {
  right: 116rpx;
  top: 316rpx;
  width: 96rpx;
  height: 96rpx;
}

.node-investor {
  left: 302rpx;
  bottom: 92rpx;
  width: 92rpx;
  height: 92rpx;
}

.node-expert {
  right: 198rpx;
  bottom: 220rpx;
}

.node-partner {
  left: 280rpx;
  bottom: 220rpx;
}

.node-small {
  left: 344rpx;
  top: 222rpx;
}

.radar-entry-copy {
  position: absolute;
  left: 0;
  right: 0;
  top: 986rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-estimate {
  color: rgba(255, 255, 255, 0.92);
  font-size: 38rpx;
  line-height: 54rpx;
}

.radar-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 484rpx;
  height: 88rpx;
  margin-top: 76rpx;
  border-radius: 48rpx;
  color: #684715;
  background: linear-gradient(90deg, #f8cb75 0%, #eda83a 100%);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.12);
}

.radar-tip {
  margin-top: 72rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  line-height: 46rpx;
}

.radar-link {
  margin-top: 22rpx;
  color: #ffe3a7;
  font-size: 34rpx;
  line-height: 48rpx;
}

.radar-matching-text {
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  top: 986rpx;
  z-index: 2;
  color: rgba(255, 255, 255, 0.92);
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
}

.radar-matching-count {
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  top: 1046rpx;
  z-index: 2;
  color: rgba(255, 227, 167, 0.9);
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

@keyframes radarScan {
  from {
    transform: rotate(-18deg);
  }

  to {
    transform: rotate(342deg);
  }
}

@keyframes radarNodeIn {
  from {
    opacity: 0;
    transform: scale(0.72);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.radar-info {
  min-height: 100vh;
  background: #ffffff;
  box-sizing: border-box;
}

.radar-info-nav {
  position: relative;
  height: 78rpx;
}

.radar-info-back {
  position: absolute;
  left: 30rpx;
  top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.radar-info-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #101010;
  border-bottom: 4rpx solid #101010;
  box-sizing: border-box;
  transform: translateX(6rpx) rotate(45deg);
}

.radar-info-title {
  display: block;
  color: #101010;
  font-size: 56rpx;
  font-weight: 400;
  line-height: 78rpx;
  text-align: center;
}

.radar-info-card {
  width: 668rpx;
  margin: 24rpx auto 0;
}

.radar-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.08);
  box-sizing: border-box;
}

.radar-info-label {
  color: #101010;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.radar-info-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 340rpx;
  color: #bebebe;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: right;
}

.radar-info-arrow {
  margin-left: 10rpx;
  color: #bebebe;
}

.radar-save {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 910rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  color: #bebebe;
  background: rgba(190, 190, 190, 0.4);
  font-size: 40rpx;
  line-height: 56rpx;
}

.radar-query {
  position: relative;
  width: 750rpx;
  min-height: 100%;
  padding-top: 156rpx;
  background: #00392f;
  box-sizing: border-box;
}

.radar-query::before {
  position: absolute;
  left: -12rpx;
  top: 0;
  width: 774rpx;
  height: 520rpx;
  background: radial-gradient(circle at 30% 0%, rgba(0, 115, 92, 0.45) 0, rgba(0, 57, 47, 0) 58%);
  content: '';
}

.radar-halo {
  position: absolute;
  right: -30rpx;
  top: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background:
    repeating-radial-gradient(circle, rgba(44, 156, 131, 0.22) 0 2rpx, transparent 3rpx 34rpx);
  opacity: 0.5;
}

.radar-found {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: rgba(255, 255, 255, 0.86);
  font-size: 28rpx;
  line-height: 40rpx;
}

.radar-found .count,
.done-count .count {
  margin: 0 12rpx;
  color: #ffe3a7;
  font-weight: 700;
}

.radar-profile-card {
  position: relative;
  z-index: 1;
  width: 636rpx;
  margin: 42rpx auto 0;
  border-radius: 40rpx;
  background: #fffaf2;
  box-sizing: border-box;
}

.query-card {
  height: 748rpx;
  padding: 48rpx 64rpx 40rpx;
  text-align: center;
  box-shadow: 0 22rpx 0 rgba(255, 250, 242, 0.72), 0 32rpx 0 rgba(226, 244, 229, 0.46), 0 40rpx 0 rgba(114, 177, 154, 0.45);
}

.radar-profile-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #e5e7eb;
}

.radar-profile-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
}

.radar-profile-name {
  color: #000000;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.radar-profile-title {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  color: rgba(51, 51, 51, 0.72);
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-profile-tag {
  display: block;
  margin-top: 10rpx;
  color: #9d5c1d;
  font-size: 22rpx;
  line-height: 32rpx;
}

.radar-profile-detail {
  margin-top: 36rpx;
  color: #333333;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: left;
}

.radar-profile-detail text {
  display: block;
  margin-top: 14rpx;
}

.radar-profile-location {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: rgba(51, 51, 51, 0.52);
  font-size: 17rpx;
  line-height: 24rpx;
}

.radar-location-pin {
  position: relative;
  flex: 0 0 auto;
  width: 24rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50% 50% 50% 0;
  background: #707070;
  transform: rotate(-45deg);
}

.radar-location-pin::after {
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fffaf2;
  content: '';
}

.radar-location-address {
  flex: 1;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-location-distance {
  flex: 0 0 auto;
  margin-left: 20rpx;
}

.radar-profile-link {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 38rpx;
  display: block;
  color: #007a6c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.radar-query-actions {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  width: 396rpx;
  margin: 72rpx auto 0;
}

.radar-cycle-action,
.radar-add-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffe3a7;
  font-size: 28rpx;
  line-height: 40rpx;
}

.cycle-icon,
.add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  font-size: 64rpx;
  line-height: 1;
}

.cycle-icon {
  border: 4rpx solid #fff2d7;
  color: #fff2d7;
  font-size: 56rpx;
}

.add-icon {
  color: #00392f;
  background: radial-gradient(circle, #fff5d7 0%, #ffe2a5 100%);
  font-weight: 300;
}

.radar-result-loading {
  position: absolute;
  left: 74rpx;
  right: 74rpx;
  top: 888rpx;
  z-index: 2;
  color: rgba(255, 255, 255, 0.94);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.radar-small-card {
  position: absolute;
  left: 56rpx;
  top: 236rpx;
  z-index: 2;
  width: 656rpx;
  min-height: 508rpx;
  padding: 56rpx 76rpx 34rpx;
  border-radius: 16rpx;
  background: #fffaf2;
  box-sizing: border-box;
  text-align: center;
}

.radar-small-avatar {
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
}

.radar-small-name {
  display: block;
  margin-top: 10rpx;
  color: #101010;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.radar-small-title,
.radar-small-tag,
.radar-small-line,
.radar-small-location {
  display: block;
  overflow: hidden;
  color: rgba(51, 51, 51, 0.72);
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-small-title {
  margin-top: 12rpx;
  text-align: center;
}

.radar-small-tag {
  margin-top: 4rpx;
  color: #a16222;
  font-size: 20rpx;
  text-align: center;
}

.radar-small-line {
  margin-top: 14rpx;
  color: #333333;
  font-size: 24rpx;
}

.radar-small-location {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 18rpx;
}

.radar-done-card {
  position: absolute;
  left: 56rpx;
  top: 270rpx;
  z-index: 4;
  width: 656rpx;
  min-height: 734rpx;
  padding: 150rpx 56rpx 60rpx;
  border-radius: 16rpx;
  background: #fffaf2;
  box-sizing: border-box;
  text-align: center;
}

.done-check {
  position: absolute;
  left: 50%;
  top: 90rpx;
  width: 96rpx;
  height: 96rpx;
  color: rgba(51, 51, 51, 0.72);
  font-size: 76rpx;
  line-height: 96rpx;
  transform: translateX(-50%);
}

.done-title {
  display: block;
  margin-top: 96rpx;
  color: rgba(51, 51, 51, 0.72);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.done-count {
  display: flex;
  justify-content: center;
  margin-top: 34rpx;
  color: rgba(51, 51, 51, 0.72);
  font-size: 34rpx;
  line-height: 48rpx;
}

.done-count .count {
  color: #003732;
}

.done-link {
  display: block;
  margin-top: 34rpx;
  color: rgba(19, 69, 33, 0.72);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.done-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 482rpx;
  height: 88rpx;
  margin: 108rpx auto 0;
  border-radius: 44rpx;
  color: #684715;
  background: rgba(241, 171, 19, 0.85);
  font-size: 34rpx;
  line-height: 48rpx;
}
