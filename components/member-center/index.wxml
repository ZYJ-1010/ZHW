<view class="member-page">
    <view class="member-card {{cardClass}}">
      <view class="member-card-mark">
        <text>VIP</text>
      </view>
      <text class="member-card-title">{{memberLevel}}</text>
      <view class="member-dots">
        <view
          wx:for="{{levels}}"
          wx:key="key"
          class="member-dot {{item.active ? 'active' : ''}}"
        ></view>
      </view>
    </view>

    <view class="member-section">
      <view class="member-section-title">
        <view class="member-title-line"></view>
        <text>{{benefitSectionTitle}}</text>
        <view class="member-title-line"></view>
      </view>

      <view class="benefit-grid">
        <view class="benefit-card">
          <view class="benefit-head {{benefitClass}}">
            <image class="benefit-icon referral" src="{{assets.referral}}" mode="aspectFit"></image>
            <text class="benefit-title">{{primaryBenefitTitle}}</text>
          </view>
          <view class="benefit-body">
            <view wx:for="{{referralBenefits}}" wx:key="*this" class="benefit-row">
              <text class="benefit-index">{{index + 1}}.</text>
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <view class="benefit-card">
          <view class="benefit-head gold">
            <image class="benefit-icon profit" src="{{assets.profit}}" mode="aspectFit"></image>
            <text class="benefit-title">{{profitBenefitTitle}}</text>
          </view>
          <view class="benefit-percent">{{profitRate}}</view>
        </view>
      </view>
    </view>

    <view class="member-section radar-section">
      <view class="member-section-title">
        <view class="member-title-line"></view>
        <text>{{radarTitle}}</text>
        <view class="member-title-line"></view>
      </view>
      <text class="section-subtitle">{{radarSubtitle}}</text>

      <view class="radar-wrap">
        <view class="radar-face">
          <view class="radar-ring ring-1"></view>
          <view class="radar-ring ring-2"></view>
          <view class="radar-ring ring-3"></view>
          <view class="radar-ring ring-4"></view>
          <view class="radar-axis horizontal"></view>
          <view class="radar-axis vertical"></view>
          <view class="radar-track outer"></view>
          <view class="radar-track inner"></view>
          <view
            wx:for="{{radarPeople}}"
            wx:key="id"
            class="radar-avatar {{item.className}}"
          >
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{item.text}}</text>
          </view>
          <view class="radar-center"></view>
        </view>
      </view>

      <button class="match-button" bindtap="handleMatch">{{radarButtonText}}</button>
    </view>

    <view class="member-section audience-section">
      <view class="member-section-title">
        <view class="member-title-line"></view>
        <text>{{audienceTitle}}</text>
        <view class="member-title-line"></view>
      </view>
      <view class="audience-list">
        <text wx:for="{{audience}}" wx:key="*this" class="audience-item">{{index + 1}}. {{item}}</text>
      </view>
    </view>

    <view class="member-section rules-section">
      <view class="member-section-title">
        <view class="member-title-line"></view>
        <text>{{openRulesTitle}}</text>
        <view class="member-title-line"></view>
      </view>
      <view class="rules-list">
        <text class="rule-main">{{openRules.step}}</text>
        <view wx:for="{{openRules.notes}}" wx:key="*this" class="rule-row">
          <view class="rule-dot"></view>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="role-link" bindtap="handleUnlockRole">
      <text>{{roleLinkText}}</text>
      <text class="role-arrow">></text>
    </view>

    <view wx:if="{{latestNotice}}" class="member-notice">
      <view class="notice-avatar">{{latestNotice.avatarText}}</view>
      <text><text class="notice-name">{{latestNotice.name}}</text> {{latestNotice.text}}</text>
    </view>

    <view class="member-footer">
      <view class="open-button" bindtap="handleOpenMember">
        <text>{{purchase.buttonText}}</text>
        <text class="open-price">{{purchase.priceText}}</text>
      </view>
      <view class="agreement-text">
        <text>{{purchase.agreementPrefix}}</text>
        <text class="agreement-link" bindtap="handleAgreement">{{purchase.agreementName}}</text>
        <text>{{purchase.agreementSuffix}}</text>
        <text class="agreement-highlight">{{purchase.highlightText}}</text>
      </view>
    </view>

    <view class="member-bottom-spacer"></view>
  </view>
