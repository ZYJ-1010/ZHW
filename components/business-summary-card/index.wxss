.business-summary-card {
  width: 750rpx;
  height: 220rpx;
  padding: 34rpx 40rpx 28rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.business-summary-card.role-guide {
  background: linear-gradient(135deg, #4a7afa 0%, #295af2 100%);
}

.business-summary-card.role-expert {
  background: linear-gradient(135deg, #4a7afa 0%, #295af2 100%);
}

.business-summary-card.role-player {
  background: linear-gradient(135deg, #14b8a6 0%, #16a34a 100%);
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.summary-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 36rpx;
}

.summary-amount {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.summary-card-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.summary-icon-image {
  width: 42rpx;
  height: 42rpx;
}

.summary-icon-trend {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.summary-trend-axis {
  position: absolute;
  left: 5rpx;
  bottom: 9rpx;
  width: 34rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #ffffff;
}

.summary-trend-axis::before {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 4rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: #ffffff;
  content: '';
}

.summary-trend-segment {
  position: absolute;
  height: 4rpx;
  border-radius: 4rpx;
  background: #ffffff;
  transform-origin: left center;
}

.summary-trend-segment.one {
  left: 11rpx;
  top: 27rpx;
  width: 11rpx;
  transform: rotate(-20deg);
}

.summary-trend-segment.two {
  left: 21rpx;
  top: 23rpx;
  width: 10rpx;
  transform: rotate(18deg);
}

.summary-trend-segment.three {
  left: 28rpx;
  top: 26rpx;
  width: 15rpx;
  transform: rotate(-35deg);
}

.summary-icon-mark {
  position: absolute;
  left: 19rpx;
  top: 20rpx;
  width: 34rpx;
  height: 28rpx;
}

.icon-guide .summary-icon-mark::before {
  position: absolute;
  left: 0;
  bottom: 2rpx;
  width: 36rpx;
  height: 22rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  border-radius: 0 0 0 4rpx;
  content: '';
}

.icon-guide .summary-icon-mark::after {
  position: absolute;
  left: 6rpx;
  top: 12rpx;
  width: 28rpx;
  height: 16rpx;
  border-top: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  transform: skewY(-24deg);
  content: '';
}

.icon-expert .summary-icon-mark {
  left: 17rpx;
  top: 23rpx;
  width: 38rpx;
  height: 28rpx;
  border: 4rpx solid #ffffff;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.icon-expert .summary-icon-mark::before {
  position: absolute;
  left: 11rpx;
  top: -14rpx;
  width: 12rpx;
  height: 10rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  box-sizing: border-box;
  content: '';
}

.icon-expert .summary-icon-mark::after {
  position: absolute;
  left: -4rpx;
  top: 9rpx;
  width: 38rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #ffffff;
  content: '';
}

.icon-player .summary-icon-mark {
  left: 18rpx;
  top: 22rpx;
  width: 38rpx;
  height: 30rpx;
  border: 4rpx solid #ffffff;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.icon-player .summary-icon-mark::before {
  position: absolute;
  left: 4rpx;
  top: -10rpx;
  width: 26rpx;
  height: 10rpx;
  border-top: 4rpx solid #ffffff;
  border-left: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
  content: '';
}

.icon-player .summary-icon-mark::after {
  position: absolute;
  right: 4rpx;
  top: 9rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffffff;
  content: '';
}

.summary-stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.summary-stat {
  margin-right: 38rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 34rpx;
  white-space: nowrap;
}
