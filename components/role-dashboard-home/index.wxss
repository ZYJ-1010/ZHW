@import "../../pages/home/player/index.wxss";

.role-home-scroll {
  width: 100%;
  height: 100%;
  background: #000000;
}

.role-home-page {
  width: 704rpx;
  min-height: 100%;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  background: #000000;
  font-family: "Noto Sans SC", sans-serif;
}

.role-home-page.guide .player-summary-card,
.role-home-page.expert .player-summary-card {
  border-color: rgba(180, 253, 255, 0.23);
}

.role-hero-title {
  color: #adff2f;
}

.role-level-pill {
  min-width: 160rpx;
}

.role-home-page.expert .role-level-pill {
  background: #16c0f6;
}

.role-home-page.expert .player-role-tag.active {
  border-color: rgba(180, 253, 255, 0.42);
  background: linear-gradient(180deg, #007bd3 0%, #034373 100%);
  opacity: 1;
}

.role-home-page.guide .role-hero-title {
  color: #ff8a34;
}

.role-home-page.guide .player-summary-card {
  border-color: rgba(90, 199, 255, 0.58);
  background: linear-gradient(180deg, #0689d8 0%, #045d8d 100%);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.role-home-page.guide .role-level-pill {
  color: #001b55;
  background: #ff8a34;
}

.role-home-page.guide .player-level-progress-fill {
  background: linear-gradient(90deg, #d9f0ff 0%, #7fc3d8 100%);
}

.role-home-page.guide .player-role-tag.active {
  border-color: rgba(219, 249, 255, 0.88);
  background: linear-gradient(180deg, #0b91d6 0%, #06517c 100%);
  box-shadow:
    0 0 16rpx rgba(255, 255, 255, 0.72),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  opacity: 1;
}

.role-home-page.guide .role-summary-device text:last-child {
  background: linear-gradient(180deg, #ff9b42 0%, #ff6a26 100%);
}

.role-summary-device {
  background: linear-gradient(180deg, #bfbaba 0%, #000000 100%);
}

.role-home-page.expert .role-summary-device text:last-child {
  background: linear-gradient(180deg, #6ef7ff 0%, #1178ff 100%);
}

.role-action-grid {
  margin-top: 28rpx;
}

.role-main-section {
  margin-top: 36rpx;
}

.role-main-section .player-section-title {
  margin-left: 0;
  padding-left: 0;
}

.role-main-section .player-section-title::before {
  display: none;
}

.role-section-title-wrap {
  display: flex;
  align-items: center;
}

.role-section-icon {
  margin-right: 4rpx;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 40rpx;
}

.role-section-count {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 10rpx;
  border-radius: 20rpx;
  color: rgba(239, 68, 68, 1);
  background: rgba(239, 68, 68, 0.2);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: justify;
}

.role-section-more {
  width: 112rpx;
  height: 36rpx;
  font-size: 18rpx;
  line-height: 32rpx;
  text-align: center;
}

.role-section-more.disabled {
  color: rgba(255, 255, 255, 0.5);
  font-weight: 400;
}

.role-section-more.enabled {
  color: #16c0f6;
  font-weight: 700;
}

.role-section-desc {
  width: 662rpx;
  margin: -6rpx auto 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  line-height: 28rpx;
}

.role-session-card {
  position: relative;
  display: flex;
  width: 662rpx;
  min-height: 192rpx;
  margin: 24rpx auto 0;
  padding: 28rpx 28rpx 20rpx;
  border: 2rpx solid rgba(0, 168, 255, 0.4);
  border-radius: 30rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #06486f 0%, #0a82c9 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.role-session-time {
  flex: none;
  width: 138rpx;
  margin-left: -28rpx;
  padding-top: 20rpx;
  text-align: center;
}

.role-session-time text {
  display: block;
  width: 100%;
  text-align: center;
}

.role-session-time text:first-child {
  color: #fbbf24;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.role-session-time text:last-child {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.role-session-divider {
  flex: none;
  width: 2rpx;
  height: 136rpx;
  margin: 0 26rpx 0 0;
  background: rgba(255, 255, 255, 0.14);
}

.role-session-main {
  flex: 1;
  min-width: 0;
  padding-right: 96rpx;
  box-sizing: border-box;
}

.role-session-title,
.role-session-date,
.role-session-meta {
  display: block;
}

.role-session-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.role-session-date,
.role-session-meta {
  max-width: 100%;
  height: 32rpx;
  margin-top: 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 32rpx;
  text-align: justify;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.role-session-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.role-session-tags text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  height: 34rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(14, 165, 233, 0.3);
  border-radius: 14rpx;
  box-sizing: border-box;
  color: rgba(103, 232, 249, 0.72);
  background: rgba(14, 165, 233, 0.14);
  font-size: 18rpx;
  line-height: 30rpx;
}

.role-session-tags text.green {
  border-color: rgba(34, 197, 94, 0.32);
  color: rgba(74, 222, 128, 0.78);
  background: rgba(34, 197, 94, 0.16);
}

.role-session-income {
  position: absolute;
  right: 30rpx;
  top: 54rpx;
  width: 104rpx;
  text-align: right;
}

.role-session-income text {
  display: block;
}

.role-session-income text:first-child {
  color: #fbbf24;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.role-session-income text:last-child {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 24rpx;
}

.role-session-players {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
}

.role-session-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 16rpx;
  line-height: 28rpx;
  overflow: hidden;
}

.role-session-avatar:not(:last-child) {
  margin-right: -6rpx;
}

.role-session-avatar image {
  width: 100%;
  height: 100%;
}

.role-session-joined {
  margin-left: 8rpx;
  color: #d8f5ff;
  font-size: 14rpx;
  font-weight: 400;
  line-height: 20rpx;
}

.role-skill-panel,
.role-review-panel,
.role-recommend-panel,
.role-network-panel {
  width: 662rpx;
  margin: 28rpx auto 0;
  box-sizing: border-box;
}

.role-network-panel {
  width: 660rpx;
  height: 594rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(185, 138, 16, 0.2);
  border-radius: 40rpx;
  background: linear-gradient(180deg, rgba(240, 188, 89, 0.05) 0%, rgba(10, 15, 28, 0.8) 100%);
  color: rgba(16, 16, 16, 1);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.role-skill-panel {
  position: relative;
  height: 302rpx;
  padding: 24rpx 34rpx 0;
  border: 2rpx solid #00a8ff;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 24% 54%, rgba(0, 123, 211, 0.18) 0%, rgba(0, 123, 211, 0) 40%),
    rgba(2, 16, 23, 0.96);
  box-shadow:
    0 0 18rpx rgba(0, 168, 255, 0.78),
    0 0 34rpx rgba(0, 168, 255, 0.38),
    inset 0 0 24rpx rgba(0, 168, 255, 0.12);
  overflow: hidden;
}

.role-skill-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.role-skill-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: transparent;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 42rpx;
}

.role-skill-heading {
  color: #64ff38;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.role-skill-tree {
  position: relative;
  z-index: 1;
  height: 214rpx;
  margin-top: 12rpx;
}

.role-skill-line {
  position: absolute;
  height: 2rpx;
  background: rgba(151, 170, 180, 0.58);
  transform-origin: left center;
}

.role-skill-line.left {
  left: 106rpx;
  top: 88rpx;
  width: 121rpx;
  border-top: 2rpx dashed rgba(196, 208, 214, 0.72);
  background: transparent;
}

.role-skill-line.top {
  left: 299rpx;
  top: 88rpx;
  width: 168rpx;
  transform: rotate(-22deg);
}

.role-skill-line.bottom {
  left: 299rpx;
  top: 88rpx;
  width: 169rpx;
  transform: rotate(15deg);
}

.role-skill-node-wrap {
  position: absolute;
  width: 114rpx;
  text-align: center;
}

.role-skill-node-wrap.start {
  left: 12rpx;
  top: 52rpx;
}

.role-skill-node-wrap.middle {
  left: 206rpx;
  top: 52rpx;
}

.role-skill-node-wrap.locked.top {
  right: 34rpx;
  top: -18rpx;
}

.role-skill-node-wrap.locked.bottom {
  right: 34rpx;
  top: 90rpx;
}

.role-skill-node {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 72rpx;
}

.role-skill-node.green {
  background: #64ff38;
  box-shadow: 0 0 18rpx rgba(100, 255, 56, 0.3);
}

.role-skill-node.orange {
  background: #ffbd66;
  box-shadow: 0 0 18rpx rgba(255, 189, 102, 0.25);
}

.role-skill-node.locked {
  width: 82rpx;
  height: 82rpx;
  border: 4rpx dashed rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
  color: #ffd36a;
  line-height: 82rpx;
}

.role-skill-node.locked text {
  line-height: 82rpx;
}

.role-skill-node text {
  line-height: 72rpx;
}

.role-skill-node-label {
  display: block;
  margin-top: 54rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.role-skill-node-wrap.locked.bottom .role-skill-node-label {
  margin-top: 6rpx;
}

.role-review-panel {
  margin-top: 40rpx;
}

.role-review-head {
  min-height: 68rpx;
  margin-bottom: 6rpx;
}

.role-review-title-wrap {
  display: flex;
  align-items: center;
}

.role-review-head .role-review-icon {
  margin-right: 18rpx;
  color: #ffd15c;
  font-size: 40rpx;
  line-height: 52rpx;
}

.role-review-head .role-review-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.role-review-more {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.role-review-card,
.role-network-card {
  padding: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(0, 123, 211, 0.18), rgba(3, 67, 115, 0.72));
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.22);
}

.role-network-card {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.role-review-card {
  min-height: 260rpx;
  padding: 34rpx 32rpx 30rpx;
  border-color: rgba(0, 168, 255, 0.68);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #00293a 0%, #0775b2 100%);
}

.role-review-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.role-review-player {
  display: flex;
  align-items: center;
  min-width: 0;
}

.role-review-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: #2f8df0;
  color: #111111;
  font-size: 34rpx;
  line-height: 70rpx;
  overflow: hidden;
}

.role-review-avatar image {
  width: 100%;
  height: 100%;
}

.role-review-player-copy {
  min-width: 0;
}

.role-review-author {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.role-review-time {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.role-review-rating {
  flex: none;
  margin-left: 20rpx;
  color: #ffc44d;
  font-size: 38rpx;
  letter-spacing: 2rpx;
  line-height: 44rpx;
  white-space: nowrap;
}

.role-review-content {
  display: block;
  margin-top: 48rpx;
  color: #d2ecff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.role-recommend-panel {
  padding: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(16, 185, 129, 0.16) 0%, rgba(16, 185, 129, 0) 32%),
    linear-gradient(135deg, rgba(16, 185, 129, 0.16), rgba(3, 67, 115, 0.74));
}

.role-recommend-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.role-recommend-tab {
  height: 34rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.06);
  font-size: 18rpx;
  line-height: 34rpx;
}

.role-recommend-tab.active {
  color: #13ed29;
  background: rgba(19, 237, 41, 0.14);
}

.role-recommend-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.role-recommend-item {
  display: flex;
  align-items: center;
  min-height: 70rpx;
}

.role-recommend-icon {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(16, 185, 129, 0.16);
  font-size: 26rpx;
  line-height: 54rpx;
  text-align: center;
}

.role-recommend-copy {
  flex: 1;
  min-width: 0;
}

.role-recommend-name {
  color: rgba(255, 255, 255, 0.86);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.role-recommend-desc {
  margin-top: 2rpx;
  color: #10b981;
  font-size: 17rpx;
  line-height: 24rpx;
}

.role-recommend-tag {
  flex: none;
  max-width: 150rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 17rpx;
  line-height: 24rpx;
  text-align: right;
}

.role-network-summary {
  color: #10b981;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 32rpx;
}

.role-network-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.role-network-meta text {
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.08);
  font-size: 17rpx;
  line-height: 34rpx;
}

.role-network-action {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  line-height: 28rpx;
}

.role-metaverse-card {
  position: relative;
  width: 662rpx;
  height: 204rpx;
  margin-top: 50rpx;
  margin-right: auto;
  margin-left: auto;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 82% 50%, rgba(52, 241, 241, 0.2) 0%, rgba(52, 241, 241, 0) 34%),
    linear-gradient(135deg, #0161a6 0%, #034373 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.role-metaverse-card .player-metaverse-title {
  color: #67f5f5;
}

.role-metaverse-card .player-metaverse-desc {
  color: #c4cad6;
}

.role-metaverse-card .player-metaverse-tags text {
  border-color: rgba(6, 182, 212, 0.3);
}

.role-metaverse-card .player-metaverse-tags text.purple {
  border-color: rgba(168, 85, 247, 0.3);
}
