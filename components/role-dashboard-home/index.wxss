.player-role-audit-steps {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 30rpx 42rpx 0;
}

.player-role-audit-steps::before,
.player-role-audit-steps::after {
  content: "";
  position: absolute;
  top: 15rpx;
  height: 4rpx;
  border-radius: 999rpx;
}

.player-role-audit-steps::before {
  left: calc(50% + 15rpx);
  width: calc(33.333% - 30rpx);
  background: rgba(255, 255, 255, 0.08);
}

.player-role-audit-steps.done::before {
  background: linear-gradient(90deg, rgba(0, 255, 136, 1) 0%, rgba(255, 149, 0, 1) 100%);
  box-shadow: 0 0 8rpx rgba(255, 138, 31, 0.18);
}

.player-role-audit-steps::after {
  left: calc(16.666% + 15rpx);
  width: calc(33.333% - 30rpx);
  background: linear-gradient(90deg, rgba(0, 255, 136, 1) 0%, rgba(255, 149, 0, 1) 100%);
  box-shadow: 0 0 8rpx rgba(255, 138, 31, 0.18);
}

.player-role-audit-step {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
