/* Keep the role dashboard anchored to the shell frame, not to a page file. */
.role-home-page,
.player-home-page {
  width: 100%;
}

.player-ranking-panel,
.player-achievement-panel,
.player-summary-card,
.player-world-card,
.player-metaverse-card,
.player-section-head,
.role-section-desc,
.role-session-card,
.role-skill-panel,
.role-review-panel,
.role-recommend-panel,
.role-network-panel,
.role-metaverse-card {
