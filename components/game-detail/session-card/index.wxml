<view class="session-card detail-card session-detail-card {{cardClass}}">
  <view class="session-card-title-row section-title-row left">
    <image class="session-card-title-icon section-title-icon" src="/pages/game/detail/assets/icon-calendar.png" mode="aspectFit"></image>
    <text class="session-card-title section-title {{titleWeight === 'regular' ? 'regular' : ''}}">组局信息</text>
  </view>
  <view class="session-card-info-list info-list">
    <view wx:for="{{items}}" wx:key="label" class="session-card-info-row info-row">
      <view class="session-card-info-icon info-icon {{item.iconClass}} {{item.iconSrc ? 'image' : ''}}">
        <image wx:if="{{item.iconSrc}}" class="session-card-info-icon-image info-icon-image" src="{{item.iconSrc}}" mode="aspectFit"></image>
        <text wx:else>{{item.iconText}}</text>
      </view>
      <view class="session-card-info-copy info-copy">
        <text class="session-card-info-label info-label">{{item.label}}</text>
        <text class="session-card-info-value info-value">{{item.value}}</text>
        <button
          wx:if="{{item.actionText}}"
          class="session-card-map-button map-button"
          hover-class="none"
          data-item="{{item}}"
          bindtap="handleMapTap"
        >{{item.actionText}}</button>
      </view>
    </view>
  </view>
</view>
