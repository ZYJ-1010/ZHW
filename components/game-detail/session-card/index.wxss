.session-card {
  width: 682rpx;
  margin-right: auto;
  margin-left: auto;
  box-sizing: border-box;
  border: 1rpx solid var(--game-detail-panel-border-color, rgba(17, 24, 39, 0.08));
  border-radius: 32rpx;
  background: var(--game-detail-panel-background-color, #ffffff);
  box-shadow: 0 16rpx 30rpx rgba(17, 24, 39, 0.08);
  height: 512rpx;
  margin-top: 18rpx;
  padding: 34rpx 30rpx 26rpx;
  border-radius: 32rpx;
  background: var(--game-detail-panel-background-color, #ffffff);
  box-shadow: 0 16rpx 30rpx rgba(17, 24, 39, 0.08);
}

.session-card.audit-session-card {
  height: auto;
  min-height: 0;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 0;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.18);
}

.session-card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.session-card-title-row.left {
  justify-content: flex-start;
  gap: 14rpx;
}

.session-card-title-icon {
  flex: none;
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.session-card-title {
  color: var(--game-detail-panel-text-color, #111827);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.session-card-title.regular {
  font-weight: 400;
}

.session-card-info-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.session-card .session-card-info-list {
  gap: 34rpx;
}

.session-card-info-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.session-card-info-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: var(--game-detail-panel-muted-color, #6b7280);
  background: var(--game-detail-panel-soft-color, #f3f4f6);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.session-card-info-icon.image {
  background: transparent;
}

.session-card-info-icon-image {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.session-card-info-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.session-card-info-label {
  color: var(--game-detail-panel-muted-color, #6b7280);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.session-card-info-value {
  margin-top: 6rpx;
  color: var(--game-detail-panel-text-color, #111827);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.session-card-map-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 70rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  color: #4b5563;
  background: var(--game-detail-panel-soft-color, #f3f4f6);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.session-card-map-button::after {
  border: 0;
}
