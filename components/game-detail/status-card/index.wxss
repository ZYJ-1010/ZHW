.status-card {
  position: relative;
  overflow: hidden;
  width: 666rpx;
  min-height: 458rpx;
  margin: 0 auto;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(154.26deg, rgba(251, 146, 60, 1) 12.58%, rgba(239, 68, 68, 1) 87.42%);
  box-shadow: 0 16rpx 34rpx rgba(252, 96, 118, 0.22);
}

.status-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}

.hourglass {
  position: relative;
  width: 34rpx;
  height: 46rpx;
  border-top: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  box-sizing: border-box;
}

.hourglass::before,
.hourglass::after {
  position: absolute;
  left: 4rpx;
  width: 26rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
  content: '';
}

.hourglass::before {
  top: 2rpx;
  border-top: 18rpx solid rgba(255, 255, 255, 0.92);
}

.hourglass::after {
  bottom: 2rpx;
  border-bottom: 18rpx solid rgba(255, 255, 255, 0.92);
}

.status-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.status-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 32rpx;
}

.status-title {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.referral-quote {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.12);
  font-size: 26rpx;
  line-height: 38rpx;
}

.status-meta-box {
  margin-top: 20rpx;
  padding: 20rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
}

.referral-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 0 24rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 34rpx;
}

.referral-name {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.countdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 24rpx 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 34rpx;
}

.countdown-value {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.2);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}
