.home-role-compare {
  min-height: 100%;
  box-sizing: border-box;
  background: #000000;
}

.home-game-appbar {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #000000;
}

.home-game-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-top: -22rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 44rpx;
  text-align: center;
}

.home-game-app-title {
  display: block;
  max-width: 500rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-role-compare-content {
  padding: 20rpx 28rpx 32rpx;
  box-sizing: border-box;
}

.home-role-hero {
  padding: 16rpx 0 28rpx;
  text-align: center;
}

.home-role-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.home-role-title-icon {
  display: block;
  font-size: 50rpx;
  line-height: 50rpx;
}

.home-role-title,
.home-role-subtitle,
.home-role-icon,
.home-role-name,
.home-role-level {
  display: block;
}

.home-role-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.home-role-subtitle {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  line-height: 34rpx;
}

.home-role-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.home-role-card {
  min-height: 180rpx;
  padding: 24rpx 8rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  box-sizing: border-box;
  background: rgba(20, 25, 50, 0.6);
  opacity: 1;
  text-align: center;
}

.home-role-card.active {
  border-width: 2rpx;
  box-shadow: 0 0 24rpx rgba(0, 206, 209, 0.24);
  opacity: 1;
}

.home-role-card.player,
.home-role-card.player.active {
  border-color: rgba(0, 212, 255, 0.5);
  background: rgba(0, 212, 255, 0.1);
  box-shadow: none;
}

.home-role-card.guide.active {
  border-color: #ff8a2c;
  box-shadow: 0 0 24rpx rgba(255, 138, 44, 0.28);
}

.home-role-card.expert.active {
  border-color: #4ddbff;
  box-shadow: 0 0 24rpx rgba(77, 219, 255, 0.28);
}

.home-role-icon {
  font-size: 56rpx;
  line-height: 62rpx;
}

.home-role-name {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.home-role-level {
  margin-top: 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.home-role-table {
  margin-top: 42rpx;
  padding: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  background: rgba(0, 0, 0, 0);
  overflow: hidden;
}

.home-role-row {
  display: grid;
  grid-template-columns: 1.18fr 0.84fr 1.1fr 1.1fr;
  align-items: center;
  min-height: 54rpx;
  padding: 0 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.home-role-row.head {
  min-height: 54rpx;
  border-top: 0;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.03);
  font-size: 28rpx;
  font-weight: 400;
  text-transform: uppercase;
}

.home-role-row.spaced {
  margin-top: 52rpx;
}

.home-role-row text:not(:first-child) {
  text-align: center;
}

.home-role-row .ok,
.home-role-row .guide.ok,
.home-role-row .guide.rate,
.home-role-row .expert.ok,
.home-role-row .expert.rate {
  color: #00e676;
}

.home-role-row .ok {
  font-size: 28rpx;
  font-weight: 400;
}

.home-role-row .muted {
  color: rgba(255, 255, 255, 0.3);
}

.home-role-row .rate {
  font-size: 24rpx;
  font-weight: 400;
}

.home-role-row.head .player {
  color: #ffffff;
}

.home-role-row.head .guide {
  color: #fd780f;
}

.home-role-row.head .expert {
  color: #16c0f6;
}

.home-game-bottom-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 620rpx;
  height: 92rpx;
  margin: 26rpx auto 0;
  border-radius: 50rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #33d9ff 0%, #15bfe8 100%);
  box-shadow: 0 0 32rpx rgba(0, 206, 209, 0.34);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.theme-guide .home-game-bottom-action {
  background: linear-gradient(180deg, #ff9a3d 0%, #ff7a1a 100%);
  box-shadow: 0 0 32rpx rgba(255, 138, 44, 0.36);
}

.theme-expert .home-game-bottom-action {
  background: linear-gradient(180deg, #33d9ff 0%, #15bfe8 100%);
  box-shadow: 0 0 32rpx rgba(0, 206, 209, 0.34);
}

.theme-player .home-game-bottom-action {
  background: linear-gradient(180deg, #2c5f7a 0%, #16435b 100%);
  box-shadow: none;
}

.home-game-bottom-action.disabled,
.theme-guide .home-game-bottom-action.disabled,
.theme-expert .home-game-bottom-action.disabled,
.theme-player .home-game-bottom-action.disabled {
  color: rgba(255, 255, 255, 0.68);
  background: linear-gradient(180deg, #404650 0%, #2b3038 100%);
  box-shadow: none;
  opacity: 0.86;
}
